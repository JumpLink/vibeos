#!/bin/sh
# the update timer stops in the user managers running now when Software goes (its enablement for every user stays
# until a purge, as debhelper's postrm does it, and points at nothing meanwhile)
set -e

if [ "$1" = remove ] && [ -z "${DPKG_ROOT:-}" ] && [ -d /run/systemd/system ]; then
    deb-systemd-invoke --user stop vibeos-software-updates.timer > /dev/null 2>&1 || true
fi

#DEBHELPER#

exit 0
