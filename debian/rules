#!/usr/bin/make -f
# VibeOS is several meson projects: the top level (libspongy, libtonal, vibeos-launcher, input-boost, vibeos-auth, vibeos-wakeup),
# libvibeos, the extension, the session files and one per app. libvibeos and the apps find libspongy and libvibeos through
# the -uninstalled.pc files meson writes into each build directory, so the projects are configured and built one
# after the other, in this order.

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

APPS := calculator calendar clock compass contacts dialer messaging browser settings weather camera files dictate
# build directory:source directory
PROJECTS := top:. libvibeos:libvibeos extension:extension session:session $(foreach a,$(APPS),$(a):apps/$(a))
BUILDDIRS := $(foreach p,$(PROJECTS),obj-$(firstword $(subst :, ,$(p))))

# the libraries being built come before anything installed (a hand-built libspongy or libvibeos in /usr/local)
export PKG_CONFIG_PATH := $(CURDIR)/obj-top/meson-uninstalled:$(CURDIR)/obj-libvibeos/meson-uninstalled
TEST_LIBS := $(CURDIR)/obj-top/libspongy:$(CURDIR)/obj-libvibeos:$(CURDIR)/obj-top/libtonal

%:
	dh $@

# each project is configured right before it is built (it needs the ones before it built)
override_dh_auto_configure:

override_dh_auto_build:
	set -e; for p in $(PROJECTS); do \
		b=obj-$${p%%:*}; s=$${p#*:}; \
		dh_auto_configure --sourcedirectory=$$s --builddirectory=$$b; \
		dh_auto_build --sourcedirectory=$$s --builddirectory=$$b; \
	done

override_dh_auto_test:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	set -e; for p in $(PROJECTS); do \
		b=obj-$${p%%:*}; s=$${p#*:}; \
		LD_LIBRARY_PATH=$(TEST_LIBS) dh_auto_test --sourcedirectory=$$s --builddirectory=$$b; \
	done
endif

override_dh_auto_install:
	set -e; for p in $(PROJECTS); do \
		b=obj-$${p%%:*}; s=$${p#*:}; \
		dh_auto_install --sourcedirectory=$$s --builddirectory=$$b --destdir=debian/tmp; \
	done

override_dh_auto_clean:
	rm -rf $(BUILDDIRS)

# Nothing that would take over a desktop is enabled: the phone session without a display manager, the docked desktop
# and the dock switcher are the user's choice (README.Debian), and input-boost's clock floor is the device's to tune.
# vibeos-wakeup and sim-apn run from boot.
# --no-start alone also stops the unit before an upgrade and never starts it again: an apt upgrade took the phone's
# screen away (the session is the whole UI). So the session units stay up through an upgrade (the new one runs from the
# next login or boot), and input-boost, if the device runs it, restarts once the new one is in.
override_dh_installsystemd:
	dh_installsystemd -pvibeos-session --no-enable --no-start --no-stop-on-upgrade
	dh_installsystemd -pvibeos-daemons --no-enable --no-start --restart-after-upgrade input-boost.service
	dh_installsystemd -pvibeos-daemons vibeos-wakeup.service
	dh_installsystemd -psim-apn
