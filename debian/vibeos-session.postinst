#!/bin/sh
# On every configure, and whenever a package changes /usr/share/applications (the trigger), GNOME's apps that a
# VibeOS app replaces are hidden again from the app lists (vibeos-hide-replaced-apps).
set -e

case "$1" in
configure|triggered)
    /usr/libexec/vibeos-hide-replaced-apps || echo "could not hide GNOME's apps that VibeOS's replace" >&2
    ;;
esac

#DEBHELPER#

exit 0
