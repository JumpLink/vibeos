#: ../dictate/src/dictate-download-dialog.c
#, c-format
msgid "%s speech recogniser"
msgstr "Reconnaissance vocale %s"

#. TRANSLATORS: a dialog's title; %s is the language's name for itself (Deutsch)
#: ../dictate/src/dictate-download-dialog.c
#, c-format
msgid "Downloading %s"
msgstr "Téléchargement de %s"

#: ../dictate/src/dictate-download-dialog.c
msgid "The package was installed, but the language is still not ready"
msgstr "Le paquet a été installé, mais la langue n'est toujours pas prête"

#. TRANSLATORS: the sum of the sizes in the download dialog; %s is a size: 90.4 MB
#: ../dictate/src/dictate-download-dialog.c
#, c-format
msgid "%s in all"
msgstr "%s au total"

#. TRANSLATORS: a dialog's title; %s is the language's name for itself (Deutsch)
#: ../dictate/src/dictate-download-dialog.c
#, c-format
msgid "Download %s?"
msgstr "Télécharger %s ?"

#. TRANSLATORS: the first %s is the language's name for itself (Deutsch), the second an app's name (Navi)
#: ../dictate/src/dictate-download-dialog.c
#, c-format
msgid "To speak %s, %s needs this on the phone:"
msgstr "Pour parler en %s, %s a besoin de ceci sur le téléphone :"

#. TRANSLATORS: %s is the language's name for itself (Deutsch)
#: ../dictate/src/dictate-download-dialog.c
#, c-format
msgid "To hear and speak %s, Vibe needs these on the phone:"
msgstr ""
"Pour comprendre et parler en %s, Vibe a besoin de ces éléments sur le "
"téléphone :"

#. TRANSLATORS: %s is the language's name for itself (Deutsch)
#: ../dictate/src/dictate-download-dialog.c
#, c-format
msgid "To hear %s, Dictate needs these on the phone:"
msgstr ""
"Pour reconnaître la parole en %s, Dictate a besoin de ces éléments sur le "
"téléphone :"

#. TRANSLATORS: under it; %s is its Debian package (vibeos-dictate-vosk)
#: ../dictate/src/dictate-download-dialog.c
#, c-format
msgid "the %s package from the VibeOS archive"
msgstr "le paquet %s de l'archive VibeOS"

#. TRANSLATORS: under what is downloaded: what it is, its licence and where it comes from
#: ../dictate/src/dictate-download-dialog.c
#, c-format
msgid "%s · %s · from %s"
msgstr "%s · %s · depuis %s"

# android: Messaging action_download (short)
#: ../dictate/src/dictate-download-dialog.c
msgid "Download"
msgstr "Télécharger"

#. TRANSLATORS: a dialog's title; %s is the language's name for itself (Français)
#. TRANSLATORS: a dialog's title; %s is the language's name for itself
#: ../dictate/src/dictate-download-dialog.c
#, c-format
msgid "%s is not available"
msgstr "%s n'est pas disponible"

#. TRANSLATORS: the first %s is the language's name for itself, the second a speech recogniser (Vosk), the
#. * third its Debian package (vibeos-dictate-vosk)
#: ../dictate/src/dictate-download-dialog.c
#, c-format
msgid ""
"%s is heard by %s, which is not installed on this phone. Install the %s "
"package, then choose %s again."
msgstr ""
"%s est reconnu par %s, qui n'est pas installé sur ce téléphone. Installez le "
"paquet %s, puis choisissez à nouveau %s."

#: ../dictate/src/dictate-download-dialog.c
msgid "There is nothing to download for it."
msgstr "Il n'y a rien à télécharger pour cette langue."

#. TRANSLATORS: %s is what went wrong, from the network or the file system
#: ../dictate/src/dictate-download.c
#, c-format
msgid "The download failed: %s"
msgstr "Échec du téléchargement : %s"

#. TRANSLATORS: %s is what went wrong
#: ../dictate/src/dictate-download.c
#, c-format
msgid "The files could not be put in place: %s"
msgstr "Impossible de mettre les fichiers en place : %s"

#. TRANSLATORS: %s is a file's name
#: ../dictate/src/dictate-download.c
#, c-format
msgid "%s did not come whole"
msgstr "%s n'est pas arrivé complet"

#. TRANSLATORS: %s is a file's name
#: ../dictate/src/dictate-download.c
#, c-format
msgid "%s is not the file it should be: its checksum does not match"
msgstr ""
"%s n'est pas le fichier attendu : sa somme de contrôle ne correspond pas"

#. TRANSLATORS: %s is a file's name
#: ../dictate/src/dictate-download.c
#, c-format
msgid "%s is larger than it should be"
msgstr "%s est plus volumineux que prévu"

#. TRANSLATORS: %s is a file's name, %u and the last %s the server's answer (404, Not Found)
#: ../dictate/src/dictate-download.c
#, c-format
msgid "The server did not give %s: %u %s"
msgstr "Le serveur n'a pas fourni %s : %u %s"

#. TRANSLATORS: %s is a file's name
#: ../dictate/src/dictate-download.c
#, c-format
msgid "%s is not the size it should be: it has changed on the server"
msgstr "%s n'a pas la taille attendue : il a changé sur le serveur"

#. TRANSLATORS: the %s are sizes: 90.4 MB
#: ../dictate/src/dictate-download.c
#, c-format
msgid "There is not enough space on the phone: %s are needed, %s are free"
msgstr "Espace insuffisant sur le téléphone : %s nécessaires, %s disponibles"
