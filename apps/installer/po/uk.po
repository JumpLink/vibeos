msgid_plural "Also installs %u other packages"
msgstr[0] "Також установить ще %u пакет"
msgstr[1] "Також установить ще %u пакети"
msgstr[2] "Також установить ще %u пакетів"

#: src/inst-view.c
#, c-format
msgid "%s to download: %s"
msgstr "Завантажити %s: %s"

#: src/inst-view.c
#, c-format
msgid "Also removes %u other package"
msgid_plural "Also removes %u other packages"
msgstr[0] "Також видалить ще %u пакет"
msgstr[1] "Також видалить ще %u пакети"
msgstr[2] "Також видалить ще %u пакетів"

#: src/inst-view.c
msgid "Package"
msgstr "Пакет"

#: src/inst-view.c
msgid "Website"
msgstr "Вебсайт"

#: src/inst-view.c
msgid ""
"A package can change anything on this device: it installs with full rights. "
"Install only what you trust."
msgstr ""
"Пакет може змінити на цьому пристрої що завгодно: він установлюється з "
"повними правами. Установлюйте лише те, чому довіряєте."

# android: PackageInstaller cancel
#: src/inst-view.c
msgid "Cancel"
msgstr "Скасувати"

# android: Framework accessibility_dialog_button_uninstall (several translations, short)
#: src/inst-view.c
