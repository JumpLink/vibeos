#. the dialog role: the shell's back gesture then sends Escape, which answers no
#. ⋮: About, VibeOS's About sheet, as every VibeOS app has it
#: data/vibeos.Installer.desktop.in src/inst-sheet.c src/inst-window.c
msgid "App Installer"
msgstr "Установщик приложений"

#: data/vibeos.Installer.desktop.in
msgid "Install apps from package files, and uninstall them"
msgstr "Установка приложений из файлов пакетов и их удаление"

#: data/vibeos.Installer.desktop.in
msgid "Install;Uninstall;Package;deb;Software;App;"
msgstr "Установить;Удалить;Пакет;deb;Программы;Приложение;"

#: src/inst-catalog.c
msgid "A sample app for trying App Installer"
msgstr "Пример приложения для знакомства с установщиком"

#: src/inst-catalog.c
msgid ""
"This package is not real: App Installer's demo shows it to try its screens.\n"
"\n"
"Nothing is installed or removed while the demo runs."
msgstr ""
"Это ненастоящий пакет: его показывает демонстрационный режим установщика, "
"чтобы можно было посмотреть экраны.\n"
"\n"
"Пока работает демонстрация, ничего не устанавливается и не удаляется."

#: src/inst-job.c
#, c-format
msgid "%s is part of VibeOS."
msgstr "%s входит в состав VibeOS."

#: src/inst-job.c
#, c-format
msgid "%s is part of the phone's shell and session."
msgstr "%s входит в оболочку и сеанс телефона."

#: src/inst-job.c
#, c-format
msgid "%s is essential: the system cannot work without it."
msgstr "%s — важнейший компонент: без него система не работает."

#: src/inst-job.c
#, c-format
msgid "%s is required by the system."
msgstr "%s требуется системе."

#: src/inst-job.c
msgid "Cannot be uninstalled"
msgstr "Удаление невозможно"

#: src/inst-job.c
#, c-format
msgid "Uninstalling it would also remove %s. %s"
msgstr "При удалении будет также удалено: %s. %s"

#: src/inst-job.c
#, c-format
msgid "Installing it would remove %s. %s"
msgstr "При установке будет удалено: %s. %s"

#: src/inst-job.c
msgid "Cannot be installed"
msgstr "Установка невозможна"

#: src/inst-job.c src/inst-view.c
msgid "Not uninstalled"
msgstr "Не удалено"

#: src/inst-job.c src/inst-view.c
msgid "Not installed"
msgstr "Не установлено"

# android: SystemUI fgs_manager_app_item_stop_button_stopped_label (other app, short)
#: src/inst-job.c
msgid "Stopped"
msgstr "Остановлено"

#: src/inst-job.c
msgid "Nothing was uninstalled."
msgstr "Ничего не удалено."

#: src/inst-job.c
msgid "Nothing was installed."
msgstr "Ничего не установлено."

#. the password dialog closed without the password: the user's no, not a failure
#: src/inst-job.c
msgid "The password was not given, so nothing was uninstalled."
msgstr "Пароль не введен, поэтому ничего не удалено."

#: src/inst-job.c
msgid "The password was not given, so nothing was installed."
msgstr "Пароль не введен, поэтому ничего не установлено."

#: src/inst-job.c
msgid ""
"Another app is installing or updating software right now. Try again once it "
"has finished."
msgstr ""
"Другое приложение сейчас устанавливает или обновляет программы. Повторите "
"попытку, когда оно закончит."

#: src/inst-job.c
msgid ""
"Something it needs cannot be installed: it is not in the software sources, "
"or not in a version that fits."
msgstr ""
"Не удается установить нужный ему компонент: его нет в источниках программ "
"или нет подходящей версии."

#: src/inst-job.c
msgid ""
"Packages it needs could not be downloaded. Check the internet connection and "
"try again."
msgstr ""
"Не удалось скачать нужные ему пакеты. Проверьте подключение к интернету и "
"повторите попытку."

#: src/inst-job.c
msgid ""
"The package is broken: the file is damaged, or it is not a proper package."
msgstr "Пакет поврежден: файл испорчен или это не настоящий пакет."

#: src/inst-job.c
msgid "There is not enough free storage for it."
msgstr "Для него недостаточно свободного места."

#: src/inst-job.c
msgid ""
"It clashes with software that is already installed: both have the same files."
msgstr ""
"Конфликтует с уже установленными программами: у них есть одинаковые файлы."

#: src/inst-job.c
msgid "The package's own setup failed. It may be only partly installed."
msgstr ""
"Не удалось выполнить настройку пакета. Возможно, он установлен не полностью."

#: src/inst-job.c
msgid ""
"The package's own removal script failed. It may be only partly uninstalled."
msgstr ""
"Не удалось выполнить сценарий удаления пакета. Возможно, он удален не "
"полностью."

#: src/inst-job.c
msgid "It is made for another kind of device."
msgstr "Он предназначен для устройств другого типа."

#: src/inst-job.c
msgid ""
"The software sources could not be verified, so nothing was downloaded from "
"them."
msgstr ""
"Не удалось проверить источники программ, поэтому из них ничего не скачано."

#: src/inst-job.c
msgid "The software sources do not have it (any more)."
msgstr "Его нет в источниках программ (или уже нет)."

#: src/inst-job.c
msgid "Software was installed or removed meanwhile. Try again."
msgstr ""
"За это время программы были установлены или удалены. Повторите попытку."

#: src/inst-job.c
msgid "Cannot install software"
msgstr "Не удается устанавливать программы"

#: src/inst-job.c
msgid ""
"PackageKit, the system service that installs software, is missing or not "
"running."
msgstr ""
"Системная служба PackageKit, которая устанавливает программы, отсутствует "
"или не запущена."

#: src/inst-job.c
msgid "Something went wrong while uninstalling."
msgstr "При удалении произошла ошибка."

#: src/inst-job.c
msgid "Something went wrong while installing."
msgstr "При установке произошла ошибка."

#: src/inst-job.c
msgid "Waiting for your password"
msgstr "Ожидание пароля"

#: src/inst-job.c
msgid "Waiting for another install to finish"
msgstr "Ожидание завершения другой установки"

#: src/inst-job.c
msgid "Downloading"
msgstr "Скачивание"

#: src/inst-job.c
msgid "Uninstalling"
msgstr "Удаление"

#: src/inst-job.c
msgid "Installing"
msgstr "Установка"

#: src/inst-job.c
msgid "Finishing"
msgstr "Завершение"

#: src/inst-job.c
msgid "Stopping"
msgstr "Остановка"

#: src/inst-job.c
msgid "Getting ready"
msgstr "Подготовка"

#: src/inst-job.c
msgid "Checking what else it takes along"
msgstr "Проверка, что еще будет удалено"

#: src/inst-job.c
msgid "Checking what else it needs"
msgstr "Проверка зависимостей"

#: src/inst-job.c
msgid "Looking it up"
msgstr "Поиск"

#: src/inst-job.c
msgid "Checking the software sources"
msgstr "Проверка источников программ"

#: src/inst-job.c
#, c-format
msgid "The software sources have no package called “%s”."
msgstr "В источниках программ нет пакета «%s»."

# android: SystemUI controls_error_removed (other app, short)
#: src/inst-job.c
msgid "Not found"
msgstr "Не найдено"

#: src/inst-job.c
msgid "Removing it would leave other software with something it needs missing."
msgstr ""
"После удаления другим программам будет не хватать нужных им компонентов."

#: src/inst-job.c
#, c-format
msgid "%s is uninstalled."
msgstr "%s: удаление завершено."

#: src/inst-job.c
msgid "Uninstalled"
msgstr "Удалено"

#: src/inst-job.c
#, c-format
msgid "%s %s is installed."
msgstr "%s %s: установка завершена."

# android: Settings installed (several translations, short)
#: src/inst-job.c src/inst-view.c
msgid "Installed"
msgstr "Установлено"

#: src/inst-job.c
msgid "Cannot open the file"
msgstr "Не удается открыть файл"

#: src/inst-job.c
msgid "The file could not be read."
msgstr "Не удалось прочитать файл."

#: src/inst-job.c
msgid "dpkg, which reads packages, is missing."
msgstr "Отсутствует dpkg, который читает пакеты."

#: src/inst-job.c
msgid "Not a package"
msgstr "Это не пакет"

#: src/inst-job.c
msgid ""
"This file is not a software package that can be installed here, or it is "
"damaged."
msgstr ""
"Этот файл не является пакетом, который можно установить здесь, или он "
"поврежден."

#: src/inst-job.c
#, c-format
msgid "It is made for %s devices; this one is %s."
msgstr "Он предназначен для устройств %s, а это устройство — %s."

#: src/inst-job.c
msgid "Made for another kind of device"
msgstr "Для устройств другого типа"

#: src/inst-job.c
msgid "Reading the package"
msgstr "Чтение пакета"

#: src/inst-job.c
msgid "Cannot uninstall software"
msgstr "Не удается удалять программы"

#: src/inst-job.c
msgid "dpkg, which keeps track of the installed software, is missing."
msgstr "Отсутствует dpkg, который ведет учет установленных программ."

#: src/inst-job.c
#, c-format
msgid "“%s” is not installed."
msgstr "Пакет «%s» не установлен."

#: src/inst-main.c
msgid "Install the package NAME from the software sources"
msgstr "Установить пакет ИМЯ из источников программ"

#: src/inst-main.c
msgid "NAME"
msgstr "ИМЯ"

#: src/inst-main.c
msgid "Uninstall the package NAME"
msgstr "Удалить пакет ИМЯ"

#: src/inst-main.c
msgid "Print the version"
msgstr "Показать версию"

#: src/inst-main.c
msgid "[FILE.deb…]"
msgstr "[ФАЙЛ.deb…]"

#: src/inst-pk.c
msgid "A library the app needs"
msgstr "Библиотека, нужная приложению"

#: src/inst-pk.c
msgid "A sample app"
msgstr "Пример приложения"

#: src/inst-service.c
#, c-format
msgid "%s %s is installed already."
msgstr "%s %s: уже установлено."

#. TRANSLATORS: %s is a list of names ("libfoo, libbar"), %u how many more there are
#: src/inst-view.c
#, c-format
msgid "%s and %u more"
msgid_plural "%s and %u more"
msgstr[0] "%s и еще %u"
msgstr[1] "%s и еще %u"
msgstr[2] "%s и еще %u"

# android: Settings vpn_version_info
#: src/inst-view.c
#, c-format
msgid "Version %s"
msgstr "Версия %s"

#: src/inst-view.c
msgid "This file"
msgstr "Этот файл"

# android: Settings wifi_p2p_status[3] (several translations, short)
#: src/inst-view.c
msgid "Available"
msgstr "Доступно"

#: src/inst-view.c
msgid "newer"
msgstr "новее"

# android: Framework older (adapted, several translations, short)
#: src/inst-view.c
msgid "older"
msgstr "старее"

# android: Framework older (adapted, several translations, short)
#: src/inst-view.c
msgid "OLDER"
msgstr "СТАРЕЕ"

#: src/inst-view.c
msgid "Install this app?"
msgstr "Установить это приложение?"

#: src/inst-view.c
msgid "Install this package?"
msgstr "Установить этот пакет?"

#: src/inst-view.c
#, c-format
msgid "Replace %s %s with %s?"
msgstr "Заменить %s %s версией %s?"

#: src/inst-view.c
msgid "This file has a newer version than the one installed."
msgstr "В этом файле более новая версия, чем установленная."

#: src/inst-view.c
msgid "The software sources have a newer version than the one installed."
msgstr "В источниках программ есть более новая версия, чем установленная."

#: src/inst-view.c
msgid "This file is an OLDER version"
msgstr "В этом файле СТАРАЯ версия"

#: src/inst-view.c
msgid "The available version is OLDER"
msgstr "Доступная версия СТАРЕЕ"

#: src/inst-view.c
#, c-format
msgid ""
"%s %s is installed. This file has %s, which is older. Replace the installed "
"version with the older one?"
msgstr ""
"Сейчас установлено: %s %s. В этом файле версия %s, более старая. Заменить "
"установленную версию более старой?"

#: src/inst-view.c
#, c-format
msgid ""
"%s %s is installed. The software sources have %s, which is older. Replace "
"the installed version with the older one?"
msgstr ""
"Сейчас установлено: %s %s. В источниках программ версия %s, более старая. "
"Заменить установленную версию более старой?"

#: src/inst-view.c
msgid "Already installed"
msgstr "Уже установлено"

#: src/inst-view.c
#, c-format
msgid ""
"%s %s is installed already. Reinstalling puts its files back as they came."
msgstr ""
"Уже установлено: %s %s. При переустановке его файлы будут восстановлены в "
"исходном виде."

#: src/inst-view.c
#, c-format
msgid ""
"%s %s is installed already. The same version cannot be installed over itself."
msgstr ""
"Уже установлено: %s %s. Нельзя установить ту же версию поверх самой себя."

#: src/inst-view.c
#, c-format
msgid "Uninstall %s?"
msgstr "Удалить «%s»?"

#: src/inst-view.c
msgid "Its data will be deleted."
msgstr "Его данные будут удалены."

#: src/inst-view.c
msgid "Its program files are removed. Your own files stay."
msgstr "Файлы программы будут удалены. Ваши собственные файлы останутся."

#: src/inst-view.c
msgid "Frees"
msgstr "Освободится"

#. TRANSLATORS: a package file's size, then the space it takes once installed: "4 MB file · 12 MB installed"
#: src/inst-view.c
#, c-format
msgid "%s file · %s installed"
msgstr "Файл: %s · после установки: %s"

#. TRANSLATORS: what installing downloads, then the space it takes: "4 MB download · 12 MB installed"
#: src/inst-view.c
#, c-format
msgid "%s download · %s installed"
msgstr "Загрузка: %s · после установки: %s"

#: src/inst-view.c
#, c-format
msgid "%s installed"
msgstr "После установки: %s"

#: src/inst-view.c
#, c-format
msgid "%s file"
msgstr "Файл: %s"

#: src/inst-view.c
#, c-format
msgid "%s download"
msgstr "Загрузка: %s"

# android: Settings accessibility_button_size_title (short)
#: src/inst-view.c
msgid "Size"
msgstr "Размер"

#: src/inst-view.c
#, c-format
msgid "Also installs %u other package"
msgid_plural "Also installs %u other packages"
msgstr[0] "Также установит еще %u пакет"
msgstr[1] "Также установит еще %u пакета"
msgstr[2] "Также установит еще %u пакетов"

#: src/inst-view.c
#, c-format
msgid "%s to download: %s"
msgstr "Загрузка %s: %s"

#: src/inst-view.c
#, c-format
msgid "Also removes %u other package"
msgid_plural "Also removes %u other packages"
msgstr[0] "Также удалит еще %u пакет"
msgstr[1] "Также удалит еще %u пакета"
msgstr[2] "Также удалит еще %u пакетов"

#: src/inst-view.c
msgid "Package"
msgstr "Пакет"

# android: Contacts header_website_entry (other app, short)
#: src/inst-view.c
msgid "Website"
msgstr "Веб-сайт"

#: src/inst-view.c
msgid ""
"A package can change anything on this device: it installs with full rights. "
"Install only what you trust."
msgstr ""
"Пакет может изменить на этом устройстве что угодно: он устанавливается с "
"полными правами. Устанавливайте только то, чему доверяете."

# android: PackageInstaller cancel (several translations, short)
#: src/inst-view.c
msgid "Cancel"
msgstr "Отмена"

# android: Framework accessibility_dialog_button_uninstall (short)
#: src/inst-view.c
msgid "Uninstall"
msgstr "Удалить"

# android: PackageInstaller install
#: src/inst-view.c
msgid "Install"
msgstr "Установить"

# android: PackageInstaller launch
#: src/inst-view.c src/inst-window.c
msgid "Open"
msgstr "Открыть"

# android: PackageInstaller done (several translations, short)
#: src/inst-view.c
msgid "Done"
msgstr "Готово"

#: src/inst-view.c
#, c-format
msgid "Replace with %s"
msgstr "Заменить на %s"

#: src/inst-view.c
msgid "Reinstall"
msgstr "Переустановить"

# android: Framework lockscreen_transport_stop_description (several translations, short)
#: src/inst-view.c
msgid "Stop"
msgstr "Остановить"

# android: PackageInstaller close (several translations, short)
#: src/inst-view.c
msgid "Close"
msgstr "Закрыть"

# android: Framework action_menu_overflow_description (several translations, short)
#: src/inst-window.c
msgid "More options"
msgstr "Ещё"

#: src/inst-window.c
msgid "Software packages (.deb)"
msgstr "Пакеты программ (.deb)"

#: src/inst-window.c
msgid "Choose a package"
msgstr "Выбрать пакет"

#: src/inst-window.c
msgid "Install apps from packages"
msgstr "Установка приложений из пакетов"

#: src/inst-window.c
msgid ""
"App Installer installs .deb package files. Tap one in Files, or choose one "
"here: it shows what the package is and asks before anything changes."
msgstr ""
"Установщик приложений устанавливает пакеты .deb. Нажмите на файл в "
"приложении «Файлы» или выберите его здесь: установщик покажет, что это за "
"пакет, и спросит, прежде чем что-либо менять."

#: src/inst-window.c
msgid ""
"Software uses it too, to install and uninstall apps from the software "
"sources."
msgstr ""
"«Центр приложений» тоже использует его для установки и удаления приложений "
"из источников программ."
