#. the dialog role: the shell's back gesture then sends Escape, which answers no
#. ⋮: About, VibeOS's About sheet, as every VibeOS app has it
#: data/vibeos.Installer.desktop.in src/inst-sheet.c src/inst-window.c
msgid "App Installer"
msgstr "מתקין האפליקציות"

#: data/vibeos.Installer.desktop.in
msgid "Install apps from package files, and uninstall them"
msgstr "התקנת אפליקציות מקובצי חבילה, והסרתן"

#: data/vibeos.Installer.desktop.in
msgid "Install;Uninstall;Package;deb;Software;App;"
msgstr "התקנה;הסרה;חבילה;תוכנה;אפליקציה;deb;Install;Uninstall;Package;Software;App;"

#: src/inst-catalog.c
msgid "A sample app for trying App Installer"
msgstr "אפליקציה לדוגמה לניסיון של מתקין האפליקציות"

#: src/inst-catalog.c
msgid ""
"This package is not real: App Installer's demo shows it to try its screens.\n"
"\n"
"Nothing is installed or removed while the demo runs."
msgstr ""
"החבילה הזו לא אמיתית: ההדגמה של מתקין האפליקציות מציגה אותה כדי לנסות את המסכים שלו.\n"
"\n"
"בזמן ההדגמה שום דבר לא מותקן ולא מוסר."

#: src/inst-job.c
#, c-format
msgid "%s is part of VibeOS."
msgstr "החבילה %s היא חלק מ-VibeOS."

#: src/inst-job.c
#, c-format
msgid "%s is part of the phone's shell and session."
msgstr "החבילה %s היא חלק מהמעטפת ומהסשן של הטלפון."

#: src/inst-job.c
#, c-format
msgid "%s is essential: the system cannot work without it."
msgstr "החבילה %s חיונית: המערכת לא יכולה לפעול בלעדיה."

#: src/inst-job.c
#, c-format
msgid "%s is required by the system."
msgstr "החבילה %s נדרשת למערכת."

#: src/inst-job.c
msgid "Cannot be uninstalled"
msgstr "לא ניתן להסיר"

#: src/inst-job.c
#, c-format
msgid "Uninstalling it would also remove %s. %s"
msgstr "הסרה שלה תסיר גם את %s. %s"

#: src/inst-job.c
#, c-format
msgid "Installing it would remove %s. %s"
msgstr "ההתקנה שלה תסיר את %s. %s"

#: src/inst-job.c
msgid "Cannot be installed"
msgstr "לא ניתן להתקין"

#: src/inst-job.c src/inst-view.c
msgid "Not uninstalled"
msgstr "לא הוסרה"

#: src/inst-job.c src/inst-view.c
msgid "Not installed"
msgstr "לא הותקנה"

# android: SystemUI fgs_manager_app_item_stop_button_stopped_label (other app, short)
#: src/inst-job.c
msgid "Stopped"
msgstr "הופסקה"

#: src/inst-job.c
msgid "Nothing was uninstalled."
msgstr "שום דבר לא הוסר."

#: src/inst-job.c
msgid "Nothing was installed."
msgstr "שום דבר לא הותקן."

#. the password dialog closed without the password: the user's no, not a failure
#: src/inst-job.c
msgid "The password was not given, so nothing was uninstalled."
msgstr "לא הוזנה סיסמה, ולכן שום דבר לא הוסר."

#: src/inst-job.c
msgid "The password was not given, so nothing was installed."
msgstr "לא הוזנה סיסמה, ולכן שום דבר לא הותקן."

#: src/inst-job.c
msgid "Another app is installing or updating software right now. Try again once it has finished."
msgstr "אפליקציה אחרת מתקינה או מעדכנת תוכנה כרגע. אפשר לנסות שוב כשהיא תסיים."

#: src/inst-job.c
msgid "Something it needs cannot be installed: it is not in the software sources, or not in a version that fits."
msgstr "רכיב שנדרש לה לא ניתן להתקנה: הוא לא נמצא במקורות התוכנה, או שאין לו גרסה מתאימה."

#: src/inst-job.c
msgid "Packages it needs could not be downloaded. Check the internet connection and try again."
msgstr "לא ניתן היה להוריד חבילות שנדרשות לה. יש לבדוק את החיבור לאינטרנט ולנסות שוב."

#: src/inst-job.c
msgid "The package is broken: the file is damaged, or it is not a proper package."
msgstr "החבילה פגומה: הקובץ ניזוק, או שזו לא חבילה תקינה."

#: src/inst-job.c
msgid "There is not enough free storage for it."
msgstr "אין מספיק נפח אחסון פנוי."

#: src/inst-job.c
msgid "It clashes with software that is already installed: both have the same files."
msgstr "היא מתנגשת בתוכנה שכבר מותקנת: לשתיהן יש אותם קבצים."

#: src/inst-job.c
msgid "The package's own setup failed. It may be only partly installed."
msgstr "ההגדרה של החבילה עצמה נכשלה. ייתכן שהיא מותקנת רק בחלקה."

#: src/inst-job.c
msgid "The package's own removal script failed. It may be only partly uninstalled."
msgstr "סקריפט ההסרה של החבילה עצמה נכשל. ייתכן שהיא הוסרה רק בחלקה."

#: src/inst-job.c
msgid "It is made for another kind of device."
msgstr "היא מיועדת לסוג אחר של מכשיר."

#: src/inst-job.c
msgid "The software sources could not be verified, so nothing was downloaded from them."
msgstr "לא ניתן היה לאמת את מקורות התוכנה, ולכן לא הורד מהם דבר."

#: src/inst-job.c
msgid "The software sources do not have it (any more)."
msgstr "היא לא נמצאת (יותר) במקורות התוכנה."

#: src/inst-job.c
msgid "Software was installed or removed meanwhile. Try again."
msgstr "בינתיים הותקנה או הוסרה תוכנה. יש לנסות שוב."

#: src/inst-job.c
msgid "Cannot install software"
msgstr "לא ניתן להתקין תוכנה"

#: src/inst-job.c
msgid "PackageKit, the system service that installs software, is missing or not running."
msgstr "PackageKit, שירות המערכת שמתקין תוכנה, חסר או לא פועל."

#: src/inst-job.c
msgid "Something went wrong while uninstalling."
msgstr "משהו השתבש במהלך ההסרה."

#: src/inst-job.c
msgid "Something went wrong while installing."
msgstr "משהו השתבש במהלך ההתקנה."

#: src/inst-job.c
msgid "Waiting for your password"
msgstr "בהמתנה לסיסמה"

#: src/inst-job.c
msgid "Waiting for another install to finish"
msgstr "בהמתנה לסיום של התקנה אחרת"

#: src/inst-job.c
msgid "Downloading"
msgstr "מתבצעת הורדה"

#: src/inst-job.c
msgid "Uninstalling"
msgstr "מתבצעת הסרה"

#: src/inst-job.c
msgid "Installing"
msgstr "מתבצעת התקנה"

#: src/inst-job.c
msgid "Finishing"
msgstr "מתבצע סיום"

#: src/inst-job.c
msgid "Stopping"
msgstr "מתבצעת עצירה"

#: src/inst-job.c
msgid "Getting ready"
msgstr "בהכנה"

#: src/inst-job.c
msgid "Checking what else it takes along"
msgstr "מתבצעת בדיקה של מה עוד יוסר יחד איתה"

#: src/inst-job.c
msgid "Checking what else it needs"
msgstr "מתבצעת בדיקה של מה עוד נדרש לה"

#: src/inst-job.c
msgid "Looking it up"
msgstr "מתבצע חיפוש"

#: src/inst-job.c
msgid "Checking the software sources"
msgstr "מתבצעת בדיקה של מקורות התוכנה"

#: src/inst-job.c
#, c-format
msgid "The software sources have no package called “%s”."
msgstr "אין במקורות התוכנה חבילה בשם \"%s\"."

# android: SystemUI controls_error_removed (other app, short)
#: src/inst-job.c
msgid "Not found"
msgstr "לא נמצא"

#: src/inst-job.c
msgid "Removing it would leave other software with something it needs missing."
msgstr "הסרה שלה תשאיר תוכנה אחרת בלי רכיב שהיא צריכה."

#: src/inst-job.c
#, c-format
msgid "%s is uninstalled."
msgstr "ההסרה של %s הושלמה."

#: src/inst-job.c
msgid "Uninstalled"
msgstr "הוסרה"

#: src/inst-job.c
#, c-format
msgid "%s %s is installed."
msgstr "ההתקנה של %s %s הושלמה."

# android: Settings installed (several translations, short)
#: src/inst-job.c src/inst-view.c
msgid "Installed"
msgstr "מותקנת"

#: src/inst-job.c
msgid "Cannot open the file"
msgstr "לא ניתן לפתוח את הקובץ"

#: src/inst-job.c
msgid "The file could not be read."
msgstr "לא ניתן היה לקרוא את הקובץ."

#: src/inst-job.c
msgid "dpkg, which reads packages, is missing."
msgstr "dpkg, שקורא חבילות, חסר."

#: src/inst-job.c
msgid "Not a package"
msgstr "זו לא חבילה"

#: src/inst-job.c
msgid "This file is not a software package that can be installed here, or it is damaged."
msgstr "הקובץ הזה הוא לא חבילת תוכנה שאפשר להתקין כאן, או שהוא פגום."

#: src/inst-job.c
#, c-format
msgid "It is made for %s devices; this one is %s."
msgstr "היא מיועדת למכשירי %s, והמכשיר הזה הוא %s."

#: src/inst-job.c
msgid "Made for another kind of device"
msgstr "מיועדת לסוג אחר של מכשיר"

#: src/inst-job.c
msgid "Reading the package"
msgstr "מתבצעת קריאה של החבילה"

#: src/inst-job.c
msgid "Cannot uninstall software"
msgstr "לא ניתן להסיר תוכנה"

#: src/inst-job.c
msgid "dpkg, which keeps track of the installed software, is missing."
msgstr "dpkg, שעוקב אחרי התוכנה המותקנת, חסר."

#: src/inst-job.c
#, c-format
msgid "“%s” is not installed."
msgstr "החבילה \"%s\" לא מותקנת."

#: src/inst-main.c
msgid "Install the package NAME from the software sources"
msgstr "התקנה של החבילה NAME ממקורות התוכנה"

#: src/inst-main.c
msgid "NAME"
msgstr "NAME"

#: src/inst-main.c
msgid "Uninstall the package NAME"
msgstr "הסרה של החבילה NAME"

#: src/inst-main.c
msgid "Print the version"
msgstr "הצגת הגרסה"

#: src/inst-main.c
msgid "[FILE.deb…]"
msgstr "[FILE.deb…]"

#: src/inst-pk.c
msgid "A library the app needs"
msgstr "ספרייה שהאפליקציה צריכה"

#: src/inst-pk.c
msgid "A sample app"
msgstr "אפליקציה לדוגמה"

#: src/inst-service.c
#, c-format
msgid "%s %s is installed already."
msgstr "כבר יש במכשיר את %s %s."

#. TRANSLATORS: %s is a list of names ("libfoo, libbar"), %u how many more there are
#: src/inst-view.c
#, c-format
msgid "%s and %u more"
msgid_plural "%s and %u more"
msgstr[0] "%s ועוד חבילה אחת"
msgstr[1] "%s ועוד שתי חבילות"
msgstr[2] "%s ועוד %u חבילות"

# android: Settings vpn_version_info
#: src/inst-view.c
#, c-format
msgid "Version %s"
msgstr "גרסה %s"

#: src/inst-view.c
msgid "This file"
msgstr "הקובץ הזה"

#: src/inst-view.c
msgid "Available"
msgstr "זמינה"

#: src/inst-view.c
msgid "newer"
msgstr "חדשה יותר"

#: src/inst-view.c
msgid "older"
msgstr "ישנה יותר"

#: src/inst-view.c
msgid "OLDER"
msgstr "ישנה יותר"

#: src/inst-view.c
msgid "Install this app?"
msgstr "להתקין את האפליקציה הזו?"

#: src/inst-view.c
msgid "Install this package?"
msgstr "להתקין את החבילה הזו?"

#: src/inst-view.c
#, c-format
msgid "Replace %s %s with %s?"
msgstr "להחליף את %s %s ב-%s?"

#: src/inst-view.c
msgid "This file has a newer version than the one installed."
msgstr "בקובץ הזה יש גרסה חדשה יותר מזו שמותקנת."

#: src/inst-view.c
msgid "The software sources have a newer version than the one installed."
msgstr "במקורות התוכנה יש גרסה חדשה יותר מזו שמותקנת."

#: src/inst-view.c
msgid "This file is an OLDER version"
msgstr "הקובץ הזה הוא גרסה ישנה יותר"

#: src/inst-view.c
msgid "The available version is OLDER"
msgstr "הגרסה הזמינה ישנה יותר"

#: src/inst-view.c
#, c-format
msgid "%s %s is installed. This file has %s, which is older. Replace the installed version with the older one?"
msgstr "במכשיר יש את %s %s. בקובץ הזה יש את %s, גרסה ישנה יותר. להחליף את הגרסה המותקנת בגרסה הישנה יותר?"

#: src/inst-view.c
#, c-format
msgid "%s %s is installed. The software sources have %s, which is older. Replace the installed version with the older one?"
msgstr "במכשיר יש את %s %s. במקורות התוכנה יש את %s, גרסה ישנה יותר. להחליף את הגרסה המותקנת בגרסה הישנה יותר?"

#: src/inst-view.c
msgid "Already installed"
msgstr "כבר מותקנת"

#: src/inst-view.c
#, c-format
msgid "%s %s is installed already. Reinstalling puts its files back as they came."
msgstr "כבר יש במכשיר את %s %s. התקנה מחדש תחזיר את הקבצים שלה למצבם המקורי."

#: src/inst-view.c
#, c-format
msgid "%s %s is installed already. The same version cannot be installed over itself."
msgstr "כבר יש במכשיר את %s %s. אי אפשר להתקין את אותה גרסה מעל עצמה."

#: src/inst-view.c
#, c-format
msgid "Uninstall %s?"
msgstr "להסיר את %s?"

#: src/inst-view.c
msgid "Its data will be deleted."
msgstr "הנתונים שלה יימחקו."

#: src/inst-view.c
msgid "Its program files are removed. Your own files stay."
msgstr "קובצי התוכנה שלה יוסרו. הקבצים שלך יישארו."

#: src/inst-view.c
msgid "Frees"
msgstr "נפח שמתפנה"

#. TRANSLATORS: a package file's size, then the space it takes once installed: "4 MB file · 12 MB installed"
#: src/inst-view.c
#, c-format
msgid "%s file · %s installed"
msgstr "קובץ של %s · %s אחרי ההתקנה"

