#: src/inst-view.c
msgid "OLDER"
msgstr "OUDER"

#: src/inst-view.c
msgid "Install this app?"
msgstr "Deze app installeren?"

#: src/inst-view.c
msgid "Install this package?"
msgstr "Dit pakket installeren?"

#: src/inst-view.c
#, c-format
msgid "Replace %s %s with %s?"
msgstr "%s %s vervangen door %s?"

#: src/inst-view.c
msgid "This file has a newer version than the one installed."
msgstr "Dit bestand bevat een nieuwere versie dan de geïnstalleerde."

#: src/inst-view.c
msgid "The software sources have a newer version than the one installed."
msgstr "De softwarebronnen hebben een nieuwere versie dan de geïnstalleerde."

#: src/inst-view.c
msgid "This file is an OLDER version"
msgstr "Dit bestand is een OUDERE versie"

#: src/inst-view.c
msgid "The available version is OLDER"
msgstr "De beschikbare versie is OUDER"

#: src/inst-view.c
#, c-format
msgid ""
"%s %s is installed. This file has %s, which is older. Replace the installed "
"version with the older one?"
msgstr ""
"%s %s is geïnstalleerd. Dit bestand bevat %s, een oudere versie. De "
"geïnstalleerde versie vervangen door de oudere?"

#: src/inst-view.c
#, c-format
msgid ""
"%s %s is installed. The software sources have %s, which is older. Replace "
"the installed version with the older one?"
msgstr ""
"%s %s is geïnstalleerd. De softwarebronnen hebben %s, een oudere versie. De "
"geïnstalleerde versie vervangen door de oudere?"

#: src/inst-view.c
msgid "Already installed"
msgstr "Al geïnstalleerd"

#: src/inst-view.c
#, c-format
msgid ""
"%s %s is installed already. Reinstalling puts its files back as they came."
msgstr ""
"%s %s is al geïnstalleerd. Opnieuw installeren zet de bestanden terug zoals "
"ze waren."

#: src/inst-view.c
#, c-format
msgid ""
"%s %s is installed already. The same version cannot be installed over itself."
msgstr ""
"%s %s is al geïnstalleerd. Dezelfde versie kan niet over zichzelf worden "
"geïnstalleerd."

#: src/inst-view.c
#, c-format
msgid "Uninstall %s?"
msgstr "%s verwijderen?"

#: src/inst-view.c
msgid "Its data will be deleted."
msgstr "De bijbehorende gegevens worden verwijderd."

#: src/inst-view.c
msgid "Its program files are removed. Your own files stay."
msgstr ""
"De programmabestanden worden verwijderd. Je eigen bestanden blijven staan."

#: src/inst-view.c
msgid "Frees"
msgstr "Maakt vrij"

#: src/inst-view.c
#, c-format
msgid "%s file"
msgstr "Bestand: %s"

#: src/inst-view.c
#, c-format
msgid "%s download"
msgstr "Download: %s"

#: src/inst-view.c
#, c-format
msgid "%s · %s installed"
msgstr "%s · %s geïnstalleerd"

#: src/inst-view.c
#, c-format
msgid "%s installed"
msgstr "%s geïnstalleerd"

