#. the dialog role: the shell's back gesture then sends Escape, which answers no
#. ⋮: About, VibeOS's About sheet, as every VibeOS app has it
#: data/vibeos.Installer.desktop.in src/inst-sheet.c src/inst-window.c
msgid "App Installer"
msgstr "App-installer"

#: data/vibeos.Installer.desktop.in
msgid "Install apps from package files, and uninstall them"
msgstr "Apps installeren uit pakketbestanden en ze verwijderen"

#: data/vibeos.Installer.desktop.in
msgid "Install;Uninstall;Package;deb;Software;App;"
msgstr "installeren;verwijderen;pakket;deb;software;app;"

#: src/inst-catalog.c
msgid "A sample app for trying App Installer"
msgstr "Een voorbeeldapp om App-installer uit te proberen"

#: src/inst-catalog.c
msgid ""
"This package is not real: App Installer's demo shows it to try its screens.\n"
"\n"
"Nothing is installed or removed while the demo runs."
msgstr ""
"Dit pakket is niet echt: de demo van App-installer laat het zien om de "
"schermen uit te proberen.\n"
"\n"
"Tijdens de demo wordt niets geïnstalleerd of verwijderd."

#: src/inst-job.c
#, c-format
msgid "%s is part of VibeOS."
msgstr "%s is onderdeel van VibeOS."

#: src/inst-job.c
#, c-format
msgid "%s is part of the phone's shell and session."
msgstr "%s is onderdeel van de shell en sessie van de telefoon."

#: src/inst-job.c
#, c-format
msgid "%s is essential: the system cannot work without it."
msgstr "%s is essentieel: het systeem werkt niet zonder dit pakket."

#: src/inst-job.c
#, c-format
msgid "%s is required by the system."
msgstr "%s is vereist door het systeem."

#: src/inst-job.c
msgid "Cannot be uninstalled"
msgstr "Kan niet worden verwijderd"

#: src/inst-job.c
#, c-format
msgid "Uninstalling it would also remove %s. %s"
msgstr "Bij het verwijderen wordt ook %s verwijderd. %s"

#: src/inst-job.c
#, c-format
msgid "Installing it would remove %s. %s"
msgstr "Bij het installeren wordt %s verwijderd. %s"

#: src/inst-job.c
msgid "Cannot be installed"
msgstr "Kan niet worden geïnstalleerd"

#: src/inst-job.c src/inst-view.c
msgid "Not uninstalled"
msgstr "Niet verwijderd"

#: src/inst-job.c src/inst-view.c
msgid "Not installed"
msgstr "Niet geïnstalleerd"

# android: SystemUI fgs_manager_app_item_stop_button_stopped_label (other app, short)
#: src/inst-job.c
msgid "Stopped"
msgstr "Gestopt"

#: src/inst-job.c
msgid "Nothing was uninstalled."
msgstr "Er is niets verwijderd."

#: src/inst-job.c
msgid "Nothing was installed."
msgstr "Er is niets geïnstalleerd."

#. the password dialog closed without the password: the user's no, not a failure
#: src/inst-job.c
msgid "The password was not given, so nothing was uninstalled."
msgstr "Het wachtwoord is niet opgegeven, dus er is niets verwijderd."

#: src/inst-job.c
msgid "The password was not given, so nothing was installed."
msgstr "Het wachtwoord is niet opgegeven, dus er is niets geïnstalleerd."

#: src/inst-job.c
msgid ""
"Another app is installing or updating software right now. Try again once it "
"has finished."
msgstr ""
"Een andere app installeert of updatet nu software. Probeer het opnieuw als "
"die klaar is."

#: src/inst-job.c
msgid ""
"Something it needs cannot be installed: it is not in the software sources, "
"or not in a version that fits."
msgstr ""
"Iets wat nodig is, kan niet worden geïnstalleerd: het staat niet in de "
"softwarebronnen, of niet in een passende versie."

#: src/inst-job.c
msgid ""
"Packages it needs could not be downloaded. Check the internet connection and "
"try again."
msgstr ""
"Benodigde pakketten konden niet worden gedownload. Controleer de "
"internetverbinding en probeer het opnieuw."

#: src/inst-job.c
msgid ""
"The package is broken: the file is damaged, or it is not a proper package."
msgstr "Het pakket is defect: het bestand is beschadigd of geen geldig pakket."

#: src/inst-job.c
msgid "There is not enough free storage for it."
msgstr "Er is niet genoeg vrije opslagruimte."

#: src/inst-job.c
msgid ""
"It clashes with software that is already installed: both have the same files."
msgstr ""
"Het botst met software die al is geïnstalleerd: beide hebben dezelfde "
"bestanden."

#: src/inst-job.c
msgid "The package's own setup failed. It may be only partly installed."
msgstr ""
"De installatie van het pakket zelf is mislukt. Het is mogelijk maar "
"gedeeltelijk geïnstalleerd."

#: src/inst-job.c
msgid ""
"The package's own removal script failed. It may be only partly uninstalled."
msgstr ""
"Het verwijderscript van het pakket is mislukt. Het is mogelijk maar "
"gedeeltelijk verwijderd."

#: src/inst-job.c
msgid "It is made for another kind of device."
msgstr "Het is gemaakt voor een ander soort apparaat."

#: src/inst-job.c
msgid ""
"The software sources could not be verified, so nothing was downloaded from "
"them."
msgstr ""
"De softwarebronnen konden niet worden geverifieerd, dus er is niets van "
"gedownload."

#: src/inst-job.c
msgid "The software sources do not have it (any more)."
msgstr "De softwarebronnen hebben het niet (meer)."

#: src/inst-job.c
msgid "Software was installed or removed meanwhile. Try again."
msgstr ""
"Intussen is er software geïnstalleerd of verwijderd. Probeer het opnieuw."

#: src/inst-job.c
msgid "Cannot install software"
msgstr "Kan geen software installeren"

#: src/inst-job.c
msgid ""
"PackageKit, the system service that installs software, is missing or not "
"running."
msgstr ""
"PackageKit, de systeemservice die software installeert, ontbreekt of draait "
"niet."

#: src/inst-job.c
msgid "Something went wrong while uninstalling."
msgstr "Er is iets misgegaan bij het verwijderen."

#: src/inst-job.c
msgid "Something went wrong while installing."
msgstr "Er is iets misgegaan bij het installeren."

#: src/inst-job.c
msgid "Waiting for your password"
msgstr "Wachten op je wachtwoord"

#: src/inst-job.c
msgid "Waiting for another install to finish"
msgstr "Wachten tot een andere installatie klaar is"

#: src/inst-job.c
msgid "Downloading"
msgstr "Downloaden"

#: src/inst-job.c
msgid "Uninstalling"
msgstr "Verwijderen"

#: src/inst-job.c
msgid "Installing"
msgstr "Installeren"

#: src/inst-job.c
msgid "Finishing"
msgstr "Afronden"

#: src/inst-job.c
msgid "Stopping"
msgstr "Stoppen"

#: src/inst-job.c
msgid "Getting ready"
msgstr "Voorbereiden"

#: src/inst-job.c
msgid "Checking what else it takes along"
msgstr "Controleren wat er nog meer mee verdwijnt"

#: src/inst-job.c
msgid "Checking what else it needs"
msgstr "Controleren wat er nog meer nodig is"

#: src/inst-job.c
msgid "Looking it up"
msgstr "Opzoeken"

#: src/inst-job.c
msgid "Checking the software sources"
msgstr "Softwarebronnen controleren"

#: src/inst-job.c
#, c-format
msgid "The software sources have no package called “%s”."
msgstr "De softwarebronnen hebben geen pakket met de naam “%s”."

# android: SystemUI controls_error_removed (other app, short)
#: src/inst-job.c
msgid "Not found"
msgstr "Niet gevonden"

#: src/inst-job.c
msgid "Removing it would leave other software with something it needs missing."
msgstr "Als je dit verwijdert, mist andere software iets wat die nodig heeft."

#: src/inst-job.c
#, c-format
msgid "%s is uninstalled."
msgstr "%s is verwijderd."

#: src/inst-job.c
msgid "Uninstalled"
msgstr "Verwijderd"

#: src/inst-job.c
#, c-format
msgid "%s %s is installed."
msgstr "%s %s is geïnstalleerd."

# android: Settings installed (short)
#: src/inst-job.c src/inst-view.c
msgid "Installed"
msgstr "Geïnstalleerd"

#: src/inst-job.c
msgid "Cannot open the file"
msgstr "Kan het bestand niet openen"

#: src/inst-job.c
msgid "The file could not be read."
msgstr "Het bestand kon niet worden gelezen."

#: src/inst-job.c
msgid "dpkg, which reads packages, is missing."
msgstr "dpkg, dat pakketten leest, ontbreekt."

#: src/inst-job.c
msgid "Not a package"
msgstr "Geen pakket"

#: src/inst-job.c
msgid ""
"This file is not a software package that can be installed here, or it is "
"damaged."
msgstr ""
"Dit bestand is geen softwarepakket dat hier kan worden geïnstalleerd, of het "
"is beschadigd."

#: src/inst-job.c
#, c-format
msgid "It is made for %s devices; this one is %s."
msgstr "Het is gemaakt voor %s-apparaten; dit apparaat is %s."

#: src/inst-job.c
msgid "Made for another kind of device"
msgstr "Gemaakt voor een ander soort apparaat"

#: src/inst-job.c
msgid "Reading the package"
msgstr "Pakket lezen"

#: src/inst-job.c
msgid "Cannot uninstall software"
msgstr "Kan geen software verwijderen"

#: src/inst-job.c
msgid "dpkg, which keeps track of the installed software, is missing."
msgstr "dpkg, dat de geïnstalleerde software bijhoudt, ontbreekt."

#: src/inst-job.c
#, c-format
msgid "“%s” is not installed."
msgstr "“%s” is niet geïnstalleerd."

#: src/inst-main.c
msgid "Install the package NAME from the software sources"
msgstr "Het pakket NAAM installeren uit de softwarebronnen"

#: src/inst-main.c
msgid "NAME"
msgstr "NAAM"

#: src/inst-main.c
msgid "Uninstall the package NAME"
msgstr "Het pakket NAAM verwijderen"

#: src/inst-main.c
msgid "Print the version"
msgstr "De versie tonen"

#: src/inst-main.c
msgid "[FILE.deb…]"
msgstr "[BESTAND.deb…]"

#: src/inst-pk.c
msgid "A library the app needs"
msgstr "Een bibliotheek die de app nodig heeft"

#: src/inst-pk.c
msgid "A sample app"
msgstr "Een voorbeeldapp"

#: src/inst-service.c
#, c-format
msgid "%s %s is installed already."
msgstr "%s %s is al geïnstalleerd."

#. TRANSLATORS: %s is a list of names ("libfoo, libbar"), %u how many more there are
#: src/inst-view.c
#, c-format
msgid "%s and %u more"
msgid_plural "%s and %u more"
msgstr[0] "%s en nog %u"
msgstr[1] "%s en nog %u"

