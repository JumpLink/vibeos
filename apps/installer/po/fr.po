#. the dialog role: the shell's back gesture then sends Escape, which answers no
#. ⋮: About, VibeOS's About sheet, as every VibeOS app has it
#: data/vibeos.Installer.desktop.in src/inst-sheet.c src/inst-window.c
msgid "App Installer"
msgstr "Installateur d'applis"

#: data/vibeos.Installer.desktop.in
msgid "Install apps from package files, and uninstall them"
msgstr ""
"Installer des applis à partir de fichiers de paquets, et les désinstaller"

#: data/vibeos.Installer.desktop.in
msgid "Install;Uninstall;Package;deb;Software;App;"
msgstr "Installer;Désinstaller;Paquet;deb;Logiciel;Appli;Application;"

#: src/inst-catalog.c
msgid "A sample app for trying App Installer"
msgstr "Une appli d'exemple pour essayer l'Installateur d'applis"

#: src/inst-catalog.c
msgid ""
"This package is not real: App Installer's demo shows it to try its screens.\n"
"\n"
"Nothing is installed or removed while the demo runs."
msgstr ""
"Ce paquet n'est pas réel : la démo de l'Installateur d'applis l'affiche pour "
"essayer ses écrans.\n"
"\n"
"Rien n'est installé ni supprimé pendant la démo."

#: src/inst-job.c
#, c-format
msgid "%s is part of VibeOS."
msgstr "%s fait partie de VibeOS."

#: src/inst-job.c
#, c-format
msgid "%s is part of the phone's shell and session."
msgstr "%s fait partie de l'interface et de la session du téléphone."

#: src/inst-job.c
#, c-format
msgid "%s is essential: the system cannot work without it."
msgstr "%s est essentiel : le système ne peut pas fonctionner sans lui."

#: src/inst-job.c
#, c-format
msgid "%s is required by the system."
msgstr "%s est requis par le système."

#: src/inst-job.c
msgid "Cannot be uninstalled"
msgstr "Impossible de désinstaller"

#: src/inst-job.c
#, c-format
msgid "Uninstalling it would also remove %s. %s"
msgstr "Le désinstaller supprimerait aussi %s. %s"

#: src/inst-job.c
#, c-format
msgid "Installing it would remove %s. %s"
msgstr "L'installer supprimerait %s. %s"

#: src/inst-job.c
msgid "Cannot be installed"
msgstr "Impossible d'installer"

#: src/inst-job.c src/inst-view.c
msgid "Not uninstalled"
msgstr "Non désinstallé"

#: src/inst-job.c src/inst-view.c
msgid "Not installed"
msgstr "Non installé"

# android: SystemUI fgs_manager_app_item_stop_button_stopped_label (other app, short)
#: src/inst-job.c
msgid "Stopped"
msgstr "Arrêté"

#: src/inst-job.c
msgid "Nothing was uninstalled."
msgstr "Rien n'a été désinstallé."

#: src/inst-job.c
msgid "Nothing was installed."
msgstr "Rien n'a été installé."

#. the password dialog closed without the password: the user's no, not a failure
#: src/inst-job.c
msgid "The password was not given, so nothing was uninstalled."
msgstr "Le mot de passe n'a pas été fourni : rien n'a été désinstallé."

#: src/inst-job.c
msgid "The password was not given, so nothing was installed."
msgstr "Le mot de passe n'a pas été fourni : rien n'a été installé."

#: src/inst-job.c
msgid ""
"Another app is installing or updating software right now. Try again once it "
"has finished."
msgstr ""
"Une autre appli installe ou met à jour des logiciels en ce moment. Réessayez "
"quand elle aura terminé."

#: src/inst-job.c
msgid ""
"Something it needs cannot be installed: it is not in the software sources, "
"or not in a version that fits."
msgstr ""
"Un élément dont il a besoin ne peut pas être installé : il ne figure pas "
"dans les sources de logiciels, ou pas dans une version compatible."

#: src/inst-job.c
msgid ""
"Packages it needs could not be downloaded. Check the internet connection and "
"try again."
msgstr ""
"Impossible de télécharger les paquets dont il a besoin. Vérifiez la "
"connexion Internet et réessayez."

#: src/inst-job.c
msgid ""
"The package is broken: the file is damaged, or it is not a proper package."
msgstr ""
"Le paquet est défectueux : le fichier est endommagé, ou ce n'est pas un vrai "
"paquet."

#: src/inst-job.c
msgid "There is not enough free storage for it."
msgstr "L'espace de stockage disponible est insuffisant."

#: src/inst-job.c
msgid ""
"It clashes with software that is already installed: both have the same files."
msgstr ""
"Il entre en conflit avec un logiciel déjà installé : les deux ont les mêmes "
"fichiers."

#: src/inst-job.c
msgid "The package's own setup failed. It may be only partly installed."
msgstr ""
"La configuration propre au paquet a échoué. Il n'est peut-être installé "
"qu'en partie."

#: src/inst-job.c
msgid ""
"The package's own removal script failed. It may be only partly uninstalled."
msgstr ""
"Le script de suppression du paquet a échoué. Il n'est peut-être désinstallé "
"qu'en partie."

#: src/inst-job.c
msgid "It is made for another kind of device."
msgstr "Il est conçu pour un autre type d'appareil."

#: src/inst-job.c
msgid ""
"The software sources could not be verified, so nothing was downloaded from "
"them."
msgstr ""
"Les sources de logiciels n'ont pas pu être vérifiées : rien n'en a été "
"téléchargé."

#: src/inst-job.c
msgid "The software sources do not have it (any more)."
msgstr "Les sources de logiciels ne le proposent pas (ou plus)."

#: src/inst-job.c
msgid "Software was installed or removed meanwhile. Try again."
msgstr "Des logiciels ont été installés ou supprimés entre-temps. Réessayez."

#: src/inst-job.c
msgid "Cannot install software"
msgstr "Impossible d'installer des logiciels"

#: src/inst-job.c
msgid ""
"PackageKit, the system service that installs software, is missing or not "
"running."
msgstr ""
"PackageKit, le service système qui installe les logiciels, est absent ou ne "
"fonctionne pas."

#: src/inst-job.c
msgid "Something went wrong while uninstalling."
msgstr "Un problème est survenu pendant la désinstallation."

#: src/inst-job.c
msgid "Something went wrong while installing."
msgstr "Un problème est survenu pendant l'installation."

#: src/inst-job.c
msgid "Waiting for your password"
msgstr "En attente de votre mot de passe"

#: src/inst-job.c
msgid "Waiting for another install to finish"
msgstr "En attente de la fin d'une autre installation"

#: src/inst-job.c
msgid "Downloading"
msgstr "Téléchargement"

#: src/inst-job.c
msgid "Uninstalling"
msgstr "Désinstallation"

#: src/inst-job.c
msgid "Installing"
msgstr "Installation"

#: src/inst-job.c
msgid "Finishing"
msgstr "Finalisation"

#: src/inst-job.c
msgid "Stopping"
msgstr "Arrêt"

#: src/inst-job.c
msgid "Getting ready"
msgstr "Préparation"

#: src/inst-job.c
msgid "Checking what else it takes along"
msgstr "Vérification des autres éléments supprimés"

#: src/inst-job.c
msgid "Checking what else it needs"
msgstr "Vérification de ce dont il a besoin"

#: src/inst-job.c
msgid "Looking it up"
msgstr "Recherche du paquet"

#: src/inst-job.c
msgid "Checking the software sources"
msgstr "Vérification des sources de logiciels"

#: src/inst-job.c
#, c-format
msgid "The software sources have no package called “%s”."
msgstr "Les sources de logiciels n'ont aucun paquet nommé « %s »."

# android: SystemUI controls_error_removed (other app, short)
#: src/inst-job.c
msgid "Not found"
msgstr "Introuvable"

#: src/inst-job.c
msgid "Removing it would leave other software with something it needs missing."
msgstr ""
"Le supprimer priverait d'autres logiciels d'un élément dont ils ont besoin."

#: src/inst-job.c
#, c-format
msgid "%s is uninstalled."
msgstr "%s est désinstallé."

#: src/inst-job.c
msgid "Uninstalled"
msgstr "Désinstallé"

#: src/inst-job.c
#, c-format
msgid "%s %s is installed."
msgstr "%s %s est installé."

# android: Settings installed (several translations, short)
#: src/inst-job.c src/inst-view.c
msgid "Installed"
msgstr "Installé"

#: src/inst-job.c
msgid "Cannot open the file"
msgstr "Impossible d'ouvrir le fichier"

#: src/inst-job.c
msgid "The file could not be read."
msgstr "Le fichier n'a pas pu être lu."

#: src/inst-job.c
msgid "dpkg, which reads packages, is missing."
msgstr "dpkg, qui lit les paquets, est absent."

#: src/inst-job.c
msgid "Not a package"
msgstr "Ce n'est pas un paquet"

#: src/inst-job.c
msgid ""
"This file is not a software package that can be installed here, or it is "
"damaged."
msgstr ""
"Ce fichier n'est pas un paquet logiciel installable ici, ou il est endommagé."

#: src/inst-job.c
#, c-format
msgid "It is made for %s devices; this one is %s."
msgstr "Il est conçu pour les appareils %s ; celui-ci est %s."

#: src/inst-job.c
msgid "Made for another kind of device"
msgstr "Conçu pour un autre type d'appareil"

#: src/inst-job.c
msgid "Reading the package"
msgstr "Lecture du paquet"

#: src/inst-job.c
msgid "Cannot uninstall software"
msgstr "Impossible de désinstaller des logiciels"

#: src/inst-job.c
msgid "dpkg, which keeps track of the installed software, is missing."
msgstr "dpkg, qui assure le suivi des logiciels installés, est absent."

#: src/inst-job.c
#, c-format
msgid "“%s” is not installed."
msgstr "« %s » n'est pas installé."

#: src/inst-main.c
msgid "Install the package NAME from the software sources"
msgstr "Installer le paquet NOM depuis les sources de logiciels"

#: src/inst-main.c
msgid "NAME"
msgstr "NOM"

#: src/inst-main.c
msgid "Uninstall the package NAME"
msgstr "Désinstaller le paquet NOM"

#: src/inst-main.c
msgid "Print the version"
msgstr "Afficher la version"

#: src/inst-main.c
msgid "[FILE.deb…]"
msgstr "[FICHIER.deb…]"

#: src/inst-pk.c
msgid "A library the app needs"
msgstr "Une bibliothèque dont l'appli a besoin"

#: src/inst-pk.c
msgid "A sample app"
msgstr "Une appli d'exemple"

#: src/inst-service.c
#, c-format
msgid "%s %s is installed already."
msgstr "%s %s est déjà installé."

#. TRANSLATORS: %s is a list of names ("libfoo, libbar"), %u how many more there are
#: src/inst-view.c
#, c-format
msgid "%s and %u more"
msgid_plural "%s and %u more"
msgstr[0] "%s et %u autre"
msgstr[1] "%s et %u autres"

# android: Settings vpn_version_info
#: src/inst-view.c
#, c-format
msgid "Version %s"
msgstr "Version %s"

#: src/inst-view.c
msgid "This file"
msgstr "Ce fichier"

# android: Framework media_route_status_available (short)
#: src/inst-view.c
msgid "Available"
msgstr "Disponible"

#: src/inst-view.c
msgid "newer"
msgstr "plus récente"

#: src/inst-view.c
msgid "older"
msgstr "plus ancienne"

#: src/inst-view.c
msgid "OLDER"
msgstr "PLUS ANCIENNE"

#: src/inst-view.c
msgid "Install this app?"
msgstr "Installer cette appli ?"

#: src/inst-view.c
msgid "Install this package?"
msgstr "Installer ce paquet ?"

#: src/inst-view.c
#, c-format
msgid "Replace %s %s with %s?"
msgstr "Remplacer %s %s par %s ?"

#: src/inst-view.c
msgid "This file has a newer version than the one installed."
msgstr "Ce fichier contient une version plus récente que celle installée."

#: src/inst-view.c
msgid "The software sources have a newer version than the one installed."
msgstr ""
"Les sources de logiciels proposent une version plus récente que celle "
"installée."

#: src/inst-view.c
msgid "This file is an OLDER version"
msgstr "Ce fichier contient une version PLUS ANCIENNE"

#: src/inst-view.c
msgid "The available version is OLDER"
msgstr "La version disponible est PLUS ANCIENNE"

#: src/inst-view.c
#, c-format
msgid ""
"%s %s is installed. This file has %s, which is older. Replace the installed "
"version with the older one?"
msgstr ""
"%s %s est installé. Ce fichier contient la version %s, qui est plus "
"ancienne. Remplacer la version installée par la plus ancienne ?"

#: src/inst-view.c
#, c-format
msgid ""
"%s %s is installed. The software sources have %s, which is older. Replace "
"the installed version with the older one?"
msgstr ""
"%s %s est installé. Les sources de logiciels proposent la version %s, qui "
"est plus ancienne. Remplacer la version installée par la plus ancienne ?"

#: src/inst-view.c
msgid "Already installed"
msgstr "Déjà installé"

#: src/inst-view.c
#, c-format
msgid ""
"%s %s is installed already. Reinstalling puts its files back as they came."
msgstr ""
"%s %s est déjà installé. La réinstallation remet ses fichiers dans leur état "
"d'origine."

#: src/inst-view.c
#, c-format
msgid ""
"%s %s is installed already. The same version cannot be installed over itself."
msgstr ""
"%s %s est déjà installé. Une version ne peut pas être réinstallée par-dessus "
"elle-même."

#: src/inst-view.c
#, c-format
msgid "Uninstall %s?"
msgstr "Désinstaller %s ?"

#: src/inst-view.c
msgid "Its data will be deleted."
msgstr "Ses données seront supprimées."

#: src/inst-view.c
msgid "Its program files are removed. Your own files stay."
msgstr ""
"Ses fichiers de programme sont supprimés. Vos propres fichiers sont "
"conservés."

#: src/inst-view.c
msgid "Frees"
msgstr "Libère"

#. TRANSLATORS: a package file's size, then the space it takes once installed: "4 MB file · 12 MB installed"
#: src/inst-view.c
#, c-format
msgid "%s file · %s installed"
msgstr "Fichier de %s · %s une fois installé"

#. TRANSLATORS: what installing downloads, then the space it takes: "4 MB download · 12 MB installed"
#: src/inst-view.c
#, c-format
msgid "%s download · %s installed"
msgstr "%s à télécharger · %s une fois installé"

#: src/inst-view.c
#, c-format
msgid "%s installed"
msgstr "%s une fois installé"

#: src/inst-view.c
#, c-format
msgid "%s file"
msgstr "Fichier de %s"

#: src/inst-view.c
#, c-format
msgid "%s download"
msgstr "%s à télécharger"

# android: Settings accessibility_button_size_title (short)
#: src/inst-view.c
msgid "Size"
msgstr "Taille"

#: src/inst-view.c
#, c-format
msgid "Also installs %u other package"
msgid_plural "Also installs %u other packages"
msgstr[0] "Installe aussi %u autre paquet"
msgstr[1] "Installe aussi %u autres paquets"

#: src/inst-view.c
#, c-format
msgid "%s to download: %s"
msgstr "%s à télécharger : %s"

#: src/inst-view.c
#, c-format
msgid "Also removes %u other package"
msgid_plural "Also removes %u other packages"
msgstr[0] "Supprime aussi %u autre paquet"
msgstr[1] "Supprime aussi %u autres paquets"

#: src/inst-view.c
msgid "Package"
msgstr "Paquet"

# android: Contacts header_website_entry (other app, several translations, short)
#: src/inst-view.c
msgid "Website"
msgstr "Site Web"

#: src/inst-view.c
msgid ""
"A package can change anything on this device: it installs with full rights. "
"Install only what you trust."
msgstr ""
"Un paquet peut modifier n'importe quoi sur cet appareil : il s'installe avec "
"tous les droits. N'installez que ce en quoi vous avez confiance."

# android: PackageInstaller cancel
#: src/inst-view.c
msgid "Cancel"
msgstr "Annuler"

# android: Framework accessibility_dialog_button_uninstall (short)
#: src/inst-view.c
msgid "Uninstall"
msgstr "Désinstaller"

# android: PackageInstaller install
#: src/inst-view.c
msgid "Install"
msgstr "Installer"

# android: PackageInstaller launch
#: src/inst-view.c src/inst-window.c
msgid "Open"
msgstr "Ouvrir"

# android: PackageInstaller done (several translations, short)
#: src/inst-view.c
msgid "Done"
msgstr "OK"

#: src/inst-view.c
#, c-format
msgid "Replace with %s"
msgstr "Remplacer par %s"

#: src/inst-view.c
msgid "Reinstall"
msgstr "Réinstaller"

# android: Framework lockscreen_transport_stop_description (short)
#: src/inst-view.c
msgid "Stop"
msgstr "Arrêter"

# android: PackageInstaller close
#: src/inst-view.c
msgid "Close"
msgstr "Fermer"

# android: Framework action_menu_overflow_description (several translations, short)
#: src/inst-window.c
msgid "More options"
msgstr "Plus d'options"

#: src/inst-window.c
msgid "Software packages (.deb)"
msgstr "Paquets logiciels (.deb)"

#: src/inst-window.c
msgid "Choose a package"
msgstr "Choisir un paquet"

#: src/inst-window.c
msgid "Install apps from packages"
msgstr "Installer des applis à partir de paquets"

#: src/inst-window.c
msgid ""
"App Installer installs .deb package files. Tap one in Files, or choose one "
"here: it shows what the package is and asks before anything changes."
msgstr ""
"L'Installateur d'applis installe les fichiers de paquets .deb. Appuyez sur "
"l'un d'eux dans Fichiers, ou choisissez-en un ici : il indique ce qu'est le "
"paquet et demande votre accord avant toute modification."

#: src/inst-window.c
msgid ""
"Software uses it too, to install and uninstall apps from the software "
"sources."
msgstr ""
"Logiciels l'utilise aussi pour installer et désinstaller des applis depuis "
"les sources de logiciels."
