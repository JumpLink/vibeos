#. the dialog role: the shell's back gesture then sends Escape, which answers no
#. ⋮: About, VibeOS's About sheet, as every VibeOS app has it
#: data/vibeos.Installer.desktop.in src/inst-sheet.c src/inst-window.c
msgid "App Installer"
msgstr "Instalador de aplicaciones"

#: data/vibeos.Installer.desktop.in
msgid "Install apps from package files, and uninstall them"
msgstr "Instala aplicaciones desde archivos de paquete y desinstálalas"

#: data/vibeos.Installer.desktop.in
msgid "Install;Uninstall;Package;deb;Software;App;"
msgstr "Instalar;Desinstalar;Paquete;deb;Software;Aplicación;"

#: src/inst-catalog.c
msgid "A sample app for trying App Installer"
msgstr "Una aplicación de ejemplo para probar el Instalador de aplicaciones"

#: src/inst-catalog.c
msgid ""
"This package is not real: App Installer's demo shows it to try its screens.\n"
"\n"
"Nothing is installed or removed while the demo runs."
msgstr ""
"Este paquete no es real: la demo del Instalador de aplicaciones lo muestra "
"para probar sus pantallas.\n"
"\n"
"No se instala ni se quita nada mientras se ejecuta la demo."

#: src/inst-job.c
#, c-format
msgid "%s is part of VibeOS."
msgstr "%s forma parte de VibeOS."

#: src/inst-job.c
#, c-format
msgid "%s is part of the phone's shell and session."
msgstr "%s forma parte del shell y la sesión del teléfono."

#: src/inst-job.c
#, c-format
msgid "%s is essential: the system cannot work without it."
msgstr "%s es esencial: el sistema no puede funcionar sin él."

#: src/inst-job.c
#, c-format
msgid "%s is required by the system."
msgstr "%s es necesario para el sistema."

#: src/inst-job.c
msgid "Cannot be uninstalled"
msgstr "No se puede desinstalar"

#: src/inst-job.c
#, c-format
msgid "Uninstalling it would also remove %s. %s"
msgstr "Desinstalarlo también quitaría %s. %s"

#: src/inst-job.c
#, c-format
msgid "Installing it would remove %s. %s"
msgstr "Instalarlo quitaría %s. %s"

#: src/inst-job.c
msgid "Cannot be installed"
msgstr "No se puede instalar"

#: src/inst-job.c src/inst-view.c
msgid "Not uninstalled"
msgstr "No desinstalado"

#: src/inst-job.c src/inst-view.c
msgid "Not installed"
msgstr "No instalado"

#: src/inst-job.c
msgid "Stopped"
msgstr "Detenido"

#: src/inst-job.c
msgid "Nothing was uninstalled."
msgstr "No se ha desinstalado nada."

#: src/inst-job.c
msgid "Nothing was installed."
msgstr "No se ha instalado nada."

#. the password dialog closed without the password: the user's no, not a failure
#: src/inst-job.c
msgid "The password was not given, so nothing was uninstalled."
msgstr ""
"No se ha introducido la contraseña, así que no se ha desinstalado nada."

#: src/inst-job.c
msgid "The password was not given, so nothing was installed."
msgstr "No se ha introducido la contraseña, así que no se ha instalado nada."

#: src/inst-job.c
msgid ""
"Another app is installing or updating software right now. Try again once it "
"has finished."
msgstr ""
"Otra aplicación está instalando o actualizando software ahora mismo. Vuelve "
"a intentarlo cuando termine."

#: src/inst-job.c
msgid ""
"Something it needs cannot be installed: it is not in the software sources, "
"or not in a version that fits."
msgstr ""
"No se puede instalar algo que necesita: no está en los orígenes de software "
"o no en una versión compatible."

#: src/inst-job.c
msgid ""
"Packages it needs could not be downloaded. Check the internet connection and "
"try again."
msgstr ""
"No se han podido descargar paquetes que necesita. Comprueba la conexión a "
"Internet y vuelve a intentarlo."

#: src/inst-job.c
msgid ""
"The package is broken: the file is damaged, or it is not a proper package."
msgstr ""
"El paquete está dañado: el archivo está corrupto o no es un paquete válido."

#: src/inst-job.c
msgid "There is not enough free storage for it."
msgstr "No hay suficiente espacio libre para él."

#: src/inst-job.c
msgid ""
"It clashes with software that is already installed: both have the same files."
msgstr ""
"Entra en conflicto con software ya instalado: ambos tienen los mismos "
"archivos."

#: src/inst-job.c
msgid "The package's own setup failed. It may be only partly installed."
msgstr ""
"Ha fallado la configuración propia del paquete. Puede que solo se haya "
"instalado en parte."

#: src/inst-job.c
msgid ""
"The package's own removal script failed. It may be only partly uninstalled."
msgstr ""
"Ha fallado el script de eliminación del paquete. Puede que solo se haya "
"desinstalado en parte."

#: src/inst-job.c
msgid "It is made for another kind of device."
msgstr "Está hecho para otro tipo de dispositivo."

#: src/inst-job.c
msgid ""
"The software sources could not be verified, so nothing was downloaded from "
"them."
msgstr ""
"No se han podido verificar los orígenes de software, así que no se ha "
"descargado nada de ellos."

#: src/inst-job.c
msgid "The software sources do not have it (any more)."
msgstr "Los orígenes de software no lo tienen (o ya no)."

#: src/inst-job.c
msgid "Software was installed or removed meanwhile. Try again."
msgstr ""
"Mientras tanto se ha instalado o quitado software. Vuelve a intentarlo."

#: src/inst-job.c
msgid "Cannot install software"
msgstr "No se puede instalar software"

#: src/inst-job.c
msgid ""
"PackageKit, the system service that installs software, is missing or not "
"running."
msgstr ""
"Falta PackageKit, el servicio del sistema que instala software, o no se está "
"ejecutando."

#: src/inst-job.c
msgid "Something went wrong while uninstalling."
msgstr "Se ha producido un error al desinstalar."

#: src/inst-job.c
msgid "Something went wrong while installing."
msgstr "Se ha producido un error al instalar."

#: src/inst-job.c
msgid "Waiting for your password"
msgstr "Esperando tu contraseña"

#: src/inst-job.c
msgid "Waiting for another install to finish"
msgstr "Esperando a que termine otra instalación"

#: src/inst-job.c
msgid "Downloading"
msgstr "Descargando"

#: src/inst-job.c
msgid "Uninstalling"
msgstr "Desinstalando"

#: src/inst-job.c
msgid "Installing"
msgstr "Instalando"

#: src/inst-job.c
msgid "Finishing"
msgstr "Terminando"

#: src/inst-job.c
msgid "Stopping"
msgstr "Deteniendo"

#: src/inst-job.c
msgid "Getting ready"
msgstr "Preparando"

#: src/inst-job.c
msgid "Checking what else it takes along"
msgstr "Comprobando qué más se quita con él"

#: src/inst-job.c
msgid "Checking what else it needs"
msgstr "Comprobando qué más necesita"

#: src/inst-job.c
msgid "Looking it up"
msgstr "Buscándolo"

#: src/inst-job.c
msgid "Checking the software sources"
msgstr "Comprobando los orígenes de software"

#: src/inst-job.c
#, c-format
msgid "The software sources have no package called “%s”."
msgstr "Los orígenes de software no tienen ningún paquete llamado «%s»."

# android: SystemUI controls_error_removed (other app, short)
#: src/inst-job.c
msgid "Not found"
msgstr "No se ha encontrado"

#: src/inst-job.c
msgid "Removing it would leave other software with something it needs missing."
msgstr "Quitarlo dejaría a otro software sin algo que necesita."

#: src/inst-job.c
#, c-format
msgid "%s is uninstalled."
msgstr "%s se ha desinstalado."

#: src/inst-job.c
msgid "Uninstalled"
msgstr "Desinstalado"

#: src/inst-job.c
#, c-format
msgid "%s %s is installed."
msgstr "%s %s se ha instalado."

# android: Settings installed (several translations, short)
#: src/inst-job.c src/inst-view.c
msgid "Installed"
msgstr "Instalado"

#: src/inst-job.c
msgid "Cannot open the file"
msgstr "No se puede abrir el archivo"

#: src/inst-job.c
msgid "The file could not be read."
msgstr "No se ha podido leer el archivo."

#: src/inst-job.c
msgid "dpkg, which reads packages, is missing."
msgstr "Falta dpkg, que lee los paquetes."

#: src/inst-job.c
msgid "Not a package"
msgstr "No es un paquete"

#: src/inst-job.c
msgid ""
"This file is not a software package that can be installed here, or it is "
"damaged."
msgstr ""
"Este archivo no es un paquete de software que se pueda instalar aquí, o está "
"dañado."

#: src/inst-job.c
#, c-format
msgid "It is made for %s devices; this one is %s."
msgstr "Está hecho para dispositivos %s; este es %s."

#: src/inst-job.c
msgid "Made for another kind of device"
msgstr "Hecho para otro tipo de dispositivo"

#: src/inst-job.c
msgid "Reading the package"
msgstr "Leyendo el paquete"

#: src/inst-job.c
msgid "Cannot uninstall software"
msgstr "No se puede desinstalar software"

#: src/inst-job.c
msgid "dpkg, which keeps track of the installed software, is missing."
msgstr "Falta dpkg, que lleva el registro del software instalado."

#: src/inst-job.c
#, c-format
msgid "“%s” is not installed."
msgstr "«%s» no está instalado."

#: src/inst-main.c
msgid "Install the package NAME from the software sources"
msgstr "Instalar el paquete NOMBRE desde los orígenes de software"

#: src/inst-main.c
msgid "NAME"
msgstr "NOMBRE"

#: src/inst-main.c
msgid "Uninstall the package NAME"
msgstr "Desinstalar el paquete NOMBRE"

#: src/inst-main.c
msgid "Print the version"
msgstr "Mostrar la versión"

#: src/inst-main.c
msgid "[FILE.deb…]"
msgstr "[ARCHIVO.deb…]"

#: src/inst-pk.c
msgid "A library the app needs"
msgstr "Una biblioteca que necesita la aplicación"

#: src/inst-pk.c
msgid "A sample app"
msgstr "Una aplicación de ejemplo"

#: src/inst-service.c
#, c-format
msgid "%s %s is installed already."
msgstr "%s %s ya está instalado."

#. TRANSLATORS: %s is a list of names ("libfoo, libbar"), %u how many more there are
#: src/inst-view.c
#, c-format
msgid "%s and %u more"
msgid_plural "%s and %u more"
msgstr[0] "%s y %u más"
msgstr[1] "%s y %u más"

# android: Settings vpn_version_info
#: src/inst-view.c
#, c-format
msgid "Version %s"
msgstr "Versión %s"

#: src/inst-view.c
msgid "This file"
msgstr "Este archivo"

# android: Framework media_route_status_available (short)
#: src/inst-view.c
msgid "Available"
msgstr "Disponible"

#: src/inst-view.c
msgid "newer"
msgstr "más reciente"

# android: Framework older (adapted, several translations, short)
#: src/inst-view.c
msgid "older"
msgstr "anterior"

# android: Framework older (adapted, several translations, short)
#: src/inst-view.c
msgid "OLDER"
msgstr "ANTERIOR"

#: src/inst-view.c
msgid "Install this app?"
msgstr "¿Instalar esta aplicación?"

#: src/inst-view.c
msgid "Install this package?"
msgstr "¿Instalar este paquete?"

#: src/inst-view.c
#, c-format
msgid "Replace %s %s with %s?"
msgstr "¿Sustituir %s %s por %s?"

#: src/inst-view.c
msgid "This file has a newer version than the one installed."
msgstr "Este archivo tiene una versión más reciente que la instalada."

#: src/inst-view.c
msgid "The software sources have a newer version than the one installed."
msgstr ""
"Los orígenes de software tienen una versión más reciente que la instalada."

#: src/inst-view.c
msgid "This file is an OLDER version"
msgstr "Este archivo es una versión ANTERIOR"

#: src/inst-view.c
msgid "The available version is OLDER"
msgstr "La versión disponible es ANTERIOR"

#: src/inst-view.c
#, c-format
msgid ""
"%s %s is installed. This file has %s, which is older. Replace the installed "
"version with the older one?"
msgstr ""
"%s %s está instalado. Este archivo tiene la %s, que es anterior. ¿Sustituir "
"la versión instalada por la anterior?"

#: src/inst-view.c
#, c-format
msgid ""
"%s %s is installed. The software sources have %s, which is older. Replace "
"the installed version with the older one?"
msgstr ""
"%s %s está instalado. Los orígenes de software tienen la %s, que es "
"anterior. ¿Sustituir la versión instalada por la anterior?"

#: src/inst-view.c
msgid "Already installed"
msgstr "Ya instalado"

#: src/inst-view.c
#, c-format
msgid ""
"%s %s is installed already. Reinstalling puts its files back as they came."
msgstr ""
"%s %s ya está instalado. Al reinstalarlo, sus archivos vuelven a quedar como "
"venían."

#: src/inst-view.c
#, c-format
msgid ""
"%s %s is installed already. The same version cannot be installed over itself."
msgstr ""
"%s %s ya está instalado. No se puede instalar la misma versión encima de sí "
"misma."

#: src/inst-view.c
#, c-format
msgid "Uninstall %s?"
msgstr "¿Desinstalar %s?"

#: src/inst-view.c
msgid "Its data will be deleted."
msgstr "Se eliminarán sus datos."

#: src/inst-view.c
msgid "Its program files are removed. Your own files stay."
msgstr "Se quitan los archivos del programa. Tus propios archivos se quedan."

#: src/inst-view.c
msgid "Frees"
msgstr "Libera"

#. TRANSLATORS: a package file's size, then the space it takes once installed: "4 MB file · 12 MB installed"
#: src/inst-view.c
#, c-format
msgid "%s file · %s installed"
msgstr "Archivo: %s · %s una vez instalado"

#. TRANSLATORS: what installing downloads, then the space it takes: "4 MB download · 12 MB installed"
#: src/inst-view.c
#, c-format
msgid "%s download · %s installed"
msgstr "Descarga: %s · %s una vez instalado"

#: src/inst-view.c
#, c-format
msgid "%s installed"
msgstr "%s una vez instalado"

#: src/inst-view.c
#, c-format
msgid "%s file"
msgstr "Archivo: %s"

#: src/inst-view.c
#, c-format
msgid "%s download"
msgstr "Descarga: %s"

# android: Settings accessibility_button_size_title (short)
#: src/inst-view.c
msgid "Size"
msgstr "Tamaño"

#: src/inst-view.c
#, c-format
msgid "Also installs %u other package"
msgid_plural "Also installs %u other packages"
msgstr[0] "También instala %u paquete más"
msgstr[1] "También instala %u paquetes más"

#: src/inst-view.c
#, c-format
msgid "%s to download: %s"
msgstr "%s de descarga: %s"

#: src/inst-view.c
#, c-format
msgid "Also removes %u other package"
msgid_plural "Also removes %u other packages"
msgstr[0] "También quita %u paquete más"
msgstr[1] "También quita %u paquetes más"

#: src/inst-view.c
msgid "Package"
msgstr "Paquete"

# android: Contacts header_website_entry (other app, several translations, short)
#: src/inst-view.c
msgid "Website"
msgstr "Sitio web"

#: src/inst-view.c
msgid ""
"A package can change anything on this device: it installs with full rights. "
"Install only what you trust."
msgstr ""
"Un paquete puede cambiar cualquier cosa de este dispositivo: se instala con "
"todos los permisos. Instala solo lo que sea de confianza."

# android: PackageInstaller cancel
#: src/inst-view.c
msgid "Cancel"
msgstr "Cancelar"

# android: Framework accessibility_dialog_button_uninstall (short)
#: src/inst-view.c
msgid "Uninstall"
msgstr "Desinstalar"

# android: PackageInstaller install
#: src/inst-view.c
msgid "Install"
msgstr "Instalar"

# android: PackageInstaller launch
#: src/inst-view.c src/inst-window.c
msgid "Open"
msgstr "Abrir"

# android: PackageInstaller done (several translations, short)
#: src/inst-view.c
msgid "Done"
msgstr "Hecho"

#: src/inst-view.c
#, c-format
msgid "Replace with %s"
msgstr "Sustituir por %s"

#: src/inst-view.c
msgid "Reinstall"
msgstr "Reinstalar"

# android: Framework lockscreen_transport_stop_description (short)
#: src/inst-view.c
msgid "Stop"
msgstr "Detener"

# android: PackageInstaller close
#: src/inst-view.c
msgid "Close"
msgstr "Cerrar"

# android: Framework action_menu_overflow_description (short)
#: src/inst-window.c
msgid "More options"
msgstr "Más opciones"

#: src/inst-window.c
msgid "Software packages (.deb)"
msgstr "Paquetes de software (.deb)"

#: src/inst-window.c
msgid "Choose a package"
msgstr "Elegir un paquete"

#: src/inst-window.c
msgid "Install apps from packages"
msgstr "Instala aplicaciones desde paquetes"

#: src/inst-window.c
msgid ""
"App Installer installs .deb package files. Tap one in Files, or choose one "
"here: it shows what the package is and asks before anything changes."
msgstr ""
"El Instalador de aplicaciones instala archivos de paquete .deb. Toca uno en "
"Archivos o elige uno aquí: muestra qué es el paquete y pregunta antes de "
"cambiar nada."

#: src/inst-window.c
msgid ""
"Software uses it too, to install and uninstall apps from the software "
"sources."
msgstr ""
"Software también lo usa para instalar y desinstalar aplicaciones desde los "
"orígenes de software."
