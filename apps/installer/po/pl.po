#. the dialog role: the shell's back gesture then sends Escape, which answers no
#. ⋮: About, VibeOS's About sheet, as every VibeOS app has it
#: data/vibeos.Installer.desktop.in src/inst-sheet.c src/inst-window.c
msgid "App Installer"
msgstr "Instalator aplikacji"

#: data/vibeos.Installer.desktop.in
msgid "Install apps from package files, and uninstall them"
msgstr "Instaluj aplikacje z plików pakietów i je odinstalowuj"

#: data/vibeos.Installer.desktop.in
msgid "Install;Uninstall;Package;deb;Software;App;"
msgstr "Zainstaluj;Instalacja;Odinstaluj;Pakiet;deb;Oprogramowanie;Aplikacja;Install;Uninstall;Package;"

#: src/inst-catalog.c
msgid "A sample app for trying App Installer"
msgstr "Przykładowa aplikacja do wypróbowania Instalatora aplikacji"

#: src/inst-catalog.c
msgid ""
"This package is not real: App Installer's demo shows it to try its screens.\n"
"\n"
"Nothing is installed or removed while the demo runs."
msgstr ""
"To nie jest prawdziwy pakiet: wersja demonstracyjna Instalatora aplikacji "
"pokazuje go, abyś mógł wypróbować jego ekrany.\n"
"\n"
"Podczas demonstracji nic nie jest instalowane ani usuwane."

#: src/inst-job.c
#, c-format
msgid "%s is part of VibeOS."
msgstr "%s jest częścią VibeOS."

#: src/inst-job.c
#, c-format
msgid "%s is part of the phone's shell and session."
msgstr "%s jest częścią powłoki i sesji telefonu."

#: src/inst-job.c
#, c-format
msgid "%s is essential: the system cannot work without it."
msgstr "%s jest niezbędny: system nie może bez niego działać."

#: src/inst-job.c
#, c-format
msgid "%s is required by the system."
msgstr "%s jest wymagany przez system."

#: src/inst-job.c
msgid "Cannot be uninstalled"
msgstr "Nie można odinstalować"

#: src/inst-job.c
#, c-format
msgid "Uninstalling it would also remove %s. %s"
msgstr "Odinstalowanie usunęłoby też: %s. %s"

#: src/inst-job.c
#, c-format
msgid "Installing it would remove %s. %s"
msgstr "Instalacja usunęłaby: %s. %s"

#: src/inst-job.c
msgid "Cannot be installed"
msgstr "Nie można zainstalować"

#: src/inst-job.c src/inst-view.c
msgid "Not uninstalled"
msgstr "Nie odinstalowano"

#: src/inst-job.c src/inst-view.c
msgid "Not installed"
msgstr "Nie zainstalowano"

# android: SystemUI fgs_manager_app_item_stop_button_stopped_label (other app, short)
#: src/inst-job.c
msgid "Stopped"
msgstr "Zatrzymano"

#: src/inst-job.c
msgid "Nothing was uninstalled."
msgstr "Niczego nie odinstalowano."

#: src/inst-job.c
msgid "Nothing was installed."
msgstr "Niczego nie zainstalowano."

#. the password dialog closed without the password: the user's no, not a failure
#: src/inst-job.c
msgid "The password was not given, so nothing was uninstalled."
msgstr "Nie podano hasła, więc niczego nie odinstalowano."

#: src/inst-job.c
msgid "The password was not given, so nothing was installed."
msgstr "Nie podano hasła, więc niczego nie zainstalowano."

#: src/inst-job.c
msgid ""
"Another app is installing or updating software right now. Try again once it "
"has finished."
msgstr ""
"Inna aplikacja właśnie instaluje lub aktualizuje oprogramowanie. Spróbuj "
"ponownie, gdy skończy."

#: src/inst-job.c
msgid ""
"Something it needs cannot be installed: it is not in the software sources, "
"or not in a version that fits."
msgstr ""
"Nie można zainstalować czegoś, czego potrzebuje: nie ma tego w źródłach "
"oprogramowania albo nie ma pasującej wersji."

#: src/inst-job.c
msgid ""
"Packages it needs could not be downloaded. Check the internet connection and "
"try again."
msgstr ""
"Nie udało się pobrać potrzebnych pakietów. Sprawdź połączenie z internetem i "
"spróbuj ponownie."

#: src/inst-job.c
msgid ""
"The package is broken: the file is damaged, or it is not a proper package."
msgstr ""
"Pakiet jest uszkodzony: plik jest uszkodzony albo nie jest prawidłowym "
"pakietem."

#: src/inst-job.c
msgid "There is not enough free storage for it."
msgstr "Za mało wolnego miejsca."

#: src/inst-job.c
msgid ""
"It clashes with software that is already installed: both have the same files."
msgstr ""
"Koliduje z już zainstalowanym oprogramowaniem: oba zawierają te same pliki."

#: src/inst-job.c
msgid "The package's own setup failed. It may be only partly installed."
msgstr ""
"Konfiguracja pakietu nie powiodła się. Może być zainstalowany tylko "
"częściowo."

#: src/inst-job.c
msgid ""
"The package's own removal script failed. It may be only partly uninstalled."
msgstr ""
"Skrypt usuwania pakietu nie powiódł się. Może być odinstalowany tylko "
"częściowo."

#: src/inst-job.c
msgid "It is made for another kind of device."
msgstr "Jest przeznaczony dla innego rodzaju urządzeń."

#: src/inst-job.c
msgid ""
"The software sources could not be verified, so nothing was downloaded from "
"them."
msgstr ""
"Nie udało się zweryfikować źródeł oprogramowania, więc niczego z nich nie "
"pobrano."

#: src/inst-job.c
msgid "The software sources do not have it (any more)."
msgstr "Nie ma go w źródłach oprogramowania (już)."

#: src/inst-job.c
msgid "Software was installed or removed meanwhile. Try again."
msgstr ""
"W międzyczasie zainstalowano lub usunięto oprogramowanie. Spróbuj ponownie."

#: src/inst-job.c
msgid "Cannot install software"
msgstr "Nie można instalować oprogramowania"

#: src/inst-job.c
msgid ""
"PackageKit, the system service that installs software, is missing or not "
"running."
msgstr ""
"Brak usługi systemowej PackageKit, która instaluje oprogramowanie, albo nie "
"jest uruchomiona."

#: src/inst-job.c
msgid "Something went wrong while uninstalling."
msgstr "Podczas odinstalowywania coś poszło nie tak."

#: src/inst-job.c
msgid "Something went wrong while installing."
msgstr "Podczas instalacji coś poszło nie tak."

#: src/inst-job.c
msgid "Waiting for your password"
msgstr "Czekam na hasło"

#: src/inst-job.c
msgid "Waiting for another install to finish"
msgstr "Czekam na zakończenie innej instalacji"

#: src/inst-job.c
msgid "Downloading"
msgstr "Pobieranie"

#: src/inst-job.c
msgid "Uninstalling"
msgstr "Odinstalowywanie"

#: src/inst-job.c
msgid "Installing"
msgstr "Instalowanie"

#: src/inst-job.c
msgid "Finishing"
msgstr "Kończenie"

#: src/inst-job.c
msgid "Stopping"
msgstr "Zatrzymywanie"

#: src/inst-job.c
msgid "Getting ready"
msgstr "Przygotowywanie"

#: src/inst-job.c
msgid "Checking what else it takes along"
msgstr "Sprawdzam, co jeszcze zostanie usunięte"

#: src/inst-job.c
msgid "Checking what else it needs"
msgstr "Sprawdzam, czego jeszcze potrzebuje"

#: src/inst-job.c
msgid "Looking it up"
msgstr "Wyszukiwanie"

#: src/inst-job.c
msgid "Checking the software sources"
msgstr "Sprawdzam źródła oprogramowania"

#: src/inst-job.c
#, c-format
msgid "The software sources have no package called “%s”."
msgstr "W źródłach oprogramowania nie ma pakietu „%s”."

# android: SystemUI controls_error_removed (other app, short)
#: src/inst-job.c
msgid "Not found"
msgstr "Nie znaleziono"

#: src/inst-job.c
msgid "Removing it would leave other software with something it needs missing."
msgstr ""
"Po jego usunięciu innemu oprogramowaniu zabrakłoby czegoś, czego potrzebuje."

#: src/inst-job.c
#, c-format
msgid "%s is uninstalled."
msgstr "Odinstalowano: %s."

#: src/inst-job.c
msgid "Uninstalled"
msgstr "Odinstalowano"

#: src/inst-job.c
#, c-format
msgid "%s %s is installed."
msgstr "Zainstalowano: %s %s."

# android: Settings installed (several translations, short)
#: src/inst-job.c src/inst-view.c
msgid "Installed"
msgstr "Zainstalowana"

#: src/inst-job.c
msgid "Cannot open the file"
msgstr "Nie można otworzyć pliku"

#: src/inst-job.c
msgid "The file could not be read."
msgstr "Nie udało się odczytać pliku."

#: src/inst-job.c
msgid "dpkg, which reads packages, is missing."
msgstr "Brak programu dpkg, który odczytuje pakiety."

#: src/inst-job.c
msgid "Not a package"
msgstr "To nie jest pakiet"

#: src/inst-job.c
msgid ""
"This file is not a software package that can be installed here, or it is "
"damaged."
msgstr ""
"Ten plik nie jest pakietem oprogramowania, który można tu zainstalować, albo "
"jest uszkodzony."

#: src/inst-job.c
#, c-format
msgid "It is made for %s devices; this one is %s."
msgstr "Jest przeznaczony dla urządzeń %s, a to urządzenie to %s."

#: src/inst-job.c
msgid "Made for another kind of device"
msgstr "Dla innego rodzaju urządzeń"

#: src/inst-job.c
msgid "Reading the package"
msgstr "Odczytuję pakiet"

#: src/inst-job.c
msgid "Cannot uninstall software"
msgstr "Nie można odinstalowywać oprogramowania"

#: src/inst-job.c
msgid "dpkg, which keeps track of the installed software, is missing."
msgstr "Brak programu dpkg, który ewidencjonuje zainstalowane oprogramowanie."

#: src/inst-job.c
#, c-format
msgid "“%s” is not installed."
msgstr "Pakiet „%s” nie jest zainstalowany."

#: src/inst-main.c
msgid "Install the package NAME from the software sources"
msgstr "Zainstaluj pakiet NAZWA ze źródeł oprogramowania"

#: src/inst-main.c
msgid "NAME"
msgstr "NAZWA"

#: src/inst-main.c
msgid "Uninstall the package NAME"
msgstr "Odinstaluj pakiet NAZWA"

#: src/inst-main.c
msgid "Print the version"
msgstr "Wyświetl wersję"

#: src/inst-main.c
msgid "[FILE.deb…]"
msgstr "[PLIK.deb…]"

#: src/inst-pk.c
msgid "A library the app needs"
msgstr "Biblioteka potrzebna aplikacji"

#: src/inst-pk.c
msgid "A sample app"
msgstr "Przykładowa aplikacja"

#: src/inst-service.c
#, c-format
msgid "%s %s is installed already."
msgstr "%s %s jest już zainstalowany."

#. TRANSLATORS: %s is a list of names ("libfoo, libbar"), %u how many more there are
#: src/inst-view.c
#, c-format
msgid "%s and %u more"
msgid_plural "%s and %u more"
msgstr[0] "%s i jeszcze %u"
msgstr[1] "%s i jeszcze %u"
msgstr[2] "%s i jeszcze %u"

# android: Settings vpn_version_info
#: src/inst-view.c
#, c-format
msgid "Version %s"
msgstr "Wersja %s"

#: src/inst-view.c
msgid "This file"
msgstr "Ten plik"

#: src/inst-view.c
msgid "Available"
msgstr "Dostępna"

#: src/inst-view.c
msgid "newer"
msgstr "nowsza"

#: src/inst-view.c
msgid "older"
msgstr "starsza"

#: src/inst-view.c
msgid "OLDER"
msgstr "STARSZA"

#: src/inst-view.c
msgid "Install this app?"
msgstr "Zainstalować tę aplikację?"

#: src/inst-view.c
msgid "Install this package?"
msgstr "Zainstalować ten pakiet?"

#: src/inst-view.c
#, c-format
msgid "Replace %s %s with %s?"
msgstr "Zastąpić %s %s wersją %s?"

#: src/inst-view.c
msgid "This file has a newer version than the one installed."
msgstr "Ten plik zawiera nowszą wersję niż zainstalowana."

#: src/inst-view.c
msgid "The software sources have a newer version than the one installed."
msgstr "Źródła oprogramowania mają nowszą wersję niż zainstalowana."

#: src/inst-view.c
msgid "This file is an OLDER version"
msgstr "Ten plik zawiera STARSZĄ wersję"

#: src/inst-view.c
msgid "The available version is OLDER"
msgstr "Dostępna wersja jest STARSZA"

#: src/inst-view.c
#, c-format
msgid ""
"%s %s is installed. This file has %s, which is older. Replace the installed "
"version with the older one?"
msgstr ""
"Zainstalowano %s %s. Ten plik zawiera starszą wersję %s. Zastąpić "
"zainstalowaną wersję starszą?"

#: src/inst-view.c
#, c-format
msgid ""
"%s %s is installed. The software sources have %s, which is older. Replace "
"the installed version with the older one?"
msgstr ""
"Zainstalowano %s %s. Źródła oprogramowania mają starszą wersję %s. Zastąpić "
"zainstalowaną wersję starszą?"

#: src/inst-view.c
msgid "Already installed"
msgstr "Już zainstalowano"

#: src/inst-view.c
#, c-format
msgid ""
"%s %s is installed already. Reinstalling puts its files back as they came."
msgstr ""
"%s %s jest już zainstalowany. Ponowna instalacja przywróci jego pliki do "
"stanu pierwotnego."

#: src/inst-view.c
#, c-format
msgid ""
"%s %s is installed already. The same version cannot be installed over itself."
msgstr ""
"%s %s jest już zainstalowany. Tej samej wersji nie można zainstalować na "
"niej samej."

#: src/inst-view.c
#, c-format
msgid "Uninstall %s?"
msgstr "Odinstalować: %s?"

#: src/inst-view.c
msgid "Its data will be deleted."
msgstr "Jej dane zostaną usunięte."

#: src/inst-view.c
msgid "Its program files are removed. Your own files stay."
msgstr "Pliki programu zostaną usunięte. Twoje pliki pozostaną."

#: src/inst-view.c
msgid "Frees"
msgstr "Zwolni"

#. TRANSLATORS: a package file's size, then the space it takes once installed: "4 MB file · 12 MB installed"
#: src/inst-view.c
#, c-format
msgid "%s file · %s installed"
msgstr "Plik: %s · po instalacji: %s"

#. TRANSLATORS: what installing downloads, then the space it takes: "4 MB download · 12 MB installed"
#: src/inst-view.c
#, c-format
msgid "%s download · %s installed"
msgstr "Do pobrania: %s · po instalacji: %s"

#: src/inst-view.c
#, c-format
msgid "%s installed"
msgstr "Po instalacji: %s"

# android: Framework mime_type_generic_ext
#: src/inst-view.c
#, c-format
msgid "%s file"
msgstr "Plik %s"

#: src/inst-view.c
#, c-format
msgid "%s download"
msgstr "Do pobrania: %s"

# android: Settings accessibility_button_size_title (short)
#: src/inst-view.c
msgid "Size"
msgstr "Rozmiar"

#: src/inst-view.c
#, c-format
msgid "Also installs %u other package"
msgid_plural "Also installs %u other packages"
msgstr[0] "Zainstaluje też %u inny pakiet"
msgstr[1] "Zainstaluje też %u inne pakiety"
msgstr[2] "Zainstaluje też %u innych pakietów"

#: src/inst-view.c
#, c-format
msgid "%s to download: %s"
msgstr "%s do pobrania: %s"

#: src/inst-view.c
#, c-format
msgid "Also removes %u other package"
msgid_plural "Also removes %u other packages"
msgstr[0] "Usunie też %u inny pakiet"
msgstr[1] "Usunie też %u inne pakiety"
msgstr[2] "Usunie też %u innych pakietów"

#: src/inst-view.c
msgid "Package"
msgstr "Pakiet"

# android: Contacts header_website_entry (other app, short)
#: src/inst-view.c
msgid "Website"
msgstr "Strona internetowa"

#: src/inst-view.c
msgid ""
"A package can change anything on this device: it installs with full rights. "
"Install only what you trust."
msgstr ""
"Pakiet może zmienić wszystko na tym urządzeniu: instaluje się z pełnymi "
"uprawnieniami. Instaluj tylko to, czemu ufasz."

# android: PackageInstaller cancel
#: src/inst-view.c
msgid "Cancel"
msgstr "Anuluj"

# android: Framework accessibility_dialog_button_uninstall (short)
#: src/inst-view.c
msgid "Uninstall"
msgstr "Odinstaluj"

# android: PackageInstaller install
#: src/inst-view.c
msgid "Install"
msgstr "Zainstaluj"

# android: PackageInstaller launch
#: src/inst-view.c src/inst-window.c
msgid "Open"
msgstr "Otwórz"

# android: PackageInstaller done (several translations, short)
#: src/inst-view.c
msgid "Done"
msgstr "Gotowe"

#: src/inst-view.c
#, c-format
msgid "Replace with %s"
msgstr "Zastąp wersją %s"

#: src/inst-view.c
msgid "Reinstall"
msgstr "Zainstaluj ponownie"

# android: Framework lockscreen_transport_stop_description (short)
#: src/inst-view.c
msgid "Stop"
msgstr "Zatrzymaj"

# android: PackageInstaller close
#: src/inst-view.c
msgid "Close"
msgstr "Zamknij"

# android: Framework action_menu_overflow_description (short)
#: src/inst-window.c
msgid "More options"
msgstr "Więcej opcji"

#: src/inst-window.c
msgid "Software packages (.deb)"
msgstr "Pakiety oprogramowania (.deb)"

#: src/inst-window.c
msgid "Choose a package"
msgstr "Wybierz pakiet"

#: src/inst-window.c
msgid "Install apps from packages"
msgstr "Instaluj aplikacje z pakietów"

#: src/inst-window.c
msgid ""
"App Installer installs .deb package files. Tap one in Files, or choose one "
"here: it shows what the package is and asks before anything changes."
msgstr ""
"Instalator aplikacji instaluje pliki pakietów .deb. Kliknij plik w aplikacji "
"Pliki albo wybierz go tutaj: instalator pokaże, co to za pakiet, i zapyta, "
"zanim cokolwiek zmieni."

#: src/inst-window.c
msgid ""
"Software uses it too, to install and uninstall apps from the software "
"sources."
msgstr ""
"Aplikacja Oprogramowanie też z niego korzysta, by instalować i "
"odinstalowywać aplikacje ze źródeł oprogramowania."
