#. the dialog role: the shell's back gesture then sends Escape, which answers no
#. ⋮: About, VibeOS's About sheet, as every VibeOS app has it
#: data/vibeos.Installer.desktop.in src/inst-sheet.c src/inst-window.c
msgid "App Installer"
msgstr "Installer app"

#: data/vibeos.Installer.desktop.in
msgid "Install apps from package files, and uninstall them"
msgstr "Installa app da file di pacchetto e disinstallale"

#: data/vibeos.Installer.desktop.in
msgid "Install;Uninstall;Package;deb;Software;App;"
msgstr "Installa;Disinstalla;Pacchetto;deb;Software;App;"

#: src/inst-catalog.c
msgid "A sample app for trying App Installer"
msgstr "Un'app di esempio per provare Installer app"

#: src/inst-catalog.c
msgid ""
"This package is not real: App Installer's demo shows it to try its screens.\n"
"\n"
"Nothing is installed or removed while the demo runs."
msgstr ""
"Questo pacchetto non è reale: la demo di Installer app lo mostra per "
"provarne le schermate.\n"
"\n"
"Durante la demo non viene installato né rimosso nulla."

#: src/inst-job.c
#, c-format
msgid "%s is part of VibeOS."
msgstr "%s fa parte di VibeOS."

#: src/inst-job.c
#, c-format
msgid "%s is part of the phone's shell and session."
msgstr "%s fa parte dell'interfaccia e della sessione del telefono."

#: src/inst-job.c
#, c-format
msgid "%s is essential: the system cannot work without it."
msgstr "%s è essenziale: il sistema non può funzionare senza."

#: src/inst-job.c
#, c-format
msgid "%s is required by the system."
msgstr "%s è richiesto dal sistema."

#: src/inst-job.c
msgid "Cannot be uninstalled"
msgstr "Impossibile disinstallare"

#: src/inst-job.c
#, c-format
msgid "Uninstalling it would also remove %s. %s"
msgstr "Disinstallarlo rimuoverebbe anche %s. %s"

#: src/inst-job.c
#, c-format
msgid "Installing it would remove %s. %s"
msgstr "Installarlo rimuoverebbe %s. %s"

#: src/inst-job.c
msgid "Cannot be installed"
msgstr "Impossibile installare"

#: src/inst-job.c src/inst-view.c
msgid "Not uninstalled"
msgstr "Non disinstallato"

#: src/inst-job.c src/inst-view.c
msgid "Not installed"
msgstr "Non installato"

# android: SystemUI fgs_manager_app_item_stop_button_stopped_label (other app, short)
#: src/inst-job.c
msgid "Stopped"
msgstr "Interrotto"

#: src/inst-job.c
msgid "Nothing was uninstalled."
msgstr "Non è stato disinstallato nulla."

#: src/inst-job.c
msgid "Nothing was installed."
msgstr "Non è stato installato nulla."

#. the password dialog closed without the password: the user's no, not a failure
#: src/inst-job.c
msgid "The password was not given, so nothing was uninstalled."
msgstr ""
"La password non è stata inserita, quindi non è stato disinstallato nulla."

#: src/inst-job.c
msgid "The password was not given, so nothing was installed."
msgstr "La password non è stata inserita, quindi non è stato installato nulla."

#: src/inst-job.c
msgid ""
"Another app is installing or updating software right now. Try again once it "
"has finished."
msgstr ""
"Un'altra app sta installando o aggiornando software in questo momento. "
"Riprova quando avrà finito."

#: src/inst-job.c
msgid ""
"Something it needs cannot be installed: it is not in the software sources, "
"or not in a version that fits."
msgstr ""
"Un componente di cui ha bisogno non può essere installato: non è nelle "
"sorgenti software, o non in una versione compatibile."

#: src/inst-job.c
msgid ""
"Packages it needs could not be downloaded. Check the internet connection and "
"try again."
msgstr ""
"Impossibile scaricare i pacchetti di cui ha bisogno. Controlla la "
"connessione a internet e riprova."

#: src/inst-job.c
msgid ""
"The package is broken: the file is damaged, or it is not a proper package."
msgstr ""
"Il pacchetto è difettoso: il file è danneggiato oppure non è un pacchetto "
"valido."

#: src/inst-job.c
msgid "There is not enough free storage for it."
msgstr "Non c'è abbastanza spazio di archiviazione libero."

#: src/inst-job.c
msgid ""
"It clashes with software that is already installed: both have the same files."
msgstr ""
"È in conflitto con software già installato: entrambi hanno gli stessi file."

#: src/inst-job.c
msgid "The package's own setup failed. It may be only partly installed."
msgstr ""
"La configurazione del pacchetto non è riuscita. Potrebbe essere installato "
"solo in parte."

#: src/inst-job.c
msgid ""
"The package's own removal script failed. It may be only partly uninstalled."
msgstr ""
"Lo script di rimozione del pacchetto non è riuscito. Potrebbe essere "
"disinstallato solo in parte."

#: src/inst-job.c
msgid "It is made for another kind of device."
msgstr "È fatto per un altro tipo di dispositivo."

#: src/inst-job.c
msgid ""
"The software sources could not be verified, so nothing was downloaded from "
"them."
msgstr ""
"Non è stato possibile verificare le sorgenti software, quindi non è stato "
"scaricato nulla."

#: src/inst-job.c
msgid "The software sources do not have it (any more)."
msgstr "Le sorgenti software non lo hanno (più)."

#: src/inst-job.c
msgid "Software was installed or removed meanwhile. Try again."
msgstr "Nel frattempo è stato installato o rimosso altro software. Riprova."

#: src/inst-job.c
msgid "Cannot install software"
msgstr "Impossibile installare software"

#: src/inst-job.c
msgid ""
"PackageKit, the system service that installs software, is missing or not "
"running."
msgstr ""
"PackageKit, il servizio di sistema che installa il software, manca o non è "
"in esecuzione."

#: src/inst-job.c
msgid "Something went wrong while uninstalling."
msgstr "Si è verificato un problema durante la disinstallazione."

#: src/inst-job.c
msgid "Something went wrong while installing."
msgstr "Si è verificato un problema durante l'installazione."

#: src/inst-job.c
msgid "Waiting for your password"
msgstr "In attesa della password"

#: src/inst-job.c
msgid "Waiting for another install to finish"
msgstr "In attesa che finisca un'altra installazione"

#: src/inst-job.c
msgid "Downloading"
msgstr "Download"

#: src/inst-job.c
msgid "Uninstalling"
msgstr "Disinstallazione"

#: src/inst-job.c
msgid "Installing"
msgstr "Installazione"

#: src/inst-job.c
msgid "Finishing"
msgstr "Completamento"

#: src/inst-job.c
msgid "Stopping"
msgstr "Interruzione"

#: src/inst-job.c
msgid "Getting ready"
msgstr "Preparazione"

#: src/inst-job.c
msgid "Checking what else it takes along"
msgstr "Verifica di cos'altro verrà rimosso"

#: src/inst-job.c
msgid "Checking what else it needs"
msgstr "Verifica di cos'altro gli serve"

#: src/inst-job.c
msgid "Looking it up"
msgstr "Ricerca del pacchetto"

#: src/inst-job.c
msgid "Checking the software sources"
msgstr "Verifica delle sorgenti software"

#: src/inst-job.c
#, c-format
msgid "The software sources have no package called “%s”."
msgstr "Le sorgenti software non hanno nessun pacchetto chiamato «%s»."

#: src/inst-job.c
msgid "Not found"
msgstr "Non trovato"

#: src/inst-job.c
msgid "Removing it would leave other software with something it needs missing."
msgstr "Rimuoverlo lascerebbe altro software senza qualcosa di cui ha bisogno."

#: src/inst-job.c
#, c-format
msgid "%s is uninstalled."
msgstr "%s è stato disinstallato."

#: src/inst-job.c
msgid "Uninstalled"
msgstr "Disinstallato"

#: src/inst-job.c
#, c-format
msgid "%s %s is installed."
msgstr "%s %s è installato."

# android: Settings installed (several translations, short)
#: src/inst-job.c src/inst-view.c
msgid "Installed"
msgstr "Installato"

#: src/inst-job.c
msgid "Cannot open the file"
msgstr "Impossibile aprire il file"

#: src/inst-job.c
msgid "The file could not be read."
msgstr "Impossibile leggere il file."

#: src/inst-job.c
msgid "dpkg, which reads packages, is missing."
msgstr "Manca dpkg, che legge i pacchetti."

#: src/inst-job.c
msgid "Not a package"
msgstr "Non è un pacchetto"

#: src/inst-job.c
msgid ""
"This file is not a software package that can be installed here, or it is "
"damaged."
msgstr ""
"Questo file non è un pacchetto software installabile qui, oppure è "
"danneggiato."

#: src/inst-job.c
#, c-format
msgid "It is made for %s devices; this one is %s."
msgstr "È fatto per dispositivi %s; questo è %s."

#: src/inst-job.c
msgid "Made for another kind of device"
msgstr "Fatto per un altro tipo di dispositivo"

#: src/inst-job.c
msgid "Reading the package"
msgstr "Lettura del pacchetto"

#: src/inst-job.c
msgid "Cannot uninstall software"
msgstr "Impossibile disinstallare software"

#: src/inst-job.c
msgid "dpkg, which keeps track of the installed software, is missing."
msgstr "Manca dpkg, che tiene traccia del software installato."

#: src/inst-job.c
#, c-format
msgid "“%s” is not installed."
msgstr "«%s» non è installato."

#: src/inst-main.c
msgid "Install the package NAME from the software sources"
msgstr "Installa il pacchetto NOME dalle sorgenti software"

#: src/inst-main.c
msgid "NAME"
msgstr "NOME"

#: src/inst-main.c
msgid "Uninstall the package NAME"
msgstr "Disinstalla il pacchetto NOME"

#: src/inst-main.c
msgid "Print the version"
msgstr "Mostra la versione"

#: src/inst-main.c
msgid "[FILE.deb…]"
msgstr "[FILE.deb…]"

#: src/inst-pk.c
msgid "A library the app needs"
msgstr "Una libreria di cui l'app ha bisogno"

#: src/inst-pk.c
msgid "A sample app"
msgstr "Un'app di esempio"

#: src/inst-service.c
#, c-format
msgid "%s %s is installed already."
msgstr "%s %s è già installato."

#. TRANSLATORS: %s is a list of names ("libfoo, libbar"), %u how many more there are
#: src/inst-view.c
#, c-format
msgid "%s and %u more"
msgid_plural "%s and %u more"
msgstr[0] "%s e %u altro"
msgstr[1] "%s e altri %u"

# android: Settings vpn_version_info
#: src/inst-view.c
#, c-format
msgid "Version %s"
msgstr "Versione %s"

#: src/inst-view.c
msgid "This file"
msgstr "Questo file"

# android: Framework media_route_status_available (short)
#: src/inst-view.c
msgid "Available"
msgstr "Disponibile"

#: src/inst-view.c
msgid "newer"
msgstr "più recente"

#: src/inst-view.c
msgid "older"
msgstr "più vecchia"

#: src/inst-view.c
msgid "OLDER"
msgstr "PIÙ VECCHIA"

#: src/inst-view.c
msgid "Install this app?"
msgstr "Installare questa app?"

#: src/inst-view.c
msgid "Install this package?"
msgstr "Installare questo pacchetto?"

#: src/inst-view.c
#, c-format
msgid "Replace %s %s with %s?"
msgstr "Sostituire %s %s con %s?"

#: src/inst-view.c
msgid "This file has a newer version than the one installed."
msgstr "Questo file contiene una versione più recente di quella installata."

#: src/inst-view.c
msgid "The software sources have a newer version than the one installed."
msgstr ""
"Le sorgenti software hanno una versione più recente di quella installata."

#: src/inst-view.c
msgid "This file is an OLDER version"
msgstr "Questo file contiene una versione PIÙ VECCHIA"

#: src/inst-view.c
msgid "The available version is OLDER"
msgstr "La versione disponibile è PIÙ VECCHIA"

#: src/inst-view.c
#, c-format
msgid ""
"%s %s is installed. This file has %s, which is older. Replace the installed "
"version with the older one?"
msgstr ""
"%s %s è installato. Questo file contiene la versione %s, che è più vecchia. "
"Sostituire la versione installata con quella più vecchia?"

#: src/inst-view.c
#, c-format
msgid ""
"%s %s is installed. The software sources have %s, which is older. Replace "
"the installed version with the older one?"
msgstr ""
"%s %s è installato. Le sorgenti software hanno la versione %s, che è più "
"vecchia. Sostituire la versione installata con quella più vecchia?"

#: src/inst-view.c
msgid "Already installed"
msgstr "Già installato"

#: src/inst-view.c
#, c-format
msgid ""
"%s %s is installed already. Reinstalling puts its files back as they came."
msgstr ""
"%s %s è già installato. La reinstallazione riporta i suoi file allo stato "
"originale."

#: src/inst-view.c
#, c-format
msgid ""
"%s %s is installed already. The same version cannot be installed over itself."
msgstr ""
"%s %s è già installato. La stessa versione non può essere installata sopra "
"se stessa."

#: src/inst-view.c
#, c-format
msgid "Uninstall %s?"
msgstr "Disinstallare %s?"

#: src/inst-view.c
msgid "Its data will be deleted."
msgstr "I suoi dati verranno eliminati."

#: src/inst-view.c
msgid "Its program files are removed. Your own files stay."
msgstr "I suoi file di programma vengono rimossi. I tuoi file restano."

#: src/inst-view.c
msgid "Frees"
msgstr "Libera"

#. TRANSLATORS: a package file's size, then the space it takes once installed: "4 MB file · 12 MB installed"
#: src/inst-view.c
#, c-format
msgid "%s file · %s installed"
msgstr "File da %s · %s una volta installato"

#. TRANSLATORS: what installing downloads, then the space it takes: "4 MB download · 12 MB installed"
#: src/inst-view.c
#, c-format
msgid "%s download · %s installed"
msgstr "%s da scaricare · %s una volta installato"

#: src/inst-view.c
#, c-format
msgid "%s installed"
msgstr "%s una volta installato"

#: src/inst-view.c
#, c-format
msgid "%s file"
msgstr "File da %s"

#: src/inst-view.c
#, c-format
msgid "%s download"
msgstr "%s da scaricare"

# android: Settings accessibility_button_size_title (short)
#: src/inst-view.c
msgid "Size"
msgstr "Dimensioni"

#: src/inst-view.c
#, c-format
msgid "Also installs %u other package"
msgid_plural "Also installs %u other packages"
msgstr[0] "Installa anche %u altro pacchetto"
msgstr[1] "Installa anche altri %u pacchetti"

#: src/inst-view.c
#, c-format
msgid "%s to download: %s"
msgstr "%s da scaricare: %s"

#: src/inst-view.c
#, c-format
msgid "Also removes %u other package"
msgid_plural "Also removes %u other packages"
msgstr[0] "Rimuove anche %u altro pacchetto"
msgstr[1] "Rimuove anche altri %u pacchetti"

#: src/inst-view.c
msgid "Package"
msgstr "Pacchetto"

# android: Contacts header_website_entry (other app, short)
#: src/inst-view.c
msgid "Website"
msgstr "Sito web"

#: src/inst-view.c
msgid ""
"A package can change anything on this device: it installs with full rights. "
"Install only what you trust."
msgstr ""
"Un pacchetto può modificare qualsiasi cosa su questo dispositivo: si "
"installa con tutti i permessi. Installa solo ciò di cui ti fidi."

# android: PackageInstaller cancel
#: src/inst-view.c
msgid "Cancel"
msgstr "Annulla"

# android: Framework accessibility_dialog_button_uninstall (short)
#: src/inst-view.c
msgid "Uninstall"
msgstr "Disinstalla"

# android: PackageInstaller install
#: src/inst-view.c
msgid "Install"
msgstr "Installa"

# android: PackageInstaller launch
#: src/inst-view.c src/inst-window.c
msgid "Open"
msgstr "Apri"

# android: PackageInstaller done (several translations, short)
#: src/inst-view.c
msgid "Done"
msgstr "Fine"

#: src/inst-view.c
#, c-format
msgid "Replace with %s"
msgstr "Sostituisci con %s"

#: src/inst-view.c
msgid "Reinstall"
msgstr "Reinstalla"

# android: Framework lockscreen_transport_stop_description (several translations, short)
#: src/inst-view.c
msgid "Stop"
msgstr "Interrompi"

# android: PackageInstaller close (several translations, short)
#: src/inst-view.c
msgid "Close"
msgstr "Chiudi"

# android: Framework action_menu_overflow_description (several translations, short)
#: src/inst-window.c
msgid "More options"
msgstr "Altre opzioni"

#: src/inst-window.c
msgid "Software packages (.deb)"
msgstr "Pacchetti software (.deb)"

#: src/inst-window.c
msgid "Choose a package"
msgstr "Scegli un pacchetto"

#: src/inst-window.c
msgid "Install apps from packages"
msgstr "Installa app dai pacchetti"

#: src/inst-window.c
msgid ""
"App Installer installs .deb package files. Tap one in Files, or choose one "
"here: it shows what the package is and asks before anything changes."
msgstr ""
"Installer app installa i file di pacchetto .deb. Toccane uno in File o "
"scegline uno qui: mostra cos'è il pacchetto e chiede conferma prima di "
"cambiare qualcosa."

#: src/inst-window.c
msgid ""
"Software uses it too, to install and uninstall apps from the software "
"sources."
msgstr ""
"Anche Software lo usa per installare e disinstallare app dalle sorgenti "
"software."
