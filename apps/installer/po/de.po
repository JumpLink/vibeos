#. the dialog role: the shell's back gesture then sends Escape, which answers no
#. ⋮: About, VibeOS's About sheet, as every VibeOS app has it
#: data/vibeos.Installer.desktop.in src/inst-sheet.c src/inst-window.c
msgid "App Installer"
msgstr "App-Installer"

#: data/vibeos.Installer.desktop.in
msgid "Install apps from package files, and uninstall them"
msgstr "Apps aus Paketdateien installieren und deinstallieren"

#: data/vibeos.Installer.desktop.in
msgid "Install;Uninstall;Package;deb;Software;App;"
msgstr "Installieren;Deinstallieren;Paket;deb;Software;App;"

#: src/inst-catalog.c
msgid "A sample app for trying App Installer"
msgstr "Eine Beispiel-App zum Ausprobieren des App-Installers"

#: src/inst-catalog.c
msgid ""
"This package is not real: App Installer's demo shows it to try its screens.\n"
"\n"
"Nothing is installed or removed while the demo runs."
msgstr ""
"Dieses Paket ist nicht echt: Die Demo des App-Installers zeigt es, damit du "
"die Bildschirme ausprobieren kannst.\n"
"\n"
"Während die Demo läuft, wird nichts installiert oder entfernt."

#: src/inst-job.c
#, c-format
msgid "%s is part of VibeOS."
msgstr "%s ist Teil von VibeOS."

#: src/inst-job.c
#, c-format
msgid "%s is part of the phone's shell and session."
msgstr "%s gehört zur Oberfläche und Sitzung des Smartphones."

#: src/inst-job.c
#, c-format
msgid "%s is essential: the system cannot work without it."
msgstr "%s ist unverzichtbar: Ohne dieses Paket funktioniert das System nicht."

#: src/inst-job.c
#, c-format
msgid "%s is required by the system."
msgstr "%s wird vom System benötigt."

#: src/inst-job.c
msgid "Cannot be uninstalled"
msgstr "Kann nicht deinstalliert werden"

#: src/inst-job.c
#, c-format
msgid "Uninstalling it would also remove %s. %s"
msgstr "Bei der Deinstallation würde auch %s entfernt. %s"

#: src/inst-job.c
#, c-format
msgid "Installing it would remove %s. %s"
msgstr "Bei der Installation würde %s entfernt. %s"

#: src/inst-job.c
msgid "Cannot be installed"
msgstr "Kann nicht installiert werden"

#: src/inst-job.c src/inst-view.c
msgid "Not uninstalled"
msgstr "Nicht deinstalliert"

#: src/inst-job.c src/inst-view.c
msgid "Not installed"
msgstr "Nicht installiert"

#: src/inst-job.c
msgid "Stopped"
msgstr "Abgebrochen"

#: src/inst-job.c
msgid "Nothing was uninstalled."
msgstr "Es wurde nichts deinstalliert."

#: src/inst-job.c
msgid "Nothing was installed."
msgstr "Es wurde nichts installiert."

#. the password dialog closed without the password: the user's no, not a failure
#: src/inst-job.c
msgid "The password was not given, so nothing was uninstalled."
msgstr "Das Passwort wurde nicht eingegeben, daher wurde nichts deinstalliert."

#: src/inst-job.c
msgid "The password was not given, so nothing was installed."
msgstr "Das Passwort wurde nicht eingegeben, daher wurde nichts installiert."

#: src/inst-job.c
msgid ""
"Another app is installing or updating software right now. Try again once it "
"has finished."
msgstr ""
"Eine andere App installiert oder aktualisiert gerade Software. Versuche es "
"noch einmal, wenn sie fertig ist."

#: src/inst-job.c
msgid ""
"Something it needs cannot be installed: it is not in the software sources, "
"or not in a version that fits."
msgstr ""
"Etwas, das benötigt wird, kann nicht installiert werden: Es ist nicht in den "
"Softwarequellen oder nicht in einer passenden Version."

#: src/inst-job.c
msgid ""
"Packages it needs could not be downloaded. Check the internet connection and "
"try again."
msgstr ""
"Benötigte Pakete konnten nicht heruntergeladen werden. Prüfe die "
"Internetverbindung und versuche es noch einmal."

#: src/inst-job.c
msgid ""
"The package is broken: the file is damaged, or it is not a proper package."
msgstr ""
"Das Paket ist defekt: Die Datei ist beschädigt oder kein richtiges Paket."

#: src/inst-job.c
msgid "There is not enough free storage for it."
msgstr "Es ist nicht genug freier Speicherplatz vorhanden."

#: src/inst-job.c
msgid ""
"It clashes with software that is already installed: both have the same files."
msgstr ""
"Es kollidiert mit bereits installierter Software: Beide enthalten dieselben "
"Dateien."

#: src/inst-job.c
msgid "The package's own setup failed. It may be only partly installed."
msgstr ""
"Die Einrichtung des Pakets ist fehlgeschlagen. Es ist möglicherweise nur "
"teilweise installiert."

#: src/inst-job.c
msgid ""
"The package's own removal script failed. It may be only partly uninstalled."
msgstr ""
"Das Entfernungsskript des Pakets ist fehlgeschlagen. Es ist möglicherweise "
"nur teilweise deinstalliert."

#: src/inst-job.c
msgid "It is made for another kind of device."
msgstr "Es ist für eine andere Geräteart gemacht."

#: src/inst-job.c
msgid ""
"The software sources could not be verified, so nothing was downloaded from "
"them."
msgstr ""
"Die Softwarequellen konnten nicht überprüft werden, daher wurde nichts von "
"ihnen heruntergeladen."

#: src/inst-job.c
msgid "The software sources do not have it (any more)."
msgstr "Die Softwarequellen enthalten es nicht (mehr)."

#: src/inst-job.c
msgid "Software was installed or removed meanwhile. Try again."
msgstr ""
"In der Zwischenzeit wurde Software installiert oder entfernt. Versuche es "
"noch einmal."

#: src/inst-job.c
msgid "Cannot install software"
msgstr "Software kann nicht installiert werden"

#: src/inst-job.c
msgid ""
"PackageKit, the system service that installs software, is missing or not "
"running."
msgstr ""
"PackageKit, der Systemdienst zum Installieren von Software, fehlt oder läuft "
"nicht."

#: src/inst-job.c
msgid "Something went wrong while uninstalling."
msgstr "Beim Deinstallieren ist ein Fehler aufgetreten."

#: src/inst-job.c
msgid "Something went wrong while installing."
msgstr "Beim Installieren ist ein Fehler aufgetreten."

#: src/inst-job.c
msgid "Waiting for your password"
msgstr "Warten auf dein Passwort"

#: src/inst-job.c
msgid "Waiting for another install to finish"
msgstr "Warten, bis eine andere Installation abgeschlossen ist"

#: src/inst-job.c
msgid "Downloading"
msgstr "Wird heruntergeladen"

#: src/inst-job.c
msgid "Uninstalling"
msgstr "Wird deinstalliert"

#: src/inst-job.c
msgid "Installing"
msgstr "Wird installiert"

#: src/inst-job.c
msgid "Finishing"
msgstr "Wird abgeschlossen"

#: src/inst-job.c
msgid "Stopping"
msgstr "Wird abgebrochen"

#: src/inst-job.c
msgid "Getting ready"
msgstr "Wird vorbereitet"

#: src/inst-job.c
msgid "Checking what else it takes along"
msgstr "Wird geprüft, was noch mit entfernt wird"

#: src/inst-job.c
msgid "Checking what else it needs"
msgstr "Wird geprüft, was noch benötigt wird"

#: src/inst-job.c
msgid "Looking it up"
msgstr "Wird gesucht"

#: src/inst-job.c
msgid "Checking the software sources"
msgstr "Softwarequellen werden geprüft"

#: src/inst-job.c
#, c-format
msgid "The software sources have no package called “%s”."
msgstr "Die Softwarequellen enthalten kein Paket namens „%s“."

# android: SystemUI controls_error_removed (other app, short)
#: src/inst-job.c
msgid "Not found"
msgstr "Nicht gefunden"

#: src/inst-job.c
msgid "Removing it would leave other software with something it needs missing."
msgstr ""
"Durch das Entfernen würde anderer Software etwas fehlen, das sie benötigt."

#: src/inst-job.c
#, c-format
msgid "%s is uninstalled."
msgstr "%s ist deinstalliert."

#: src/inst-job.c
msgid "Uninstalled"
msgstr "Deinstalliert"

#: src/inst-job.c
#, c-format
msgid "%s %s is installed."
msgstr "%s %s ist installiert."

# android: Settings installed (short)
#: src/inst-job.c src/inst-view.c
msgid "Installed"
msgstr "Installiert"

#: src/inst-job.c
msgid "Cannot open the file"
msgstr "Datei kann nicht geöffnet werden"

#: src/inst-job.c
msgid "The file could not be read."
msgstr "Die Datei konnte nicht gelesen werden."

#: src/inst-job.c
msgid "dpkg, which reads packages, is missing."
msgstr "dpkg, das Pakete liest, fehlt."

#: src/inst-job.c
msgid "Not a package"
msgstr "Kein Paket"

#: src/inst-job.c
msgid ""
"This file is not a software package that can be installed here, or it is "
"damaged."
msgstr ""
"Diese Datei ist kein Softwarepaket, das hier installiert werden kann, oder "
"sie ist beschädigt."

#: src/inst-job.c
#, c-format
msgid "It is made for %s devices; this one is %s."
msgstr "Es ist für %s-Geräte gemacht, dieses Gerät ist %s."

#: src/inst-job.c
msgid "Made for another kind of device"
msgstr "Für eine andere Geräteart gemacht"

#: src/inst-job.c
msgid "Reading the package"
msgstr "Paket wird gelesen"

#: src/inst-job.c
msgid "Cannot uninstall software"
msgstr "Software kann nicht deinstalliert werden"

#: src/inst-job.c
msgid "dpkg, which keeps track of the installed software, is missing."
msgstr "dpkg, das die installierte Software verwaltet, fehlt."

#: src/inst-job.c
#, c-format
msgid "“%s” is not installed."
msgstr "„%s“ ist nicht installiert."

#: src/inst-main.c
msgid "Install the package NAME from the software sources"
msgstr "Das Paket NAME aus den Softwarequellen installieren"

#: src/inst-main.c
msgid "NAME"
msgstr "NAME"

#: src/inst-main.c
msgid "Uninstall the package NAME"
msgstr "Das Paket NAME deinstallieren"

#: src/inst-main.c
msgid "Print the version"
msgstr "Version ausgeben"

#: src/inst-main.c
msgid "[FILE.deb…]"
msgstr "[DATEI.deb…]"

#: src/inst-pk.c
msgid "A library the app needs"
msgstr "Eine Bibliothek, die die App benötigt"

#: src/inst-pk.c
msgid "A sample app"
msgstr "Eine Beispiel-App"

#: src/inst-service.c
#, c-format
msgid "%s %s is installed already."
msgstr "%s %s ist bereits installiert."

#. TRANSLATORS: %s is a list of names ("libfoo, libbar"), %u how many more there are
#: src/inst-view.c
#, c-format
msgid "%s and %u more"
msgid_plural "%s and %u more"
msgstr[0] "%s und %u weitere"
msgstr[1] "%s und %u weitere"

# android: Settings vpn_version_info (several translations)
#: src/inst-view.c
#, c-format
msgid "Version %s"
msgstr "Version %s"

#: src/inst-view.c
msgid "This file"
msgstr "Diese Datei"

# android: Framework media_route_status_available (short)
#: src/inst-view.c
msgid "Available"
msgstr "Verfügbar"

#: src/inst-view.c
msgid "newer"
msgstr "neuer"

#: src/inst-view.c
msgid "older"
msgstr "älter"

# android: Framework older (adapted, several translations, short)
#: src/inst-view.c
msgid "OLDER"
msgstr "ÄLTER"

#: src/inst-view.c
msgid "Install this app?"
msgstr "Diese App installieren?"

#: src/inst-view.c
msgid "Install this package?"
msgstr "Dieses Paket installieren?"

#: src/inst-view.c
#, c-format
msgid "Replace %s %s with %s?"
msgstr "%s %s durch %s ersetzen?"

#: src/inst-view.c
msgid "This file has a newer version than the one installed."
msgstr "Diese Datei enthält eine neuere Version als die installierte."

#: src/inst-view.c
msgid "The software sources have a newer version than the one installed."
msgstr "Die Softwarequellen haben eine neuere Version als die installierte."

#: src/inst-view.c
msgid "This file is an OLDER version"
msgstr "Diese Datei ist eine ÄLTERE Version"

#: src/inst-view.c
msgid "The available version is OLDER"
msgstr "Die verfügbare Version ist ÄLTER"

#: src/inst-view.c
#, c-format
msgid ""
"%s %s is installed. This file has %s, which is older. Replace the installed "
"version with the older one?"
msgstr ""
"%s %s ist installiert. Diese Datei enthält %s, eine ältere Version. Die "
"installierte Version durch die ältere ersetzen?"

#: src/inst-view.c
#, c-format
msgid ""
"%s %s is installed. The software sources have %s, which is older. Replace "
"the installed version with the older one?"
msgstr ""
"%s %s ist installiert. Die Softwarequellen haben %s, eine ältere Version. "
"Die installierte Version durch die ältere ersetzen?"

#: src/inst-view.c
msgid "Already installed"
msgstr "Bereits installiert"

#: src/inst-view.c
#, c-format
msgid ""
"%s %s is installed already. Reinstalling puts its files back as they came."
msgstr ""
"%s %s ist bereits installiert. Bei einer Neuinstallation werden die Dateien "
"in ihren ursprünglichen Zustand zurückversetzt."

#: src/inst-view.c
#, c-format
msgid ""
"%s %s is installed already. The same version cannot be installed over itself."
msgstr ""
"%s %s ist bereits installiert. Dieselbe Version kann nicht über sich selbst "
"installiert werden."

#: src/inst-view.c
#, c-format
msgid "Uninstall %s?"
msgstr "%s deinstallieren?"

#: src/inst-view.c
msgid "Its data will be deleted."
msgstr "Die zugehörigen Daten werden gelöscht."

#: src/inst-view.c
msgid "Its program files are removed. Your own files stay."
msgstr ""
"Die Programmdateien werden entfernt. Deine eigenen Dateien bleiben erhalten."

#: src/inst-view.c
msgid "Frees"
msgstr "Gibt frei"

#: src/inst-view.c
#, c-format
msgid "%s file"
msgstr "Datei: %s"

#: src/inst-view.c
#, c-format
msgid "%s download"
msgstr "Download: %s"

#: src/inst-view.c
#, c-format
msgid "%s · %s installed"
msgstr "%s · %s installiert"

#: src/inst-view.c
#, c-format
msgid "%s installed"
msgstr "%s installiert"

# android: Settings accessibility_button_size_title (short)
#: src/inst-view.c
msgid "Size"
msgstr "Größe"

#: src/inst-view.c
#, c-format
msgid "Also installs %u other package"
msgid_plural "Also installs %u other packages"
msgstr[0] "Installiert auch %u weiteres Paket"
msgstr[1] "Installiert auch %u weitere Pakete"

#: src/inst-view.c
#, c-format
msgid "%s to download: %s"
msgstr "%s zum Herunterladen: %s"

#: src/inst-view.c
#, c-format
msgid "Also removes %u other package"
msgid_plural "Also removes %u other packages"
msgstr[0] "Entfernt auch %u weiteres Paket"
msgstr[1] "Entfernt auch %u weitere Pakete"

#: src/inst-view.c
msgid "Package"
msgstr "Paket"

# android: Contacts header_website_entry (other app, several translations, short)
#: src/inst-view.c
msgid "Website"
msgstr "Website"

#: src/inst-view.c
msgid ""
"A package can change anything on this device: it installs with full rights. "
"Install only what you trust."
msgstr ""
"Ein Paket kann alles auf diesem Gerät ändern: Es wird mit vollen Rechten "
"installiert. Installiere nur Pakete, denen du vertraust."

# android: PackageInstaller cancel
#: src/inst-view.c
msgid "Cancel"
msgstr "Abbrechen"

# android: Framework accessibility_dialog_button_uninstall (short)
#: src/inst-view.c
msgid "Uninstall"
msgstr "Deinstallieren"

# android: PackageInstaller install
#: src/inst-view.c
msgid "Install"
msgstr "Installieren"

# android: PackageInstaller launch
#: src/inst-view.c src/inst-window.c
msgid "Open"
msgstr "Öffnen"

# android: PackageInstaller done
#: src/inst-view.c
msgid "Done"
msgstr "Fertig"

#: src/inst-view.c
#, c-format
msgid "Replace with %s"
msgstr "Durch %s ersetzen"

#: src/inst-view.c
msgid "Reinstall"
msgstr "Neu installieren"

#: src/inst-view.c
msgid "Stop"
msgstr "Stoppen"

# android: PackageInstaller close
#: src/inst-view.c
msgid "Close"
msgstr "Schließen"

# android: Framework action_menu_overflow_description (several translations, short)
#: src/inst-window.c
msgid "More options"
msgstr "Weitere Optionen"

#: src/inst-window.c
msgid "Software packages (.deb)"
msgstr "Softwarepakete (.deb)"

#: src/inst-window.c
msgid "Choose a package"
msgstr "Paket auswählen"

#: src/inst-window.c
msgid "Install apps from packages"
msgstr "Apps aus Paketen installieren"

#: src/inst-window.c
msgid ""
"App Installer installs .deb package files. Tap one in Files, or choose one "
"here: it shows what the package is and asks before anything changes."
msgstr ""
"Der App-Installer installiert .deb-Paketdateien. Tippe in „Dateien“ auf eine "
"Datei oder wähle hier eine aus: Er zeigt, was das Paket ist, und fragt, "
"bevor sich etwas ändert."

#: src/inst-window.c
msgid ""
"Software uses it too, to install and uninstall apps from the software "
"sources."
msgstr ""
"Auch die App „Software“ nutzt ihn, um Apps aus den Softwarequellen zu "
"installieren und zu deinstallieren."
