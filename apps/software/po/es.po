msgstr "Cuenta y ajustes"

#: src/sw-account-pages.c
msgid "Your account is deleted"
msgstr "Se ha eliminado tu cuenta"

#: src/sw-account-pages.c
msgid "Enter your password to delete the account."
msgstr "Introduce tu contraseña para eliminar la cuenta."

#: src/sw-account-pages.c
msgid ""
"The store deletes the account, its devices, the list of apps it had and its "
"helpful votes. It cannot be undone. Your apps stay installed."
msgstr ""
"La tienda elimina la cuenta, sus dispositivos, la lista de aplicaciones que "
"tenía y sus votos de utilidad. No se puede deshacer. Tus aplicaciones siguen "
"instaladas."

#: src/sw-account-pages.c
msgid "Delete my reviews too"
msgstr "Eliminar también mis reseñas"

#: src/sw-account-pages.c
msgid ""
"Otherwise they stay, under \"Deleted account\", and nobody can change them"
msgstr "Si no, se quedan, como «Cuenta eliminada», y nadie puede cambiarlas"

#: src/sw-account-pages.c
msgid "A moderator hid this review: only you see it."
msgstr "Un moderador ha ocultado esta reseña: solo la ves tú."

#: src/sw-account-pages.c
msgid "You have not reviewed any apps yet. An app's page has its stars to tap."
msgstr ""
"Todavía no has reseñado ninguna aplicación. En la página de cada aplicación "
"puedes tocar sus estrellas."

# android: Settings request_manage_credentials_more (short)
#: src/sw-account-pages.c
msgid "Show more"
msgstr "Mostrar más"

#: src/sw-account.c
msgid ""
"Software could not keep your sign-in in the keyring. You will need to sign "
"in again next time."
msgstr ""
"Software no ha podido guardar tu sesión en el llavero. Tendrás que volver a "
"iniciar sesión la próxima vez."

#. TRANSLATORS: the keyring entry's name, as a password manager shows it; %s is the store's address
#: src/sw-account.c
#, c-format
msgid "VibeOS Software: the store account on %s"
msgstr "Software de VibeOS: la cuenta de la tienda en %s"

#: src/sw-account.c
msgid "You were signed out of the store. Sign in again to review apps."
msgstr ""
"Se ha cerrado tu sesión en la tienda. Vuelve a iniciarla para reseñar "
"aplicaciones."

#. TRANSLATORS: %u is the HTTP status code
#: src/sw-api.c
#, c-format
msgid "The store is not working right now (error %u). Try again later."
msgstr ""
"La tienda no funciona en este momento (error %u). Vuelve a intentarlo más "
"tarde."

#. TRANSLATORS: %u is the HTTP status code
#: src/sw-api.c
#, c-format
msgid "The store answered with error %u."
msgstr "La tienda ha respondido con el error %u."

#: src/sw-api.c
msgid "The store's answer could not be read. Try again later."
msgstr ""
"No se ha podido leer la respuesta de la tienda. Vuelve a intentarlo más "
"tarde."

#: src/sw-api.c
#, c-format
msgid "%s Try again in %d minute."
msgid_plural "%s Try again in %d minutes."
msgstr[0] "%s Vuelve a intentarlo dentro de %d minuto."
msgstr[1] "%s Vuelve a intentarlo dentro de %d minutos."

#: src/sw-api.c
#, c-format
msgid "%s Try again in %d second."
msgid_plural "%s Try again in %d seconds."
msgstr[0] "%s Vuelve a intentarlo dentro de %d segundo."
msgstr[1] "%s Vuelve a intentarlo dentro de %d segundos."

# android: Settings supervision_generic_error_page_title (adapted, several translations)
