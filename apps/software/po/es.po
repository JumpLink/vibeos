#: data/vibeos.Software.desktop.in src/sw-account-pages.c src/sw-window.c
msgid "Software"
msgstr "Software"

#: data/vibeos.Software.desktop.in
msgid "Find, install and update apps and games"
msgstr "Busca, instala y actualiza aplicaciones y juegos"

#: data/vibeos.Software.desktop.in
msgid "Store;Apps;Games;Install;Update;Uninstall;Review;"
msgstr "Tienda;Aplicaciones;Juegos;Instalar;Actualizar;Desinstalar;Reseña;"

#: src/sw-account-pages.c
msgid "You are signed in"
msgstr "Has iniciado sesión"

#: src/sw-account-pages.c
msgid "Enter your email address."
msgstr "Introduce tu dirección de correo."

# android: SystemUI biometric_dialog_enter_password (adapted, other app)
#: src/sw-account-pages.c
msgid "Enter your password."
msgstr "Introduce tu contraseña."

# android: Settings private_space_retry_signin_title (short)
#: src/sw-account-pages.c src/sw-app-page.c src/sw-mine.c
msgid "Sign in"
msgstr "Iniciar sesión"

#: src/sw-account-pages.c
msgid ""
"Sign in to rate and review apps, and to see your apps on all your devices."
msgstr ""
"Inicia sesión para valorar y reseñar aplicaciones, y para ver tus "
"aplicaciones en todos tus dispositivos."

# android: SystemUI keyboard_shortcut_group_applications_email (other app, several translations, short)
#: src/sw-account-pages.c
msgid "Email"
msgstr "Correo electrónico"

# android: Settings unlock_set_unlock_password_title (short)
#: src/sw-account-pages.c
msgid "Password"
msgstr "Contraseña"

# android: Settings lockpassword_forgot_password
#: src/sw-account-pages.c
msgid "Forgot your password?"
msgstr "¿Has olvidado la contraseña?"

#: src/sw-account-pages.c
msgid "No account yet?"
msgstr "¿Aún no tienes cuenta?"

#: src/sw-account-pages.c
msgid "Create an account"
msgstr "Crear una cuenta"

#: src/sw-account-pages.c
msgid "Enter a name. It shows on your reviews."
msgstr "Introduce un nombre. Aparece en tus reseñas."

#: src/sw-account-pages.c
msgid ""
"With an account you can rate and review apps, and see your apps on all your "
"devices. The store emails you a code to confirm the address."
msgstr ""
"Con una cuenta puedes valorar y reseñar aplicaciones, y ver tus aplicaciones "
"en todos tus dispositivos. La tienda te envía un código por correo para "
"confirmar la dirección."

# android: Settings security_settings_fingerprint_enroll_dialog_name_label (short)
#: src/sw-account-pages.c
msgid "Name"
msgstr "Nombre"

#: src/sw-account-pages.c
msgid "Shown on your reviews"
msgstr "Aparece en tus reseñas"

#: src/sw-account-pages.c
msgid "At least 8 characters"
msgstr "Al menos 8 caracteres"

#: src/sw-account-pages.c
msgid "Create the account"
msgstr "Crear la cuenta"

#: src/sw-account-pages.c
msgid "Send a new code"
msgstr "Enviar un código nuevo"

#. TRANSLATORS: %d is the seconds left until a new code can be asked for, "s" the abbreviation of seconds
#: src/sw-account-pages.c
#, c-format
msgid "Send a new code in %d s"
msgstr "Enviar un código nuevo en %d s"

#. TRANSLATORS: %s is the store's message (a whole sentence), %d how many more codes may be tried
#: src/sw-account-pages.c
#, c-format
msgid "%s %d try left."
msgid_plural "%s %d tries left."
msgstr[0] "%s Te queda %d intento."
msgstr[1] "%s Te quedan %d intentos."

#. TRANSLATORS: %d is the code's length in digits, %s the email address
#: src/sw-account-pages.c
#, c-format
msgid ""
"The store sent a %d-digit code to %s. Enter it here to confirm the address. "
"It works for 15 minutes."
msgstr ""
"La tienda ha enviado un código de %d dígitos a %s. Introdúcelo aquí para "
"confirmar la dirección. Es válido durante 15 minutos."

#. TRANSLATORS: %d is the code's length in digits, %s the email address
#: src/sw-account-pages.c
#, c-format
msgid ""
"Confirm your address to rate and review apps: enter the %d-digit code the "
"store emailed to %s, or ask for a new one."
msgstr ""
"Confirma tu dirección para valorar y reseñar aplicaciones: introduce el "
"código de %d dígitos que la tienda envió a %s o pide uno nuevo."

#: src/sw-account-pages.c
msgid "A new code is on its way"
msgstr "Hay un código nuevo en camino"

#: src/sw-account-pages.c
msgid "Your address is confirmed"
msgstr "Tu dirección está confirmada"

#: src/sw-account-pages.c
msgid "Confirm your email"
msgstr "Confirma tu correo"

# android: Settings security_settings_remoteauth_enroll_enrolling_agree (short)
#: src/sw-account-pages.c
msgid "Confirm"
msgstr "Confirmar"

# android: Aperture location_permission_dialog_later (other app, short)
#: src/sw-account-pages.c
msgid "Later"
msgstr "Más tarde"

#: src/sw-account-pages.c
msgid "Your password is changed, and you are signed in"
msgstr "Se ha cambiado tu contraseña y has iniciado sesión"

#: src/sw-account-pages.c
msgid ""
"Enter the address you signed up with. If it has an account, the store emails "
"a code to it to set a new password."
msgstr ""
"Introduce la dirección con la que te registraste. Si tiene una cuenta, la "
"tienda le enviará un código para establecer una contraseña nueva."

#: src/sw-account-pages.c
msgid "Send the code"
msgstr "Enviar el código"

#. TRANSLATORS: %s is the email address (partly hidden), %d the code's length in digits
#: src/sw-account-pages.c
#, c-format
msgid ""
"If %s has an account, a %d-digit code is on its way to it. Enter it here."
msgstr ""
"Si %s tiene una cuenta, se le está enviando un código de %d dígitos. "
"Introdúcelo aquí."

# android: Settings next_label (short)
#: src/sw-account-pages.c
msgid "Next"
msgstr "Siguiente"

#: src/sw-account-pages.c
msgid ""
"Choose a new password. Every device signed in to the account is signed out, "
"and this one signed in."
msgstr ""
"Elige una contraseña nueva. Se cerrará la sesión en todos los dispositivos "
"con esta cuenta y se iniciará en este."

#: src/sw-account-pages.c
msgid "New password"
msgstr "Contraseña nueva"

#: src/sw-account-pages.c
msgid "Set the password"
msgstr "Establecer la contraseña"

#: src/sw-account-pages.c
msgid "On Wi-Fi only"
msgstr "Solo con Wi-Fi"

#: src/sw-account-pages.c
msgid "Not on a network that counts the data (a phone's mobile data)"
msgstr "No en redes que cuentan los datos (los datos móviles del teléfono)"

#: src/sw-account-pages.c
msgid "On any network"
msgstr "Con cualquier red"

#. TRANSLATORS: Mine is the tab of the apps on the device, "Check for updates" its button
#: src/sw-account-pages.c
msgid "Only when I ask"
msgstr "Solo cuando lo pida"

#: src/sw-account-pages.c
msgid "Mine's Check for updates"
msgstr "Con «Buscar actualizaciones» en Mis apps"

#. TRANSLATORS: the theme: light or dark as the system's
#: src/sw-account-pages.c
msgid "As the system"
msgstr "Como el sistema"

# android: Etar preferences_light_theme (other app, short)
#: src/sw-account-pages.c
msgid "Light"
msgstr "Claro"

# android: Etar preferences_dark_theme (other app, short)
#: src/sw-account-pages.c
msgid "Dark"
msgstr "Oscuro"

#: src/sw-account-pages.c
msgid "Software's settings are not installed."
msgstr "Los ajustes de Software no están instalados."

#: src/sw-account-pages.c
msgid "Look for updates"
msgstr "Búsqueda de actualizaciones"

#: src/sw-account-pages.c
msgid ""
"Software looks for updates when it starts and when apps change. It does not "
"install them by itself: update from Mine."
msgstr ""
"Software busca actualizaciones al iniciarse y cuando cambian las "
"aplicaciones. No las instala por sí solo: actualiza desde Mis apps."

# android: Etar preferences_theme (other app, short)
#: src/sw-account-pages.c
msgid "Theme"
msgstr "Tema"

#: src/sw-account-pages.c
msgid "VibeOS apps only"
msgstr "Solo aplicaciones de VibeOS"

#: src/sw-account-pages.c
msgid "None of Debian's in the store's lists"
msgstr "Ninguna de Debian en las listas de la tienda"

#: src/sw-account-pages.c
msgid "About Software"
msgstr "Información de Software"

# android: PackageInstaller external_sources_settings
#: src/sw-account-pages.c
msgid "Settings"
msgstr "Ajustes"

#: src/sw-account-pages.c
msgid "The catalog"
msgstr "El catálogo"

#: src/sw-account-pages.c
msgid ""
"The apps, their descriptions and pictures come from the store at vibeos.top, "
"which takes them from Debian's and VibeOS's software sources and the apps' "
"own AppStream data."
msgstr ""
"Las aplicaciones, sus descripciones e imágenes vienen de la tienda de "
"vibeos.top, que las toma de los orígenes de software de Debian y VibeOS y de "
"los datos AppStream de cada aplicación."

#. TRANSLATORS: keep the links' markup as it is
#: src/sw-account-pages.c
msgid ""
"The category icons are Font Awesome Free 7.0.0 by Fonticons, Inc. (solid "
"style, unchanged), under the <a href=\"https://creativecommons.org/licenses/"
"by/4.0/\">Creative Commons Attribution 4.0</a> licence. <a href=\"https://"
"fontawesome.com\">fontawesome.com</a>"
msgstr ""
"Los iconos de las categorías son Font Awesome Free 7.0.0 de Fonticons, Inc. "
"(estilo sólido, sin cambios), con la licencia <a href=\"https://"
"creativecommons.org/licenses/by/4.0/\">Creative Commons Attribution 4.0</a>. "
"<a href=\"https://fontawesome.com\">fontawesome.com</a>"

#: src/sw-account-pages.c
msgid "You are signed out"
msgstr "Has cerrado sesión"

#: src/sw-account-pages.c
msgid "Sign out?"
msgstr "¿Cerrar sesión?"

#: src/sw-account-pages.c
msgid "Your reviews and your apps stay. Sign in again to write reviews."
msgstr ""
"Tus reseñas y tus aplicaciones se quedan. Vuelve a iniciar sesión para "
"escribir reseñas."

