#: src/sw-account-pages.c
msgid "Sign in to rate and review apps, and to see your apps on all your devices."
msgstr "Zaloguj się, aby oceniać aplikacje, pisać opinie i widzieć swoje aplikacje na wszystkich urządzeniach."

