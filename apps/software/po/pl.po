msgid "No account yet?"
msgstr "Nie masz konta?"

#: src/sw-account-pages.c
msgid "Create an account"
msgstr "Utwórz konto"

#: src/sw-account-pages.c
msgid "Enter a name. It shows on your reviews."
msgstr "Wpisz nazwę. Będzie widoczna przy Twoich opiniach."

#: src/sw-account-pages.c
msgid "With an account you can rate and review apps, and see your apps on all your devices. The store emails you a code to confirm the address."
msgstr "Z kontem możesz oceniać aplikacje, pisać opinie i widzieć swoje aplikacje na wszystkich urządzeniach. Sklep wyśle Ci e-mailem kod do potwierdzenia adresu."

# android: Settings security_settings_fingerprint_enroll_dialog_name_label (several translations, short)
#: src/sw-account-pages.c
msgid "Name"
msgstr "Nazwa"

#: src/sw-account-pages.c
msgid "Shown on your reviews"
msgstr "Widoczna przy Twoich opiniach"

#: src/sw-account-pages.c
msgid "At least 8 characters"
msgstr "Co najmniej 8 znaków"

#: src/sw-account-pages.c
msgid "Create the account"
msgstr "Utwórz konto"

#: src/sw-account-pages.c
msgid "Send a new code"
msgstr "Wyślij nowy kod"

#. TRANSLATORS: %d is the seconds left until a new code can be asked for, "s" the abbreviation of seconds
#: src/sw-account-pages.c
#, c-format
msgid "Send a new code in %d s"
msgstr "Wyślij nowy kod za %d s"

#. TRANSLATORS: %s is the store's message (a whole sentence), %d how many more codes may be tried
#: src/sw-account-pages.c
#, c-format
msgid "%s %d try left."
msgid_plural "%s %d tries left."
msgstr[0] "%s Została %d próba."
msgstr[1] "%s Zostały %d próby."
msgstr[2] "%s Zostało %d prób."

#. TRANSLATORS: %d is the code's length in digits, %s the email address
#: src/sw-account-pages.c
#, c-format
msgid "The store sent a %d-digit code to %s. Enter it here to confirm the address. It works for 15 minutes."
msgstr "Sklep wysłał %d-cyfrowy kod na adres %s. Wpisz go tutaj, aby potwierdzić adres. Kod jest ważny przez 15 minut."

#. TRANSLATORS: %d is the code's length in digits, %s the email address
#: src/sw-account-pages.c
#, c-format
msgid "Confirm your address to rate and review apps: enter the %d-digit code the store emailed to %s, or ask for a new one."
msgstr "Potwierdź adres, aby oceniać aplikacje i pisać opinie: wpisz %d-cyfrowy kod, który sklep wysłał na adres %s, albo poproś o nowy."

#: src/sw-account-pages.c
msgid "A new code is on its way"
msgstr "Nowy kod jest w drodze"

#: src/sw-account-pages.c
msgid "Your address is confirmed"
msgstr "Adres został potwierdzony"

#: src/sw-account-pages.c
msgid "Confirm your email"
msgstr "Potwierdź e-mail"

# android: Settings security_settings_remoteauth_enroll_enrolling_agree (short)
#: src/sw-account-pages.c
msgid "Confirm"
msgstr "Potwierdź"

# android: Aperture location_permission_dialog_later (other app, short)
#: src/sw-account-pages.c
msgid "Later"
msgstr "Później"

#: src/sw-account-pages.c
msgid "Your password is changed, and you are signed in"
msgstr "Zmieniono hasło i zalogowano Cię"

#: src/sw-account-pages.c
msgid "Enter the address you signed up with. If it has an account, the store emails a code to it to set a new password."
msgstr "Wpisz adres użyty przy rejestracji. Jeśli jest z nim powiązane konto, sklep wyśle na niego kod do ustawienia nowego hasła."

#: src/sw-account-pages.c
msgid "Send the code"
msgstr "Wyślij kod"

#. TRANSLATORS: %s is the email address (partly hidden), %d the code's length in digits
#: src/sw-account-pages.c
#, c-format
msgid "If %s has an account, a %d-digit code is on its way to it. Enter it here."
msgstr "Jeśli z adresem %s jest powiązane konto, wysłano na niego %d-cyfrowy kod. Wpisz go tutaj."

# android: Settings next_label (several translations, short)
#: src/sw-account-pages.c
msgid "Next"
msgstr "Dalej"

#: src/sw-account-pages.c
msgid "Choose a new password. Every device signed in to the account is signed out, and this one signed in."
msgstr "Wybierz nowe hasło. Wszystkie urządzenia zalogowane na to konto zostaną wylogowane, a to urządzenie – zalogowane."

#: src/sw-account-pages.c
msgid "New password"
msgstr "Nowe hasło"

#: src/sw-account-pages.c
msgid "Set the password"
msgstr "Ustaw hasło"

#: src/sw-account-pages.c
msgid "On Wi-Fi only"
msgstr "Tylko przez Wi-Fi"

#: src/sw-account-pages.c
msgid "Not on a network that counts the data (a phone's mobile data)"
msgstr "Nie w sieci z pomiarem użycia danych (dane mobilne telefonu)"

#: src/sw-account-pages.c
msgid "On any network"
msgstr "Przez dowolną sieć"

#. TRANSLATORS: Mine is the tab of the apps on the device, "Check for updates" its button
#: src/sw-account-pages.c
msgid "Only when I ask"
msgstr "Tylko na żądanie"

#: src/sw-account-pages.c
msgid "Mine's Check for updates"
msgstr "Przycisk „Sprawdź aktualizacje” w karcie „Moje”"

