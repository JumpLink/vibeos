msgid_plural "%s Try again in %d seconds."
msgstr[0] "%s Réessayez dans %d seconde."
msgstr[1] "%s Réessayez dans %d secondes."

#: src/sw-api.c
msgid "Something went wrong."
msgstr "Un problème est survenu."

#: src/sw-api.c
msgid ""
"Software cannot reach the store. Check the internet connection and try again."
msgstr ""
"Logiciels ne parvient pas à joindre la boutique. Vérifiez la connexion "
"Internet et réessayez."

#: src/sw-api.c
msgid "The store's address is not valid."
msgstr "L'adresse de la boutique n'est pas valide."

#: src/sw-app-page.c
