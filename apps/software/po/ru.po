#: data/vibeos.Software.desktop.in src/sw-account-pages.c src/sw-window.c
msgid "Software"
msgstr "Центр приложений"

#: data/vibeos.Software.desktop.in
msgid "Find, install and update apps and games"
msgstr "Поиск, установка и обновление приложений и игр"

#: data/vibeos.Software.desktop.in
msgid "Store;Apps;Games;Install;Update;Uninstall;Review;"
msgstr "Магазин;Приложения;Игры;Установить;Обновить;Удалить;Отзыв;"

#: src/sw-account-pages.c
msgid "You are signed in"
msgstr "Вы вошли в аккаунт"

#: src/sw-account-pages.c
msgid "Enter your email address."
msgstr "Введите адрес электронной почты."

# android: SystemUI biometric_dialog_enter_password (adapted, other app)
#: src/sw-account-pages.c
msgid "Enter your password."
msgstr "Введите пароль."

# android: Settings private_space_retry_signin_title (several translations, short)
#: src/sw-account-pages.c src/sw-app-page.c src/sw-mine.c
msgid "Sign in"
msgstr "Войти"

#: src/sw-account-pages.c
msgid ""
"Sign in to rate and review apps, and to see your apps on all your devices."
msgstr ""
"Войдите, чтобы оценивать приложения, оставлять отзывы и видеть свои "
"приложения на всех устройствах."

# android: SystemUI keyboard_shortcut_group_applications_email (other app, several translations, short)
#: src/sw-account-pages.c
msgid "Email"
msgstr "Эл. почта"

# android: Settings unlock_set_unlock_password_title (short)
#: src/sw-account-pages.c
msgid "Password"
msgstr "Пароль"

# android: Settings lockpassword_forgot_password
#: src/sw-account-pages.c
msgid "Forgot your password?"
msgstr "Забыли пароль?"

#: src/sw-account-pages.c
msgid "No account yet?"
msgstr "Еще нет аккаунта?"

#: src/sw-account-pages.c
msgid "Create an account"
msgstr "Создать аккаунт"

#: src/sw-account-pages.c
msgid "Enter a name. It shows on your reviews."
msgstr "Введите имя. Оно будет показано в ваших отзывах."

#: src/sw-account-pages.c
msgid ""
"With an account you can rate and review apps, and see your apps on all your "
"devices. The store emails you a code to confirm the address."
msgstr ""
"С аккаунтом можно оценивать приложения, оставлять отзывы и видеть свои "
"приложения на всех устройствах. Магазин пришлет код на почту, чтобы "
"подтвердить адрес."

#: src/sw-account-pages.c
msgid "Name"
msgstr "Имя"

#: src/sw-account-pages.c
msgid "Shown on your reviews"
msgstr "Отображается в ваших отзывах"

#: src/sw-account-pages.c
msgid "At least 8 characters"
msgstr "Не менее 8 символов"

#: src/sw-account-pages.c
msgid "Create the account"
msgstr "Создать аккаунт"

#: src/sw-account-pages.c
msgid "Send a new code"
msgstr "Отправить новый код"

#. TRANSLATORS: %d is the seconds left until a new code can be asked for, "s" the abbreviation of seconds
#: src/sw-account-pages.c
#, c-format
msgid "Send a new code in %d s"
msgstr "Отправить новый код через %d с"

#. TRANSLATORS: %s is the store's message (a whole sentence), %d how many more codes may be tried
#: src/sw-account-pages.c
#, c-format
msgid "%s %d try left."
msgid_plural "%s %d tries left."
msgstr[0] "%s Осталась %d попытка."
msgstr[1] "%s Осталось %d попытки."
msgstr[2] "%s Осталось %d попыток."

#. TRANSLATORS: %d is the code's length in digits, %s the email address
#: src/sw-account-pages.c
#, c-format
msgid ""
"The store sent a %d-digit code to %s. Enter it here to confirm the address. "
"It works for 15 minutes."
msgstr ""
"Магазин отправил %d-значный код на адрес %s. Введите его здесь, чтобы "
"подтвердить адрес. Код действует 15 минут."

#. TRANSLATORS: %d is the code's length in digits, %s the email address
#: src/sw-account-pages.c
#, c-format
msgid ""
"Confirm your address to rate and review apps: enter the %d-digit code the "
"store emailed to %s, or ask for a new one."
msgstr ""
"Подтвердите адрес, чтобы оценивать приложения и оставлять отзывы: введите %d-"
"значный код, который магазин отправил на %s, или запросите новый."

#: src/sw-account-pages.c
msgid "A new code is on its way"
msgstr "Новый код уже отправлен"

#: src/sw-account-pages.c
msgid "Your address is confirmed"
msgstr "Адрес подтвержден"

#: src/sw-account-pages.c
msgid "Confirm your email"
msgstr "Подтвердите адрес эл. почты"

# android: Settings security_settings_remoteauth_enroll_enrolling_agree (several translations, short)
#: src/sw-account-pages.c
msgid "Confirm"
msgstr "Подтвердить"

# android: Aperture location_permission_dialog_later (other app, short)
#: src/sw-account-pages.c
msgid "Later"
msgstr "Позже"

#: src/sw-account-pages.c
msgid "Your password is changed, and you are signed in"
msgstr "Пароль изменен, вы вошли в аккаунт"

#: src/sw-account-pages.c
msgid ""
"Enter the address you signed up with. If it has an account, the store emails "
"a code to it to set a new password."
msgstr ""
"Введите адрес, указанный при регистрации. Если с ним связан аккаунт, магазин "
"пришлет на него код для установки нового пароля."

#: src/sw-account-pages.c
msgid "Send the code"
msgstr "Отправить код"

#. TRANSLATORS: %s is the email address (partly hidden), %d the code's length in digits
#: src/sw-account-pages.c
#, c-format
msgid ""
"If %s has an account, a %d-digit code is on its way to it. Enter it here."
msgstr ""
"Если с адресом %s связан аккаунт, на него отправлен %d-значный код. Введите "
"его здесь."

# android: Settings next_label (several translations, short)
#: src/sw-account-pages.c
msgid "Next"
msgstr "Далее"

#: src/sw-account-pages.c
msgid ""
"Choose a new password. Every device signed in to the account is signed out, "
"and this one signed in."
msgstr ""
"Придумайте новый пароль. На всех устройствах, где выполнен вход в аккаунт, "
"произойдет выход, а на этом — вход."

#: src/sw-account-pages.c
msgid "New password"
msgstr "Новый пароль"

#: src/sw-account-pages.c
msgid "Set the password"
msgstr "Установить пароль"

#: src/sw-account-pages.c
msgid "On Wi-Fi only"
msgstr "Только по Wi-Fi"

#: src/sw-account-pages.c
msgid "Not on a network that counts the data (a phone's mobile data)"
msgstr "Не в сетях с учетом трафика (мобильный интернет телефона)"

#: src/sw-account-pages.c
msgid "On any network"
msgstr "В любой сети"

#. TRANSLATORS: Mine is the tab of the apps on the device, "Check for updates" its button
#: src/sw-account-pages.c
msgid "Only when I ask"
msgstr "Только по запросу"

#: src/sw-account-pages.c
msgid "Mine's Check for updates"
msgstr "Кнопка «Проверить обновления» в разделе «Мои»"

#. TRANSLATORS: the theme: light or dark as the system's
#: src/sw-account-pages.c
msgid "As the system"
msgstr "Как в системе"

# android: Etar preferences_light_theme (other app, short)
#: src/sw-account-pages.c
msgid "Light"
msgstr "Светлая"

# android: Etar preferences_dark_theme (other app, short)
#: src/sw-account-pages.c
msgid "Dark"
msgstr "Тёмная"

#: src/sw-account-pages.c
msgid "Software's settings are not installed."
msgstr "Настройки Центра приложений не установлены."

#: src/sw-account-pages.c
msgid "Look for updates"
msgstr "Поиск обновлений"

#: src/sw-account-pages.c
msgid ""
"Software looks for updates when it starts and when apps change. It does not "
"install them by itself: update from Mine."
msgstr ""
"Центр приложений ищет обновления при запуске и при изменении приложений. Сам "
"он их не устанавливает: обновляйте в разделе «Мои»."

# android: Etar preferences_theme (other app, short)
#: src/sw-account-pages.c
msgid "Theme"
msgstr "Тема"

#: src/sw-account-pages.c
msgid "VibeOS apps only"
msgstr "Только приложения VibeOS"

#: src/sw-account-pages.c
msgid "None of Debian's in the store's lists"
msgstr "Без приложений Debian в списках магазина"

#: src/sw-account-pages.c
msgid "About Software"
msgstr "О приложении «Центр приложений»"

# android: PackageInstaller external_sources_settings (several translations, short)
#: src/sw-account-pages.c
msgid "Settings"
msgstr "Настройки"

#: src/sw-account-pages.c
msgid "The catalog"
msgstr "Каталог"

#: src/sw-account-pages.c
msgid ""
"The apps, their descriptions and pictures come from the store at vibeos.top, "
"which takes them from Debian's and VibeOS's software sources and the apps' "
"own AppStream data."
msgstr ""
"Приложения, их описания и изображения берутся из магазина на vibeos.top, "
"который получает их из источников программ Debian и VibeOS и из данных "
"AppStream самих приложений."

#. TRANSLATORS: keep the links' markup as it is
#: src/sw-account-pages.c
msgid ""
"The category icons are Font Awesome Free 7.0.0 by Fonticons, Inc. (solid "
"style, unchanged), under the <a href=\"https://creativecommons.org/licenses/"
"by/4.0/\">Creative Commons Attribution 4.0</a> licence. <a href=\"https://"
"fontawesome.com\">fontawesome.com</a>"
msgstr ""
"Значки категорий — Font Awesome Free 7.0.0 от Fonticons, Inc. (стиль solid, "
"без изменений) по лицензии <a href=\"https://creativecommons.org/licenses/by/"
"4.0/\">Creative Commons Attribution 4.0</a>. <a href=\"https://"
"fontawesome.com\">fontawesome.com</a>"

#: src/sw-account-pages.c
msgid "You are signed out"
msgstr "Вы вышли из аккаунта"

#: src/sw-account-pages.c
msgid "Sign out?"
msgstr "Выйти из аккаунта?"

#: src/sw-account-pages.c
msgid "Your reviews and your apps stay. Sign in again to write reviews."
msgstr ""
"Ваши отзывы и приложения сохранятся. Чтобы писать отзывы, войдите снова."

# android: PackageInstaller cancel (several translations, short)
#: src/sw-account-pages.c src/sw-app-page.c src/sw-reviews.c
msgid "Cancel"
msgstr "Отмена"

# android: LatinIME account_select_sign_out (other app, short)
#: src/sw-account-pages.c
msgid "Sign out"
msgstr "Выйти"

#: src/sw-account-pages.c
msgid "Signed in"
msgstr "Вход выполнен"

#: src/sw-account-pages.c
msgid "Confirm your email address"
msgstr "Подтвердите адрес эл. почты"

#: src/sw-account-pages.c
msgid "Needed to rate and review apps"
msgstr "Нужно, чтобы оценивать приложения и оставлять отзывы"

#: src/sw-account-pages.c
msgid "My reviews"
msgstr "Мои отзывы"

#: src/sw-account-pages.c
msgid "Delete the account"
msgstr "Удалить аккаунт"

#: src/sw-account-pages.c src/sw-mine.c
msgid "Account and settings"
msgstr "Аккаунт и настройки"

#: src/sw-account-pages.c
msgid "Your account is deleted"
msgstr "Аккаунт удален"

#: src/sw-account-pages.c
msgid "Enter your password to delete the account."
msgstr "Чтобы удалить аккаунт, введите пароль."

#: src/sw-account-pages.c
msgid ""
"The store deletes the account, its devices, the list of apps it had and its "
"helpful votes. It cannot be undone. Your apps stay installed."
msgstr ""
"Магазин удалит аккаунт, его устройства, список его приложений и отметки "
"«Полезно». Это действие нельзя отменить. Приложения останутся установленными."

#: src/sw-account-pages.c
msgid "Delete my reviews too"
msgstr "Удалить и мои отзывы"

#: src/sw-account-pages.c
msgid ""
"Otherwise they stay, under \"Deleted account\", and nobody can change them"
msgstr ""
"Иначе они останутся с подписью «Удаленный аккаунт», и никто не сможет их "
"изменить"

#: src/sw-account-pages.c
msgid "A moderator hid this review: only you see it."
msgstr "Модератор скрыл этот отзыв: его видите только вы."

#: src/sw-account-pages.c
msgid "You have not reviewed any apps yet. An app's page has its stars to tap."
msgstr ""
"Вы еще не оставили ни одного отзыва. На странице приложения можно нажать на "
"звезды."

# android: Settings request_manage_credentials_more (several translations, short)
#: src/sw-account-pages.c
msgid "Show more"
msgstr "Показать больше"

#: src/sw-account.c
msgid ""
"Software could not keep your sign-in in the keyring. You will need to sign "
"in again next time."
msgstr ""
"Центру приложений не удалось сохранить вход в связке ключей. В следующий раз "
"нужно будет войти снова."

#. TRANSLATORS: the keyring entry's name, as a password manager shows it; %s is the store's address
#: src/sw-account.c
#, c-format
msgid "VibeOS Software: the store account on %s"
msgstr "Центр приложений VibeOS: аккаунт магазина на %s"

#: src/sw-account.c
msgid "You were signed out of the store. Sign in again to review apps."
msgstr "Вы вышли из аккаунта магазина. Войдите снова, чтобы оставлять отзывы."

#. TRANSLATORS: %u is the HTTP status code
#: src/sw-api.c
#, c-format
msgid "The store is not working right now (error %u). Try again later."
msgstr "Магазин сейчас не работает (ошибка %u). Повторите попытку позже."

#. TRANSLATORS: %u is the HTTP status code
#: src/sw-api.c
#, c-format
msgid "The store answered with error %u."
msgstr "Магазин вернул ошибку %u."

#: src/sw-api.c
msgid "The store's answer could not be read. Try again later."
msgstr "Не удалось прочитать ответ магазина. Повторите попытку позже."

#: src/sw-api.c
#, c-format
msgid "%s Try again in %d minute."
msgid_plural "%s Try again in %d minutes."
msgstr[0] "%s Повторите попытку через %d минуту."
msgstr[1] "%s Повторите попытку через %d минуты."
msgstr[2] "%s Повторите попытку через %d минут."

#: src/sw-api.c
#, c-format
msgid "%s Try again in %d second."
msgid_plural "%s Try again in %d seconds."
msgstr[0] "%s Повторите попытку через %d секунду."
msgstr[1] "%s Повторите попытку через %d секунды."
msgstr[2] "%s Повторите попытку через %d секунд."

#: src/sw-api.c
msgid "Something went wrong."
msgstr "Что-то пошло не так."

#: src/sw-api.c
msgid ""
"Software cannot reach the store. Check the internet connection and try again."
msgstr ""
"Центру приложений не удается связаться с магазином. Проверьте подключение к "
"интернету и повторите попытку."

#: src/sw-api.c
msgid "The store's address is not valid."
msgstr "Недопустимый адрес магазина."

#: src/sw-app-page.c
msgid "This app has no window of its own to open."
msgstr "У этого приложения нет собственного окна."

#. TRANSLATORS: %s is the app's name
#: src/sw-app-page.c
#, c-format
msgid "Uninstall %s?"
msgstr "Удалить «%s»?"

#: src/sw-app-page.c
msgid "The app goes. What it keeps in your home folder stays."
msgstr "Приложение будет удалено. Его данные в вашей домашней папке останутся."

# android: Settings uninstall_text (short)
#: src/sw-app-page.c
msgid "Uninstall"
msgstr "Удалить"

# android: PackageInstaller install
#: src/sw-app-page.c src/sw-widgets.c
msgid "Install"
msgstr "Установить"

# android: PackageInstaller update
#: src/sw-app-page.c src/sw-widgets.c
msgid "Update"
msgstr "Обновить"

# android: PackageInstaller launch
#: src/sw-app-page.c src/sw-widgets.c src/sw-window.c
msgid "Open"
msgstr "Открыть"

# android: Settings installed (several translations, short)
#: src/sw-app-page.c
msgid "Installed"
msgstr "Установлено"

#. TRANSLATORS: %s is the new version's number, then the size of its download
#: src/sw-app-page.c
#, c-format
msgid "Version %s is out · %s"
msgstr "Вышла версия %s · %s"

#: src/sw-app-page.c
#, c-format
msgid "Version %s is out"
msgstr "Вышла версия %s"

#. TRANSLATORS: under the number of the app's installs
#: src/sw-app-page.c
msgid "installs"
msgstr "установок"

#. TRANSLATORS: under the size of the app's download
#: src/sw-app-page.c
msgid "download"
msgstr "для скачивания"

#. TRANSLATORS: under the app's age rating ("12+")
#: src/sw-app-page.c
msgid "age rating"
msgstr "возраст"

#: src/sw-app-page.c
#, c-format
msgid "Screenshot %u of %u"
msgstr "Скриншот %u из %u"

#: src/sw-app-page.c
msgid "About this app"
msgstr "Об этом приложении"

#: src/sw-app-page.c
msgid "Read more"
msgstr "Подробнее"

#: src/sw-app-page.c
msgid "What's new"
msgstr "Что нового"

#. TRANSLATORS: the version's number, then the date it came out
#: src/sw-app-page.c
#, c-format
msgid "Version %s · %s"
msgstr "Версия %s · %s"

# android: Settings vpn_version_info
#: src/sw-app-page.c src/sw-mine.c src/sw-reviews.c
#, c-format
msgid "Version %s"
msgstr "Версия %s"

#: src/sw-app-page.c
msgid "The developer did not say what changed."
msgstr "Разработчик не указал, что изменилось."

# android: Settings permissions_label (short)
#: src/sw-app-page.c
msgid "Permissions"
msgstr "Разрешения"

#: src/sw-app-page.c
msgid ""
"What the app says it uses. VibeOS's own apps are part of the system: they do "
"not run in a sandbox."
msgstr ""
"Что приложение, по его словам, использует. Собственные приложения VibeOS — "
"часть системы: они работают не в изолированной среде."

#: src/sw-app-page.c
msgid ""
"What the app asks for. VibeOS enforces these permissions: the app runs in a "
"sandbox, and you allow or deny each one in Settings. Taking one away stops "
"the app."
msgstr ""
"Что запрашивает приложение. VibeOS следит за соблюдением этих разрешений: "
"приложение работает в изолированной среде, а вы разрешаете или запрещаете "
"каждое в настройках. Если отозвать разрешение, приложение будет остановлено."

#: src/sw-app-page.c
msgid "The app declares no permissions."
msgstr "Приложение не заявляет никаких разрешений."

#: src/sw-app-page.c
msgid ""
"The app declares no permissions. Until you change them in Settings, it may "
"use the network, and you are asked before it gets your location or the "
"camera, or runs in the background."
msgstr ""
"Приложение не заявляет никаких разрешений. Пока вы не измените их в "
"настройках, оно может пользоваться сетью, а перед доступом к местоположению "
"или камере и перед работой в фоновом режиме у вас спросят разрешение."

#: src/sw-app-page.c
msgid "Permissions in Settings"
msgstr "Разрешения в настройках"

#: src/sw-app-page.c
msgid "Allow or deny each one for this app"
msgstr "Разрешите или запретите каждое для этого приложения"

#: src/sw-app-page.c
msgid "Confirm your email address to rate and review apps."
msgstr ""
"Подтвердите адрес эл. почты, чтобы оценивать приложения и оставлять отзывы."

#: src/sw-app-page.c
msgid ""
"Install the app to rate it: the store takes reviews from people who have had "
"it on one of their devices."
msgstr ""
"Установите приложение, чтобы оценить его: магазин принимает отзывы от тех, у "
"кого оно было установлено на одном из устройств."

#: src/sw-app-page.c
msgid "The store does not take a review of this app from your account."
msgstr "Магазин не принимает отзывы об этом приложении от вашего аккаунта."

#: src/sw-app-page.c
msgid "Sign in to rate and review apps."
msgstr "Войдите, чтобы оценивать приложения и оставлять отзывы."

#: src/sw-app-page.c src/sw-reviews.c
msgid "Your review"
msgstr "Ваш отзыв"

#: src/sw-app-page.c
msgid "A moderator hid your review: only you see it."
msgstr "Модератор скрыл ваш отзыв: его видите только вы."

#: src/sw-app-page.c
msgid "Confirm the address"
msgstr "Подтвердить адрес"

#: src/sw-app-page.c src/sw-reviews.c
msgid "Rate the app"
msgstr "Оценить приложение"

#: src/sw-app-page.c
msgid "Write a review"
msgstr "Написать отзыв"

#: src/sw-app-page.c
msgid "Ratings and reviews"
msgstr "Оценки и отзывы"

#: src/sw-app-page.c
msgid "All reviews"
msgstr "Все отзывы"

#: src/sw-app-page.c
msgid "Similar apps"
msgstr "Похожие приложения"

#: src/sw-app-page.c
msgid "Information"
msgstr "Информация"

#: src/sw-app-page.c
msgid "Developer"
msgstr "Разработчик"

# android: Settings vpn_version (short)
#: src/sw-app-page.c
msgid "Version"
msgstr "Версия"

