#, c-format
msgid "The store answered with error %u."
msgstr "De Store antwoordde met fout %u."

#: src/sw-api.c
msgid "The store's answer could not be read. Try again later."
msgstr ""
"Het antwoord van de Store kon niet worden gelezen. Probeer het later opnieuw."

#: src/sw-api.c
