#: main.c
msgid "The sensor service is not running, so the compass cannot be read."
msgstr "שירות החיישנים לא פועל, ולכן אי אפשר לקרוא את המצפן."

#: main.c
msgid "The compass cannot be read right now."
msgstr "אי אפשר לקרוא את המצפן כרגע."

#: main.c
msgid "Hold the device flat, away from metal. Move it in a figure 8 to calibrate."
msgstr "יש להחזיק את המכשיר במצב שטוח, רחוק ממתכת, ולהזיז אותו בתנועה של הספרה 8 כדי לכייל."

#: main.c
msgid "This device has no compass."
msgstr "אין מצפן במכשיר הזה."

#: main.c
msgid "Location unavailable"
msgstr "המיקום לא זמין"

