#: main.c
msgid "The sensor service is not running, so the compass cannot be read."
msgstr ""
"El servicio de sensores no se está ejecutando, por lo que no se puede leer "
"la brújula."

#: main.c
msgid "The compass cannot be read right now."
msgstr "Ahora mismo no se puede leer la brújula."

#: main.c
msgid ""
"Hold the device flat, away from metal. Move it in a figure 8 to calibrate."
msgstr ""
"Sujeta el dispositivo en horizontal, lejos de objetos metálicos. Muévelo "
"trazando un 8 para calibrarlo."

#: main.c
msgid "This device has no compass."
msgstr "Este dispositivo no tiene brújula."

#: main.c
msgid "Location unavailable"
msgstr "Ubicación no disponible"

