<?xml version="1.0" encoding="UTF-8"?>
<!-- the app's stylesheet and its icons (data/icons: the microphone is Material Symbols Rounded's, filled, as the
     Round icon pack's glyphs; Copy and Clear are the Dialer's), where GtkApplication looks for icons: the resource
     base path + /icons -->
