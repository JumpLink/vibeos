#: src/dictate-download.c
#, c-format
msgid "%s is not the file it should be: its checksum does not match"
msgstr ""
"%s no es el archivo que debería ser: la suma de comprobación no coincide"

#. TRANSLATORS: %s is a file's name
#: src/dictate-download.c
#, c-format
msgid "%s is larger than it should be"
msgstr "%s es más grande de lo que debería"

