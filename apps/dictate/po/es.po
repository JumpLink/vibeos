# android: Messaging action_download (short)
#: src/dictate-download-dialog.c
msgid "Download"
msgstr "Descargar"

#. TRANSLATORS: a dialog's title; %s is the language's name for itself (Français)
#. TRANSLATORS: a dialog's title; %s is the language's name for itself
#: src/dictate-download-dialog.c
#, c-format
msgid "%s is not available"
msgstr "%s no está disponible"

#. TRANSLATORS: the first %s is the language's name for itself, the second a speech recogniser (Vosk), the
#. * third its Debian package (vibeos-dictate-vosk)
#: src/dictate-download-dialog.c
#, c-format
msgid ""
"%s is heard by %s, which is not installed on this phone. Install the %s "
"package, then choose %s again."
msgstr ""
"%s lo reconoce %s, que no está instalado en este teléfono. Instala el "
"paquete %s y vuelve a elegir %s."

# android: Framework httpErrorOk (several translations, short)
#: src/dictate-download-dialog.c
msgid "OK"
msgstr "Aceptar"

#: src/dictate-download-dialog.c
msgid "There is nothing to download for it."
msgstr "No hay nada que descargar."

