#: src/dictate-download.c
#, c-format
msgid "There is not enough space on the phone: %s are needed, %s are free"
msgstr "Espace insuffisant sur le téléphone : %s nécessaires, %s disponibles"

#. TRANSLATORS: the first %s is the language's name for itself (Deutsch), the second the package's name
#. * (vibeos-dictate-de)
#: src/dictate-engine.c
#, c-format
msgid "There is no speech model for %s. Install the %s package."
msgstr ""
"Il n'y a pas de modèle de reconnaissance vocale pour la langue %s. Installez "
"le paquet %s."

#: src/dictate-engine.c
msgid ""
"There is no speech model. Install a vibeos-dictate language package, such as "
"vibeos-dictate-en."
msgstr ""
"Il n'y a aucun modèle de reconnaissance vocale. Installez un paquet de "
"langue vibeos-dictate, par exemple vibeos-dictate-en."

#. TRANSLATORS: %s is the package's name (vibeos-dictate-moonshine)
#: src/dictate-engine.c
#, c-format
msgid "Speech recognition is not installed. Install the %s package."
msgstr "La reconnaissance vocale n'est pas installée. Installez le paquet %s."

#: src/dictate-engine.c
msgid "The speech model could not be loaded."
msgstr "Impossible de charger le modèle de reconnaissance vocale."

#: src/dictate-engine.c
msgid "Speech recognition could not be started."
msgstr "Impossible de démarrer la reconnaissance vocale."

#: src/dictate-engine.c
msgid "The microphone could not be opened."
msgstr "Impossible d'ouvrir le microphone."

#: src/dictate-enroll.c
msgid ""
"Vibe, what time is it now? I'm teaching you how my voice sounds, so that you "
"only listen to me."
msgstr ""
"Vibe, quelle heure est-il ? Je t'apprends à reconnaître ma voix, pour que tu "
"n'écoutes que moi."

#: src/dictate-enroll.c
msgid ""
"Read my new messages out loud, then tell me what is on my calendar for "
"tomorrow morning."
msgstr ""
"Lis mes nouveaux messages à voix haute, puis dis-moi ce qu'il y a dans mon "
"agenda demain matin."

#: src/dictate-enroll.c
msgid ""
"Call my sister on her mobile, and set an alarm for seven thirty tomorrow."
msgstr ""
"Appelle ma sœur sur son portable et mets un réveil demain à sept heures et "
"demie."

#: src/dictate-enroll.c
msgid "What's the time? Call Anna. Set a timer."
msgstr "Quelle heure est-il ? Appelle Anna. Mets un minuteur."

#. TRANSLATORS: a phrase to read aloud, in quotation marks
#. TRANSLATORS: a thing to say to Vibe, in quotation marks
#: src/dictate-enroll.c src/dictate-onboarding.c
#, c-format
msgid "“%s”"
msgstr "« %s »"

#: src/dictate-enroll.c
msgid "Vibe says · repeat after me"
msgstr "Vibe dit · répétez après moi"

#. while Vibe says it, the microphone opens when it is done
#: src/dictate-enroll.c
msgid "Tap anywhere and read it again"
msgstr "Appuyez n'importe où et relisez-la"

#: src/dictate-enroll.c
msgid "Tap anywhere, then read the phrase"
msgstr "Appuyez n'importe où, puis lisez la phrase"

#: src/dictate-enroll.c src/dictate-onboarding.c src/dictate-stage.c
#: src/dictate-window.c
msgid "Vibe says"
msgstr "Vibe dit"

#: src/dictate-enroll.c
msgid "I can't listen right now."
msgstr "Je ne peux pas écouter pour l'instant."

#: src/dictate-enroll.c
msgid "Tap anywhere to go back"
msgstr "Appuyez n'importe où pour revenir"

#: src/dictate-enroll.c src/dictate-window.c
msgid "Listening"
msgstr "À l'écoute"

#: src/dictate-enroll.c
msgid "Go ahead…"
msgstr "Allez-y…"

#: src/dictate-enroll.c
msgid "Say any command."
msgstr "Dites n'importe quelle commande."

#. TRANSLATORS: over the phrase being read: listening to phrase 2 of 4
#: src/dictate-enroll.c
#, c-format
msgid "Listening · phrase %u of %u"
msgstr "À l'écoute · phrase %u sur %u"

#: src/dictate-enroll.c
msgid "Read the phrase at your normal pace"
msgstr "Lisez la phrase à votre rythme habituel"

#: src/dictate-enroll.c
msgid "Tap anywhere, or just start talking"
msgstr "Appuyez n'importe où ou commencez simplement à parler"

#: src/dictate-enroll.c
msgid "Voice Match is not ready yet."
msgstr "L'identification vocale n'est pas encore prête."

#: src/dictate-enroll.c
msgid "Your recordings were not kept, and nothing changed on the phone."
msgstr ""
"Vos enregistrements n'ont pas été conservés, et rien n'a changé sur le "
"téléphone."

#: src/dictate-enroll.c
msgid "I couldn't keep your voice sample."
msgstr "Je n'ai pas pu conserver votre échantillon vocal."

#: src/dictate-enroll.c
msgid "Done"
msgstr "Terminé"

#: src/dictate-enroll.c
msgid "That's all I need."
msgstr "C'est tout ce qu'il me faut."

#: src/dictate-enroll.c
msgid "Voice match is on. Say any command to test it. Nothing is carried out."
msgstr ""
"L'identification vocale est activée. Dites une commande pour la tester. Rien "
"ne sera exécuté."

#: src/dictate-enroll.c
msgid "Tap anywhere, then speak"
msgstr "Appuyez n'importe où, puis parlez"

#: src/dictate-enroll.c src/dictate-window.c
msgid "Tap anywhere to try again"
msgstr "Appuyez n'importe où pour réessayer"

#: src/dictate-enroll.c
msgid "Say a bit more."
msgstr "Parlez un peu plus longtemps."

#: src/dictate-enroll.c
msgid "That was too short to tell whose voice it is."
msgstr "C'était trop court pour savoir à qui appartient la voix."

#: src/dictate-enroll.c
msgid "I couldn't check that."
msgstr "Je n'ai pas pu vérifier."

#. TRANSLATORS: a voice check's result: 88% match, 75% needed
#: src/dictate-enroll.c
