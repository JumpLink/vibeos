#. TRANSLATORS: under a language in the list; %s is a speech recogniser (Vosk)
#: src/dictate-download-dialog.c
#, c-format
msgid "Needs %s, which is not installed"
msgstr "Braucht %s, das nicht installiert ist"

#: src/dictate-download-dialog.c
msgid "Not available on this phone"
msgstr "Auf diesem Telefon nicht verfügbar"

#. TRANSLATORS: under a language in the list; the first %s is a speech recogniser (Vosk), the second a size
#: src/dictate-download-dialog.c
#, c-format
msgid "%s and %s to download"
msgstr "%s und %s zum Herunterladen"

#. TRANSLATORS: under a language in the list; %s is a speech recogniser (Vosk)
#: src/dictate-download-dialog.c
#, c-format
msgid "%s to install"
msgstr "%s zum Installieren"

#. TRANSLATORS: under a language in the list; %s is a size: 90.4 MB
#: src/dictate-download-dialog.c
#, c-format
msgid "%s to download"
msgstr "%s zum Herunterladen"

#. TRANSLATORS: a dialog's title; %s is the language's name for itself (Deutsch)
#: src/dictate-download-dialog.c
#, c-format
msgid "%s was not downloaded"
msgstr "%s wurde nicht heruntergeladen"

#. TRANSLATORS: the first %s is what went wrong, the second a speech recogniser (Vosk)
#: src/dictate-download-dialog.c
#, c-format
msgid "%s. %s was installed, but none of the files were kept on the phone."
msgstr ""
"%s. %s wurde installiert, aber keine der Dateien blieb auf dem Telefon."

#. TRANSLATORS: %s is what went wrong
#: src/dictate-download-dialog.c
#, c-format
msgid "%s. Nothing of it was kept on the phone."
msgstr "%s. Nichts davon blieb auf dem Telefon."

#. TRANSLATORS: said aloud while a language downloads; %s is its name for itself (Deutsch)
#: src/dictate-download-dialog.c
#, c-format
msgid "Downloading %s: a quarter done."
msgstr "%s wird geladen: ein Viertel ist geschafft."

#. TRANSLATORS: said aloud while a language downloads; %s is its name for itself (Deutsch)
#: src/dictate-download-dialog.c
#, c-format
msgid "Downloading %s: half done."
msgstr "%s wird geladen: die Hälfte ist geschafft."

#. TRANSLATORS: said aloud while a language downloads; %s is its name for itself (Deutsch)
#: src/dictate-download-dialog.c
#, c-format
msgid "Downloading %s: three quarters done."
msgstr "%s wird geladen: drei Viertel sind geschafft."

#. TRANSLATORS: the progress, two sizes: 12.3 MB of 90.4 MB
#: src/dictate-download-dialog.c
#, c-format
msgid "%s of %s"
msgstr "%s von %s"

#: src/dictate-download-dialog.c
msgid "Unpacking and installing…"
msgstr "Wird entpackt und installiert…"

#: src/dictate-download-dialog.c
msgid "Installing…"
msgstr "Wird installiert…"

#: src/dictate-download-dialog.c
msgid "Voice"
msgstr "Stimme"

#: src/dictate-download-dialog.c
msgid "Speech recognition"
msgstr "Spracherkennung"

#: src/dictate-download-dialog.c
msgid "The files came, but the language is still not ready"
msgstr "Die Dateien sind da, aber die Sprache ist noch nicht bereit"

#. TRANSLATORS: in the progress dialog; %s is a speech recogniser (Vosk)
#. TRANSLATORS: what is installed, in the download dialog; %s is a speech recogniser (Vosk)
#: src/dictate-download-dialog.c
#, c-format
msgid "%s speech recogniser"
msgstr "Spracherkennung %s"

#. TRANSLATORS: a dialog's title; %s is the language's name for itself (Deutsch)
#: src/dictate-download-dialog.c
#, c-format
msgid "Downloading %s"
msgstr "%s wird heruntergeladen"

#: src/dictate-download-dialog.c
msgid "The package was installed, but the language is still not ready"
msgstr "Das Paket ist installiert, aber die Sprache ist noch nicht bereit"

#. TRANSLATORS: the sum of the sizes in the download dialog; %s is a size: 90.4 MB
#: src/dictate-download-dialog.c
#, c-format
msgid "%s in all"
msgstr "%s insgesamt"

#. TRANSLATORS: a dialog's title; %s is the language's name for itself (Deutsch)
#: src/dictate-download-dialog.c
#, c-format
msgid "Download %s?"
msgstr "%s herunterladen?"

#. TRANSLATORS: under the title "Download Deutsch?"; %s is an app's name (Navi)
#: src/dictate-download-dialog.c
#, c-format
msgid "To speak this language, %s needs this on the phone:"
msgstr "Um diese Sprache zu sprechen, braucht %s Folgendes auf dem Telefon:"

#. TRANSLATORS: under the title "Download Deutsch?"
#: src/dictate-download-dialog.c
msgid "To hear and speak this language, Vibe needs these on the phone:"
msgstr ""
"Um diese Sprache zu hören und zu sprechen, braucht Vibe Folgendes auf dem "
"Telefon:"

#. TRANSLATORS: under the title "Download Deutsch?"
#: src/dictate-download-dialog.c
msgid "To hear this language, Dictate needs these on the phone:"
msgstr ""
"Um diese Sprache zu hören, braucht Diktieren Folgendes auf dem Telefon:"

#. TRANSLATORS: under it; %s is its Debian package (vibeos-dictate-vosk)
#: src/dictate-download-dialog.c
#, c-format
msgid "the %s package from the VibeOS archive"
msgstr "das Paket %s aus dem VibeOS-Archiv"

#. TRANSLATORS: under what is downloaded: what it is, its licence and where it comes from
#: src/dictate-download-dialog.c
#, c-format
msgid "%s · %s · from %s"
msgstr "%s · %s · von %s"

#: src/dictate-download-dialog.c
msgid "Download"
msgstr "Herunterladen"

#. TRANSLATORS: a dialog's title; %s is the language's name for itself (Français)
#. TRANSLATORS: a dialog's title; %s is the language's name for itself
#: src/dictate-download-dialog.c
#, c-format
msgid "%s is not available"
msgstr "%s ist nicht verfügbar"

#. TRANSLATORS: the first %s is the language's name for itself, the second a speech recogniser (Vosk), the
#. * third its Debian package (vibeos-dictate-vosk)
#: src/dictate-download-dialog.c
#, c-format
msgid ""
"%s is heard by %s, which is not installed on this phone. Install the %s "
"package, then choose %s again."
msgstr ""
"%s wird von %s erkannt, das auf diesem Telefon nicht installiert ist. "
"Installiere das Paket %s und wähle dann noch einmal %s."

#: src/dictate-download-dialog.c
msgid "OK"
msgstr "OK"

#: src/dictate-download-dialog.c
msgid "There is nothing to download for it."
msgstr "Dafür gibt es nichts herunterzuladen."

#. TRANSLATORS: %s is what went wrong, from the network or the file system
#: src/dictate-download.c
#, c-format
msgid "The download failed: %s"
msgstr "Das Herunterladen ist fehlgeschlagen: %s"

#. TRANSLATORS: %s is what went wrong
#: src/dictate-download.c
#, c-format
msgid "The files could not be put in place: %s"
msgstr "Die Dateien konnten nicht an ihren Platz gelegt werden: %s"

#. TRANSLATORS: %s is a file's name
#: src/dictate-download.c
#, c-format
msgid "%s did not come whole"
msgstr "%s kam nicht vollständig an"

#. TRANSLATORS: %s is a file's name
#: src/dictate-download.c
#, c-format
msgid "%s is not the file it should be: its checksum does not match"
msgstr "%s ist nicht die erwartete Datei: die Prüfsumme stimmt nicht"

#. TRANSLATORS: %s is a file's name
#: src/dictate-download.c
#, c-format
msgid "%s is larger than it should be"
msgstr "%s ist größer als erwartet"

#. TRANSLATORS: %s is a file's name, %u and the last %s the server's answer (404, Not Found)
#: src/dictate-download.c
#, c-format
msgid "The server did not give %s: %u %s"
msgstr "Der Server hat %s nicht geliefert: %u %s"

#. TRANSLATORS: %s is a file's name
#: src/dictate-download.c
#, c-format
msgid "%s is not the size it should be: it has changed on the server"
msgstr ""
"%s hat nicht die erwartete Größe: die Datei hat sich auf dem Server geändert"

#. TRANSLATORS: the %s are sizes: 90.4 MB
#: src/dictate-download.c
#, c-format
msgid "There is not enough space on the phone: %s are needed, %s are free"
msgstr ""
"Auf dem Telefon ist nicht genug Platz: %s werden gebraucht, %s sind frei"

#. TRANSLATORS: the first %s is the language's name for itself (Deutsch), the second the package's name
#. * (vibeos-dictate-de)
#: src/dictate-engine.c
#, c-format
msgid "There is no speech model for %s. Install the %s package."
msgstr "Für %s gibt es kein Spracherkennungsmodell. Installiere das Paket %s."

#: src/dictate-engine.c
msgid ""
"There is no speech model. Install a vibeos-dictate language package, such as "
"vibeos-dictate-en."
msgstr ""
"Es gibt kein Spracherkennungsmodell. Installiere ein vibeos-dictate-"
"Sprachpaket, zum Beispiel vibeos-dictate-en."

#. TRANSLATORS: %s is the package's name (vibeos-dictate-moonshine)
#: src/dictate-engine.c
#, c-format
msgid "Speech recognition is not installed. Install the %s package."
msgstr "Die Spracherkennung ist nicht installiert. Installiere das Paket %s."

#: src/dictate-engine.c
msgid "The speech model could not be loaded."
msgstr "Das Spracherkennungsmodell konnte nicht geladen werden."

#: src/dictate-engine.c
msgid "Speech recognition could not be started."
msgstr "Die Spracherkennung konnte nicht gestartet werden."

#: src/dictate-engine.c
msgid "The microphone could not be opened."
msgstr "Das Mikrofon konnte nicht geöffnet werden."

#: src/dictate-enroll.c
msgid ""
"Vibe, what time is it now? I'm teaching you how my voice sounds, so that you "
"only listen to me."
msgstr ""
"Vibe, wie spät ist es jetzt? Ich bringe dir bei, wie meine Stimme klingt, "
"damit du nur auf mich hörst."

#: src/dictate-enroll.c
msgid ""
"Read my new messages out loud, then tell me what is on my calendar for "
"tomorrow morning."
msgstr ""
"Lies mir meine neuen Nachrichten vor und sag mir dann, was morgen früh in "
"meinem Kalender steht."

#: src/dictate-enroll.c
msgid ""
"Call my sister on her mobile, and set an alarm for seven thirty tomorrow."
msgstr ""
"Ruf meine Schwester auf dem Handy an und stell einen Wecker für morgen um "
"halb acht."

#: src/dictate-enroll.c
msgid "What's the time? Call Anna. Set a timer."
msgstr "Wie spät ist es? Ruf Anna an. Stell einen Timer."

#. TRANSLATORS: a phrase to read aloud, in quotation marks
#. TRANSLATORS: a thing to say to Vibe, in quotation marks
#: src/dictate-enroll.c src/dictate-onboarding.c
#, c-format
msgid "“%s”"
msgstr "„%s“"

#: src/dictate-enroll.c
msgid "Vibe says · repeat after me"
msgstr "Vibe sagt · sprich mir nach"

#. while Vibe says it, the microphone opens when it is done
#: src/dictate-enroll.c
msgid "Tap anywhere and read it again"
msgstr "Tippe irgendwo und lies ihn noch einmal"

#: src/dictate-enroll.c
msgid "Tap anywhere, then read the phrase"
msgstr "Tippe irgendwo und lies dann den Satz"

#: src/dictate-enroll.c src/dictate-onboarding.c src/dictate-stage.c
#: src/dictate-window.c
msgid "Vibe says"
msgstr "Vibe sagt"

#: src/dictate-enroll.c
msgid "I can't listen right now."
msgstr "Ich kann gerade nicht zuhören."

#: src/dictate-enroll.c
msgid "Tap anywhere to go back"
msgstr "Tippe irgendwo, um zurückzugehen"

#: src/dictate-enroll.c src/dictate-window.c
msgid "Listening"
msgstr "Hört zu"

#: src/dictate-enroll.c
msgid "Go ahead…"
msgstr "Leg los…"

#: src/dictate-enroll.c
msgid "Say any command."
msgstr "Sag einen beliebigen Befehl."

#. TRANSLATORS: over the phrase being read: listening to phrase 2 of 4
#: src/dictate-enroll.c
#, c-format
msgid "Listening · phrase %u of %u"
msgstr "Hört zu · Satz %u von %u"

#: src/dictate-enroll.c
msgid "Read the phrase at your normal pace"
msgstr "Lies den Satz in deinem normalen Tempo"

#: src/dictate-enroll.c
msgid "Tap anywhere, or just start talking"
msgstr "Tippe irgendwo oder fang einfach an zu sprechen"

#: src/dictate-enroll.c
msgid "Voice Match is not ready yet."
msgstr "Die Stimmerkennung ist noch nicht bereit."

#: src/dictate-enroll.c
msgid "Your recordings were not kept, and nothing changed on the phone."
msgstr ""
"Deine Aufnahmen wurden nicht gespeichert, und am Telefon hat sich nichts "
"geändert."

#: src/dictate-enroll.c
msgid "I couldn't keep your voice sample."
msgstr "Ich konnte deine Stimmprobe nicht speichern."

#: src/dictate-enroll.c
msgid "Done"
msgstr "Fertig"

#: src/dictate-enroll.c
msgid "That's all I need."
msgstr "Mehr brauche ich nicht."

#: src/dictate-enroll.c
msgid "Voice match is on. Say any command to test it. Nothing is carried out."
msgstr ""
"Die Stimmerkennung ist an. Sag einen beliebigen Befehl, um sie zu testen. Es "
"wird nichts ausgeführt."

#: src/dictate-enroll.c
msgid "Tap anywhere, then speak"
msgstr "Tippe irgendwo und sprich dann"

#: src/dictate-enroll.c src/dictate-window.c
msgid "Tap anywhere to try again"
msgstr "Tippe irgendwo, um es noch mal zu versuchen"

#: src/dictate-enroll.c
msgid "Say a bit more."
msgstr "Sag ein bisschen mehr."

#: src/dictate-enroll.c
msgid "That was too short to tell whose voice it is."
msgstr "Das war zu kurz, um zu erkennen, wessen Stimme es ist."

#: src/dictate-enroll.c
msgid "I couldn't check that."
msgstr "Das konnte ich nicht prüfen."

#. TRANSLATORS: a voice check's result: 88% match, 75% needed
#: src/dictate-enroll.c
#, c-format
msgid "%.0f%% match, %.0f%% needed. Vibe would carry out the command."
msgstr ""
"%.0f %% Übereinstimmung, %.0f %% nötig. Vibe würde den Befehl ausführen."

#: src/dictate-enroll.c
msgid "That's you."
msgstr "Das bist du."

#. TRANSLATORS: a voice check's result: 41% match, 75% needed
#: src/dictate-enroll.c
#, c-format
msgid "%.0f%% match, %.0f%% needed. Vibe would not carry out the command."
msgstr ""
"%.0f %% Übereinstimmung, %.0f %% nötig. Vibe würde den Befehl nicht "
"ausführen."

#: src/dictate-enroll.c
msgid "That didn't sound like you."
