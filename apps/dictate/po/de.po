#: src/dictate-debuglog-page.c
#, no-c-format
msgid "%e %b, %H:%M"
msgstr "%e. %b, %H:%M"

#. TRANSLATORS: a turn in the debug log; %u is how many tools it called
#: src/dictate-debuglog-page.c
#, c-format
msgid "%u tool"
msgid_plural "%u tools"
msgstr[0] "%u Werkzeug"
msgstr[1] "%u Werkzeuge"

#: src/dictate-debuglog-page.c
msgid "(nothing said)"
msgstr "(nichts gesagt)"

#: src/dictate-debuglog-page.c
