msgstr "Для языка %s нет речевой модели. Установите пакет %s."

#: src/dictate-engine.c
msgid ""
"There is no speech model. Install a vibeos-dictate language package, such as "
"vibeos-dictate-en."
msgstr ""
"Нет речевой модели. Установите языковой пакет vibeos-dictate, например "
"vibeos-dictate-en."

#. TRANSLATORS: %s is the package's name (vibeos-dictate-moonshine)
#: src/dictate-engine.c
#, c-format
