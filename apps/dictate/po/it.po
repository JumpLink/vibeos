msgstr "%s · %s · da %s"

# android: Messaging action_download (short)
#: src/dictate-download-dialog.c
msgid "Download"
msgstr "Scarica"

#. TRANSLATORS: a dialog's title; %s is the language's name for itself (Français)
#. TRANSLATORS: a dialog's title; %s is the language's name for itself
#: src/dictate-download-dialog.c
#, c-format
msgid "%s is not available"
msgstr "%s non è disponibile"

#. TRANSLATORS: the first %s is the language's name for itself, the second a speech recogniser (Vosk), the
#. * third its Debian package (vibeos-dictate-vosk)
#: src/dictate-download-dialog.c
#, c-format
msgid ""
"%s is heard by %s, which is not installed on this phone. Install the %s "
"package, then choose %s again."
msgstr ""
"%s viene riconosciuto da %s, che non è installato su questo telefono. "
"Installa il pacchetto %s, poi scegli di nuovo %s."

# android: Framework httpErrorOk (several translations, short)
#: src/dictate-download-dialog.c
msgid "OK"
msgstr "OK"

#: src/dictate-download-dialog.c
msgid "There is nothing to download for it."
msgstr "Non c'è niente da scaricare per questa lingua."

#. TRANSLATORS: %s is what went wrong, from the network or the file system
#: src/dictate-download.c
#, c-format
msgid "The download failed: %s"
msgstr "Download non riuscito: %s"

#. TRANSLATORS: %s is what went wrong
#: src/dictate-download.c
#, c-format
msgid "The files could not be put in place: %s"
msgstr "Impossibile sistemare i file: %s"

#. TRANSLATORS: %s is a file's name
#: src/dictate-download.c
#, c-format
msgid "%s did not come whole"
msgstr "%s non è arrivato completo"

#. TRANSLATORS: %s is a file's name
#: src/dictate-download.c
#, c-format
msgid "%s is not the file it should be: its checksum does not match"
msgstr "%s non è il file previsto: il checksum non corrisponde"

#. TRANSLATORS: %s is a file's name
#: src/dictate-download.c
#, c-format
msgid "%s is larger than it should be"
msgstr "%s è più grande del previsto"

#. TRANSLATORS: %s is a file's name, %u and the last %s the server's answer (404, Not Found)
#: src/dictate-download.c
#, c-format
msgid "The server did not give %s: %u %s"
msgstr "Il server non ha fornito %s: %u %s"

#. TRANSLATORS: %s is a file's name
#: src/dictate-download.c
#, c-format
msgid "%s is not the size it should be: it has changed on the server"
msgstr "%s non ha la dimensione prevista: è cambiato sul server"

#. TRANSLATORS: the %s are sizes: 90.4 MB
#: src/dictate-download.c
#, c-format
msgid "There is not enough space on the phone: %s are needed, %s are free"
msgstr "Spazio insufficiente sul telefono: servono %s, liberi %s"

#. TRANSLATORS: the first %s is the language's name for itself (Deutsch), the second the package's name
#. * (vibeos-dictate-de)
#: src/dictate-engine.c
#, c-format
msgid "There is no speech model for %s. Install the %s package."
msgstr ""
"Non c'è un modello di riconoscimento vocale per la lingua %s. Installa il "
"pacchetto %s."

#: src/dictate-engine.c
msgid ""
"There is no speech model. Install a vibeos-dictate language package, such as "
"vibeos-dictate-en."
msgstr ""
"Non c'è nessun modello di riconoscimento vocale. Installa un pacchetto "
"lingua vibeos-dictate, ad esempio vibeos-dictate-en."

#. TRANSLATORS: %s is the package's name (vibeos-dictate-moonshine)
#: src/dictate-engine.c
#, c-format
msgid "Speech recognition is not installed. Install the %s package."
msgstr "Il riconoscimento vocale non è installato. Installa il pacchetto %s."

#: src/dictate-engine.c
msgid "The speech model could not be loaded."
msgstr "Impossibile caricare il modello di riconoscimento vocale."

#: src/dictate-engine.c
msgid "Speech recognition could not be started."
msgstr "Impossibile avviare il riconoscimento vocale."

#: src/dictate-engine.c
msgid "The microphone could not be opened."
msgstr "Impossibile aprire il microfono."

#: src/dictate-enroll.c
msgid ""
"Vibe, what time is it now? I'm teaching you how my voice sounds, so that you "
"only listen to me."
msgstr ""
"Vibe, che ore sono adesso? Ti sto insegnando com'è la mia voce, così ascolti "
"solo me."

#: src/dictate-enroll.c
msgid ""
"Read my new messages out loud, then tell me what is on my calendar for "
"tomorrow morning."
msgstr ""
"Leggi ad alta voce i miei nuovi messaggi, poi dimmi cosa c'è nel mio "
"calendario domani mattina."

#: src/dictate-enroll.c
msgid ""
"Call my sister on her mobile, and set an alarm for seven thirty tomorrow."
msgstr ""
"Chiama mia sorella sul cellulare e metti una sveglia per domani alle sette e "
"mezza."

#: src/dictate-enroll.c
msgid "What's the time? Call Anna. Set a timer."
msgstr "Che ore sono? Chiama Anna. Imposta un timer."

#. TRANSLATORS: a phrase to read aloud, in quotation marks
#. TRANSLATORS: a thing to say to Vibe, in quotation marks
#: src/dictate-enroll.c src/dictate-onboarding.c
#, c-format
msgid "“%s”"
msgstr "«%s»"

#: src/dictate-enroll.c
msgid "Vibe says · repeat after me"
msgstr "Vibe dice · ripeti dopo di me"

#. while Vibe says it, the microphone opens when it is done
#: src/dictate-enroll.c
msgid "Tap anywhere and read it again"
msgstr "Tocca ovunque e rileggila"

#: src/dictate-enroll.c
msgid "Tap anywhere, then read the phrase"
msgstr "Tocca ovunque, poi leggi la frase"

#: src/dictate-enroll.c src/dictate-onboarding.c src/dictate-stage.c
#: src/dictate-window.c
msgid "Vibe says"
msgstr "Vibe dice"

#: src/dictate-enroll.c
msgid "I can't listen right now."
msgstr "Al momento non posso ascoltare."

#: src/dictate-enroll.c
msgid "Tap anywhere to go back"
msgstr "Tocca ovunque per tornare indietro"

#: src/dictate-enroll.c src/dictate-window.c
msgid "Listening"
msgstr "In ascolto"

#: src/dictate-enroll.c
msgid "Go ahead…"
msgstr "Dimmi…"

#: src/dictate-enroll.c
msgid "Say any command."
msgstr "Di' un comando qualsiasi."

#. TRANSLATORS: over the phrase being read: listening to phrase 2 of 4
#: src/dictate-enroll.c
#, c-format
msgid "Listening · phrase %u of %u"
msgstr "In ascolto · frase %u di %u"

#: src/dictate-enroll.c
msgid "Read the phrase at your normal pace"
msgstr "Leggi la frase al tuo ritmo normale"

#: src/dictate-enroll.c
msgid "Tap anywhere, or just start talking"
msgstr "Tocca ovunque o inizia semplicemente a parlare"

#: src/dictate-enroll.c
msgid "Voice Match is not ready yet."
msgstr "L'identificazione vocale non è ancora pronta."

#: src/dictate-enroll.c
msgid "Your recordings were not kept, and nothing changed on the phone."
msgstr ""
"Le tue registrazioni non sono state conservate e sul telefono non è cambiato "
"nulla."

#: src/dictate-enroll.c
msgid "I couldn't keep your voice sample."
msgstr "Non ho potuto salvare il tuo campione vocale."

#: src/dictate-enroll.c
msgid "Done"
msgstr "Fatto"

#: src/dictate-enroll.c
msgid "That's all I need."
msgstr "È tutto quello che mi serve."

#: src/dictate-enroll.c
msgid "Voice match is on. Say any command to test it. Nothing is carried out."
msgstr ""
"L'identificazione vocale è attiva. Di' un comando qualsiasi per provarla. "
"Non verrà eseguito nulla."

#: src/dictate-enroll.c
msgid "Tap anywhere, then speak"
msgstr "Tocca ovunque, poi parla"

#: src/dictate-enroll.c src/dictate-window.c
msgid "Tap anywhere to try again"
msgstr "Tocca ovunque per riprovare"

#: src/dictate-enroll.c
msgid "Say a bit more."
msgstr "Di' qualcosa in più."

#: src/dictate-enroll.c
msgid "That was too short to tell whose voice it is."
msgstr "Era troppo breve per capire di chi è la voce."

#: src/dictate-enroll.c
msgid "I couldn't check that."
msgstr "Non ho potuto verificarlo."

#. TRANSLATORS: a voice check's result: 88% match, 75% needed
#: src/dictate-enroll.c
#, c-format
msgid "%.0f%% match, %.0f%% needed. Vibe would carry out the command."
msgstr ""
"Corrispondenza del %.0f%%, richiesto il %.0f%%. Vibe eseguirebbe il comando."

#: src/dictate-enroll.c
msgid "That's you."
msgstr "Sei tu."

#. TRANSLATORS: a voice check's result: 41% match, 75% needed
