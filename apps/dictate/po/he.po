#: src/dictate-window.c
msgid "“Turn on Wi-Fi” · “How's the battery?”"
msgstr "\"תפעיל Wi-Fi\" · \"מה מצב הסוללה?\""

#: src/dictate-window.c
msgid "Around me"
msgstr "בסביבה"

#: src/dictate-window.c
msgid "“Take me home” · “What's the weather?”"
msgstr "\"תנווט הביתה\" · \"מה מזג האוויר?\""

#: src/dictate-window.c
msgid "“What time is it?” · “Timer, ten minutes”"
msgstr "\"מה השעה?\" · \"טיימר, עשר דקות\""

#: src/dictate-window.c
msgid "What I just did"
msgstr "מה עשיתי עכשיו"

#: src/dictate-window.c
msgid "“Undo” · “What did you just do?”"
msgstr "\"תבטל\" · \"מה עשית עכשיו?\""

#: src/dictate-window.c
msgid "No connection · basic commands only"
msgstr "אין חיבור · רק פקודות בסיסיות"

#: src/dictate-window.c
msgid "Tap anywhere and speak, or just try a command"
msgstr "אפשר להקיש במקום כלשהו ולדבר, או פשוט לנסות פקודה"

#: src/dictate-window.c
msgid "Without my model, these still work."
msgstr "גם בלי המודל שלי, אלה עדיין עובדים."

#: src/dictate-window.c
msgid "Here are some things you can say."
msgstr "הנה כמה דברים שאפשר לומר."

#. TRANSLATORS: what the button asks Vibe, as if said
#: src/dictate-window.c
msgctxt "vibe asked"
msgid "What can I do?"
msgstr "מה אפשר לעשות?"

#. TRANSLATORS: what a user says to hear what Vibe can do, alternatives separated by "|", lower case, without
#. * punctuation; only the whole sentence counts
#: src/dictate-window.c
msgid "what can i say|what can you do|what can i ask|help"
msgstr ""
"מה אפשר לעשות|מה אפשר לומר|מה אפשר להגיד|מה אפשר לשאול|מה אתה יודע לעשות|מה "
"אתה יכול לעשות|עזרה"

