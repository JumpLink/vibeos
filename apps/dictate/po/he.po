#. TRANSLATORS: the date under Vibe's greeting, a g_date_time_format () string: "Tuesday 24 November"
#: src/dictate-window.c
msgid "%A %e %B"
msgstr "%A, %e ב%B"

#. TRANSLATORS: over "I'm keeping quiet."; %s is when the quiet hours end: 07:00
#: src/dictate-window.c
#, c-format
msgid "Quiet hours · until %s"
msgstr "שעות שקטות · עד %s"

#: src/dictate-window.c
msgid "I'm keeping quiet."
msgstr "אני שומר על שקט."

#: src/dictate-window.c
msgid ""
"I won't speak or play sounds on my own. Calls are still announced. Ask me "
"anything and I'll answer."
msgstr ""
"אני לא מדבר ולא משמיע צלילים מיוזמתי. עדיין מתבצעת הכרזה על שיחות. אפשר "
"לשאול אותי כל דבר, ואענה."

#: src/dictate-window.c
msgid ""
"I won't speak or play sounds on my own. Ask me anything and I'll answer."
msgstr "אני לא מדבר ולא משמיע צלילים מיוזמתי. אפשר לשאול אותי כל דבר, ואענה."

#: src/dictate-window.c
msgid "Good evening."
msgstr "ערב טוב."

#: src/dictate-window.c
msgid "Good morning."
msgstr "בוקר טוב."

#: src/dictate-window.c
msgid "Good afternoon."
msgstr "צהריים טובים."

#: src/dictate-window.c
msgid "Say “answer” or “decline”"
msgstr "אפשר לומר \"מענה\" או \"דחייה\""

#: src/dictate-window.c
msgid "Release the side button when you have finished"
msgstr "בסיום, יש לשחרר את הלחצן שבצד"

#: src/dictate-window.c
msgid "Listening for your answer…"
msgstr "מקשיב לתשובה שלך…"

#: src/dictate-window.c
msgid "Tap to stop"
msgstr "אפשר להקיש כדי לעצור"

#: src/dictate-window.c
msgid "Hold the phone a little closer, or speak up."
msgstr "כדאי להחזיק את הטלפון קצת יותר קרוב, או לדבר חזק יותר."

#: src/dictate-window.c
msgid "I can't check your voice right now."
msgstr "אני לא יכול לבדוק את הקול שלך כרגע."

#: src/dictate-window.c
msgid ""
"Voice match was updated since your voice was recorded. Record it again and I "
"can check it."
msgstr ""
"Voice Match עודכן מאז שהקול שלך הוקלט. אחרי הקלטה חוזרת אוכל לבדוק אותו."

#: src/dictate-window.c
msgid ""
"The voice model is not installed any more, so I can't tell your voice from "
"anyone else's."
msgstr ""
"מודל הקול כבר לא מותקן, ולכן אני לא יכול להבחין בין הקול שלך לקולות אחרים."

#. the model is there and the sample made for it, and the check failed to run
#: src/dictate-window.c
msgid ""
"Voice match couldn't run just now, so I can't tell your voice from anyone "
"else's."
msgstr ""
"לא ניתן היה להפעיל את Voice Match עכשיו, ולכן אני לא יכול להבחין בין הקול "
"שלך לקולות אחרים."

#: src/dictate-window.c
msgid "Use PIN instead"
msgstr "שימוש בקוד אימות במקום זאת"

#: src/dictate-window.c
msgid "Unlock with PIN instead"
msgstr "ביטול הנעילה באמצעות קוד אימות במקום זאת"

#: src/dictate-window.c
msgid "Until voices can be checked, commands like this one need your PIN"
msgstr "עד שאפשר יהיה לבדוק קולות, פקודות כמו זו דורשות את קוד האימות שלך"

#: src/dictate-window.c
msgid "Until voices can be checked, commands like this one are not carried out"
msgstr "עד שאפשר יהיה לבדוק קולות, פקודות כמו זו לא מבוצעות"

#: src/dictate-window.c
msgid "Third try not recognised"
msgstr "גם הניסיון השלישי לא זוהה"

#: src/dictate-window.c
msgid "Has your voice changed?"
msgstr "האם הקול שלך השתנה?"

#: src/dictate-window.c
msgid ""
"A cold or a new microphone can do that. Enter your PIN and I'll learn it "
"again."
msgstr ""
"הצטננות או מיקרופון חדש יכולים לגרום לזה. אחרי הזנת קוד האימות אלמד אותו "
"מחדש."

#: src/dictate-window.c
msgid ""
"A cold or a new microphone can do that. Record your voice again and I'll "
"learn it."
msgstr ""
"הצטננות או מיקרופון חדש יכולים לגרום לזה. אחרי הקלטה חוזרת של הקול שלך אלמד "
"אותו מחדש."

# android: Framework autofill_save_notnow (short)
#: src/dictate-window.c
msgid "Not now"
msgstr "לא עכשיו"

# android: Framework kg_pin_instructions (several translations, short)
#: src/dictate-window.c
msgid "Enter PIN"
msgstr "יש להזין קוד אימות"

#: src/dictate-window.c
msgid "Until then, commands in this voice are not carried out"
msgstr "עד אז, פקודות בקול הזה לא מבוצעות"

#: src/dictate-window.c
msgid "That didn't sound like my owner."
msgstr "זה לא נשמע כמו הבעלים שלי."

#: src/dictate-window.c
msgid ""
"I only take commands from the voice I was taught. Try again, closer to the "
"phone."
msgstr ""
"אני מקבל פקודות רק מהקול שלימדו אותי. אפשר לנסות שוב, קרוב יותר לטלפון."

#: src/dictate-window.c
msgid "Leave it off"
msgstr "להשאיר כבוי"

