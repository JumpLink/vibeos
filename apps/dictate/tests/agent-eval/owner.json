{
  "about": "Agent's everyday test set (agent-eval): what a phone's owner asks most, in English and German, on the private phone of cases.json (its made-up \"phone\"). A turn with \"gap\" asks for something no tool does yet: it must say plainly that it can't, and claim nothing done; scored apart by score-owner.py.",
  "phone_from": "cases.json",
  "cases": [
    { "id": "o-calls-today", "lang": "en", "turns": [ { "say": "Who called me today?", "tools": ["get_recent_calls"], "allowed": ["find_contacts", "get_time"], "reply_any": ["Anna"] } ] },
    { "id": "o-anna-texted", "lang": "en", "turns": [ { "say": "Did Anna text me?", "tools": ["get_messages"], "allowed": ["find_contacts"], "reply_any": ["yes", "Anna"] } ] },
