[Desktop Entry]
Type=Application
Name=Files
Comment=Browse the phone's files and the servers on your network
Exec=neo-files %U
Icon=neo.Files
Terminal=false
StartupNotify=false
DBusActivatable=true
Categories=System;FileTools;FileManager;GTK;
Keywords=Files;Folders;File Manager;Browse;SMB;Samba;SFTP;FTP;WebDAV;Network;Recycle Bin;Trash;
# a folder opened with the app is browsed; a file's folder is shown
MimeType=inode/directory;
X-Purism-FormFactor=Workstation;Mobile;
