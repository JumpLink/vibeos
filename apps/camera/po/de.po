msgstr "Keine Kamera mit Videounterstützung vorhanden."

# android: Aperture thermal_status_moderate
#: src/cam-window.c
msgid "Moderate thermal throttling, make sure the device isn't under direct sunlight."
msgstr "Mäßige thermische Drosselung; achte darauf, dass das Gerät nicht direkter Sonneneinstrahlung ausgesetzt ist."

# android: Aperture thermal_status_severe
#: src/cam-window.c
msgid "Severe thermal throttling, it is recommended to let the device cool down a bit."
msgstr "Starke thermische Drosselung; es wird empfohlen, das Gerät etwas abkühlen zu lassen."

# android: Aperture thermal_status_critical
#: src/cam-window.c
msgid "Critical thermal throttling, the app might be closed soon."
msgstr "Kritische thermische Drosselung; die App wird möglicherweise bald geschlossen."

# android: Aperture thermal_status_emergency
#: src/cam-window.c
msgid "Emergency thermal throttling, the app will close now."
msgstr "Thermische Notdrosselung; die App wird jetzt geschlossen."

# android: Aperture thermal_status_shutdown
#: src/cam-window.c
msgid "Shutdown thermal throttling, the device will power off."
msgstr "Abschaltung wegen thermischer Drosselung; das Gerät wird ausgeschaltet."

# android: Aperture save_location_toast
#: src/cam-window.c
