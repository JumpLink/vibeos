#: src/cam-settings.c
msgid "Play a sound on capture"
msgstr "Воспроизводить звук при съемке"

# android: Aperture leveler_title
#: src/cam-settings.c
msgid "Leveler"
msgstr "Уровень"

# android: Aperture leveler_summary
#: src/cam-settings.c
