#: src/cam-settings.c
msgid "Back"
msgstr "Назад"

# android: Aperture general_header
#: src/cam-settings.c
msgid "General"
msgstr "Общие"

# android: Aperture bright_screen_title
#: src/cam-settings.c
msgid "Bright screen"
msgstr "Яркий экран"

# android: Aperture bright_screen_summary
#: src/cam-settings.c
msgid "Locks brightness to 100%"
msgstr "Фиксация яркости на 100%"

