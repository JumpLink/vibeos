#: src/cam-qr-sheet.c
msgid "Call phone number"
msgstr "Позвонить по номеру"

# android: Aperture qr_sms_title
#: src/cam-qr-sheet.c
msgid "Send a new SMS"
msgstr "Отправить новое SMS"

# android: Aperture qr_isbn_title
#: src/cam-qr-sheet.c
msgid "Lookup this ISBN"
msgstr "Найти этот ISBN"

# android: Aperture qr_product_title
#: src/cam-qr-sheet.c
msgid "Lookup product"
msgstr "Поиск товара"

# android: Aperture qr_vin_title
