#: src/cam-window.c
msgid "GRID 3x3"
msgstr "СЕТКА 3x3"

# android: Aperture grid_on_4
#: src/cam-window.c
msgid "GRID 4x4"
msgstr "СЕТКА 4x4"

# android: Aperture grid_on_goldenratio
#: src/cam-window.c
msgid "GRID φ"
msgstr "СЕТКА φ"

# android: Aperture timer_3
#: src/cam-window.c
msgid "TIMER 3s"
msgstr "ТАЙМЕР 3 сек."

# android: Aperture timer_10
#: src/cam-window.c
msgid "TIMER 10s"
msgstr "ТАЙМЕР 10 сек."

#: src/cam-window.c
msgid "TIMER OFF"
msgstr "ТАЙМЕР ВЫКЛ"

# android: Aperture video_framerate_auto
#. the camera's own rate: there is no other to choose, so AUTO and disabled, as a single option is shown
#: src/cam-window.c
msgid "AUTO FPS"
msgstr "АВТО FPS"

# android: Aperture mic_on
#: src/cam-window.c
msgid "MIC ON"
msgstr "МИКРОФОН ВКЛ"

# android: Aperture mic_off
#: src/cam-window.c
msgid "MIC OFF"
msgstr "МИКРОФОН ВЫКЛ"

# android: Aperture settings (several translations, short)
#: src/cam-window.c
msgid "SETTINGS"
msgstr "НАСТРОЙКИ"

# android: Aperture error_stream_config
#: src/cam-window.c
msgid ""
"There was an error while preparing the stream. Please report this to the "
"developers."
msgstr ""
"При подготовке потока произошла ошибка. Пожалуйста, сообщите об этом "
"разработчикам."

# android: Aperture error_camera_in_use
#: src/cam-window.c
msgid "This camera is already in use, try closing the app using it."
msgstr ""
"Эта камера уже используется, попробуйте закрыть использующее ее приложение."

# android: Aperture error_other_recoverable_error
#: src/cam-window.c
msgid "Error while setting up the session. The app will try to recover."
msgstr "Ошибка при настройке сессии. Приложение попытается восстановиться."

# android: Aperture camcorder_unsupported_toast
#: src/cam-window.c
msgid "No camera supports video recording."
msgstr "Ни одна камера не поддерживает видеозапись."

#. the measure takes seconds the first time; without a word the press looks ignored
#: src/cam-window.c
msgid "Preparing video…"
msgstr "Подготовка видео…"

#: src/cam-window.c
msgid ""
"Moderate thermal throttling, make sure the device isn't under direct "
"sunlight."
msgstr ""
"Умеренный перегрев. Убедитесь, что устройство не находится под прямыми "
"солнечными лучами."

#: src/cam-window.c
msgid ""
"Severe thermal throttling, it is recommended to let the device cool down a "
"bit."
msgstr "Сильный перегрев. Рекомендуется дать устройству немного остыть."

#: src/cam-window.c
msgid "Critical thermal throttling, the app might be closed soon."
msgstr "Критический перегрев. Приложение может скоро закрыться."

#: src/cam-window.c
msgid "Emergency thermal throttling, the app will close now."
msgstr "Опасный перегрев. Приложение будет закрыто."

#: src/cam-window.c
msgid "Shutdown thermal throttling, the device will power off."
msgstr "Перегрев. Устройство выключается."

# android: Aperture save_location_toast
#: src/cam-window.c
msgid "Location permissions not granted by the user."
msgstr "Пользователь не предоставил разрешение на доступ к местоположению."

# android: Aperture pro_button_description
#: src/cam-window.c
msgid "Pro settings"
msgstr "Профессиональные настройки"

# android: Aperture flash_button_description
#: src/cam-window.c
msgid "Flash mode"
msgstr "Режим вспышки"

#. TRANSLATORS: over the empty viewfinder while the camera is being found and opened
#: src/cam-window.c
msgid "Starting camera…"
msgstr "Запуск камеры…"

#. TRANSLATORS: over the empty viewfinder: the device has no camera, or none answered; a tap looks again
#: src/cam-window.c
msgid "No camera found"
msgstr "Камера не найдена"

#. TRANSLATORS: over the empty viewfinder: the camera system did not start in time; a tap tries again
#: src/cam-window.c
msgid "The camera is not responding"
msgstr "Камера не отвечает"
