#: src/cam-qr-sheet.c src/cam-window.c
msgid "No app available to handle this action"
msgstr "Нет приложения для обработки этого действия"

# android: Aperture qr_copy_description (several translations)
#: src/cam-qr-sheet.c
msgid "Copy to clipboard"
msgstr "Скопировать в буфер обмена"

#: src/cam-settings.c
msgid ""
"The cameras are driven by <a href=\"https://libcamera.org/\">libcamera</a>, "
"under the GNU LGPL 2.1 or later."
msgstr ""
"Камеры работают через <a href=\"https://libcamera.org/\">libcamera</a> по "
"лицензии GNU LGPL 2.1 или более поздней версии."

