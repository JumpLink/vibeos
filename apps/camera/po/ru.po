# android: Aperture location_permission_dialog_title
#: src/cam-dialogs.c
msgid "Add photo and video locations"
msgstr "Добавлять данные о местоположении к фото и видео"

# android: Aperture location_permission_dialog_description
#: src/cam-dialogs.c
msgid "Map your memories by including location metadata with each capture."
msgstr ""
"Составьте карту ваших воспоминаний, включив метаданные о местоположении в "
"каждый снимок."

# android: Aperture location_permission_dialog_later
#: src/cam-dialogs.c
msgid "Later"
msgstr "Позже"

# android: Aperture location_permission_dialog_turn_on (several translations, short)
