# android: Aperture error_stream_config
#: src/cam-window.c
msgid "There was an error while preparing the stream. Please report this to the developers."
msgstr "При підготовці потоку сталася помилка. Будь ласка, повідомте про це розробникам."

#: src/cam-window.c
msgid "This camera is already in use, try closing the app using it."
msgstr "Камера вже використовується. Спробуйте закрити додаток, який її використовує."

#: src/cam-window.c
msgid "Error while setting up the session. The app will try to recover."
msgstr "Помилка налаштування сеансу. Додаток спробує відновити роботу."

# android: Aperture camcorder_unsupported_toast
#: src/cam-window.c
msgid "No camera supports video recording."
msgstr "Жодна камера не підтримує запис відео."

#. the measure takes seconds the first time; without a word the press looks ignored
#: src/cam-window.c
msgid "Preparing video…"
msgstr "Підготовка відео…"

# android: Aperture thermal_status_moderate
#: src/cam-window.c
msgid "Moderate thermal throttling, make sure the device isn't under direct sunlight."
msgstr "Помірне сповільнення через нагрів. Переконайтесь, що пристрій не під сонцем."

# android: Aperture thermal_status_severe
#: src/cam-window.c
msgid "Severe thermal throttling, it is recommended to let the device cool down a bit."
msgstr "Сильне сповільнення через нагрів. Варто дати пристрою охолонути."

#: src/cam-window.c
msgid "Critical thermal throttling, the app might be closed soon."
msgstr "Критичне сповільнення через нагрів. Додаток невдовзі може закритися."

#: src/cam-window.c
msgid "Emergency thermal throttling, the app will close now."
msgstr "Аварійне сповільнення через нагрів. Додаток закривається."

#: src/cam-window.c
msgid "Shutdown thermal throttling, the device will power off."
msgstr "Пристрій перегрівся й буде вимкнений."

# android: Aperture save_location_toast
#: src/cam-window.c
msgid "Location permissions not granted by the user."
msgstr "Користувач не дозволив отримувати місцеперебування."

# android: Aperture pro_button_description
#: src/cam-window.c
msgid "Pro settings"
msgstr "Професійні налаштування"

# android: Aperture flash_button_description
#: src/cam-window.c
msgid "Flash mode"
msgstr "Режим спалаху"

#. TRANSLATORS: over the empty viewfinder while the camera is being found and opened
#: src/cam-window.c
msgid "Starting camera…"
msgstr "Запуск камери…"

#. TRANSLATORS: over the empty viewfinder: the device has no camera, or none answered; a tap looks again
#: src/cam-window.c
msgid "No camera found"
msgstr "Камеру не знайдено"

#. TRANSLATORS: over the empty viewfinder: the camera system did not start in time; a tap tries again
#: src/cam-window.c
msgid "The camera is not responding"
msgstr "Камера не відповідає"
