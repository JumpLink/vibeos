#: src/cam-settings.c
msgid "Save front camera photos as they appear in the preview"
msgstr ""
"Guardar las fotos de la cámara frontal como aparecen en la vista previa"

# android: Aperture video_header
#: src/cam-settings.c
msgctxt "settings"
msgid "Video"
msgstr "Vídeo"

#: src/cam-settings.c
msgid "Enable video mirroring"
msgstr "Activar efecto espejo en vídeo"

#. last, About: the camera has no ⋮ (its top corners are the flash's and the flip's), so it is here
#: src/cam-settings.c
msgid "About"
msgstr "Información"

#: src/cam-settings.c
msgid "About Camera"
msgstr "Información de Cámara"

# android: Aperture volume_buttons_title (several translations, short)
#: src/cam-settings.c
msgid "Volume buttons"
msgstr "Botones del volumen"

# android: Aperture volume_buttons_action_title
#: src/cam-settings.c
msgid "Volume buttons action"
msgstr "Acción de los botones del volumen"

# android: Aperture volume_buttons_invert_title
#: src/cam-settings.c
msgid "Invert volume buttons"
msgstr "Invertir botones del volumen"

# android: Aperture volume_buttons_invert_summary
#: src/cam-settings.c
msgid "Invert volume up and down behavior"
msgstr "Invertir el comportamiento de subir y bajar el volumen"

# android: Aperture flip_camera_button_description
#: src/cam-widgets.c src/cam-window.c
msgid "Flip camera"
msgstr "Girar cámara"

# android: Aperture video_recording_state_button_description
#: src/cam-widgets.c src/cam-window.c
msgid "Pause/resume video recording"
msgstr "Pausar/reanudar grabación de vídeo"

# android: Aperture gallery_button_description
#: src/cam-widgets.c src/cam-window.c
msgid "Gallery"
msgstr "Galería"

#: src/cam-window.c
msgid "Camera access is off. Turn it on in Settings, Security and privacy."
msgstr ""
"El acceso a la cámara está desactivado. Actívalo en Ajustes, Seguridad y "
"privacidad."

# android: Aperture force_torch_help
#: src/cam-window.c
msgid ""
"On photo mode, you can long press the flash button to switch into torch mode."
msgstr ""
"En el modo foto, puedes mantener pulsado el botón de flash para cambiar al "
"modo de linterna."

