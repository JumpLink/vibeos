#: src/cam-window.c
msgid "TIMER 3s"
msgstr "טיימר 3 שניות"

# android: Aperture timer_10
#: src/cam-window.c
msgid "TIMER 10s"
msgstr "טיימר 10 שניות"

# android: Aperture timer_off
#: src/cam-window.c
msgid "TIMER OFF"
msgstr "טיימר כבוי"

#. the camera's own rate: there is no other to choose, so AUTO and disabled, as a single option is shown
#: src/cam-window.c
msgid "AUTO FPS"
msgstr "FPS אוטומטי"

# android: Aperture mic_on
#: src/cam-window.c
msgid "MIC ON"
msgstr "מיקרופון פעיל"

# android: Aperture mic_off
#: src/cam-window.c
msgid "MIC OFF"
msgstr "מיקרופון כבוי"

# android: Aperture settings
#: src/cam-window.c
msgid "SETTINGS"
msgstr "הגדרות"

# android: Aperture error_stream_config
#: src/cam-window.c
msgid ""
"There was an error while preparing the stream. Please report this to the "
"developers."
msgstr "אירעה שגיאה בעת הכנת התזרים. נא לדווח על כך למפתחים."

#: src/cam-window.c
msgid "This camera is already in use, try closing the app using it."
msgstr "המצלמה הזו כבר בשימוש. כדאי לנסות לסגור את האפליקציה שמשתמשת בה."

#: src/cam-window.c
msgid "Error while setting up the session. The app will try to recover."
msgstr "אירעה שגיאה בהגדרת ההפעלה. האפליקציה תנסה להתאושש."

# android: Aperture camcorder_unsupported_toast
#: src/cam-window.c
msgid "No camera supports video recording."
msgstr "אין מצלמה שתומכת בהקלטת וידאו"

#. the measure takes seconds the first time; without a word the press looks ignored
#: src/cam-window.c
msgid "Preparing video…"
msgstr "הסרטון בהכנה…"

# android: Aperture thermal_status_moderate
#: src/cam-window.c
msgid ""
"Moderate thermal throttling, make sure the device isn't under direct "
"sunlight."
msgstr "האטה תרמית מתונה. יש לוודא שהמכשיר אינו חשוף לאור שמש ישירה."

# android: Aperture thermal_status_severe
#: src/cam-window.c
msgid ""
"Severe thermal throttling, it is recommended to let the device cool down a "
"bit."
msgstr "האטה תרמית חמורה. מומלץ לאפשר למכשיר להתקרר מעט."

#: src/cam-window.c
msgid "Critical thermal throttling, the app might be closed soon."
msgstr "האטה תרמית קריטית. ייתכן שהאפליקציה תיסגר בקרוב."

#: src/cam-window.c
msgid "Emergency thermal throttling, the app will close now."
msgstr "האטת חירום תרמית. האפליקציה תיסגר עכשיו."

# android: Aperture thermal_status_shutdown
#: src/cam-window.c
msgid "Shutdown thermal throttling, the device will power off."
msgstr "כיבוי עקב האטה תרמית קריטית. המכשיר יכבה."

# android: Aperture save_location_toast
#: src/cam-window.c
msgid "Location permissions not granted by the user."
msgstr "הרשאות מיקום לא ניתנו על ידי המשתמש"

# android: Aperture pro_button_description
#: src/cam-window.c
msgid "Pro settings"
msgstr "הגדרות למתקדמים"

# android: Aperture flash_button_description
#: src/cam-window.c
msgid "Flash mode"
msgstr "מצב מבזק"

#. TRANSLATORS: over the empty viewfinder while the camera is being found and opened
#: src/cam-window.c
msgid "Starting camera…"
msgstr "המצלמה מופעלת…"

#. TRANSLATORS: over the empty viewfinder: the device has no camera, or none answered; a tap looks again
#: src/cam-window.c
msgid "No camera found"
msgstr "לא נמצאה מצלמה"

#. TRANSLATORS: over the empty viewfinder: the camera system did not start in time; a tap tries again
#: src/cam-window.c
msgid "The camera is not responding"
msgstr "המצלמה לא מגיבה"
