msgctxt "settings"
msgid "Video"
msgstr "וידאו"

# android: Aperture video_mirror_mode_title
#: src/cam-settings.c
msgid "Enable video mirroring"
msgstr "הפעלת שיקוף וידאו"

#. last, About: the camera has no ⋮ (its top corners are the flash's and the flip's), so it is here
#: src/cam-settings.c
msgid "About"
msgstr "מידע על האפליקציה"

#: src/cam-settings.c
msgid "About Camera"
msgstr "מידע על המצלמה"

