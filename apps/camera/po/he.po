#: src/cam-window.c
msgid "GRID 3x3"
msgstr "רשת 3x3"

# android: Aperture grid_on_4
#: src/cam-window.c
msgid "GRID 4x4"
msgstr "רשת 4x4"

# android: Aperture grid_on_goldenratio
#: src/cam-window.c
msgid "GRID φ"
msgstr "רשת φ"

