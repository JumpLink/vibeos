msgstr "היפוך לחצני עוצמת הקול"

#: src/cam-settings.c
msgid "Invert volume up and down behavior"
msgstr "היפוך הפעולה של לחצני הגברת והנמכת עוצמת הקול"

# android: Aperture flip_camera_button_description
#: src/cam-widgets.c src/cam-window.c
msgid "Flip camera"
msgstr "החלפת מצלמה"

