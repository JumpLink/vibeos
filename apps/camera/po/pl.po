msgstr "AUTOMATYCZNE Kl/s"

# android: Aperture mic_on
#: src/cam-window.c
msgid "MIC ON"
msgstr "MIK WŁ."

# android: Aperture mic_off
#: src/cam-window.c
msgid "MIC OFF"
msgstr "MIK WYŁ."

# android: Aperture settings
#: src/cam-window.c
msgid "SETTINGS"
msgstr "USTAWIENIA"

# android: Aperture error_stream_config
#: src/cam-window.c
msgid ""
"There was an error while preparing the stream. Please report this to the "
"developers."
msgstr ""
"Wystąpił błąd podczas przygotowywania strumienia. Prosimy zgłosić go "
"programistom."

# android: Aperture error_camera_in_use
#: src/cam-window.c
msgid "This camera is already in use, try closing the app using it."
msgstr ""
"Ten aparat jest już w użyciu, spróbuj zamknąć aplikację, która go obecnie "
"używa."

# android: Aperture error_other_recoverable_error
#: src/cam-window.c
msgid "Error while setting up the session. The app will try to recover."
msgstr "Błąd podczas konfigurowania sesji. Aplikacja spróbuje odzyskać dane."

# android: Aperture camcorder_unsupported_toast
#: src/cam-window.c
msgid "No camera supports video recording."
msgstr "Żaden aparat nie obsługuje nagrywania wideo."

#. the measure takes seconds the first time; without a word the press looks ignored
#: src/cam-window.c
msgid "Preparing video…"
msgstr "Przygotowuję wideo…"

# android: Aperture thermal_status_moderate
#: src/cam-window.c
msgid ""
"Moderate thermal throttling, make sure the device isn't under direct "
"sunlight."
msgstr ""
"Umiarkowane dławienie termiczne, upewnij się, że urządzenie nie jest "
"narażone na bezpośrednie działanie promieni słonecznych."

# android: Aperture thermal_status_severe
#: src/cam-window.c
msgid ""
"Severe thermal throttling, it is recommended to let the device cool down a "
"bit."
msgstr ""
"W przypadku poważnego dławienia termicznego zaleca się zaprzestanie używania "
"urządzenia aż do jego ostygnięcia."

# android: Aperture thermal_status_critical
#: src/cam-window.c
msgid "Critical thermal throttling, the app might be closed soon."
msgstr ""
"Krytyczny dławienie termiczne, aplikacja może zostać wkrótce zamknięta."

# android: Aperture thermal_status_emergency
#: src/cam-window.c
msgid "Emergency thermal throttling, the app will close now."
msgstr "Awaryjne dławienie termiczne, aplikacja zostanie teraz zamknięta."

# android: Aperture thermal_status_shutdown
#: src/cam-window.c
msgid "Shutdown thermal throttling, the device will power off."
msgstr "Wyłączenie dławienia termicznego, urządzenie się wyłączy."

# android: Aperture save_location_toast
#: src/cam-window.c
msgid "Location permissions not granted by the user."
msgstr "Uprawnienia lokalizacji nie zostały przyznane przez użytkownika."

# android: Aperture pro_button_description
#: src/cam-window.c
msgid "Pro settings"
msgstr "Zaawansowane"

# android: Aperture flash_button_description
#: src/cam-window.c
msgid "Flash mode"
msgstr "Tryb błysku"

#. TRANSLATORS: over the empty viewfinder while the camera is being found and opened
#: src/cam-window.c
msgid "Starting camera…"
msgstr "Uruchamiam aparat…"

#. TRANSLATORS: over the empty viewfinder: the device has no camera, or none answered; a tap looks again
#: src/cam-window.c
msgid "No camera found"
msgstr "Nie znaleziono aparatu"

#. TRANSLATORS: over the empty viewfinder: the camera system did not start in time; a tap tries again
#: src/cam-window.c
msgid "The camera is not responding"
msgstr "Aparat nie odpowiada"
