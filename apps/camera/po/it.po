# android: Aperture error_camera_in_use
#: src/cam-window.c
msgid "This camera is already in use, try closing the app using it."
msgstr "Questa fotocamera è già in uso, prova a chiudere l'app che la sta usando."

# android: Aperture error_other_recoverable_error
#: src/cam-window.c
msgid "Error while setting up the session. The app will try to recover."
msgstr "Errore durante l'apertura della sessione. L'applicazione proverà a rimediare."

# android: Aperture camcorder_unsupported_toast
#: src/cam-window.c
msgid "No camera supports video recording."
msgstr "Nessuna fotocamera supporta la registrazione video."

# android: Aperture thermal_status_moderate
#: src/cam-window.c
msgid "Moderate thermal throttling, make sure the device isn't under direct sunlight."
msgstr "Moderata limitazione termica in atto, assicurarsi che il dispositivo non sia sotto la luce solare diretta."

# android: Aperture thermal_status_severe
#: src/cam-window.c
msgid "Severe thermal throttling, it is recommended to let the device cool down a bit."
msgstr "Intensa limitazione termica in atto, si consiglia di lasciare che il dispositivo si raffreddi un po'."

# android: Aperture thermal_status_critical
#: src/cam-window.c
msgid "Critical thermal throttling, the app might be closed soon."
msgstr "Critica limitazione termica in atto, l'app potrebbe venire chiusa a breve."

# android: Aperture thermal_status_emergency
#: src/cam-window.c
msgid "Emergency thermal throttling, the app will close now."
msgstr "Limitazione termica d'emergenza in atto, l'app verrà chiusa ora."

# android: Aperture thermal_status_shutdown
#: src/cam-window.c
msgid "Shutdown thermal throttling, the device will power off."
msgstr "Limitazione termica da spegnimento in atto, il dispositivo si spegnerà."

# android: Aperture save_location_toast
#: src/cam-window.c
msgid "Location permissions not granted by the user."
msgstr "Accesso sulla posizione negato dall'utente."

