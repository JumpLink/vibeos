#: src/cam-window.c
msgid "GRID 3x3"
msgstr "RASTER 3x3"

# android: Aperture grid_on_4
#: src/cam-window.c
msgid "GRID 4x4"
msgstr "RASTER 4x4"

# android: Aperture grid_on_goldenratio
#: src/cam-window.c
msgid "GRID φ"
msgstr "RASTER φ"

# android: Aperture timer_3
#: src/cam-window.c
msgid "TIMER 3s"
msgstr "TIMER 3s"

# android: Aperture timer_10
#: src/cam-window.c
msgid "TIMER 10s"
msgstr "TIMER 10s"

# android: Aperture timer_off
#: src/cam-window.c
msgid "TIMER OFF"
msgstr "TIMER UIT"

# android: Aperture video_framerate_auto
#. the camera's own rate: there is no other to choose, so AUTO and disabled, as a single option is shown
#: src/cam-window.c
msgid "AUTO FPS"
msgstr "AUTOMATISCH FPS"

# android: Aperture mic_on
#: src/cam-window.c
msgid "MIC ON"
msgstr "MIC AAN"

# android: Aperture mic_off
#: src/cam-window.c
msgid "MIC OFF"
msgstr "MIC UIT"

# android: Aperture settings
#: src/cam-window.c
msgid "SETTINGS"
msgstr "INSTELLINGEN"

# android: Aperture error_stream_config
#: src/cam-window.c
msgid ""
"There was an error while preparing the stream. Please report this to the "
"developers."
msgstr ""
"Er is een fout opgetreden tijdens het voorbereiden van de stream. Rapporteer "
"dit aan de ontwikkelaars."

# android: Aperture error_camera_in_use
#: src/cam-window.c
msgid "This camera is already in use, try closing the app using it."
msgstr ""
"Deze camera is al in gebruik, probeer de app te sluiten die de camera "
"gebruikt."

# android: Aperture error_other_recoverable_error
#: src/cam-window.c
msgid "Error while setting up the session. The app will try to recover."
msgstr ""
"Fout tijdens het instellen van de sessie. De app zal proberen dit te "
"herstellen."

# android: Aperture camcorder_unsupported_toast
#: src/cam-window.c
msgid "No camera supports video recording."
msgstr "Geen camera ondersteunt video-opname."

# android: Aperture thermal_status_moderate
#: src/cam-window.c
msgid ""
"Moderate thermal throttling, make sure the device isn't under direct "
"sunlight."
msgstr ""
"Matige warmtebeperking; zorg ervoor dat het apparaat niet in direct zonlicht "
"is."

# android: Aperture thermal_status_severe
#: src/cam-window.c
msgid ""
"Severe thermal throttling, it is recommended to let the device cool down a "
"bit."
msgstr ""
"Ernstige thermische beperking; het wordt aangeraden om het apparaat af te "
"koelen."

# android: Aperture thermal_status_critical
#: src/cam-window.c
msgid "Critical thermal throttling, the app might be closed soon."
msgstr "Kritische thermische beperking; de app kan binnenkort worden gesloten."

# android: Aperture thermal_status_emergency
#: src/cam-window.c
msgid "Emergency thermal throttling, the app will close now."
msgstr "Noodgeval thermische beperking; de app wordt nu afgesloten."

# android: Aperture thermal_status_shutdown
#: src/cam-window.c
msgid "Shutdown thermal throttling, the device will power off."
msgstr "Het apparaat wordt vanwege oververhitting uitgeschakeld."

# android: Aperture save_location_toast
#: src/cam-window.c
msgid "Location permissions not granted by the user."
msgstr "Locatierechten niet verleend door de gebruiker."

# android: Aperture pro_button_description
#: src/cam-window.c
msgid "Pro settings"
msgstr "Pro-instellingen"

# android: Aperture flash_button_description
#: src/cam-window.c
msgid "Flash mode"
msgstr "Flitsmodus"

#. TRANSLATORS: over the empty viewfinder while the camera is being found and opened
#: src/cam-window.c
msgid "Starting camera…"
msgstr "Camera starten…"

#. TRANSLATORS: over the empty viewfinder: the device has no camera, or none answered; a tap looks again
#: src/cam-window.c
msgid "No camera found"
msgstr "Geen camera gevonden"

#. TRANSLATORS: over the empty viewfinder: the camera system did not start in time; a tap tries again
#: src/cam-window.c
msgid "The camera is not responding"
msgstr "De camera reageert niet"
