# android: Aperture app_name
#: data/vibeos.Camera.desktop.in src/cam-settings.c src/cam-window.c
msgid "Camera"
msgstr "Camera"

#: data/vibeos.Camera.desktop.in
msgid "Take photos and videos, scan barcodes"
msgstr "Foto's en video's maken, barcodes scannen"

#: data/vibeos.Camera.desktop.in
msgid "Camera;Photo;Video;Picture;Selfie;QR;Barcode;"
msgstr "camera;foto;video;afbeelding;selfie;qr;barcode;"

