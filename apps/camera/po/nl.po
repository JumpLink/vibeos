msgstr "Helderheid vast op 100%"

# android: Aperture save_location_title
#: src/cam-settings.c
msgid "Save location data"
msgstr "Locatiegegevens opslaan"

# android: Aperture save_location_summary
#: src/cam-settings.c
msgid "Include GPS location in metadata"
msgstr "GPS-locatie opnemen in metadata"

# android: Aperture shutter_sound_title
#: src/cam-settings.c
msgid "Shutter sound"
msgstr "Sluitergeluid"

# android: Aperture shutter_sound_summary
#: src/cam-settings.c
