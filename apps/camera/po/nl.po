msgstr "Indicator die de stand van het apparaat toont"

#: src/cam-settings.c
msgid "Gestures"
msgstr "Gebaren"

# android: Aperture photos_header
#: src/cam-settings.c
msgid "Photos"
msgstr "Foto's"

# android: Aperture photo_ffc_mirror_title
#: src/cam-settings.c
msgid "Mirror front camera"
msgstr "Camera aan de voorzijde spiegelen"

# android: Aperture photo_ffc_mirror_summary
#: src/cam-settings.c
msgid "Save front camera photos as they appear in the preview"
msgstr ""
"Foto's van de camera aan de voorzijde opslaan zoals ze in het voorbeeld "
"worden getoond"

# android: Aperture video_header
#: src/cam-settings.c
msgctxt "settings"
msgid "Video"
msgstr "Video"

# android: Aperture video_mirror_mode_title
#: src/cam-settings.c
msgid "Enable video mirroring"
msgstr "Videospiegeling inschakelen"

#. last, About: the camera has no ⋮ (its top corners are the flash's and the flip's), so it is here
#: src/cam-settings.c
msgid "About"
msgstr "Over"

#: src/cam-settings.c
msgid "About Camera"
msgstr "Over Camera"

# android: Aperture volume_buttons_title
#: src/cam-settings.c
msgid "Volume buttons"
msgstr "Volumeknoppen"

# android: Aperture volume_buttons_action_title
#: src/cam-settings.c
msgid "Volume buttons action"
msgstr "Functie volumeknoppen"

# android: Aperture volume_buttons_invert_title
#: src/cam-settings.c
msgid "Invert volume buttons"
msgstr "Volumeknoppen omkeren"

# android: Aperture volume_buttons_invert_summary
#: src/cam-settings.c
msgid "Invert volume up and down behavior"
msgstr "Gedrag van volume omhoog en omlaag omkeren"

# android: Aperture flip_camera_button_description
#: src/cam-widgets.c src/cam-window.c
msgid "Flip camera"
msgstr "Schakelen tussen camera's"

# android: Aperture video_recording_state_button_description
#: src/cam-widgets.c src/cam-window.c
msgid "Pause/resume video recording"
msgstr "Video-opname onderbreken/hervatten"

# android: Aperture gallery_button_description
#: src/cam-widgets.c src/cam-window.c
msgid "Gallery"
msgstr "Galerij"

#: src/cam-window.c
msgid "Camera access is off. Turn it on in Settings, Security and privacy."
msgstr ""
"Cameratoegang staat uit. Zet deze aan via Instellingen > Beveiliging en "
"privacy."

# android: Aperture force_torch_help
#: src/cam-window.c
msgid ""
"On photo mode, you can long press the flash button to switch into torch mode."
msgstr ""
"In de fotomodus kun je lang op de flitserknop drukken om naar de "
"zaklampmodus te schakelen."

# android: Framework httpErrorOk (short)
#: src/cam-window.c
msgid "OK"
msgstr "OK"

# android: Aperture grid_off
#: src/cam-window.c
msgid "GRID OFF"
msgstr "RASTER UIT"

