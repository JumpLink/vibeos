#: data/vibeos.Weather.desktop.in src/main.c
msgid "Weather"
msgstr "Weer"

#: data/vibeos.Weather.desktop.in
msgid "The weather where you are"
msgstr "Het weer waar je bent"

#: data/vibeos.Weather.desktop.in
msgid "forecast;temperature;rain;"
msgstr "weer;weersverwachting;temperatuur;regen;"

#. TRANSLATORS: the sky, as the page names it under the temperature
#: src/main.c
msgctxt "sky"
msgid "Clear"
msgstr "Helder"

#: src/main.c
msgid "Mostly clear"
msgstr "Overwegend helder"

#: src/main.c
msgid "Partly cloudy"
msgstr "Gedeeltelijk bewolkt"

#: src/main.c
msgid "Cloudy"
msgstr "Bewolkt"

#: src/main.c
msgid "Fog"
msgstr "Mist"

#: src/main.c
msgid "Drizzle"
msgstr "Motregen"

#: src/main.c
msgid "Freezing drizzle"
msgstr "Aanvriezende motregen"

#: src/main.c
msgid "Rain"
msgstr "Regen"

#: src/main.c
msgid "Heavy rain"
msgstr "Zware regen"

#: src/main.c
msgid "Freezing rain"
msgstr "IJzel"

#: src/main.c
msgid "Snow"
msgstr "Sneeuw"

#: src/main.c
msgid "Snow grains"
msgstr "Motsneeuw"

#: src/main.c
msgid "Showers"
msgstr "Buien"

#: src/main.c
msgid "Heavy showers"
msgstr "Zware buien"

#: src/main.c
msgid "Snow showers"
msgstr "Sneeuwbuien"

#: src/main.c
msgid "Thunderstorm"
msgstr "Onweer"

#: src/main.c
msgid "Sunrise"
msgstr "Zonsopkomst"

#: src/main.c
msgid "Sunset"
msgstr "Zonsondergang"

# android: Settings ram_states[2] (short)
#. TRANSLATORS: the UV index's levels
#: src/main.c
msgctxt "uv"
msgid "Low"
msgstr "Laag"

#: src/main.c
msgctxt "uv"
msgid "Moderate"
msgstr "Matig"

# android: Settings high_label (short)
#: src/main.c
msgctxt "uv"
msgid "High"
msgstr "Hoog"

#: src/main.c
msgctxt "uv"
msgid "Very high"
msgstr "Zeer hoog"

# android: SystemUI extreme_battery_saver_text (short)
#: src/main.c
msgctxt "uv"
msgid "Extreme"
msgstr "Extreem"

#. TRANSLATORS: today's highest and lowest temperatures, then what it feels like now
#: src/main.c
#, c-format
msgid ""
"↑%s / ↓%s\n"
"Feels like %s"
msgstr ""
"↑%s / ↓%s\n"
"Voelt als %s"

#. TRANSLATORS: today's sky ("Partly cloudy"), then its highest and lowest temperatures ("12°")
#: src/main.c
#, c-format
msgid "%s. High %s, low %s."
msgstr "%s. Max. %s, min. %s."

#: src/main.c
msgid "Today's temperature"
msgstr "Temperatuur vandaag"

#: src/main.c
msgid "About the same as yesterday"
msgstr "Ongeveer hetzelfde als gisteren"

#: src/main.c
msgid "Temperatures a little lower than yesterday"
msgstr "Iets koeler dan gisteren"

#: src/main.c
msgid "Much colder than yesterday"
msgstr "Veel kouder dan gisteren"

#: src/main.c
msgid "Temperatures a little higher than yesterday"
msgstr "Iets warmer dan gisteren"

#: src/main.c
msgid "Much warmer than yesterday"
msgstr "Veel warmer dan gisteren"

# android: DocumentsUI search_last_modified_2_days (short)
#: src/main.c
msgid "Yesterday"
msgstr "Gisteren"

# android: DocumentsUI search_last_modified_1_day (short)
#: src/main.c
msgid "Today"
msgstr "Vandaag"

#. TRANSLATORS: under the sunrise's time; %s is the sunset's
#: src/main.c
#, c-format
msgid "Sunset %s"
msgstr "Zonsondergang %s"

#: src/main.c
msgid "UV index"
msgstr "Uv-index"

#: src/main.c
msgid "Humidity"
msgstr "Luchtvochtigheid"

#: src/main.c
msgid "Wind"
msgstr "Wind"

#: src/main.c
msgid "Pressure"
msgstr "Luchtdruk"

#: src/main.c
msgid "No forecast: Open-Meteo did not answer. Tap reload to try again."
msgstr ""
"Geen verwachting: Open-Meteo gaf geen antwoord. Tik op vernieuwen om het "
"opnieuw te proberen."

#: src/main.c
#, c-format
msgid "Getting the weather for %s…"
msgstr "Weer ophalen voor %s…"

#. TRANSLATORS: under "Use my location"; %s is the city chosen now
#: src/main.c
#, c-format
msgid "Instead of %s"
msgstr "In plaats van %s"

#: src/main.c
msgid "Use my location"
msgstr "Mijn locatie gebruiken"

#: src/main.c
msgid "No answer. Check the connection, then type again."
msgstr "Geen antwoord. Controleer de verbinding en typ opnieuw."

#: src/main.c
msgid "No cities found"
msgstr "Geen steden gevonden"

#: src/main.c
msgid "Set City"
msgstr "Stad instellen"

#: src/main.c
msgid "City name"
msgstr "Plaatsnaam"

# android: Settings proxy_clear_text (short)
#: src/main.c
msgid "Clear"
msgstr "Wissen"

#: src/main.c
msgid ""
"Weather forecasts by <a href=\"https://open-meteo.com/\">Open-Meteo.com</a>, "
"under <a href=\"https://creativecommons.org/licenses/by/4.0/\">CC BY 4.0</"
"a>.\n"
"\n"
"Set City finds cities with Open-Meteo's geocoding, on data from <a "
"href=\"https://www.geonames.org/\">GeoNames</a>, under CC BY 4.0."
msgstr ""
"Weersverwachtingen van <a href=\"https://open-meteo.com/\">Open-Meteo.com</"
"a>, onder <a href=\"https://creativecommons.org/licenses/by/4.0/\">CC BY "
"4.0</a>.\n"
"\n"
"“Stad instellen” zoekt steden met de geocodering van Open-Meteo, op gegevens "
"van <a href=\"https://www.geonames.org/\">GeoNames</a>, onder CC BY 4.0."

#: src/main.c
msgid ""
"The place's name, where the phone is, from OpenStreetMap's <a href=\"https://"
"nominatim.openstreetmap.org/\">Nominatim</a>. Data © <a href=\"https://"
"www.openstreetmap.org/copyright\">OpenStreetMap contributors</a>, under the "
"<a href=\"https://opendatacommons.org/licenses/odbl/\">Open Database "
"License</a> (ODbL)."
msgstr ""
"De naam van de plaats waar de telefoon is, komt van <a href=\"https://"
"nominatim.openstreetmap.org/\">Nominatim</a> van OpenStreetMap. Gegevens © "
"<a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap-"
"bijdragers</a>, onder de <a href=\"https://opendatacommons.org/licenses/odbl/"
"\">Open Database License</a> (ODbL)."

#: src/main.c
msgid "About"
msgstr "Over"

#: src/main.c
msgid "Reload"
msgstr "Vernieuwen"

# android: Framework action_menu_overflow_description (short)
#: src/main.c
msgid "More options"
msgstr "Meer opties"

#: src/main.c
msgid "Finding where you are…"
msgstr "Locatie bepalen…"

#: src/wx-place.c
msgid ""
"No location yet. Set a city in the ⋮ menu, or tap reload under open sky."
msgstr ""
"Nog geen locatie. Stel een stad in via het ⋮-menu, of tik in de open lucht "
"op vernieuwen."

#: src/wx-place.c
msgid ""
"No location. Turn on Location in Settings, then tap reload, or set a city in "
"the ⋮ menu."
msgstr ""
"Geen locatie. Zet Locatie aan in Instellingen en tik dan op vernieuwen, of "
"stel een stad in via het ⋮-menu."
