#: data/vibeos.Weather.desktop.in src/main.c
msgid "Weather"
msgstr "Météo"

#: data/vibeos.Weather.desktop.in
msgid "The weather where you are"
msgstr "La météo là où vous êtes"

#: data/vibeos.Weather.desktop.in
msgid "forecast;temperature;rain;"
msgstr "prévisions;température;pluie;météo;"

#. TRANSLATORS: the sky, as the page names it under the temperature
#: src/main.c
msgctxt "sky"
msgid "Clear"
msgstr "Dégagé"

#: src/main.c
msgid "Mostly clear"
msgstr "Généralement dégagé"

#: src/main.c
msgid "Partly cloudy"
msgstr "Partiellement nuageux"

#: src/main.c
msgid "Cloudy"
msgstr "Nuageux"

#: src/main.c
msgid "Fog"
msgstr "Brouillard"

#: src/main.c
msgid "Drizzle"
msgstr "Bruine"

#: src/main.c
msgid "Freezing drizzle"
msgstr "Bruine verglaçante"

#: src/main.c
msgid "Rain"
msgstr "Pluie"

#: src/main.c
msgid "Heavy rain"
msgstr "Forte pluie"

#: src/main.c
msgid "Freezing rain"
msgstr "Pluie verglaçante"

#: src/main.c
msgid "Snow"
msgstr "Neige"

#: src/main.c
msgid "Snow grains"
msgstr "Neige en grains"

#: src/main.c
msgid "Showers"
msgstr "Averses"

#: src/main.c
msgid "Heavy showers"
msgstr "Fortes averses"

#: src/main.c
msgid "Snow showers"
msgstr "Averses de neige"

#: src/main.c
msgid "Thunderstorm"
msgstr "Orage"

#: src/main.c
msgid "Sunrise"
msgstr "Lever du soleil"

#: src/main.c
msgid "Sunset"
msgstr "Coucher du soleil"

# android: Settings ram_states[2] (several translations, short)
#. TRANSLATORS: the UV index's levels
#: src/main.c
msgctxt "uv"
msgid "Low"
msgstr "Faible"

#: src/main.c
msgctxt "uv"
msgid "Moderate"
msgstr "Modéré"

#: src/main.c
msgctxt "uv"
msgid "High"
msgstr "Élevé"

#: src/main.c
msgctxt "uv"
msgid "Very high"
msgstr "Très élevé"

#: src/main.c
msgctxt "uv"
msgid "Extreme"
msgstr "Extrême"

#. TRANSLATORS: today's highest and lowest temperatures, then what it feels like now
#: src/main.c
#, c-format
msgid ""
"↑%s / ↓%s\n"
"Feels like %s"
msgstr ""
"↑%s / ↓%s\n"
"Ressenti %s"

#. TRANSLATORS: today's sky ("Partly cloudy"), then its highest and lowest temperatures ("12°")
#: src/main.c
#, c-format
msgid "%s. High %s, low %s."
msgstr "%s. Max. %s, min. %s."

#: src/main.c
msgid "Today's temperature"
msgstr "Température du jour"

#: src/main.c
msgid "About the same as yesterday"
msgstr "À peu près comme hier"

#: src/main.c
msgid "Temperatures a little lower than yesterday"
msgstr "Températures un peu plus basses qu'hier"

#: src/main.c
msgid "Much colder than yesterday"
msgstr "Bien plus froid qu'hier"

#: src/main.c
msgid "Temperatures a little higher than yesterday"
msgstr "Températures un peu plus élevées qu'hier"

#: src/main.c
msgid "Much warmer than yesterday"
msgstr "Bien plus chaud qu'hier"

# android: DocumentsUI search_last_modified_2_days (short)
#: src/main.c
msgid "Yesterday"
msgstr "Hier"

# android: Etar today (several translations, short)
#: src/main.c
msgid "Today"
msgstr "Aujourd’hui"

#. TRANSLATORS: under the sunrise's time; %s is the sunset's
#: src/main.c
#, c-format
msgid "Sunset %s"
msgstr "Coucher : %s"

#. TRANSLATORS: the wind's speed in kilometres an hour
#: src/main.c
#, c-format
msgid "%.0f km/h"
msgstr "%.0f km/h"

#. TRANSLATORS: the air pressure in hectopascals
#: src/main.c
#, c-format
msgid "%.0f hPa"
msgstr "%.0f hPa"

#: src/main.c
msgid "UV index"
msgstr "Indice UV"

#: src/main.c
msgid "Humidity"
msgstr "Humidité"

#: src/main.c
msgid "Wind"
msgstr "Vent"

#: src/main.c
msgid "Pressure"
msgstr "Pression"

#: src/main.c
msgid "No forecast: Open-Meteo did not answer. Tap reload to try again."
msgstr "Aucune prévision : Open-Meteo n'a pas répondu. Appuyez sur Actualiser pour réessayer."

#: src/main.c
msgid ""
"No location. Turn on Location in Settings, then tap reload, or set a city in "
"the ⋮ menu."
msgstr "Position inconnue. Activez la localisation dans Paramètres, puis appuyez sur Actualiser, ou choisissez une ville dans le menu ⋮."

#: src/main.c
#, c-format
msgid "Getting the weather for %s…"
msgstr "Récupération de la météo pour %s…"

#. TRANSLATORS: under "Use my location"; %s is the city chosen now
#: src/main.c
#, c-format
msgid "Instead of %s"
msgstr "Au lieu de %s"

#: src/main.c
msgid "Use my location"
msgstr "Utiliser ma position"

#: src/main.c
msgid "No answer. Check the connection, then type again."
msgstr "Aucune réponse. Vérifiez la connexion, puis réessayez de saisir le nom."

#: src/main.c
msgid "No cities found"
msgstr "Aucune ville trouvée"

#: src/main.c
msgid "Set City"
msgstr "Choisir la ville"

#: src/main.c
msgid "City name"
msgstr "Nom de la ville"

# android: Settings proxy_clear_text (short)
#: src/main.c
msgid "Clear"
msgstr "Effacer"

#: src/main.c
msgid ""
"Weather forecasts by <a href=\"https://open-meteo.com/\">Open-Meteo.com</a>, "
"under <a href=\"https://creativecommons.org/licenses/by/4.0/\">CC BY 4.0</"
"a>.\n"
"\n"
"Set City finds cities with Open-Meteo's geocoding, on data from <a "
"href=\"https://www.geonames.org/\">GeoNames</a>, under CC BY 4.0."
msgstr ""
"Prévisions météo fournies par <a href=\"https://open-meteo.com/\">Open-Meteo.com</a>, sous licence <a href=\"https://creativecommons.org/licenses/by/4.0/\">CC BY 4.0</a>.\n"
"\n"
"« Choisir la ville » trouve les villes grâce au géocodage d'Open-Meteo, à partir des données de <a href=\"https://www.geonames.org/\">GeoNames</a>, sous licence CC BY 4.0."

#: src/main.c
msgid ""
"The place's name, where the phone is, from OpenStreetMap's <a href=\"https://"
"nominatim.openstreetmap.org/\">Nominatim</a>. Data © <a href=\"https://"
"www.openstreetmap.org/copyright\">OpenStreetMap contributors</a>, under the "
"<a href=\"https://opendatacommons.org/licenses/odbl/\">Open Database "
"License</a> (ODbL)."
msgstr "Le nom du lieu où se trouve le téléphone provient de <a href=\"https://nominatim.openstreetmap.org/\">Nominatim</a>, d'OpenStreetMap. Données © <a href=\"https://www.openstreetmap.org/copyright\">contributeurs d'OpenStreetMap</a>, sous licence <a href=\"https://opendatacommons.org/licenses/odbl/\">Open Database License</a> (ODbL)."

#: src/main.c
msgid "About"
msgstr "À propos"

#: src/main.c
msgid "Reload"
msgstr "Actualiser"

# android: Framework action_menu_overflow_description (several translations, short)
#: src/main.c
msgid "More options"
msgstr "Plus d'options"

#: src/main.c
msgid "Finding where you are…"
msgstr "Localisation en cours…"
