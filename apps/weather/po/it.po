#: data/vibeos.Weather.desktop.in src/main.c
msgid "Weather"
msgstr "Meteo"

#: data/vibeos.Weather.desktop.in
msgid "The weather where you are"
msgstr "Il meteo dove ti trovi"

#: data/vibeos.Weather.desktop.in
msgid "forecast;temperature;rain;"
msgstr "previsioni;temperatura;pioggia;meteo;"

#. TRANSLATORS: the sky, as the page names it under the temperature
#: src/main.c
msgctxt "sky"
msgid "Clear"
msgstr "Sereno"

#: src/main.c
msgid "Mostly clear"
msgstr "Prevalentemente sereno"

#: src/main.c
msgid "Partly cloudy"
msgstr "Parzialmente nuvoloso"

#: src/main.c
msgid "Cloudy"
msgstr "Nuvoloso"

#: src/main.c
msgid "Fog"
msgstr "Nebbia"

#: src/main.c
msgid "Drizzle"
msgstr "Pioviggine"

#: src/main.c
msgid "Freezing drizzle"
msgstr "Pioviggine gelata"

#: src/main.c
msgid "Rain"
msgstr "Pioggia"

#: src/main.c
msgid "Heavy rain"
msgstr "Pioggia forte"

#: src/main.c
msgid "Freezing rain"
msgstr "Pioggia gelata"

#: src/main.c
msgid "Snow"
msgstr "Neve"

#: src/main.c
msgid "Snow grains"
msgstr "Neve granulosa"

#: src/main.c
msgid "Showers"
msgstr "Rovesci"

#: src/main.c
msgid "Heavy showers"
msgstr "Forti rovesci"

#: src/main.c
msgid "Snow showers"
msgstr "Rovesci di neve"

#: src/main.c
msgid "Thunderstorm"
msgstr "Temporale"

#: src/main.c
msgid "Sunrise"
msgstr "Alba"

#: src/main.c
msgid "Sunset"
msgstr "Tramonto"

#. TRANSLATORS: the UV index's levels
#: src/main.c
msgctxt "uv"
msgid "Low"
msgstr "Basso"

#: src/main.c
msgctxt "uv"
msgid "Moderate"
msgstr "Moderato"

#: src/main.c
msgctxt "uv"
msgid "High"
msgstr "Alto"

#: src/main.c
msgctxt "uv"
msgid "Very high"
msgstr "Molto alto"

# android: SystemUI extreme_battery_saver_text (short)
#: src/main.c
msgctxt "uv"
msgid "Extreme"
msgstr "Estremo"

#. TRANSLATORS: today's highest and lowest temperatures, then what it feels like now
#: src/main.c
#, c-format
msgid ""
"↑%s / ↓%s\n"
"Feels like %s"
msgstr ""
"↑%s / ↓%s\n"
"Percepita %s"

#. TRANSLATORS: today's sky ("Partly cloudy"), then its highest and lowest temperatures ("12°")
#: src/main.c
#, c-format
msgid "%s. High %s, low %s."
msgstr "%s. Massima %s, minima %s."

#: src/main.c
msgid "Today's temperature"
msgstr "Temperatura di oggi"

#: src/main.c
msgid "About the same as yesterday"
msgstr "Più o meno come ieri"

#: src/main.c
msgid "Temperatures a little lower than yesterday"
msgstr "Temperature un po' più basse di ieri"

#: src/main.c
msgid "Much colder than yesterday"
msgstr "Molto più freddo di ieri"

#: src/main.c
msgid "Temperatures a little higher than yesterday"
msgstr "Temperature un po' più alte di ieri"

#: src/main.c
msgid "Much warmer than yesterday"
msgstr "Molto più caldo di ieri"

# android: DocumentsUI search_last_modified_2_days (short)
#: src/main.c
msgid "Yesterday"
msgstr "Ieri"

# android: DocumentsUI search_last_modified_1_day (short)
#: src/main.c
msgid "Today"
msgstr "Oggi"

#. TRANSLATORS: under the sunrise's time; %s is the sunset's
#: src/main.c
#, c-format
msgid "Sunset %s"
msgstr "Tramonto: %s"

#: src/main.c
msgid "UV index"
msgstr "Indice UV"

#: src/main.c
msgid "Humidity"
msgstr "Umidità"

#: src/main.c
msgid "Wind"
msgstr "Vento"

#: src/main.c
msgid "Pressure"
msgstr "Pressione"

#: src/main.c
msgid "No forecast: Open-Meteo did not answer. Tap reload to try again."
msgstr ""
"Nessuna previsione: Open-Meteo non ha risposto. Tocca Ricarica per riprovare."

#: src/main.c
#, c-format
msgid "Getting the weather for %s…"
msgstr "Recupero del meteo per %s…"

#. TRANSLATORS: under "Use my location"; %s is the city chosen now
#: src/main.c
#, c-format
msgid "Instead of %s"
msgstr "Invece di %s"

#: src/main.c
msgid "Use my location"
msgstr "Usa la mia posizione"

#: src/main.c
msgid "No answer. Check the connection, then type again."
msgstr "Nessuna risposta. Controlla la connessione, poi digita di nuovo."

#: src/main.c
msgid "No cities found"
msgstr "Nessuna città trovata"

#: src/main.c
msgid "Set City"
msgstr "Imposta città"

#: src/main.c
msgid "City name"
msgstr "Nome della città"

# android: Settings proxy_clear_text (several translations, short)
#: src/main.c
msgid "Clear"
msgstr "Cancella"

#: src/main.c
msgid ""
"Weather forecasts by <a href=\"https://open-meteo.com/\">Open-Meteo.com</a>, "
"under <a href=\"https://creativecommons.org/licenses/by/4.0/\">CC BY 4.0</"
"a>.\n"
"\n"
"Set City finds cities with Open-Meteo's geocoding, on data from <a "
"href=\"https://www.geonames.org/\">GeoNames</a>, under CC BY 4.0."
msgstr ""
"Previsioni meteo di <a href=\"https://open-meteo.com/\">Open-Meteo.com</a>, "
"con licenza <a href=\"https://creativecommons.org/licenses/by/4.0/\">CC BY "
"4.0</a>.\n"
"\n"
"«Imposta città» trova le città con il geocoding di Open-Meteo, su dati di <a "
"href=\"https://www.geonames.org/\">GeoNames</a>, con licenza CC BY 4.0."

#: src/main.c
msgid ""
"The place's name, where the phone is, from OpenStreetMap's <a href=\"https://"
"nominatim.openstreetmap.org/\">Nominatim</a>. Data © <a href=\"https://"
"www.openstreetmap.org/copyright\">OpenStreetMap contributors</a>, under the "
"<a href=\"https://opendatacommons.org/licenses/odbl/\">Open Database "
"License</a> (ODbL)."
msgstr ""
"Il nome del luogo in cui si trova il telefono viene da <a href=\"https://"
"nominatim.openstreetmap.org/\">Nominatim</a> di OpenStreetMap. Dati © <a "
"href=\"https://www.openstreetmap.org/copyright\">collaboratori di "
"OpenStreetMap</a>, con licenza <a href=\"https://opendatacommons.org/"
"licenses/odbl/\">Open Database License</a> (ODbL)."

#: src/main.c
msgid "About"
msgstr "Informazioni"

#: src/main.c
msgid "Reload"
msgstr "Ricarica"

# android: Framework action_menu_overflow_description (several translations, short)
#: src/main.c
msgid "More options"
msgstr "Altre opzioni"

#: src/main.c
msgid "Finding where you are…"
msgstr "Ricerca della posizione…"

#: src/wx-place.c
msgid ""
"No location yet. Set a city in the ⋮ menu, or tap reload under open sky."
msgstr ""
"Ancora nessuna posizione. Imposta una città nel menu ⋮, oppure tocca "
"Ricarica all'aperto."

#: src/wx-place.c
msgid ""
"No location. Turn on Location in Settings, then tap reload, or set a city in "
"the ⋮ menu."
msgstr ""
"Nessuna posizione. Attiva la geolocalizzazione in Impostazioni, poi tocca "
"Ricarica, oppure imposta una città nel menu ⋮."
