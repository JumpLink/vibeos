[Desktop Entry]
# The ringing alarm, full screen (vibeos-clock --ringing). Not in the app list: the alarm service has the shell start
# it, and this file says it may show over the lock screen (DeskClock's AlarmActivity, showWhenLocked).
Type=Application
Name=Alarm
Exec=vibeos-clock --ringing
Icon=vibeos.Clock
Terminal=false
NoDisplay=true
StartupNotify=false
X-Vibeos-ShowWhenLocked=true
