[Desktop Entry]
# The ringing alarm, full screen (neo-clock --ringing). Not in the app list: the alarm service has the shell start
# it, and this file says it may show over the lock screen (DeskClock's AlarmActivity, showWhenLocked).
Type=Application
Name=Alarm
Exec=neo-clock --ringing
Icon=de.yesman.Clock
Terminal=false
NoDisplay=true
StartupNotify=false
X-GnomePhone-ShowWhenLocked=true
