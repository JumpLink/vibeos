# The Clock's alarm service: from login, whether or not the Clock app is open (an alarm rings either way)
[Unit]
Description=Clock alarms
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=dbus
BusName=neo.Clock.Alarms
ExecStart=@bindir@/neo-clock-alarms
# a crash must not cost an alarm: it comes back and rings on what is due (alarm_engine_fix)
Restart=on-failure
RestartSec=1

[Install]
WantedBy=graphical-session.target
