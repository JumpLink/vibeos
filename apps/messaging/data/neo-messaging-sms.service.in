# The Messaging's SMS service: from login, whether or not the Messaging app is open (a message is taken off the
# modem and notified either way)
[Unit]
Description=Text messages
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=dbus
BusName=neo.Messaging.Sms
ExecStart=@bindir@/neo-messaging-sms
# a crash must not leave messages on the modem: it comes back and takes what came meanwhile (Messaging.List)
Restart=on-failure
RestartSec=1

[Install]
WantedBy=graphical-session.target
