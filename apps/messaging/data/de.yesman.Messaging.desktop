[Desktop Entry]
Type=Application
Name=Messaging
Comment=Send and receive text messages
Exec=neo-messaging %u
Icon=de.yesman.Messaging
Terminal=false
StartupNotify=false
DBusActivatable=true
Categories=Network;InstantMessaging;GTK;
Keywords=SMS;Text;Message;Messages;Chat;
# sms: and smsto: links (a number in a web page) open the conversation with that number
MimeType=x-scheme-handler/sms;x-scheme-handler/smsto;
X-GNOME-UsesNotifications=true
X-Purism-FormFactor=Workstation;Mobile;
