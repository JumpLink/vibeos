#: src/calc-window.c
msgid "Copy"
msgstr "העתקה"

# android: Framework paste (short)
#: src/calc-window.c
msgid "Paste"
msgstr "הדבקה"

#. Translators: short key and display labels (a few capital letters): degrees and radians, the angle unit
#: src/calc-window.c
msgctxt "calculator key"
msgid "DEG"
msgstr "DEG"

#: src/calc-window.c
msgctxt "calculator key"
msgid "RAD"
msgstr "RAD"

# android: ExactCalculator cancelled
#: src/calc-window.c
msgid "Computation cancelled."
msgstr "החישוב בוטל."

# android: ExactCalculator dialog_timeout
#: src/calc-window.c
msgid "Timeout"
msgstr "זמן קצוב לתפוגה"

# android: ExactCalculator timeout
#: src/calc-window.c
msgid "Value may be infinite or undefined."
msgstr "ייתכן שהערך הוא אינסופי או לא מוגדר."

#: src/calc-window.c
msgid "Use longer timeouts"
