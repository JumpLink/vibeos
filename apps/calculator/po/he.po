# android: Settings proxy_clear_text (other app, several translations, short)
#: src/calc-window.c
msgid "Clear"
msgstr "ניקוי"

# android: ExactCalculator exact
#: src/calc-window.c
msgid "(exact)"
msgstr "(מדויק)"

# android: ExactCalculator approximate
#: src/calc-window.c
msgid "(±1 in last digit)"
msgstr "(±1 בספרה האחרונה)"

# android: ExactCalculator menu_leading
#: src/calc-window.c
msgid "Answer with leading digits"
msgstr "תשובה עם ספרות מובילות"

# android: ExactCalculator menu_fraction
#: src/calc-window.c
msgid "Answer as fraction"
msgstr "תשובה בצורת שבר"

