# android: ExactCalculator no_history
#: src/calc-history.c
msgid "No History"
msgstr "אין היסטוריה"

# android: ExactCalculator menu_history
#: src/calc-history.c src/calc-window.c
msgid "History"
msgstr "היסטוריה"

# android: Framework input_method_nav_back_button_desc (several translations, short)
#. the shell's back gesture clicks a button named Back
#: src/calc-history.c src/calc-licenses.c
msgid "Back"
msgstr "חזרה"

