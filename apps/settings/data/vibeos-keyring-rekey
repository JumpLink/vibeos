#!/usr/bin/python3
# vibeos-keyring-rekey: give the login keyring the new lock-screen password.
#
# The lock screen sends the user's password (the PIN, or the pattern's dots as digits) through PAM, and
# pam_gnome_keyring unlocks the login keyring with it, but only while the keyring has that same password.
# VibeOS Settings changes the account password through AccountsService, which never sees the old one, and
# gnome-keyring refuses to change a keyring's password without it, even while it is unlocked. So, while it is
# unlocked, this copies every secret out of the login keyring, makes a new login keyring with the new password
# and puts the secrets back. The old file is kept as login.keyring.before-rekey-<time>.
#
# Run as the session user. The new password is the first line on stdin; an optional second line is the current
# one: with it gnome-keyring changes the password in place, and the copying is only the fallback (a keyring that
# had drifted from the account password). Exit 0 = done, 2 = the login keyring is locked (unlock it first),
# 1 = anything else.
import os, pwd, shutil, sys, time

import gi
gi.require_version("Gio", "2.0")
from gi.repository import Gio, GLib

BUS_NAME, SERVICE = "org.freedesktop.secrets", "/org/freedesktop/secrets"
LOGIN = SERVICE + "/collection/login"
S_SERVICE, S_COLL, S_ITEM = ("org.freedesktop.Secret." + n for n in ("Service", "Collection", "Item"))
GNOME = "org.gnome.keyring.InternalUnsupportedGuiltRiddenInterface"


def main():
    password = sys.stdin.readline().rstrip("\n").encode()
    old = sys.stdin.readline().rstrip("\n").encode()
    if not password:
        sys.exit("vibeos-keyring-rekey: no password on stdin")
    bus = Gio.bus_get_sync(Gio.BusType.SESSION)

    def call(path, iface, method, args=None, reply=None):
        return bus.call_sync(BUS_NAME, path, iface, method, args, reply, Gio.DBusCallFlags.NONE, -1, None).unpack()

    def prop(path, iface, name):
        return call(path, "org.freedesktop.DBus.Properties", "Get", GLib.Variant("(ss)", (iface, name)))[0]

    session = call(SERVICE, S_SERVICE, "OpenSession", GLib.Variant("(sv)", ("plain", GLib.Variant("s", ""))))[1]
    secret = lambda value, ctype: GLib.Variant("(oayays)", (session, b"", value, ctype))

    have_login = LOGIN in prop(SERVICE, S_SERVICE, "Collections")
    if have_login and old:
        try:
            call(SERVICE, GNOME, "ChangeWithMasterPassword",
                 GLib.Variant.new_tuple(GLib.Variant("o", LOGIN), secret(old, "text/plain"), secret(password, "text/plain")))
            print("vibeos-keyring-rekey: login keyring password changed")
            return
        except GLib.Error as e:
            print(f"vibeos-keyring-rekey: in-place change refused ({e.message}), copying instead", file=sys.stderr)
    items = []
    if have_login:
        if prop(LOGIN, S_COLL, "Locked"):
            print("vibeos-keyring-rekey: the login keyring is locked", file=sys.stderr)
            sys.exit(2)
        paths = prop(LOGIN, S_COLL, "Items")
        secrets = call(SERVICE, S_SERVICE, "GetSecrets", GLib.Variant("(aoo)", (paths, session)))[0] if paths else {}
        for p in paths:
            _s, _params, value, ctype = secrets[p]
            items.append((prop(p, S_ITEM, "Label"), prop(p, S_ITEM, "Attributes"), bytes(value), ctype))
        # the file as it was, before anything changes; no backup, no change ($HOME is not trusted: under setpriv
        # or sudo it is someone else's)
        home = pwd.getpwuid(os.getuid()).pw_dir
        src = os.path.join(home, ".local", "share", "keyrings", "login.keyring")
        backup = f"{src}.before-rekey-{time.strftime('%Y%m%d-%H%M%S')}"
        shutil.copy2(src, backup)
        if os.path.getsize(backup) != os.path.getsize(src):
            sys.exit(f"vibeos-keyring-rekey: the backup {backup} is incomplete; nothing changed")
        call(LOGIN, S_COLL, "Delete")

    # gnome-keyring names the collection (and its file) after the label: "login" gives login.keyring, the one
    # pam_gnome_keyring unlocks
    label = {"org.freedesktop.Secret.Collection.Label": GLib.Variant("s", "login")}
    created = call(SERVICE, GNOME, "CreateWithMasterPassword",
                   GLib.Variant.new_tuple(GLib.Variant("a{sv}", label), secret(password, "text/plain")))[0]
    # the secrets go back in first, wherever the keyring ended up: they exist nowhere else now
    for name, attrs, value, ctype in items:
        props = {f"{S_ITEM}.Label": GLib.Variant("s", name), f"{S_ITEM}.Attributes": GLib.Variant("a{ss}", attrs)}
        call(created, S_COLL, "CreateItem",
             GLib.Variant.new_tuple(GLib.Variant("a{sv}", props), secret(value, ctype), GLib.Variant("b", True)))
    call(SERVICE, S_SERVICE, "SetAlias", GLib.Variant("(so)", ("default", created)))
    if created != LOGIN:
        sys.exit(f"vibeos-keyring-rekey: the new keyring is {created}, not {LOGIN}: the lock screen will not unlock it")
    print(f"vibeos-keyring-rekey: login keyring has the new password ({len(items)} secrets carried over)")


if __name__ == "__main__":
    try:
        main()
    except GLib.Error as e:
        sys.exit(f"vibeos-keyring-rekey: {e.message}")
