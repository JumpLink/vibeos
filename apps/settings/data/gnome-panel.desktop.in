[Desktop Entry]
# GNOME Settings' @panel@ panel, which VibeOS Settings replaces: its page in VibeOS Settings
Name=Settings
Comment=Wi-Fi, sound, display, apps and more
Exec=vibeos-settings --page @page@
Icon=vibeos.Settings
Terminal=false
Type=Application
NoDisplay=true
StartupNotify=true
X-GNOME-Settings-Panel=@panel@
