<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!--
  VibeOS Settings' "Set PIN" and "Set pattern": pkexec runs vibeos-set-own-password, and only it, for a process in
  the active local session, without asking (Settings has asked for the current PIN or pattern on its own page, and
  the helper checks it again through PAM before it changes anything). Nobody else gets it, not even with an
  administrator's password: 50-vibeos-set-own-password.rules says no to anything but an active local session.
-->
<policyconfig>
  <vendor>VibeOS</vendor>
  <action id="org.vibeos.set-own-password">
    <description>Change your own password</description>
    <message>Changing your PIN, pattern or password requires the current one</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@libexecdir@/vibeos-set-own-password</annotate>
  </action>
</policyconfig>
