[Desktop Entry]
# GNOME Settings, which VibeOS Settings replaces: VibeOS Settings answers to its name on the session bus too
# (org.gnome.Settings.service), so this opens VibeOS Settings. Hidden: VibeOS Settings has its own launcher entry.
Name=Settings
Comment=Phone settings
Exec=vibeos-settings
Icon=vibeos.Settings
Terminal=false
Type=Application
NoDisplay=true
StartupNotify=true
DBusActivatable=true
