// VibeOS Settings' "Set PIN" and "Set pattern" (org.vibeos.set-own-password.policy): only a process in the active
// session on this device's own seat runs vibeos-set-own-password through pkexec, and without a prompt; anything else
// (an ssh login, a session in the background) is refused, with no administrator's password to fall back on.
polkit.addRule(function (action, subject) {
    if (action.id !== "org.vibeos.set-own-password")
        return polkit.Result.NOT_HANDLED;
    return subject.local && subject.active ? polkit.Result.YES : polkit.Result.NO;
});
