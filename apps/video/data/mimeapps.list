# VibeOS Video Player plays videos (installed as /etc/xdg/mimeapps.list: GLib reads $XDG_CONFIG_DIRS before
# $XDG_DATA_DIRS, so this comes before Debian's /usr/share/applications/gnome-mimeapps.list; a default the user
# sets in ~/.config/mimeapps.list still comes first). The types are the ones vibeos.Video.desktop lists.
[Default Applications]
application/ogg=vibeos.Video.desktop
application/x-ogg=vibeos.Video.desktop
application/mxf=vibeos.Video.desktop
application/vnd.rn-realmedia=vibeos.Video.desktop
application/vnd.rn-realmedia-vbr=vibeos.Video.desktop
video/mpeg=vibeos.Video.desktop
video/x-mpeg2=vibeos.Video.desktop
video/x-mpeg3=vibeos.Video.desktop
video/mp4v-es=vibeos.Video.desktop
video/x-m4v=vibeos.Video.desktop
video/mp4=vibeos.Video.desktop
video/divx=vibeos.Video.desktop
video/vnd.divx=vibeos.Video.desktop
video/msvideo=vibeos.Video.desktop
video/x-msvideo=vibeos.Video.desktop
video/ogg=vibeos.Video.desktop
video/quicktime=vibeos.Video.desktop
video/vnd.rn-realvideo=vibeos.Video.desktop
video/x-ms-afs=vibeos.Video.desktop
video/x-ms-asf=vibeos.Video.desktop
video/x-ms-wmv=vibeos.Video.desktop
video/x-ms-wmx=vibeos.Video.desktop
video/x-ms-wvxvideo=vibeos.Video.desktop
video/x-avi=vibeos.Video.desktop
video/avi=vibeos.Video.desktop
video/x-flic=vibeos.Video.desktop
video/fli=vibeos.Video.desktop
video/x-flc=vibeos.Video.desktop
video/flv=vibeos.Video.desktop
video/x-flv=vibeos.Video.desktop
video/x-theora=vibeos.Video.desktop
video/x-theora+ogg=vibeos.Video.desktop
video/x-matroska=vibeos.Video.desktop
video/mkv=vibeos.Video.desktop
application/x-matroska=vibeos.Video.desktop
video/webm=vibeos.Video.desktop
video/x-ogm=vibeos.Video.desktop
video/x-ogm+ogg=vibeos.Video.desktop
video/mp2t=vibeos.Video.desktop
video/vnd.mpegurl=vibeos.Video.desktop
video/3gp=vibeos.Video.desktop
