[Desktop Entry]
Type=Application
Name=Browser
GenericName=Web Browser
Comment=Browse the web
Exec=neo-browser %U
Icon=neo.Browser
Terminal=false
Categories=Network;WebBrowser;
MimeType=text/html;x-scheme-handler/http;x-scheme-handler/https;
StartupNotify=false
StartupWMClass=neo.Browser
X-Purism-FormFactor=Workstation;Mobile;
Actions=new-incognito-tab;

[Desktop Action new-incognito-tab]
Name=New incognito tab
Exec=neo-browser --incognito
