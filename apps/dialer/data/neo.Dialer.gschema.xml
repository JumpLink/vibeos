<?xml version="1.0" encoding="UTF-8"?>
<!-- The Phone's settings: "Display options", "Sounds and vibration" with the system settings that page writes,
     and what the app remembers. The service reads the ringing and in-call ones as calls
     come and go; the app's Settings page writes them. -->
<schemalist>
  <enum id="neo.Dialer.Tab">
    <value nick="favorites" value="0"/>   <!-- the tabs, in their order -->
    <value nick="recents" value="1"/>
    <value nick="contacts" value="2"/>
  </enum>

  <!-- Display options: "Sort by" and "Name format" -->
  <enum id="neo.Dialer.SortOrder">
    <value nick="given-name" value="0"/>        <!-- First name -->
    <value nick="family-name" value="1"/>       <!-- Last name -->
  </enum>
  <enum id="neo.Dialer.DisplayOrder">
    <value nick="given-name-first" value="0"/>  <!-- First name first -->
    <value nick="family-name-first" value="1"/> <!-- Last name first -->
  </enum>

  <schema id="neo.Dialer" path="/neo/Dialer/">
    <key name="selected-tab" enum="neo.Dialer.Tab">
      <default>'favorites'</default>
      <summary>The tab the app shows</summary>
    </key>

    <key name="favorites" type="as">
      <default>[]</default>
      <summary>Favorites</summary>
      <description>The starred contacts' uids, in the order the Favorites tab shows them. Evolution's address books
        have no star, so the Phone keeps its own (spec §14.2)</description>
    </key>

    <key name="favorite-numbers" type="a{ss}">
      <default>{}</default>
      <summary>Favorites' numbers</summary>
      <description>For a favourite with several numbers, the one its tile calls (uid to number): "Remember this
        choice" in Choose call type</description>
    </key>

    <!-- Display options: how the contacts are ordered and their names written, in every screen -->
    <key name="sort-order" enum="neo.Dialer.SortOrder">
      <default>'given-name'</default>
      <summary>Sort by</summary>
    </key>
    <key name="display-order" enum="neo.Dialer.DisplayOrder">
      <default>'given-name-first'</default>
      <summary>Name format</summary>
    </key>

    <!-- Sounds and vibration -->
    <key name="ringtone" type="s">
      <default>''</default>
      <summary>Phone ringtone</summary>
      <description>A sound file's URI; 'none' for no sound (the phone still vibrates if it is to); empty or
        'default' for the default ringtone (Orion)</description>
    </key>
    <key name="ring-volume" type="d">
      <!-- 5 of 7 steps -->
      <range min="0" max="1"/>
      <default>0.714</default>
      <summary>Ring volume</summary>
    </key>
    <key name="vibrate-when-ringing" type="b">
      <default>false</default>
      <summary>Also vibrate for calls</summary>
    </key>
    <key name="dtmf-tone-when-dialing" type="b">
      <default>true</default>
      <summary>Keypad tones</summary>
    </key>

    <!-- In-call vibrations -->
    <key name="incall-vibrate-outgoing" type="b">
      <default>false</default>
      <summary>Vibrate on answer</summary>
    </key>
    <key name="incall-vibrate-call-waiting" type="b">
      <default>false</default>
      <summary>Vibrate on call waiting</summary>
    </key>
    <key name="incall-vibrate-hangup" type="b">
      <default>false</default>
      <summary>Vibrate on hang up</summary>
    </key>
    <key name="incall-vibrate-45secs" type="b">
      <default>false</default>
      <summary>Vibrate every minute</summary>
      <description>Vibrates at the 45 second mark of every minute during outgoing calls</description>
    </key>
  </schema>
</schemalist>
