# The Phone's call service: from login, whether or not the Phone app is open (a call rings either way)
[Unit]
Description=Phone calls
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=dbus
BusName=de.yesman.Dialer.Calls
ExecStart=@bindir@/neo-dialer-calls
# a crash must not leave the phone deaf to calls: it comes back and picks up the calls the modem has (ListCalls)
Restart=on-failure
RestartSec=1

[Install]
WantedBy=graphical-session.target
