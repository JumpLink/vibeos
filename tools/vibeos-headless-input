#!/usr/bin/env python3
# vibeos-headless-input: touches on vibeos-headless's display, through mutter's RemoteDesktop D-Bus API.
#
#   vibeos-headless-input tap X Y
#   vibeos-headless-input swipe X0 Y0 X1 Y1 [MS]
#   vibeos-headless-input keyboard      a keyboard and a touchscreen plugged in until mutter goes (vibeos-headless
#                                       start runs it, before any app)
#
# Coordinates are in dp (the headless display runs at scale 1). VIBEOS_HEADLESS_BUS is the private bus the headless
# mutter is on. Absolute input needs a screen-cast stream of the monitor to give the coordinates a frame, so each
# run opens a remote-desktop session with one, sends the touch, and closes it.
import os
import sys
import time

from gi.repository import Gio, GLib

MUTTER = 'org.gnome.Mutter.'
STEP_MS = 8          # a moving finger reports at 120 Hz, like the phone's panel
SHIFT_L = 0xffe1


def call(bus, name, path, interface, method, args=None, reply=None):
    return bus.call_sync(name, path, interface, method, args, GLib.VariantType(reply) if reply else None,
                         Gio.DBusCallFlags.NONE, -1, None)


def spin(seconds):
    # let the session's signals and mutter's replies go through
    context = GLib.MainContext.default()
    end = time.monotonic() + seconds
    while time.monotonic() < end:
        context.iteration(False)
        time.sleep(0.005)


def main():
    bus = Gio.DBusConnection.new_for_address_sync(
        os.environ['VIBEOS_HEADLESS_BUS'],
        Gio.DBusConnectionFlags.AUTHENTICATION_CLIENT | Gio.DBusConnectionFlags.MESSAGE_BUS_CONNECTION, None, None)

    command, numbers = sys.argv[1], [float(v) for v in sys.argv[2:]]
    rd_service = MUTTER + 'RemoteDesktop'
    # just after mutter's start its Wayland socket can be there before its D-Bus API
    for _ in range(50):
        try:
            rd_session = call(bus, rd_service, '/org/gnome/Mutter/RemoteDesktop', rd_service, 'CreateSession',
                              reply='(o)').unpack()[0]
            break
        except GLib.Error:
            spin(0.1)
    else:
        sys.exit('vibeos-headless-input: no RemoteDesktop on the display')

    def rd(method, signature=None, *args):
        call(bus, rd_service, rd_session, rd_service + '.Session', method,
             GLib.Variant(signature, args) if signature else None)

    session_id = call(bus, rd_service, rd_session, 'org.freedesktop.DBus.Properties', 'Get',
                      GLib.Variant('(ss)', (rd_service + '.Session', 'SessionId')), '(v)').unpack()[0]

    sc_service = MUTTER + 'ScreenCast'
    sc_session = call(bus, sc_service, '/org/gnome/Mutter/ScreenCast', sc_service, 'CreateSession',
                      GLib.Variant('(a{sv})', ({'remote-desktop-session-id': GLib.Variant('s', session_id)},)),
                      '(o)').unpack()[0]
    stream = call(bus, sc_service, sc_session, sc_service + '.Session', 'RecordMonitor',
                  GLib.Variant('(sa{sv})', ('Meta-0', {})), '(o)').unpack()[0]

    rd('Start')

    if command == 'keyboard':
        # Mutter activates a window (xdg_toplevel "activated": GTK's is-active, an app's onResume) only while the
        # seat has a keyboard. The phone always has one (its power and volume keys), the headless display none, so
        # every window on it was inactive. A session's keyboard is made on its first key and lasts as long as the
        # session: one key (Shift, which no app acts on alone).
        rd('NotifyKeyboardKeysym', '(ub)', SHIFT_L, True)
        rd('NotifyKeyboardKeysym', '(ub)', SHIFT_L, False)
        # A touchscreen too, as the phone's, made by a touch (on no window: no app is on the display yet). With a
        # touchscreen only in each tap's session, the seat lost its touch when the session closed, and a GTK 4.24
        # app whose touch events were still queued then (one busy for 0.1 s after the tap) crashed on them: GDK
        # takes the device's seat away, gdk_seat_get_topmost_grab_surface (NULL) in GTK's rewrite_event_for_grabs.
        # It also lets an app bind wl_touch at its start, so a tap's first touch is no longer lost.
        rd('NotifyTouchDown', '(sudd)', stream, 0, 0.0, 0.0)
        rd('NotifyTouchUp', '(u)', 0)
        spin(0.1)
        # the session is held until mutter's bus goes; vibeos-headless start waits for this line
        print('vibeos-headless-input: keyboard and touchscreen ready', flush=True)
        loop = GLib.MainLoop()
        bus.connect('closed', lambda *args: loop.quit())
        loop.run()
        return

    if command == 'tap':
        x, y = numbers
        rd('NotifyTouchDown', '(sudd)', stream, 0, x, y)
        spin(0.06)
        rd('NotifyTouchUp', '(u)', 0)
    elif command == 'swipe':
        x0, y0, x1, y1 = numbers[:4]
        duration = numbers[4] if len(numbers) > 4 else 300
        steps = max(1, int(duration / STEP_MS))
        rd('NotifyTouchDown', '(sudd)', stream, 0, x0, y0)
        for i in range(1, steps + 1):
            spin(STEP_MS / 1000)
            t = i / steps
            rd('NotifyTouchMotion', '(sudd)', stream, 0, x0 + (x1 - x0) * t, y0 + (y1 - y0) * t)
        rd('NotifyTouchUp', '(u)', 0)
    else:
        sys.exit(f'vibeos-headless-input: no command {command}')

    spin(0.1)
    rd('Stop')


main()
