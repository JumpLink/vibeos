# Carries the user's settings, files and home screen over from the IDs gnome-phone had up to 0.1.6 to the neo.*
# ones, once, before the session's programs start and read them. Afterwards the stamp file is there and the unit does
# not even start. A failure does not hold the session up: what is left is tried again at the next start.
[Unit]
Description=Carry GNOME Phone settings over to the renamed apps
Before=graphical-session-pre.target
ConditionPathExists=!%S/gnome-phone/ids-migrated

[Service]
Type=oneshot
ExecStart=@path@
TimeoutStartSec=60

[Install]
WantedBy=graphical-session-pre.target
