+// Android's input resampling: the touchscreen reports at its own rate (240 Hz here) and the frames come at the
+// display's (120 Hz); a scroll step per touch report gave each frame 0 to 3 reports' worth of movement, and the page
+// moved in uneven jumps under a steady finger. Each frame now scrolls to where the finger was RESAMPLE_LATENCY before
+// it, interpolated between the reports around that moment (predicted a little past the last one if none is newer).
+static constexpr double touchScrollResampleLatency = 5000; // µs
+static constexpr double touchScrollMaxPrediction = 8000; // µs
+
+static double touchScrollEventTime(const GdkEvent* event)
+{
+    // event times are milliseconds of CLOCK_MONOTONIC in 32 bits (Wayland); place them on the µs clock of now
+    double now = g_get_monotonic_time();
+    if (!event)
+        return now;
+    int32_t ago = static_cast<int32_t>(static_cast<uint32_t>(now / 1000) - gdk_event_get_time(const_cast<GdkEvent*>(event)));
+    return now - std::max(ago, 0) * 1000.;
+}
+
+static FloatPoint touchScrollOffsetAt(const Vector<WebKitWebViewBasePrivate::TouchScrollSample, 16>& samples, double time)
+{
+    const auto& last = samples.last();
+    if (samples.size() == 1 || time <= samples[0].time)
+        return time <= samples[0].time ? samples[0].offset : last.offset;
+    for (size_t i = 1; i < samples.size(); ++i) {
+        const auto& a = samples[i - 1];
+        const auto& b = samples[i];
+        if (time <= b.time) {
+            float t = b.time > a.time ? (time - a.time) / (b.time - a.time) : 1;
+            return a.offset + (b.offset - a.offset) * t;
+        }
+    }
+    // past the newest report: extrapolate, by at most half the last interval and 8 ms
+    const auto& prev = samples[samples.size() - 2];
+    double interval = last.time - prev.time;
+    if (interval <= 0)
+        return last.offset;
+    double ahead = std::min({ time - last.time, interval / 2, touchScrollMaxPrediction });
+    return last.offset + (last.offset - prev.offset) * static_cast<float>(ahead / interval);
+}
+
+static void webkitWebViewBaseTouchScrollSendTo(WebKitWebViewBase* webViewBase, FloatPoint offset)
+{
+    WebKitWebViewBasePrivate* priv = webViewBase->priv;
+    double deltaX = priv->touchScrollSent.x() - offset.x();
+    double deltaY = priv->touchScrollSent.y() - offset.y();
+    if (!deltaX && !deltaY)
+        return;
+    priv->touchScrollSent = offset;
+
+    ViewGestureController* controller = webkitWebViewBaseViewGestureController(webViewBase);
+    if (controller && controller->isSwipeGestureEnabled()) {
+        FloatSize delta(deltaX / Scrollbar::pixelsPerLineStep(), deltaY / Scrollbar::pixelsPerLineStep());
+        int32_t eventTime = static_cast<int32_t>(g_get_monotonic_time() / 1000);
+        PlatformGtkScrollData scrollData = { .delta = delta, .eventTime = eventTime, .source = GDK_SOURCE_TOUCHSCREEN, .isEnd = false };
+        if (controller->handleScrollWheelEvent(&scrollData))
+            return;
+    }
+
+    webkitWebViewBaseSynthesizeWheelEvent(webViewBase, nullptr, -deltaX, -deltaY, priv->touchScrollX, priv->touchScrollY, WheelEventPhase::Changed, WheelEventPhase::NoPhase, true);
+}
+
+static gboolean webkitWebViewBaseTouchScrollTick(GtkWidget* widget, GdkFrameClock* frameClock, gpointer)
+{
+    WebKitWebViewBasePrivate* priv = WEBKIT_WEB_VIEW_BASE(widget)->priv;
+    auto& samples = priv->touchScrollSamples;
+    if (samples.isEmpty())
+        return G_SOURCE_CONTINUE;
+
+    double target = gdk_frame_clock_get_frame_time(frameClock) - touchScrollResampleLatency;
+    webkitWebViewBaseTouchScrollSendTo(WEBKIT_WEB_VIEW_BASE(widget), touchScrollOffsetAt(samples, target));
+    // keep the report just before the target and everything newer
+    while (samples.size() > 2 && samples[1].time <= target)
+        samples.removeAt(0);
+    return G_SOURCE_CONTINUE;
+}
+
+static void webkitWebViewBaseTouchScrollStop(WebKitWebViewBase* webViewBase, bool flush)
+{
+    WebKitWebViewBasePrivate* priv = webViewBase->priv;
+    if (flush && !priv->touchScrollSamples.isEmpty())
+        webkitWebViewBaseTouchScrollSendTo(webViewBase, priv->touchScrollSamples.last().offset);
+    priv->touchScrollSamples.clear();
+    if (priv->touchScrollTickID) {
+        gtk_widget_remove_tick_callback(GTK_WIDGET(webViewBase), priv->touchScrollTickID);
+        priv->touchScrollTickID = 0;
+    }
+}
