Description: Cross-building with clang: give the GObject-introspection scanner the target
 The scanner compiles a dumper with $CC; CMAKE_C_COMPILER alone is the build machine's clang.
Author: pulpoff <pashkovsky@gmail.com>
Forwarded: no

--- a/Source/cmake/FindGI.cmake	2026-10-10 03:28:40.519054714 +0200
+++ b/Source/cmake/FindGI.cmake	2026-10-10 03:28:40.569013074 +0200
@@ -334,6 +334,11 @@
     # Generate .gir
     set(target_def "$<TARGET_PROPERTY:${opt_TARGET},COMPILE_DEFINITIONS>")
     set(target_inc "$<TARGET_PROPERTY:${opt_TARGET},INTERFACE_INCLUDE_DIRECTORIES>")
+    # cross-building with clang: the scanner compiles and runs a dumper, so its compiler needs the target too
+    set(gi_cc "${CMAKE_C_COMPILER}")
+    if (CMAKE_C_COMPILER_TARGET)
+        set(gi_cc "${CMAKE_C_COMPILER} --target=${CMAKE_C_COMPILER_TARGET}")
+    endif ()
     add_custom_command(
         OUTPUT "${gir_path}"
         COMMENT "Generating ${gir_name}.gir"
@@ -341,7 +346,7 @@
         DEPENDS ${gir_deps} ${gir_srcs}
         VERBATIM
         COMMAND_EXPAND_LISTS
-        COMMAND ${CMAKE_COMMAND} -E env "CC=${CMAKE_C_COMPILER}" "CFLAGS=${CMAKE_C_FLAGS}"
+        COMMAND ${CMAKE_COMMAND} -E env "CC=${gi_cc}" "CFLAGS=${CMAKE_C_FLAGS}"
             "${GI_SCANNER_EXE}" --quiet --warn-all --warn-error --no-libtool
             "--output=${gir_path}"
             "--library=$<TARGET_FILE_BASE_NAME:${opt_TARGET}>"
