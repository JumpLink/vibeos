diff --git a/board/qualcomm/qcom-quiet.config b/board/qualcomm/qcom-quiet.config
new file mode 100644
index 00000000000..fe84b69709a
--- /dev/null
+++ b/board/qualcomm/qcom-quiet.config
@@ -0,0 +1,11 @@
+# Quiet boot for phones with autologin UIs: keep the firmware splash on the panel
+# (no framebuffer clear at video probe) and route the console to serial only; the
+# boot menu re-enables the video console (see qcom-phone-quiet.env).
+CONFIG_ENV_DEFAULT_ENV_TEXT_FILE="board/qualcomm/qcom-phone-quiet.env"
+CONFIG_NO_FB_CLEAR=y
+# Options the phone's original build had that qcom_defconfig lacks (found by diffing the
+# binaries' strings): blkmap is what preboot uses to expose the ESP inside the Nura image.
+CONFIG_BLKMAP=y
+CONFIG_CMD_BLKMAP=y
+CONFIG_CMD_UFETCH=y
+CONFIG_IPV6=y
diff --git a/board/qualcomm/qcom-recovery.config b/board/qualcomm/qcom-recovery.config
new file mode 100644
index 00000000000..172c0860cd1
--- /dev/null
+++ b/board/qualcomm/qcom-recovery.config
@@ -0,0 +1,4 @@
+# U-Boot in the RECOVERY partition (LineageOS keeps boot): Linux lives in the "linux" partition, and U-Boot
+# carries its own surya DT (ABL hands it LineageOS's DT, with that image's recovery_dtbo applied)
+CONFIG_ENV_DEFAULT_ENV_TEXT_FILE="board/qualcomm/qcom-phone-linuxpart.env"
+CONFIG_DEFAULT_DEVICE_TREE="qcom/sm7150-xiaomi-surya-huaxing"
