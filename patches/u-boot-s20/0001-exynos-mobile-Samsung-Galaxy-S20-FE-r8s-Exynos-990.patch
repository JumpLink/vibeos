diff --git a/board/samsung/exynos-mobile/dss-ring.c b/board/samsung/exynos-mobile/dss-ring.c
new file mode 100644
index 00000000000..d211ef67834
--- /dev/null
+++ b/board/samsung/exynos-mobile/dss-ring.c
@@ -0,0 +1,145 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Console into Samsung's debug-snapshot kernel log ring.
+ *
+ * S-Boot (LK) writes its own log into the debug-snapshot "kernel" ring and
+ * keeps the ring's write pointer (a physical address) in the
+ * debug-snapshot header. A downstream kernel continues at that pointer and
+ * shows the previous boots' ring as /proc/last_kmsg, so text appended here
+ * can be read from a downstream recovery after any reset.
+ *
+ * The pointer's place in the header is not documented: find it as the word
+ * that points just past LK's last line, "Starting kernel...\n". Without
+ * it, append after that line anyway and leave the header alone.
+ */
+
+#include <cpu_func.h>
+#include <dm.h>
+#include <serial.h>
+#include <asm/cache.h>
+#include <asm/global_data.h>
+#include <asm/io.h>
+#include <linux/string.h>
+
+DECLARE_GLOBAL_DATA_PTR;
+
+#define DSS_HDR		CONFIG_EXYNOS_MOBILE_DSS_HEADER
+#define DSS_HDR_SIZE	0x10000UL
+#define RING		CONFIG_EXYNOS_MOBILE_DSS_RING
+#define RING_SIZE	CONFIG_EXYNOS_MOBILE_DSS_RING_SIZE
+
+static const char lk_tail[] = "Starting kernel...\n";
+
+/* .data, not .bss: these must survive relocation. */
+static ulong ring_wpos __section(".data") = 1;
+static ulong ring_ptr_loc __section(".data") = 1;
+
+static bool ring_text_before(ulong end, const char *s, size_t len)
+{
+	size_t i;
+
+	if (end < RING + len || end > RING + RING_SIZE)
+		return false;
+	for (i = 0; i < len; i++)
+		if (readb(end - len + i) != (u8)s[i])
+			return false;
+	return true;
+}
+
+static void ring_clean(ulong addr)
+{
+	ulong line = addr & ~(ulong)(ARCH_DMA_MINALIGN - 1);
+
+	if (gd->flags & GD_FLG_RELOC)
+		flush_dcache_range(line, line + ARCH_DMA_MINALIGN);
+}
+
+static void ring_find(void)
+{
+	size_t len = strlen(lk_tail);
+	ulong off, p, last = 0;
+
+	ring_wpos = 0;
+	ring_ptr_loc = 0;
+
+	for (off = 0; off < DSS_HDR_SIZE; off += 4) {
+		p = readl(DSS_HDR + off);
+		if (ring_text_before(p, lk_tail, len)) {
+			ring_ptr_loc = DSS_HDR + off;
+			ring_wpos = p;
+			return;
+		}
+	}
+
+	for (p = RING + len; p <= RING + RING_SIZE; p++)
+		if (readb(p - 1) == '\n' && ring_text_before(p, lk_tail, len))
+			last = p;
+	ring_wpos = last;
+}
+
+static void ring_putc_raw(char c)
+{
+	writeb(c, ring_wpos);
+	ring_clean(ring_wpos);
+	if (++ring_wpos >= RING + RING_SIZE)
+		ring_wpos = RING;
+	if (ring_ptr_loc) {
+		writel(ring_wpos, ring_ptr_loc);
+		ring_clean(ring_ptr_loc);
+	}
+}
+
+static int dss_ring_putc(struct udevice *dev, const char ch)
+{
+	if (!ring_wpos)
+		return 0;
+	ring_putc_raw(ch);
+	return 0;
+}
+
+static int dss_ring_pending(struct udevice *dev, bool input)
+{
+	return 0;
+}
+
+static int dss_ring_getc(struct udevice *dev)
+{
+	return -EAGAIN;
+}
+
+static int dss_ring_setbrg(struct udevice *dev, int baudrate)
+{
+	return 0;
+}
+
+static int dss_ring_probe(struct udevice *dev)
+{
+	const char *s = "\n[U-Boot] console in the debug-snapshot ring\n";
+
+	if (ring_wpos != 1)
+		return 0;	/* found before relocation */
+	ring_find();
+	if (ring_wpos)
+		while (*s)
+			ring_putc_raw(*s++);
+	return 0;
+}
+
+static const struct dm_serial_ops dss_ring_ops = {
+	.putc = dss_ring_putc,
+	.pending = dss_ring_pending,
+	.getc = dss_ring_getc,
+	.setbrg = dss_ring_setbrg,
+};
+
+U_BOOT_DRIVER(exynos_dss_ring) = {
+	.name	= "exynos_dss_ring",
+	.id	= UCLASS_SERIAL,
+	.probe	= dss_ring_probe,
+	.ops	= &dss_ring_ops,
+	.flags	= DM_FLAG_PRE_RELOC,
+};
+
+U_BOOT_DRVINFO(exynos_dss_ring) = {
+	.name = "exynos_dss_ring",
+};
