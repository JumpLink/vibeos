From 552ea66f907ccd0b5b089f612550e3d191d97d50 Mon Sep 17 00:00:00 2001
From: pulpoff <pashkovsky@gmail.com>
Date: Wed, 25 Nov 2026 17:37:27 +0100
Subject: [PATCH 1/7] exynos-mobile: Samsung Galaxy S10e (beyond0lte, Exynos
 9820)

Match the S10e's model (G970) like the other 9820 phones.
---
 board/samsung/exynos-mobile/exynos-mobile.c | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/board/samsung/exynos-mobile/exynos-mobile.c b/board/samsung/exynos-mobile/exynos-mobile.c
index 9416c8a57d9..940422b8016 100644
--- a/board/samsung/exynos-mobile/exynos-mobile.c
+++ b/board/samsung/exynos-mobile/exynos-mobile.c
@@ -182,6 +182,14 @@ static struct exynos_board_info exynos_board_info_match[] = {
 		.match = exynos7870_fdt_match,
 		.match_model = "G610",
 		.match_max_rev = U8_MAX,
+	}, {
+		/* Samsung Galaxy S10e */
+		.name = "beyond0lte",
+		.chip = "exynos9820",
+		.dram_bank_bases = exynos9820_common_dram_bank_bases,
+		.match = exynos7870_fdt_match,
+		.match_model = "G970",
+		.match_max_rev = U8_MAX,
 	}, {
 		/* Samsung Galaxy S10 */
 		.name = "beyond1lte",
