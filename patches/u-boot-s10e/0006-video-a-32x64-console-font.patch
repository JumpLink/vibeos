From 7fa23ebdaac588e70e4afaa883e622868f6010e7 Mon Sep 17 00:00:00 2001
From: pulpoff <pashkovsky@gmail.com>
Date: Wed, 25 Nov 2026 17:37:30 +0100
Subject: [PATCH 6/7] video: a 32x64 console font

Terminus 16x32 with every pixel doubled, for phone panels where 16x32 is
still tiny. CONFIG_VIDEO_FONT_32X64, the default console font when
enabled.
---
 drivers/video/Kconfig         |     6 +
 include/video_font.h          |     6 +
 include/video_font_ter32x64.h | 16654 ++++++++++++++++++++++++++++++++
 3 files changed, 16666 insertions(+)
 create mode 100644 include/video_font_ter32x64.h

diff --git a/drivers/video/Kconfig b/drivers/video/Kconfig
index d6c0d4fdfc4..55fa515baa3 100644
--- a/drivers/video/Kconfig
+++ b/drivers/video/Kconfig
@@ -51,6 +51,12 @@ config VIDEO_FONT_16X32
 	  Provides character bitmap data in header file.
 	  When selecting multiple fonts, you may want to enable CMD_SELECT_FONT too.
 
+config VIDEO_FONT_32X64
+	bool "32 x 64 font size"
+	help
+	  Terminus 16x32 scaled 2x, for high-density phone panels. When
+	  enabled it is the default console font.
+
 config VIDEO_LOGO
 	bool "Show the U-Boot logo on the display"
 	default y if !SPLASH_SCREEN
diff --git a/include/video_font.h b/include/video_font.h
index 05d3f989a77..4095fa41c41 100644
--- a/include/video_font.h
+++ b/include/video_font.h
@@ -21,8 +21,14 @@
 #if defined(CONFIG_VIDEO_FONT_16X32)
 #include <video_font_ter16x32.h>
 #endif
+#if defined(CONFIG_VIDEO_FONT_32X64)
+#include <video_font_ter32x64.h>
+#endif
 
 static struct video_fontdata __maybe_unused fonts[] = {
+#if defined(CONFIG_VIDEO_FONT_32X64)
+	FONT_ENTRY(32, 64, 32x64),
+#endif
 #if defined(CONFIG_VIDEO_FONT_8X16)
 	FONT_ENTRY(8, 16, 8x16),
 #endif
diff --git a/include/video_font_ter32x64.h b/include/video_font_ter32x64.h
new file mode 100644
index 00000000000..0d329fb9610
--- /dev/null
+++ b/include/video_font_ter32x64.h
@@ -0,0 +1,16654 @@
