From: pulpoff <pashkovsky@gmail.com>
Subject: [PATCH] keyboard: Keep a window moved for the OSK above it

When the keyboard comes up, _animateWindow unmaximizes the focus window
and moves it to the top of the work area at the height left above the
keyboard. Mutter applies the unmaximize only once the client acks it,
and that restores the window's floating size and position, centred in
the work area: on the S10e a chat app's window came back 360 wide at x 36,
and a chat's composer sat under the keys, out of reach.

Fit the window, full width from the top of the work area down to the
keyboard, and again whenever it moves or resizes, or the keyboard does
(a layout with another row), while the keyboard is up. The fit waits
for the frame (a BEFORE_REDRAW later): a move made from inside the
window's position-changed or size-changed is lost while mutter is still
applying the client's ack, and Files then stayed centred with the
launcher showing above it. Measure down to the keyboard's own top: the
height above subtracts the bottom panel, which on gnome-phone reserves
no strut, so the last 18 px of the window were still under the keys.
A window closed with the keyboard up drops its fit.

Mutter 51's unmaximize() and maximize() take no flags (the stock calls
logged "Too many arguments" on every keyboard).

For gnome-shell-mobile 51.1.mobile.22 (/usr/src/gnome-mobile/gnome-shell
on the S10e, built into /opt/gnome-mobile by build51.sh), after 0001.
---
--- a/js/ui/keyboard.js
+++ b/js/ui/keyboard.js
@@ -2343,25 +2343,57 @@
         }
 
         if (show && window.maximized_vertically && !window.__keyboardMoved && !window.is_alien()) {
-            const frameRect = window.get_frame_rect();
-            const workArea = window.get_work_area_current_monitor();
+            // Fit the window, full width, from the top of the work area down to the keyboard's own top: not to the
+            // work area less the bottom panel, which on gnome-phone reserves no strut and sits under the keys.
+            // Mutter unmaximizes only once the client acks it, and the ack restores the window's floating rect,
+            // centred in the work area, after any move: so fit again whenever the window moves or resizes, or the
+            // keyboard does (a layout with another row), while the keyboard is up. Not from inside those signals:
+            // mutter is still applying the client's state there and loses a move made from them, so the fit waits
+            // for the frame.
+            const fit = () => {
+                const rect = window.get_frame_rect();
+                const area = window.get_work_area_current_monitor();
+                const monitor = Main.layoutManager.keyboardMonitor;
+                const top = monitor.y + monitor.height - this.allocation.get_height();
+                const height = Math.min(area.y + area.height, top) - area.y;
+                if (rect.x !== area.x || rect.y !== area.y || rect.width !== area.width || rect.height !== height)
+                    window.move_resize_frame(false, area.x, area.y, area.width, height);
+            };
+            const laters = global.compositor.get_laters();
+            let later = 0;
+            const fitLater = () => {
+                later ||= laters.add(Meta.LaterType.BEFORE_REDRAW, () => {
+                    later = 0;
+                    fit();
+                    return GLib.SOURCE_REMOVE;
+                });
+            };
+            const allocationId = this.connect('notify::allocation', fitLater);
+            const ids = [
+                window.connect('position-changed', fitLater),
+                window.connect('size-changed', fitLater),
+                window.connect('unmanaging', () => {
+                    window.__keyboardUnfit();
+                    delete window.__keyboardMoved;
+                }),
+            ];
+            window.__keyboardUnfit = () => {
+                if (later)
+                    laters.remove(later);
+                later = 0;
+                ids.forEach(id => window.disconnect(id));
+                this.disconnect(allocationId);
+                delete window.__keyboardUnfit;
+            };
 
-            this._bla = this.connect('notify::allocation', () => {
-                const currentFrameRect = window.get_frame_rect();
-                const currentWorkArea = window.get_work_area_current_monitor();
-
-                window.move_resize_frame(false, currentFrameRect.x, currentWorkArea.y, currentFrameRect.width, currentWorkArea.height - (this.allocation.get_height() - this._bottomPanelBox.allocation.get_height()));
-            });
-
-            window.unmaximize(Meta.MaximizeFlags.VERTICAL);
-            window.move_resize_frame(false, frameRect.x, workArea.y, frameRect.width, workArea.height - (this.allocation.get_height() - (this._bottomPanelBox?.allocation.get_height() ?? 0)));
+            window.unmaximize();
+            fit();
 
             window.__keyboardMoved = true;
         } else if (!show && window.__keyboardMoved) {
-            this.disconnect(this._bla);
-            delete this._bla;
+            window.__keyboardUnfit();
 
-            window.maximize(Meta.MaximizeFlags.VERTICAL);
+            window.maximize();
             delete window.__keyboardMoved;
         }
 
