+    /**
+     * holdStartup:
+     *
+     * Keeps the stage hidden while the shell starts, so the screen goes on
+     * showing what was there before (the boot splash, kept by
+     * `plymouth quit --retain-splash`), until the function it returns is
+     * called. An extension that puts its own first screen up, a lock screen
+     * say, takes a hold in enable() and releases it once that screen is built:
+     * the first frame the shell shows is then that screen, not the overview.
+     *
+     * The extensions enabled at startup are enabled before the stage is
+     * shown, so enable() is soon enough. Once the stage is shown a hold does
+     * nothing, and one never released ends STARTUP_HOLD_TIMEOUT seconds
+     * after the shell started waiting. A startup that was held has no
+     * startup animation: the screen the holder put up shows as it is, and
+     * the startup completes once that frame is on the screen. Completing it
+     * has GDM quit Plymouth (RegisterDisplay), and the retained boot splash
+     * goes with Plymouth: any sooner, and the screen is black until the
+     * first frame, which takes seconds on a phone.
+     *
+     * @returns {Function} releases the hold; calling it again does nothing
+     */
+    holdStartup() {
+        if (!this._startingUp || this._stageShown)
+            return () => {};
+
+        this._startupHeld = true;
+        this._startupHolds++;
+        let released = false;
+        return () => {
+            if (released)
+                return;
+            released = true;
+            this._startupHolds--;
+            if (this._startupHolds === 0)
+                this._startupHoldsReleased?.();
+        };
+    }
+
+    async _waitForStartupHolds() {
+        const {promise, resolve} = Promise.withResolvers();
+        let timeoutId = GLib.timeout_add_seconds(GLib.PRIORITY_DEFAULT,
+            STARTUP_HOLD_TIMEOUT, () => {
+                timeoutId = 0;
+                if (this._startupHolds > 0)
+                    log(`Showing the stage with ${this._startupHolds} startup hold(s) unreleased`);
+                resolve();
+                return GLib.SOURCE_REMOVE;
+            });
+
+        (async () => {
+            await Main.extensionManager?.waitForStartup();
+            if (this._startupHolds > 0) {
+                const held = Promise.withResolvers();
+                this._startupHoldsReleased = held.resolve;
+                await held.promise;
+            }
+        })().catch(logError).finally(resolve);
+
+        await promise;
+        if (timeoutId)
+            GLib.source_remove(timeoutId);
+        this._startupHoldsReleased = null;
+    }
+
+    // Resolves once the stage's next frame is on the screen, or after
+    // FIRST_FRAME_TIMEOUT seconds. Not from 'presented': its ClutterFrameInfo
+    // is a bare pointer GJS cannot take (every handler call throws), so
+    // FIRST_FRAME_FLIP ms after the frame was painted.
+    _waitForFirstFrame() {
+        return new Promise(resolve => {
+            let timeoutId = 0;
+            const paintId = global.stage.connect('after-paint', () => {
+                global.stage.disconnect(paintId);
+                GLib.source_remove(timeoutId);
+                timeoutId = 0;
+                GLib.timeout_add(GLib.PRIORITY_DEFAULT, FIRST_FRAME_FLIP, () => {
+                    resolve();
+                    return GLib.SOURCE_REMOVE;
+                });
+            });
+            timeoutId = GLib.timeout_add_seconds(GLib.PRIORITY_DEFAULT,
+                FIRST_FRAME_TIMEOUT, () => {
+                    timeoutId = 0;
+                    global.stage.disconnect(paintId);
+                    log('Completing the startup before its first frame was painted');
+                    resolve();
+                    return GLib.SOURCE_REMOVE;
+                });
+        });
+    }
+
     async _loadBackground() {
         await this._ensurePrimaryMonitor();
 
