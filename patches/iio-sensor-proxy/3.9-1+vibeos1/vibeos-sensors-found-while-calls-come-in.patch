+/* The sensor's Has property, to every client on the bus. send_dbus_event goes only to the clients that claimed a
+ * sensor, and a client that has claimed nothing yet (mutter before it claims the accelerometer, an app before it
+ * claims the compass) reads HasAccelerometer or HasCompass once and then follows PropertiesChanged: a sensor found
+ * after that read, or opened only after it, would never reach it. The readings still go only to the claimants. */
+static void
+send_has_sensor_broadcast (SensorData *data,
+			   DriverType  driver_type)
+{
+	GVariantBuilder props_builder;
+	const char *name;
+	gboolean compass = (driver_type == DRIVER_TYPE_COMPASS);
+
+	if (driver_type == DRIVER_TYPE_ACCEL)
+		name = "HasAccelerometer";
+	else if (driver_type == DRIVER_TYPE_LIGHT)
+		name = "HasAmbientLight";
+	else if (driver_type == DRIVER_TYPE_PROXIMITY)
+		name = "HasProximity";
+	else if (driver_type == DRIVER_TYPE_COMPASS)
+		name = "HasCompass";
+	else
+		g_assert_not_reached ();
+
+	g_variant_builder_init (&props_builder, G_VARIANT_TYPE ("a{sv}"));
+	g_variant_builder_add (&props_builder, "{sv}", name,
+			       g_variant_new_boolean (driver_type_exists (data, driver_type)));
+
+	g_dbus_connection_emit_signal (data->connection,
+				       NULL,
+				       compass ? SENSOR_PROXY_COMPASS_DBUS_PATH : SENSOR_PROXY_DBUS_PATH,
+				       "org.freedesktop.DBus.Properties",
+				       "PropertiesChanged",
+				       g_variant_new ("(s@a{sv}@as)",
+						      compass ? SENSOR_PROXY_COMPASS_IFACE_NAME : SENSOR_PROXY_IFACE_NAME,
+						      g_variant_builder_end (&props_builder),
+						      g_variant_new_strv (NULL, 0)),
+				       NULL);
+}
+
 static void
 send_driver_changed_dbus_event (SensorData   *data,
 				DriverType    driver_type)
@@ -387,6 +428,8 @@ send_driver_changed_dbus_event (SensorData   *data,
 		send_dbus_event (data, PROP_HAS_COMPASS);
 	else
 		g_assert_not_reached ();
+
+	send_has_sensor_broadcast (data, driver_type);
 }
 
