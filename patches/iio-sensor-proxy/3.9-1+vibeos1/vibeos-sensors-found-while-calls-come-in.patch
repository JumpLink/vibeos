 	    g_hash_table_size (ht) == 0) {
 		SensorDevice *sensor_device = DEVICE_FOR_TYPE(driver_type);
 		driver_set_polling (sensor_device, FALSE);
@@ -522,7 +566,15 @@ handle_generic_method_call (SensorData            *data,
 							   NULL);
 		g_hash_table_insert (ht, g_strdup (sender), GUINT_TO_POINTER (watch_id));
 
-		if (driver_type_exists (data, driver_type)) {
+		if (driver_type_exists (data, driver_type) &&
+		    DEVICE_FOR_TYPE(driver_type) == NULL) {
+			/* Found, and still being opened: the SSC drivers wait for the sensor core (libssc's
+			 * _sync calls) by running the main loop, which takes this call meanwhile.
+			 * name_acquired_handler() starts the sensor once it is open, and the call returns
+			 * with its first reading. */
+			g_ptr_array_add (data->sensor_startup_dbus_invocations_delayed[driver_type],
+					 invocation);
+		} else if (driver_type_exists (data, driver_type)) {
 			SensorDevice *sensor_device = DEVICE_FOR_TYPE(driver_type);
 
 			/* No other clients for this sensor? Start it */
@@ -742,8 +794,12 @@ bus_acquired_handler (GDBusConnection *connection,
 	/* Initialize DBus clients hash table before DBus is fully exposed */
 	data->client = g_udev_client_new (subsystems);
 
-	for (guint i = 0; i < NUM_SENSOR_TYPES; i++)
+	/* the calls waiting for a sensor's start too: find_sensors() and driver_open() of the SSC drivers take
+	 * calls while they wait for the sensor core */
+	for (guint i = 0; i < NUM_SENSOR_TYPES; i++) {
 		data->clients[i] = create_clients_hash_table ();
+		data->sensor_startup_dbus_invocations_delayed[i] = g_ptr_array_new ();
+	}
 
 	data->connection = g_object_ref (connection);
 }
@@ -765,8 +821,6 @@ name_acquired_handler (GDBusConnection *connection,
 	for (i = 0; i < NUM_SENSOR_TYPES; i++) {
 		SensorDevice *sensor_device;
 
-		data->sensor_startup_dbus_invocations_delayed[i] = g_ptr_array_new ();
-
 		if (!driver_type_exists (data, i))
 			continue;
 
@@ -775,10 +829,24 @@ name_acquired_handler (GDBusConnection *connection,
 		if (!sensor_device) {
 			DRIVER_FOR_TYPE(i) = NULL;
 			g_clear_object (&UDEV_DEVICE_FOR_TYPE(i));
+			/* the claims made while it was opened return, as for a sensor there is not */
+			maybe_notify_sensor_startup_finished (data, i);
+			send_has_sensor_broadcast (data, i);
 			continue;
 		}
 
 		DEVICE_FOR_TYPE(i) = sensor_device;
+
+		if (g_hash_table_size (data->clients[i]) > 0) {
+			/* claimed while it was found or opened: started now, as a hotplugged sensor
+			 * that is claimed already, and announced with its first reading */
+			data->sensor_startup_dbus_event_delayed[i] = TRUE;
+			driver_set_polling (sensor_device, TRUE);
+		} else {
+			/* a claim whose client let go before the sensor was open returns now */
+			maybe_notify_sensor_startup_finished (data, i);
+			send_has_sensor_broadcast (data, i);
+		}
 	}
 
 	if (!any_sensors_left (data))
@@ -1006,7 +1074,7 @@ free_sensor_data (SensorData *data)
 	}
 
 	for (i = 0; i < NUM_SENSOR_TYPES; i++) {
-		if (driver_type_exists (data, i))
+		if (driver_type_exists (data, i) && DEVICE_FOR_TYPE(i) != NULL)
 			driver_close (DEVICE_FOR_TYPE(i));
 		g_clear_object (&UDEV_DEVICE_FOR_TYPE(i));
 		g_clear_pointer (&data->clients[i], g_hash_table_unref);
@@ -1045,7 +1113,8 @@ sensor_changes (GUdevClient *client,
 					 g_udev_device_get_sysfs_path (dev));
 
 				g_clear_object (&UDEV_DEVICE_FOR_TYPE(i));
-				driver_close (DEVICE_FOR_TYPE(i));
+				if (DEVICE_FOR_TYPE(i) != NULL)
+					driver_close (DEVICE_FOR_TYPE(i));
 				DEVICE_FOR_TYPE(i) = NULL;
 				DRIVER_FOR_TYPE(i) = NULL;
 
diff --git a/tests/integration-test.py b/tests/integration-test.py
index 23bf623..aa2deab 100755
--- a/tests/integration-test.py
+++ b/tests/integration-test.py
@@ -433,6 +433,44 @@ class Tests(dbusmock.DBusTestCase):
 
         self.stop_daemon()
 
+    def test_hotplug_has_to_unclaimed_client(self):
+        '''a sensor that comes or goes is announced to a client that claimed nothing'''
+        # the fake compass keeps the daemon running; the light sensor comes and goes
+        self.testbed.add_device('input', 'fake-compass', None,
+            [],
+            ['NAME', '"Power Button"']
+        )
+        env = os.environ.copy()
+        env['FAKE_COMPASS'] = '1'
+        self.start_daemon(env)
+        self.assertEqual(self.get_dbus_property('HasAmbientLight'), False)
+
+        # this client follows PropertiesChanged, as mutter does before it claims the accelerometer
+        has_light = []
+        def on_properties_changed(connection, sender, path, iface, signal, params):
+            changed = params.unpack()[1]
+            if 'HasAmbientLight' in changed:
+                has_light.append(changed['HasAmbientLight'])
+        sub = self.dbus.signal_subscribe(SP, 'org.freedesktop.DBus.Properties', 'PropertiesChanged',
+                                         SP_PATH, None, Gio.DBusSignalFlags.NONE, on_properties_changed)
+
+        iio = self.testbed.add_device('iio', 'iio-als', None,
+            ['integration_time', '1',
+             'in_illuminance_input', '10',
+             'in_illuminance_scale', '1.0'],
+            ['NAME', '"IIO Light Sensor"',
+             'IIO_SENSOR_PROXY_TYPE', 'iio-poll-als']
+        )
+        self.assertEventually(lambda: has_light == [True])
+        self.assertEqual(self.get_dbus_property('HasAmbientLight'), True)
+
+        self.testbed.uevent(iio, 'remove')
+        self.assertEventually(lambda: has_light == [True, False])
+        self.assertEqual(self.get_dbus_property('HasAmbientLight'), False)
+
+        self.dbus.signal_unsubscribe(sub)
+        self.stop_daemon()
+
     def test_iio_poll_proximity(self):
