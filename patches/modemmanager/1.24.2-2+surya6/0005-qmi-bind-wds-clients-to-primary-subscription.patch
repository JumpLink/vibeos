     connect_context_step (task);
 }
 
+/* On a multi-SIM (DSDS) modem a WDS client that is not bound to a subscription
+ * follows the modem's default data subscription (DDS). Nothing on the host ever
+ * sets the DDS, so it may point at a subscription without a SIM (it does on the
+ * POCO X3 NFC, SM7150), and every call then fails at once with CallFailed,
+ * verbose reason [cm] no-service, while the modem is registered and attached.
+ * ModemManager only ever uses the primary GW provisioning session, so bind the
+ * client to the primary subscription, as the Android data stack binds each of
+ * its WDS clients. Binding is per client and is reset by Bind (Mux) Data Port,
+ * so it is done after that, on every connection. Modems that don't know the
+ * message keep the default binding, as before. */
+static void
+bind_subscription_ready (QmiClientWds *client,
+                         GAsyncResult *res,
+                         GTask        *task)
+{
+    ConnectContext                                 *ctx;
+    g_autoptr(GError)                               error = NULL;
+    g_autoptr(QmiMessageWdsBindSubscriptionOutput)  output = NULL;
+
+    ctx = g_task_get_task_data (task);
+
+    output = qmi_client_wds_bind_subscription_finish (client, res, &error);
+    if (!output || !qmi_message_wds_bind_subscription_output_get_result (output, &error))
+        mm_obj_dbg (ctx->self, "couldn't bind WDS client to the primary subscription: %s", error->message);
+    else
+        mm_obj_dbg (ctx->self, "WDS client bound to the primary subscription");
+
+    /* Keep on */
+    ctx->step++;
+    connect_context_step (task);
+}
+
+static void
+bind_subscription (GTask        *task,
+                   QmiClientWds *client)
+{
+    g_autoptr(QmiMessageWdsBindSubscriptionInput) input = NULL;
+
+    input = qmi_message_wds_bind_subscription_input_new ();
+    qmi_message_wds_bind_subscription_input_set_subscription_id (input, QMI_SUBSCRIPTION_TYPE_PRIMARY, NULL);
+    qmi_client_wds_bind_subscription (client,
+                                      input,
+                                      10,
+                                      g_task_get_cancellable (task),
+                                      (GAsyncReadyCallback)bind_subscription_ready,
+                                      task);
+}
+
 static void
 qmi_port_allocate_client_ready (MMPortQmi *qmi,
                                 GAsyncResult *res,
@@ -2106,6 +2156,10 @@ connect_context_step (GTask *task)
         ctx->step++;
         /* fall through */
 
+    case CONNECT_STEP_BIND_SUBSCRIPTION_IPV4:
+        bind_subscription (task, ctx->client_ipv4);
+        return;
+
     case CONNECT_STEP_IP_FAMILY_IPV4:
         /* If client is new enough, select IP family */
         if (!ctx->no_ip_family_preference) {
@@ -2251,6 +2305,10 @@ connect_context_step (GTask *task)
         ctx->step++;
         /* fall through */
 
+    case CONNECT_STEP_BIND_SUBSCRIPTION_IPV6:
+        bind_subscription (task, ctx->client_ipv6);
+        return;
+
     case CONNECT_STEP_IP_FAMILY_IPV6: {
         QmiMessageWdsSetIpFamilyInput *input;
 
