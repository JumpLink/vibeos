# base/packages: what build-base.sh asks mmdebstrap for (--variant=important, Recommends installed, as any Debian
# GNOME install). The 0.1.3 base's `apt-mark showmanual`, less what Priority required/important brings anyway; apt
# resolves the rest (1435 packages in the 0.1.3 base). build-system.sh then removes the GNOME apps the ROM leaves out
# (kit/ourapps-remove), Showtime and GNOME Settings, and installs VibeOS.

# Mobian's base, without any UI metapackage (mobian-phosh*, mobian-plasma-mobile*: pinned out, base/overlay)
mobian-archive-keyring
mobian-base
mobian-phone-base
# GNOME as Debian ships it: gnome-core is GDM, the Shell and GNOME's core apps; GNOME Web is the browser (without it
# gnome-core's browser recommendation pulls firefox-esr)
gnome-core
epiphany-browser
gnome-software-plugin-deb
# a phone's hardware through the standard services: modem, rotation/light/proximity, cameras, swap in RAM
