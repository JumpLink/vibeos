# image/local.conf: this machine's settings for the image tools (copy this file to local.conf; git ignores it).
# Every script in image/ reads it (a shell file). A line VAR=value here wins over the environment; write it as
# VAR=${VAR:-value} to let the environment win, as for a test build elsewhere.

# where builds, work files (work/, tmp/) and logs go: OUT/system, OUT/DEVICE, ...
VIBEOS_OUT=/srv/vibeos-images/0.1.3

# ---- build-base.sh, build-chroot.sh, build-mutter.sh, build-mobile.sh: the system image's inputs from sources
# DEBIAN_MIRROR=http://deb.debian.org/debian
# SNAPSHOT=				# YYYYMMDDTHHMMSSZ: Debian as snapshot.debian.org had it then (Mobian: as it is now)
# MOBIAN_MIRROR=http://repo.mobian.org/
# BASE_TZ=Europe/Berlin			# the base's time zone and language
# BASE_LANG=en_GB.UTF-8
# HOLD_DEBS=				# .debs build-base.sh installs over Debian's and holds (other builds of archive packages)
# BUILD_CHROOT=				# the arm64 build chroot (default OUT/work/build-chroot, made by build-chroot.sh)
# JOBS=8				# compile jobs

# ---- build-system.sh: the system image
# SYSTEM_VERSION=0.1.4			# the release the system image carries (build-system.sh; 0.1.4 when unset)
VDEBS=/srv/vibeos-debs/0.1.4		# VibeOS's own .debs, version 1:SYSTEM_VERSION (dpkg-buildpackage of this repository)
MUTTER=/srv/vibeos-debs/mutter		# mutter 51.0-3+gp1: Debian's mutter 51.0-3 with patches/mutter (build-mutter.sh)
SPEECH=/srv/vibeos-debs/speech		# the vibeos-dictate-* packages: tools/vibeos-dictate-speech/build-debs.sh
MOBILE=/srv/gnome-mobile.tar		# GNOME Shell mobile with patches/gnome-shell, as a tar of opt/gnome-mobile (build-mobile.sh)
STAGE=					# only for the S10e r7 base (the 0.1.3 release's): its device stage, whose files are removed
BASE_ORIG=				# the base image itself: build-system.sh refuses to work on it, only on a copy
# ART=					# the third-party icon packs and parallax sets: not in this repository, left out unset
# KIT=					# the home screen and app list (default: image/kit)
# VIBEOS_DEV=0				# 1: a developer image (USB network on the gadget port); 0: a release image, without
# FORBID_EXTRA=				# more names no image may contain (gsm2sip and waydroid always)

# ---- build-zips.sh
# UPDATE_BINARY=			# LineageOS's updater (default: image/zip/update-binary, get-update-binary.sh)
# VIBEOS_PART=				# the GPT tool (default: image/src/s10e-part, make -C image/src)
# STRICT=1				# refuse any update-binary or vibeos-part but the 0.1.3 zips' own
# CHUNK_MB=1024				# the system image's part size in the zip (LineageOS's updater: under 4 GiB each)
# SYS_DIR=				# where rootfs.img is (default: OUT/system)

# ---- build-device.sh: our four devices, from their device stages (none of them is in this repository: each holds
# a kernel build and firmware read from our own phones)
S10E_STAGE=				# Galaxy S10e: device stage (root/ with /boot/s10e, modules, units...)
S10E_KIT=				# its kit: clean/60-s10e-gpu.conf, tools/s10e-logo, boot-logo/*.jpg
S10E_VENDOR_FW=				# Samsung's firmware from its vendor partition (usr/lib/firmware of a root copy)
S10E_CALLAUDIO_FW=			# optional: the call-audio kit's firmware, compared with the above
S10E_UBOOT=				# U-Boot image for recovery (its first 4 MiB are taken)
S10E_IMAGE=				# its kernel, 7.2.15-s10e-2 #58: the Image of that build, which the stage's replaces
S10E_MODULES=				# that kernel build's modules_install tree (lib/modules)
S10E_HCI_UART=				# hci_uart.ko with the hci_bcm sleep fix, built against that kernel (updates/)
S10E_SHUB=				# bcm4775-shub.ko with the GNSS device, built against that kernel (stripped, uncompressed)
POCO_STAGE=				# POCO X3 NFC: device stage
POCO_K22_IMG=				# its 0.1.1 ROM image (the ESP is read from it)
POCO_K22_ZIP=				# its 0.1.1 ROM zip (recovery-uboot.img, which POCO_UBOOT must make again)
POCO_LINEAGE_ZIP=			# LineageOS 22.2 surya 20261102 (its boot.img, dtbo.img, vbmeta.img, recovery.img)
POCO_UBOOT=				# u-boot.bin of the POCO's U-Boot (env qcom-phone-linuxpart.env: it boots "linux")
POCO_AVB=				# a folder with AOSP's avbtool.py and testkey_rsa4096.pem (external/avb)
S5E_STAGE=				# Galaxy Tab S5e: device stage
S5E_TABK=				# the tablet's recovery backup, linux-k11-uc.img, its kernel Image-uc.gz, repack-v2.py
					# (rewrites a boot image v2 with a new ramdisk) and later device files
S5E_MODULES=				# its kernel build's modules_install tree (lib/modules)
S5E_KIT_TOOLS=				# extents, keepmisc and dmlinear (static aarch64 helpers)
S5E_UBOOT=				# its dual-boot U-Boot, u-boot-nodtb.bin as s5e/build-uboot.sh builds it (s5e/uboot.env)
S5E_IIO=				# iio-sensor-proxy_3.9-1+vibeos1_arm64.deb (VibeOS's build, in place of the stage's +gts4lv3)
S20_DIR=				# Galaxy S20 FE: its kit (build/, kit/rootfs, kit/modem, quietboot/rootfs)
S20_SLEEP=				# its sleep helper sources
S20_KBUILD=				# its release kernel's build directory (O=: Image, modules, kernel.release), built with
					# s20/build-initramfs.sh's tree (REGDB_FROM set) as CONFIG_INITRAMFS_SOURCE
S20_BOOT=				# its boot image, s20/make-boot.sh's (build-device checks it with s20/check-boot.py)
S20_SHUB=				# the sensor hub's bcm4775b1-shub-r8s.patch (3b2a01e5): the C strings of LineageOS's
					# universal9830 kernel, lineage-24.0 97369af7, drivers/sensorhub/brcm/bbdpl/r_os/bbd_patch_file_r8.h
# DEVICE_VERSION=			# a device package's version instead of the system image's (SYSIMG)
NABU_STAGE=				# Xiaomi Pad 5: device stage (root/, debs/ with debs.sha256, firmware.txt)
NABU_MODULES=				# its kernel build's modules_install tree (lib/modules)
NABU_BOOT=				# its boot_b image (b3)
NABU_CAMSS=				# qcom-camss.ko with the camera fix (vibeos-nabu-7.3.6 e0a119144716), in place of NABU_MODULES's
# SYSIMG=				# the system image whose upstream-signed regulatory.db goes into the initramfs of a
					# kernel with cfg80211 built in (default: OUT/system/rootfs.img)
# S5E_KERNEL=				# the same for the S5e: a gzip -9n Image for the slot image instead of Image-uc.gz
# POCO_ESP_KERNEL=			# the same for the POCO: a vmlinuz.efi (EFI zboot) of vmlinuz-mobian's size, written
					# over that file's clusters on the ESP

# ---- s20/make-boot.sh (with S20_DIR and S20_KBUILD)
# S20_DTB=				# the devicetree the FIT carries
# S20_UBSHIM=				# S20_DIR/kit/uboot/build-ubshim.sh's shim around u-boot.bin of the branch r8s-ub13
# S20_STOCK_BOOT=			# the phone's stock BOOT (its header and DT table are kept)
# S20_MKIMAGE=				# U-Boot's tools/mkimage

# ---- test/zip-test.sh, test/setup-test.sh
# UP_PARAM_IMG=				# a copy of an S10e's up_param (default: a stand-in tar)
# OUT/work/test needs sda-real.img (a sparse copy of an S10e's sda holding only its GPT) and r/ (LineageOS's
# recovery ramdisk, from nura/test/recovery-chroot.py RECOVERY.img OUT/work/test/r)
