#!/bin/busybox sh
# Galaxy S20 FE (r8s) mainline initramfs: a USB network (NCM + RNDIS) and a
# serial port (ACM) on the gadget, DHCP for the PC, the console on the screen
# through simple-framebuffer, the watchdog fed, and kexec for test kernels.
# Root shells (telnet and SSH on 172.16.43.1, root without a password, and a
# shell on the ACM port) only with r8s.debug on the command line, which
# U-Boot's "Rescue shell (USB)" entry passes (Volume Down at power-on):
# without it nothing here takes a login. Every
# block device is set read-only as it appears, except the partition named
# vibeos when the command line asks for it (rw-ok=sda33). With
# r8s.root=vibeos it checks that partition, grows it to fill the partition,
# mounts it and switch_roots into its /sbin/init. Without, nothing from the
# phone's storage is mounted.

/bin/busybox mkdir -p /bin /sbin /usr/bin /usr/sbin /proc /sys /dev /tmp /run /mnt
/bin/busybox --install -s

mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev 2>/dev/null
mkdir -p /dev/pts && mount -t devpts devpts /dev/pts
mount -t tmpfs tmpfs /tmp
mount -t tmpfs tmpfs /run
mount -t configfs configfs /sys/kernel/config
mount -t pstore pstore /sys/fs/pstore 2>/dev/null
mount -t debugfs debugfs /sys/kernel/debug 2>/dev/null

log() { echo "r8s-init: $*" > /dev/kmsg; echo "r8s-init: $*" > /dev/tty0 2>/dev/null; }

# Read-only guard: every UFS LUN and partition is set read-only as it
# appears (BLKROSET on a disk doesn't cover its partitions, so each one), for
# the first 120 s. rw-ok=<dev>[,<dev>] leaves those partitions writable, and
# only partitions NAMED vibeos (the root) or vibeos-swap (the UFS swap): a
# request for anything else is refused. r8s.root=vibeos asks for both, by
# name. A read-only disk makes every partition on it read-only, so the disk
# holding a writable partition stays writable at the block layer; its /dev
# node is removed instead, so nothing can open the whole disk by name. The
# flags outlive the switch_root: the booted system sees every other
# partition read-only.
RWREQ=$(tr ' ' '\n' < /proc/cmdline | sed -n 's/^rw-ok=//p' | tr ',' ' ')
for p in $(tr ' ' '\n' < /proc/cmdline | sed -n 's/^r8s\.root=//p'); do
	RWREQ="$RWREQ partname:$p partname:vibeos-swap"
done
writable() {
	pn=$(sed -n 's/^PARTNAME=//p' /sys/class/block/$1/uevent 2>/dev/null)
	case $pn in vibeos|vibeos-swap) ;; *) return 1 ;; esac
	for w in $RWREQ; do
		[ "$w" = "$1" ] && return 0
		[ "$w" = "partname:$pn" ] && return 0
	done
	return 1
}
holds_writable() {
	for p in /sys/class/block/$1/$1*; do
		[ -e "$p/partition" ] && writable ${p##*/} && return 0
	done
	return 1
}
for w in $RWREQ; do
	case $w in sd[a-z][0-9]*|partname:vibeos|partname:vibeos-swap) ;; *) log "guard: refusing rw-ok=$w (only vibeos and vibeos-swap)" ;; esac
done
(
	end=$(( $(cut -d. -f1 /proc/uptime) + 120 ))
	while [ $(cut -d. -f1 /proc/uptime) -lt $end ]; do
		for b in /sys/class/block/sd* /sys/class/block/mmcblk*; do
			[ -e "$b" ] || continue
			n=${b##*/}
			[ -b /dev/$n ] || continue
			if [ -n "$RWREQ" ] && writable $n; then
				[ -e /run/r8s-rw-$n ] && continue
				blockdev --setrw /dev/$n && touch /run/r8s-rw-$n && log "guard: $n ($(sed -n 's/^PARTNAME=//p' $b/uevent)) writable"
				continue
			fi
			if [ -n "$RWREQ" ] && [ ! -e $b/partition ] && holds_writable $n; then
				blockdev --setrw /dev/$n && rm -f /dev/$n && log "guard: $n writable for its vibeos partition, /dev/$n removed"
				continue
			fi
			[ "$(blockdev --getro /dev/$n 2>/dev/null)" = 1 ] || blockdev --setro /dev/$n
		done
		sleep 0.2
	done
) &
GUARD=$!

log "up, kernel $(uname -r)"

# Boot counter (PMU INFORM 0x85c = 0x5238 << 16 | count): the U-Boot shim
# adds one per boot through BOOT and sends the third in a row to Lineage
# Recovery; it is cleared below, once SSH is listening.
BOOTCNT=$(devmem 0x1586085c 32 2>/dev/null)
log "boot counter $BOOTCNT$(grep -q r8s.kexec /proc/cmdline && echo ', kexec')"

# Watchdog: s3c2410_wdt took over the one the shim armed (tmr_atboot=1).
# Fed every 10 s with a 60 s timeout: a hung kernel or a dead feeder resets
# the board, back through U-Boot to the kernel in BOOT.
if [ -c /dev/watchdog0 ]; then
	watchdog -T 60 -t 10 /dev/watchdog0 && log "watchdog: fed every 10 s, resets after 60 s without"
else
	log "watchdog: no /dev/watchdog0, nothing guards this boot"
fi

# The previous boot's console, if ramoops kept one.
ls /sys/fs/pstore/* > /dev/null 2>&1 && { mkdir -p /tmp/pstore; cp /sys/fs/pstore/* /tmp/pstore/ 2>/dev/null; log "pstore: $(ls /sys/fs/pstore | tr '\n' ' ')"; }

IP=172.16.43.1
G=/sys/kernel/config/usb_gadget/g1

gadget() {
	mkdir -p $G && cd $G || return 1
	echo 0x18d1 > idVendor
	echo 0xd001 > idProduct
	mkdir -p strings/0x409
	echo "Samsung" > strings/0x409/manufacturer
	echo "r8s mainline debug" > strings/0x409/product
	echo r8s > strings/0x409/serialnumber
	mkdir -p configs/c.1/strings/0x409
	echo "NCM+RNDIS+ACM" > configs/c.1/strings/0x409/configuration
	echo 500 > configs/c.1/MaxPower
	for f in ncm.usb0 rndis.usb0 acm.usb0; do
		mkdir -p functions/$f 2>/dev/null || { log "gadget: no $f"; continue; }
		# fixed MACs (locally administered), not the S10e's 02:5e:10:e0:00:0x:
		# the PC sees enx025e10e00802 for this phone every boot
		case $f in
		ncm.*)   echo 02:5e:10:e0:08:01 > functions/$f/dev_addr
			 echo 02:5e:10:e0:08:02 > functions/$f/host_addr ;;
		rndis.*) echo 02:5e:10:e0:08:03 > functions/$f/dev_addr
			 echo 02:5e:10:e0:08:04 > functions/$f/host_addr ;;
		esac
		ln -s functions/$f configs/c.1/ 2>/dev/null || log "gadget: no $f"
	done
	cd /
}

bind_udc() {
	for i in $(seq 30); do
		UDC=$(ls /sys/class/udc 2>/dev/null | head -n1)
		[ -n "$UDC" ] && break
		sleep 1
	done
	if [ -z "$UDC" ]; then log "no UDC after 30 s"; return 1; fi
	echo "$UDC" > $G/UDC && log "gadget bound to $UDC"
}

gadget && bind_udc

for n in usb0 usb1; do ip link set $n up 2>/dev/null; done
ip addr add $IP/24 dev usb0 2>/dev/null && log "usb0 $IP"
ip link set lo up

cat > /tmp/udhcpd.conf <<EOC
start 172.16.43.2
end 172.16.43.2
interface usb0
option subnet 255.255.255.0
max_leases 1
lease_file /tmp/udhcpd.leases
EOC
touch /tmp/udhcpd.leases
udhcpd /tmp/udhcpd.conf

# The login shells: telnet and SSH on $IP and a shell on the ACM port, root
# without a password. Only with r8s.debug on the command line.
SHELLS= TTYGS=
if grep -qw r8s.debug /proc/cmdline; then
	SHELLS=1
	telnetd -l /bin/sh -b $IP
	mkdir -p /etc/dropbear
	dropbear -R -B -p $IP:22
	( while true; do
		[ -c /dev/ttyGS0 ] && setsid sh -c 'exec sh </dev/ttyGS0 >/dev/ttyGS0 2>&1'
		sleep 1
	done ) &
	TTYGS=$!
	log "ready: ssh root@$IP (or telnet $IP)"
fi
devmem 0x1586085c 32 0x52380000 && log "boot counter cleared"
if [ -n "$SHELLS" ]; then
	log "reboot2 recovery | reboot2 download | reboot2 (back to U-Boot and BOOT's kernel)"
	log "kexec-try: a test kernel from /tmp (kexec -l IMAGE --dtb DTB -c, then kexec -e)"
fi

# r8s.root=vibeos: the root file system on the partition named vibeos.
# e2fsck -p; grown to the whole partition when it is smaller (the image is
# written shrunk); mounted rw; then switch_root into its /sbin/init. Our
# services stop first. The watchdog feeder is killed WITHOUT the magic close:
# the watchdog core then keeps the hardware fed until systemd opens
# /dev/watchdog-r8s. Drop-ins in /run make a boot that doesn't reach
# multi-user.target in 5 min, or that falls into emergency or rescue mode,
# reboot (back through U-Boot to BOOT's kernel). Nothing about the file system
# stops the boot (owner 11-23: nothing stops the boot to the GUI): a failed
# check gets e2fsck -fy, a failed grow is skipped, a root that does not mount
# gets e2fsck -fy and then a read-only mount, a root left read-only at the
# block layer boots read-only. Only no partition, a root that mounts in no
# way, or no /sbin/init leave this shell up.
boot_root() {
	dev=
	for i in $(seq 50); do
		for u in /sys/class/block/sd*/uevent; do
			grep -qx "PARTNAME=$1" $u 2>/dev/null && { dev=$(sed -n 's/^DEVNAME=//p' $u); break 2; }
		done
		sleep 0.2
	done
	[ -n "$dev" ] || { log "root: no partition named $1"; return 1; }
	for i in $(seq 25); do [ -e /run/r8s-rw-$dev ] && break; sleep 0.2; done
	RW=rw
	if [ "$(blockdev --getro /dev/$dev)" != 0 ]; then
		log "root: /dev/$dev is read-only (no rw-ok for it): booting it read-only, unchecked"; RW=ro
	fi
	log "root: $1 is /dev/$dev, checking"
	if [ $RW = rw ]; then
		e2fsck -p /dev/$dev > /tmp/e2fsck.txt 2>&1; rc=$?
		if [ $rc -gt 1 ]; then
			log "root: e2fsck -p: exit $rc (/tmp/e2fsck.txt), running e2fsck -fy"
			e2fsck -f -y /dev/$dev > /tmp/e2fsck-y.txt 2>&1; log "root: e2fsck -fy: exit $? (/tmp/e2fsck-y.txt)"
		fi
		psz=$(( $(cat /sys/class/block/$dev/size) / 8 ))
		fsz=$(dumpe2fs -h /dev/$dev 2>/dev/null | sed -n 's/^Block count: *//p')
		if [ -n "$fsz" ] && [ $fsz -lt $(( psz - 256 )) ]; then
			log "root: growing $fsz -> $psz 4 KiB blocks"
			e2fsck -f -y /dev/$dev > /tmp/e2fsck-f.txt 2>&1; rc=$?
			if [ $rc -gt 1 ]; then
				log "root: e2fsck -f: exit $rc (/tmp/e2fsck-f.txt), not growing it"
			elif ! resize2fs /dev/$dev > /tmp/resize2fs.txt 2>&1; then
				log "root: resize2fs failed (/tmp/resize2fs.txt), booting it at its old size"
			else
				log "root: $(dumpe2fs -h /dev/$dev 2>/dev/null | sed -n 's/^Block count: *//p') blocks now"
			fi
		fi
	fi
	mkdir -p /newroot
	if ! mount -t ext4 -o $RW,noatime /dev/$dev /newroot; then
		[ $RW = rw ] && { log "root: mount failed, running e2fsck -fy"; e2fsck -f -y /dev/$dev > /tmp/e2fsck-y2.txt 2>&1; }
		if [ $RW = rw ] && mount -t ext4 -o rw,noatime /dev/$dev /newroot; then
			log "root: mounted after e2fsck"
		elif mount -t ext4 -o ro,noatime /dev/$dev /newroot; then
			log "root: mounted READ-ONLY, booting it so"
		else
			log "root: mounts neither read-write nor read-only"; return 1
		fi
	fi
	if [ ! -e /newroot/sbin/init ] && [ ! -L /newroot/sbin/init ]; then
		log "root: no /sbin/init"; umount /newroot; return 1
	fi
	mkdir -p /run/systemd/system/multi-user.target.d /run/systemd/system/emergency.service.d /run/systemd/system/rescue.service.d
	printf '[Unit]\nJobRunningTimeoutSec=300\nJobTimeoutAction=reboot-force\n' > /run/systemd/system/multi-user.target.d/r8s-bringup.conf
	for u in emergency rescue; do
		printf '[Service]\nExecStart=\nExecStart=/bin/sh -c "echo r8s: %s mode, rebooting in 60 s > /dev/kmsg; sleep 60; systemctl reboot --force"\n' $u \
			> /run/systemd/system/$u.service.d/r8s-bringup.conf
	done
	# dead man's switch: unless someone touches /run/r8s-reached (ssh in and
	# touch it) within 10 min, reboot back to BOOT's kernel, so a boot that
	# comes up without a working USB network doesn't need hands
	mkdir -p /run/systemd/system/multi-user.target.wants
	printf '[Unit]\nDescription=r8s bring-up: reboot unless /run/r8s-reached appears within 10 min\n[Service]\nExecStart=/bin/sh -c "sleep 600; [ -e /run/r8s-reached ] || { echo r8s: nobody reached this boot, rebooting > /dev/kmsg; systemctl reboot --force; }"\n' \
		> /run/systemd/system/r8s-deadman.service
	ln -sf ../r8s-deadman.service /run/systemd/system/multi-user.target.wants/r8s-deadman.service
	log "root: switch_root into $1 (/dev/$dev)"
	kill $GUARD 2>/dev/null
	killall dropbear telnetd udhcpd 2>/dev/null
	[ -z "$TTYGS" ] || kill $TTYGS 2>/dev/null
	for q in /proc/[0-9]*; do [ "$(readlink $q/fd/0 2>/dev/null)" = /dev/ttyGS0 ] && kill -9 ${q#/proc/} 2>/dev/null; done
	killall -9 watchdog 2>/dev/null
	umount /tmp 2>/dev/null
	for m in /dev /proc /sys /run; do mount --move $m /newroot$m || log "root: cannot move $m"; done
	exec switch_root /newroot /sbin/init
}
ROOT=$(tr ' ' '\n' < /proc/cmdline | sed -n 's/^r8s\.root=//p' | head -n1)
[ -z "$ROOT" ] || boot_root "$ROOT" || log "root: staying in the initramfs"
log "staying in the initramfs"
[ -n "$SHELLS" ] || log "no login here. For a root shell over USB (telnet or ssh root@$IP): restart holding Volume Down, pick \"Rescue shell (USB)\""

# a shell on the screen too, for when the keys work
while true; do sleep 3600; done
