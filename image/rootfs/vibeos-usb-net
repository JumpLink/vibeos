#!/bin/sh
# vibeos-usb-net [start|stop]: a USB network over the phone's gadget port, the address the initramfs's debug shell
# uses (vibeos.debug=1): this side 172.16.42.1/16, the PC gets 172.16.42.2 by DHCP. The way in when Wi-Fi is not
# there (the modem DSP runs the WLAN firmware on some phones). It offers no service of its own: ssh, telnet or
# anything else answers on 172.16.42.1 only if it is running and listens there.
# Off with `vibeos.usbnet=0` on the kernel command line, or with the file /etc/vibeos/no-usbnet.
# Harmless where there is nothing to do (no USB device controller, USB in host mode, another gadget bound): it
# says so and exits 0. Run twice it changes nothing. The paths can be moved for the test (test/usbnet-test.sh).
set -u
CFG=${VIBEOS_CONFIGFS:-/sys/kernel/config}
UDCD=${VIBEOS_UDC_DIR:-/sys/class/udc}
NETD=${VIBEOS_NET_DIR:-/sys/class/net}
CMDLINE=${VIBEOS_CMDLINE:-/proc/cmdline}
OFF=${VIBEOS_NO_USBNET:-/etc/vibeos/no-usbnet}
RUN=${VIBEOS_RUN:-/run/vibeos}
WAIT=${VIBEOS_WAIT:-10}
ADDR=172.16.42.1 PEER=172.16.42.2
G=$CFG/usb_gadget/vibeos
PID=$RUN/usb-net-dnsmasq.pid
log() { echo "vibeos-usb-net: $*"; }

stop_dhcp() {
	[ -s "$PID" ] && kill "$(cat "$PID")" 2>/dev/null
	rm -f "$PID"
}

if [ "${1:-start}" = stop ]; then
	stop_dhcp
	exit 0
fi

if [ -e "$OFF" ] || grep -qw 'vibeos.usbnet=0' "$CMDLINE" 2>/dev/null; then
	log "off (vibeos.usbnet=0 or $OFF)"
	exit 0
fi

# the controller: some phones list it a moment after the kernel is up
udc=
i=0
while :; do
	udc=$(ls "$UDCD" 2>/dev/null | head -n1)
	[ -n "$udc" ] || [ "$i" -ge "$WAIT" ] && break
	sleep 1; i=$((i + 1))
done
[ -n "$udc" ] || { log "no USB device controller: nothing to do"; exit 0; }

# another gadget on this controller (not the initramfs's "vibeos" one) is somebody's: leave it
for g in "$CFG"/usb_gadget/*; do
	[ -d "$g" ] && [ "$g" != "$G" ] || continue
	[ "$(cat "$g/UDC" 2>/dev/null)" = "$udc" ] && { log "$udc belongs to the gadget ${g##*/}: left alone"; exit 0; }
done

if [ -z "$(cat "$G/UDC" 2>/dev/null)" ]; then
	for m in libcomposite usb_f_ncm usb_f_rndis; do modprobe -q $m 2>/dev/null; done
	[ -d "$CFG/usb_gadget" ] || mount -t configfs configfs "$CFG" 2>/dev/null
	mkdir -p "$G/strings/0x409" "$G/configs/c.1/strings/0x409" 2>/dev/null || { log "no USB gadget support (configfs): nothing to do"; exit 0; }
	echo 0x18d1 > "$G/idVendor"; echo 0xd001 > "$G/idProduct"
	echo VibeOS > "$G/strings/0x409/manufacturer"
	echo "VibeOS" > "$G/strings/0x409/product"
	echo vibeos > "$G/strings/0x409/serialnumber"
	echo "NCM+RNDIS" > "$G/configs/c.1/strings/0x409/configuration"
	for f in ncm.usb0 rndis.usb0; do
		mkdir -p "$G/functions/$f" 2>/dev/null && ln -sfn "$G/functions/$f" "$G/configs/c.1/$f" 2>/dev/null
	done
	echo "$udc" > "$G/UDC" 2>/dev/null || { log "cannot bind $udc (USB in host mode?): nothing to do"; exit 0; }
else
	# the initramfs's debug gadget (vibeos.debug=1) is still bound: it stays
	log "gadget vibeos already bound to $(cat "$G/UDC"): reused"
fi

# the network device the host sees first: usb0, else usb1 (as the initramfs picks it)
n=
i=0
while :; do
	for c in usb0 usb1; do [ -e "$NETD/$c" ] && { n=$c; break; }; done
	[ -n "$n" ] || [ "$i" -ge "$WAIT" ] && break
	sleep 1; i=$((i + 1))
done
[ -n "$n" ] || { log "no usb0/usb1 network device after binding $udc"; exit 0; }
ip link set "$n" up
ip addr replace "$ADDR/16" dev "$n" || { log "cannot give $n $ADDR/16"; exit 0; }

# DHCP for the PC: one address, no router and no DNS (the PC keeps its own route to the Internet)
stop_dhcp
if command -v dnsmasq > /dev/null 2>&1; then
	mkdir -p "$RUN"
	dnsmasq --conf-file=/dev/null --port=0 --interface="$n" --bind-interfaces --except-interface=lo \
		--dhcp-range="$PEER,$PEER,255.255.0.0,12h" --dhcp-option=3 --dhcp-option=6 --dhcp-authoritative \
		--dhcp-leasefile="$RUN/usb-net.leases" --pid-file="$PID" || log "dnsmasq failed: the PC needs $PEER/16 by hand"
else
	log "no dnsmasq: the PC needs $PEER/16 by hand"
fi
log "up: $n $ADDR/16 (the PC gets $PEER)"
