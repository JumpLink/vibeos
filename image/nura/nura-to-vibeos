def unit_commands(text):
    """the programs a unit file runs (Exec* lines, systemd's prefixes stripped)"""
    out = []
    for line in text.splitlines():
        m = re.match(r'\s*Exec(Start|StartPre|StartPost|Stop|StopPost|Reload|Condition)\s*=\s*(.*)', line)
        if m and m.group(2).strip():
            out.append(re.sub(r'^[-@:+!|]+', '', m.group(2).split()[0]))
    return out


def log(*a):
    print(*a, flush=True)


def die(msg):
    raise SystemExit('nura-to-vibeos: ' + msg)


def sha256f(p):
    h = hashlib.sha256()
    with open(p, 'rb') as f:
        for b in iter(lambda: f.read(1 << 20), b''):
            h.update(b)
    return h.hexdigest()


def run(cmd, **kw):
    r = subprocess.run(cmd, capture_output=True, **kw)
    if r.returncode:
        die('%s failed: %s' % (cmd[0], (r.stderr or b'').decode(errors='replace')[-800:]))
    return r.stdout


