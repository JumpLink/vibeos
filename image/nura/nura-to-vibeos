# ---------------------------------------------------------------- inputs
def fetch_listing(url, dest):
    """a Nura build directory: its -boot.img.xz and .img.xz, each checked against the listing's sha256"""
    if not url.endswith('/'):
        url += '/'
    with urllib.request.urlopen(urllib.request.Request(url, headers=UA), timeout=60) as r:
        page = r.read().decode('utf-8', 'replace')
    files = {}
    for m in re.finditer(r'href="([^"/]+\.img\.xz)\.sha256"\s*>\s*sha256\s*(?:</a>)?\s*:\s*([0-9a-f]{64})', page):
        files[html.unescape(m.group(1))] = m.group(2)
    if not files:
        die('no .img.xz with a sha256 in %s' % url)
    os.makedirs(dest, exist_ok=True)
    out = []
    for name, sha in sorted(files.items()):
        p = os.path.join(dest, name)
        if os.path.isfile(p) and not os.path.islink(p) and sha256f(p) == sha:
            log('  %s: downloaded before, sha256 as listed' % name)
            out.append(p)
            continue
        log('  downloading %s' % name)
        with urllib.request.urlopen(urllib.request.Request(url + name, headers=UA), timeout=600) as r, \
                open(p + '.part', 'wb') as f:
            shutil.copyfileobj(r, f, 1 << 20)
        if sha256f(p + '.part') != sha:
            die('%s: sha256 differs from the listing' % name)
        os.rename(p + '.part', p)
        out.append(p)
    return out, url


def build_stamp(names):
    for n in names:
        m = re.search(r'(\d{8}-\d{4})', os.path.basename(n))
        if m:
            return m.group(1)
    return time.strftime('%Y%m%d')


# ---------------------------------------------------------------- the image
class Nura:
    def __init__(self, work):
        self.w = work
        self.notes, self.carried, self.not_carried = [], [], []

    def unpack(self, files):
        self.bootimg = self.disk = None
        for f in files:
            base = os.path.basename(f)
            if re.search(r'-boot\.img(\.xz)?$', base):
                dst = os.path.join(self.w, 'nura-boot.img')
                extract.unxz(f, dst)
                self.bootimg = dst
            elif re.search(r'\.img(\.xz)?$', base):
                dst = os.path.join(self.w, 'nura-disk.img')
                kind = extract.unxz(f, dst)
                self.disk = dst
                log('  %s: %s image, %d MiB' % (base, kind, os.path.getsize(dst) >> 20))
            else:
                die('%s: neither a -boot.img(.xz) nor an .img(.xz)' % base)
        if not self.disk:
            die('the full image (.img.xz) is needed: the modules, firmware and device files are in it')
        parts = extract.partitions(self.disk)
        if not parts:
            die('%s: no partition table' % self.disk)
        self.parts = parts
        roots = [p for p in parts if p['label'] == 'pmOS_root'] or \
                [p for p in parts if p['fs'] in ('ext4', 'btrfs') and p['type'] in ('root-arm64', 'linux')]
        boots = [p for p in parts if p['label'] == 'pmOS_boot'] or \
                [p for p in parts if p['fs'] in ('vfat', 'ext4') and p['type'] in ('esp', 'xbootldr', 'linux')
                 and p not in roots]
        if not roots or not boots:
            die('no pmOS boot and root partitions: %s' % [(p['name'], p['fs'], p['label']) for p in parts])
        self.root, self.boot = max(roots, key=lambda p: p['size']), boots[0]
        if self.root['fs'] != 'ext4':
            die('the root is %s: only ext4 roots are read (debugfs)' % self.root['fs'])
        self.spec = extract.ext4_spec(self.disk, self.root['offset'])

    def read_root(self):
        s = self.spec
        db = None
        for p in ('/lib/apk/db/installed', '/usr/lib/apk/db/installed'):
            b = extract.ext4_cat(s, extract.resolve(s, p))
            if b:
                db = b.decode('utf-8', 'replace'); break
        if not db:
            die('no apk database in the root (/lib/apk/db/installed)')
        self.pkgs = apkdb.parse(db)
        di = ''
        for p in ('/usr/share/deviceinfo/deviceinfo', '/etc/deviceinfo'):
            b = extract.ext4_cat(s, extract.resolve(s, p))
            if b:
                di += b.decode('utf-8', 'replace') + '\n'
        self.deviceinfo_text = di
        self.di = extract.deviceinfo(di)
        if not self.di.get('codename'):
            die('no deviceinfo in the root')
        self.codename = self.di['codename']
        # the trees, each into a new directory of its own
        R = self.rootdir = os.path.join(self.w, 'root')
        os.makedirs(R)
        self.trees = {}
        for t in ('/usr/lib/modules', '/usr/lib/firmware', '/usr/share/qcom', '/usr/share/alsa', '/usr/lib/udev',
                  '/etc/udev', '/usr/lib/modprobe.d', '/etc/modprobe.d', '/usr/lib/modules-load.d',
                  '/etc/modules-load.d', '/etc/UPower', '/usr/share/wireplumber', '/etc/wireplumber',
                  '/etc/environment.d', '/usr/lib/environment.d', '/usr/share/feedbackd', '/usr/share/iio-sensor-proxy',
                  '/usr/lib/systemd/system-preset', '/usr/lib/systemd/system', '/usr/lib/systemd/user',
                  '/usr/share/hexagonrpcd', '/usr/share/q6voiced', '/usr/lib/kernel-cmdline.d', '/usr/share/mkinitfs',
                  '/usr/share/deviceinfo'):
            d = extract.ext4_rdump(s, t, os.path.join(R, t.strip('/').replace('/', '_')))
            if d:
                self.trees[t.strip('/')] = d
        md = self.trees.get('usr/lib/modules')
        self.kvers = sorted(k for k in os.listdir(md) if os.path.isfile(os.path.join(md, k, 'modules.dep'))) if md else []
        mi = extract.ext4_cat(s, extract.resolve(s, '/etc/machine-info'))
        self.machine_info = mi.decode('utf-8', 'replace') if mi else ''

    def tree_file(self, rel):
        """a path of the root (no leading /) -> its dumped copy, or None"""
        for t, d in self.trees.items():
            if rel == t or rel.startswith(t + '/'):
                p = os.path.join(d, rel[len(t):].lstrip('/'))
                return p if os.path.lexists(p) else None
        return None

    def read_boot(self):
        b = self.boot
        dest = os.path.join(self.w, 'bootpart')
        if b['fs'] == 'vfat':
            extract.fat_copy(self.disk, b['offset'], dest)
            self.bootdir = dest
        else:
            self.bootdir = extract.ext4_rdump(extract.ext4_spec(self.disk, b['offset']), '/', dest) or dest
        entries = []
        ld = os.path.join(self.bootdir, 'loader', 'entries')
        if os.path.isdir(ld):
            for n in sorted(os.listdir(ld)):
                p = os.path.join(ld, n)
                if os.path.isfile(p) and not os.path.islink(p):
                    entries.append(extract.read_nofollow(p).decode('utf-8', 'replace'))
        self.loader_entries = entries
        if not self.bootimg:
            p = os.path.join(self.bootdir, 'boot.img')
            if os.path.isfile(p) and not os.path.islink(p):
                self.bootimg = p
                self.notes.append('boot.img: from the image\'s boot partition (no -boot.img.xz given)')


# ---------------------------------------------------------------- the boot image
def clean_cmdline(c):
    """Nura's command line without pmOS's own parameters, and with Plymouth off: Nura's splash settings are for
    pmOS's boot, and Debian's plymouthd they start in VibeOS crashed the OnePlus 6T's first boot (it stopped at a
    maps: dump of /usr/sbin/plymouthd)"""
    keep, dropped = [], []
    for t in c.split():
        if t.startswith(('pmos_', 'pmos.', 'plymouth.')) or t.split('=')[0] in ('root', 'rootfstype', 'rootflags',
                                                                                'init', 'initrd', 'rw', 'ro', 'splash'):
            dropped.append(t)
        else:
            keep.append(t)
    return ' '.join(keep + ['plymouth.enable=0']), dropped


def device_row(nura_dev):
    p = os.path.join(HERE, 'data', 'devices.txt')
    for line in open(p, encoding='utf-8'):
        f = line.split()
        if f and not f[0].startswith('#') and f[0] == nura_dev:
            return {'android': f[1].split(','), 'dtb': None if f[2] == '-' else f[2],
                    'layout': None if f[3] == '-' else f[3],
                    'panels': [] if len(f) < 5 or f[4] == '-' else f[4].split(','),
                    'dtbo': 'clear' if len(f) > 5 and f[5] == 'clear' else None,
                    'mask': [] if len(f) < 7 or f[6] == '-' else f[6].split(','),
                    'watchdog': len(f) > 7 and f[7] == 'reset'}
    return None


def mask_units(P, units):
    """the units masked in the payload root P, as empty files under /etc/systemd/system (see the presets in
    build_payload); the ones it masked, without those already there"""
    d, done = os.path.join(P, 'etc/systemd/system'), []
    for unit in units:
        if not unit.endswith(('.service', '.socket', '.timer')) or '/' in unit or '*' in unit:
            die('devices.txt: mask %r: not a unit name' % unit)
        os.makedirs(d, exist_ok=True)
        if not os.path.lexists(os.path.join(d, unit)):
            open(os.path.join(d, unit), 'wb').close()
            done.append(unit)
    return done


def watchdog_dropins(P):
    """the two systemd settings of a phone whose reboot can hang in the modem's shutdown path (table column
    watchdog): the hardware watchdog resets it, and rmtfs's stop no longer waits the default 90 s"""
    for rel, body in (
        ('etc/systemd/system.conf.d/90-fajita-watchdog.conf',
         '# qcom_wdt accepts at most 31 s. A reboot that hangs in the modem/rmtfs shutdown path is reset by the\n'
         '# hardware watchdog instead of hanging forever.\n[Manager]\nRuntimeWatchdogSec=30s\nRebootWatchdogSec=30s\n'),
        ('etc/systemd/system/rmtfs.service.d/90-fajita-stop.conf',
         '# rmtfs blocks its stop for the default 90 s when the modem is gone.\n[Service]\nTimeoutStopSec=15s\n')):
        os.makedirs(os.path.dirname(os.path.join(P, rel)), exist_ok=True)
        with open(os.path.join(P, rel), 'w') as f:
            f.write(body)


def kernel_from_vmlinuz(v):
    """an Image.gz for the ABL from pmOS's vmlinuz: as it is when gzip or a plain Image (then gzipped), the
    payload of an EFI zboot image otherwise"""
    if v[:2] == b'\x1f\x8b':
        return v, 'vmlinuz (Image.gz)'
    if v[56:60] == b'ARM\x64':
        return gzip.compress(v, 9, mtime=0), 'vmlinuz (Image, gzipped here)'
    if v[:2] == b'MZ' and v[4:8] == b'zimg':
        off, size = struct.unpack_from('<II', v, 8)
        comp = v[24:56].split(b'\0')[0].decode()
        payload = v[off:off + size]
        if comp == 'gzip':
            img = gzip.decompress(payload)
        elif comp == 'zstd':
            img = subprocess.run(['zstd', '-dc'], input=payload, capture_output=True, check=True).stdout
        else:
            die('vmlinuz: EFI zboot with %s: not supported' % comp)
        return gzip.compress(img, 9, mtime=0), 'vmlinuz (EFI zboot %s, its Image gzipped here)' % comp
    die('vmlinuz: not an arm64 Image, Image.gz or EFI zboot image')


def plan_boot(nura, args, row):
    """the header (addresses, page size, version, os_version, dtb...) and the kernel section of the new image"""
    r = {}
    if nura.bootimg:
        d = open(nura.bootimg, 'rb').read()
        h = bootimg.parse(d)
        if h['header_version'] > 2:
            die('Nura\'s boot.img is header v%d (vendor_boot devices): not supported yet' % h['header_version'])
        r.update(source='Nura boot.img', header=h, kernel=h['kernel'], cmdline=h['cmdline'].decode())
        fmt, img, clen, dtbs = bootimg.split_kernel(h['kernel'])
        r.update(kfmt=fmt, image=img, dtbs=dtbs)
        if h.get('dtb'):
            r['dtb_section'] = h['dtb']
        return r
    # no boot.img: built from the boot partition and deviceinfo (or the device table's layout)
    di = nura.di
    v = os.path.join(nura.bootdir, 'vmlinuz')
    if not os.path.isfile(v):
        die('no boot.img and no vmlinuz in the boot partition')
    kgz, how = kernel_from_vmlinuz(extract.read_nofollow(v))
    want = args.dtb or (row and row['dtb']) or (di.get('dtb', '').split() or [None])[0]
    if not want:
        die('which DTB? (--dtb qcom/NAME.dtb)')
    if not want.endswith('.dtb') and '*' not in want:
        want += '.dtb'
    cands = []
    for rel, st in extract.walk(os.path.join(nura.bootdir, 'dtbs')):
        if stat.S_ISREG(st.st_mode) and fnmatch.fnmatch(rel, want):
            cands.append(rel)
    if not cands:
        alln = sorted(rel for rel, st in extract.walk(os.path.join(nura.bootdir, 'dtbs')) if rel.endswith('.dtb'))
        die('no DTB %s in the image\'s dtbs/ (it has %d: %s)' % (want, len(alln), ' '.join(alln)))
    panels = (row or {}).get('panels') or []
    phone = re.sub(r'\s*\([^)]*\)$', '', bootimg.dtb_model(extract.read_nofollow(os.path.join(nura.bootdir, 'dtbs', cands[0])))[0] or '')
    r['model'] = phone or nura.di.get('name', 'phone')
    if len(cands) > 1 and args.panel:
        cands = [c for c in cands if args.panel.lower() in os.path.basename(c).lower()]
        if not cands:
            die('no DTB for the %s panel among %s' % (args.panel, want))
    if len(cands) > 1:
        if panels:
            die('the %s comes with different panels, one DTB each: %s. Which panel this phone has: in LineageOS '
                'recovery (adb shell) or Android, "cat /proc/cmdline" names it in msm_drm.dsi_display0=... '
                '(e.g. dsi_nt36672c_huaxing_fhd_video_display: huaxing). Then --panel %s'
                % (r['model'], ' '.join(cands), '|'.join(panels)))
        die('more than one DTB matches %s: %s (--dtb picks one)' % (want, ' '.join(cands)))
    r['panel'] = next((pn for pn in panels if pn in os.path.basename(cands[0]).lower()), None)
    dtb = extract.read_nofollow(os.path.join(nura.bootdir, 'dtbs', cands[0]))
    if row and row['layout']:
        hv, ps, ka, ra, sa, ta, da = row['layout'].split(':')
        lay = dict(header_version=int(hv), page_size=int(ps), kernel_addr=int(ka, 16), ramdisk_addr=int(ra, 16),
                   second_addr=int(sa, 16), tags_addr=int(ta, 16), dtb_addr=int(da, 16))
        lsrc = 'the device table (data/devices.txt)'
        if args.header is not None and args.header != lay['header_version']:
            lay['header_version'] = args.header
            lsrc += ', header v%d by --header' % args.header
    elif di.get('flash_offset_kernel'):
        base = int(di.get('flash_offset_base', '0'), 16)
        lay = dict(header_version=int(di.get('header_version', '0')), page_size=int(di.get('flash_pagesize', '2048')),
                   kernel_addr=base + int(di['flash_offset_kernel'], 16),
                   ramdisk_addr=base + int(di['flash_offset_ramdisk'], 16),
                   second_addr=base + int(di.get('flash_offset_second', '0'), 16),
                   tags_addr=base + int(di['flash_offset_tags'], 16),
                   dtb_addr=base + int(di.get('flash_offset_dtb', '0'), 16))
        lsrc = 'deviceinfo'
    else:
        die('no boot.img, and neither deviceinfo nor data/devices.txt gives the boot image layout')
    h = dict(lay, name=b'\0' * 16, os_version=0, second=b'', recovery_dtbo=b'', dtb=b'')
    append = di.get('append_dtb', 'false') == 'true' or lay['header_version'] < 2
    if lay['header_version'] >= 2 and not append:
        h['dtb'] = dtb
        kernel = kgz
    else:
        kernel = kgz + dtb
    cmd = ''
    for e in nura.loader_entries:
        m = re.search(r'^options\s+(.*)$', e, re.M)
        if m:
            cmd = m.group(1).strip(); break
    if not cmd:
        cmd = di.get('kernel_cmdline', '')
        nura.notes.append('command line: deviceinfo_kernel_cmdline (no systemd-boot entry)')
    fmt, img, clen, dtbs = bootimg.split_kernel(kernel)
    r.update(source='built here: %s, DTB %s, layout from %s' % (how, cands[0], lsrc), header=h, kernel=kernel,
             cmdline=cmd, kfmt=fmt, image=img, dtbs=dtbs, dtb_name=cands[0])
    if h['dtb']:
        r['dtb_section'] = h['dtb']
    return r


# cfg80211 checks /lib/firmware/regulatory.db against the signers built into it. A kernel not built by Debian has the
# upstream wireless-regdb signers only, and Debian's wireless-regdb defaults to its own re-signed copy
# (regulatory.db-debian, README.Debian): such a kernel needs the system's regulatory.db-upstream
REGDB_UPSTREAM = (b'sforshee', b'wens')
REGDB_DEBIAN = b'benh@debian.org'


def regdb_signers(moddir, image):
    """'upstream', 'debian' or 'none' (cfg80211 names no signer), or None when there is no cfg80211"""
    body = None
    for rel, st in extract.walk(moddir):
        if re.search(r'(^|/)cfg80211\.ko(\.\w+)?$', rel) and stat.S_ISREG(st.st_mode):
            body = unzst(extract.read_nofollow(os.path.join(moddir, rel)))
            break
    if body is None and image and b'regulatory.db' in image:
        body = image  # built in
    if body is None:
        return None
    if REGDB_DEBIAN in body:
        return 'debian'
    return 'upstream' if any(k in body for k in REGDB_UPSTREAM) else 'none'


# ---------------------------------------------------------------- modules
def mod_name(path):
    return re.sub(r'\.ko(\.(zst|xz|gz))?$', '', os.path.basename(path)).replace('-', '_')


def unzst(b):
    if b[:4] == b'\x28\xb5\x2f\xfd':
        return subprocess.run(['zstd', '-dcq'], input=b, capture_output=True, check=True).stdout
    if b[:6] == b'\xfd7zXZ\0':
        import lzma
        return lzma.decompress(b)
    if b[:2] == b'\x1f\x8b':
        return gzip.decompress(b)
    return b


def vermagic(ko):
    i = ko.find(b'vermagic=')
    return ko[i + 9:ko.index(b'\0', i)].decode(errors='replace') if i >= 0 else None


def check_modules(moddir, kver, sample=None):
    """(count, mismatches) of the modules' vermagic against kver (each module decompressed, nothing loaded)"""
    files = [os.path.join(r, f) for r, _, fs in os.walk(moddir) for f in fs if re.search(r'\.ko(\.\w+)?$', f)]
    bad, n = [], 0
    # all zstd modules in one zstd run per batch: decompressing 1000+ one by one is slow
    for f in files if sample is None else files[:sample]:
        vm = vermagic(unzst(extract.read_nofollow(f)))
        n += 1
        if not vm or vm.split()[0] != kver:
            bad.append((os.path.relpath(f, moddir), vm))
    return n, bad


# ---------------------------------------------------------------- the initramfs
def initramfs(nura, kver, moddir, busybox, out_conf, comp, skip=frozenset()):
    """our initramfs: busybox, vibeos-loop, /init; the modules and firmware pmOS's initramfs had, plus the USB
    gadget and loop/ext4 ones (with what they depend on), decompressed for busybox's modprobe"""
    W = cpio.Writer()
    for d in ('bin', 'dev', 'etc', 'lib', 'lib/modules', 'proc', 'run', 'sys', 'tmp', 'newroot', 'sbin', 'usr',
              'usr/bin', 'usr/sbin'):
        W.dir(d)
    W.chardev('dev/console', 0o600, 5, 1)
    W.chardev('dev/null', 0o666, 1, 3)
    W.file('init', open(os.path.join(HERE, 'initramfs', 'init'), 'rb').read(), 0o755)
    W.file('bin/busybox', busybox, 0o755)
    W.file('bin/vibeos-loop', open(os.path.join(HERE, 'initramfs', 'vibeos-loop.aarch64'), 'rb').read(), 0o755)
    W.file('etc/mdev.conf', b'$MODALIAS=.*\t0:0 0660 @modprobe -q -b "$MODALIAS"\n')
    W.file('etc/vibeos-initramfs.conf', out_conf.encode())
    # pmOS's initramfs: what it loads and carries
    pm = None
    for p in (os.path.join(nura.bootdir, 'initramfs'),):
        if os.path.isfile(p) and not os.path.islink(p):
            pm = cpio.read(unzst(extract.read_nofollow(p)))
    if pm is None:
        nura.notes.append('initramfs: the boot partition has no pmOS initramfs to take the early module list from')
        pm = []
    early_load, pm_mods, pm_fw = [], set(), {}
    for name, mode, body in pm:
        n = name.lstrip('./')
        if n.endswith('lib/modules/initramfs.load'):
            early_load = [l.strip() for l in body.decode(errors='replace').splitlines() if l.strip()]
        elif re.search(r'\.ko(\.\w+)?$', n) and stat.S_ISREG(mode):
            pm_mods.add(mod_name(n))
        elif re.match(r'(usr/)?lib/firmware/', n) and stat.S_ISREG(mode):
            if 'usr/lib/firmware/' + re.sub(r'^(usr/)?lib/firmware/', '', n) not in skip:
                pm_fw[re.sub(r'^(usr/)?lib/firmware/', '', n)] = body
    dep = {}
    for line in open(os.path.join(moddir, 'modules.dep'), encoding='utf-8', errors='replace'):
        k, _, v = line.partition(':')
        dep[k.strip()] = v.split()
    byname = {mod_name(k): k for k in dep}
    want = set(pm_mods) | {mod_name(m) for m in early_load} | {
        'libcomposite', 'usb_f_ncm', 'usb_f_rndis', 'usb_f_acm', 'u_ether', 'u_serial', 'loop', 'dm_mod', 'ext4',
        'jbd2', 'mbcache', 'crc16', 'crc32c_generic', 'f2fs', 'nls_utf8'}
    todo, take = [byname[m] for m in sorted(want) if m in byname], set()
    while todo:
        k = todo.pop()
        if k in take:
            continue
        take.add(k)
        todo.extend(dep.get(k, []))
    base = 'lib/modules/%s' % kver
    W.dir(base)
    made = set()
    for k in sorted(take):
        parts = k.split('/')
        for i in range(1, len(parts)):
            d = base + '/' + '/'.join(parts[:i])
            if d not in made:
                W.dir(d); made.add(d)
        W.file(base + '/' + re.sub(r'\.(zst|xz|gz)$', '', k), unzst(extract.read_nofollow(os.path.join(moddir, k))))
    plain = lambda k: re.sub(r'\.(zst|xz|gz)$', '', k)
    W.file(base + '/modules.dep', ''.join('%s: %s\n' % (plain(k), ' '.join(plain(x) for x in dep[k]))
                                         for k in sorted(take)).encode())
    names = {mod_name(k) for k in take}
    al = []
    p = os.path.join(moddir, 'modules.alias')
    if os.path.isfile(p):
        for line in open(p, encoding='utf-8', errors='replace'):
            f = line.split()
            if len(f) == 3 and f[0] == 'alias' and f[2].replace('-', '_') in names:
                al.append(line)
    W.file(base + '/modules.alias', ''.join(al).encode())
    for f in ('modules.builtin', 'modules.builtin.modinfo', 'modules.order'):
        p = os.path.join(moddir, f)
        if os.path.isfile(p) and not os.path.islink(p):
            W.file(base + '/' + f, extract.read_nofollow(p))
    W.file('lib/modules/initramfs.load', ''.join(m + '\n' for m in early_load).encode())
    fwd = set()
    for rel in sorted(pm_fw):
        rel2 = re.sub(r'^postmarketos/', 'updates/', rel)
        parts = ('lib/firmware/' + rel2).split('/')
        for i in range(2, len(parts)):
            d = '/'.join(parts[:i])
            if d not in fwd:
                W.dir(d); fwd.add(d)
        W.file('lib/firmware/' + rel2, pm_fw[rel])
    raw = W.bytes()
    if comp == 'zstd':
        data = subprocess.run(['zstd', '-q', '-19', '-c'], input=raw, capture_output=True, check=True).stdout
    elif comp == 'xz':
        import lzma
        data = lzma.compress(raw, check=lzma.CHECK_CRC32)
    else:
        data = gzip.compress(raw, 9, mtime=0)
    info = {'modules': sorted(plain(k) for k in take), 'early_load': early_load, 'firmware': sorted(pm_fw),
            'raw_size': len(raw), 'size': len(data), 'compression': comp}
    return data, info


def initramfs_compression(nura):
    p = os.path.join(nura.bootdir, 'initramfs')
    if os.path.isfile(p) and not os.path.islink(p):
        h = open(p, 'rb').read(6)
        if h[:4] == b'\x28\xb5\x2f\xfd':
            return 'zstd'
        if h[:6] == b'\xfd7zXZ\0':
            return 'xz'
    return 'gzip'


# ---------------------------------------------------------------- the device layer
class Payload:
    def __init__(self, P, system_files, nura):
        self.P, self.sys, self.nura = P, system_files, nura
        self.carried, self.kept_system, self.not_carried = [], [], []

    def add(self, src, rel, why):
        """src (a dumped file or symlink) -> /rel, unless the system image's packages own /rel"""
        if '/' + rel in self.sys:
            self.kept_system.append((rel, why))
            extract.copy_entry(src, os.path.join(self.P, 'usr/share/vibeos-device/nura/system-has', rel))
            return False
        extract.copy_entry(src, os.path.join(self.P, rel))
        self.carried.append((rel, why))
        return True


def merged_usr(f):
    """an apk database path as it is on pmOS's merged-/usr root (/lib -> usr/lib, /bin and /sbin -> usr/bin)"""
    for a, b in (('lib/', 'usr/lib/'), ('bin/', 'usr/bin/'), ('sbin/', 'usr/bin/'), ('usr/sbin/', 'usr/bin/')):
        if f.startswith(a):
            return b + f[len(a):]
    return f


def device_packages(nura):
    c = nura.codename
    out = []
    for n, p in nura.pkgs.items():
        if n == 'device-' + c or n.startswith('device-' + c + '-') or n.startswith(('firmware-', 'soc-', 'alsa-ucm-conf-')) \
                or n.startswith('linux-firmware'):
            out.append(n)
    return sorted(out)


def ucm_relevant(rel, words):
    low = rel.lower()
    return any(w in low for w in words)


def other_phones_files(nura, dev):
    """a generic SoC image carries the firmware of every phone it boots (firmware-<vendor>-<phone>): the files of
    the packages for phones other than dev, by the phones its dtbs/ names"""
    phones = set()
    for rel, st in extract.walk(os.path.join(nura.bootdir, 'dtbs')):
        m = re.match(r'(?:.*/)?[a-z]+\d+-([a-z0-9]+)-([a-z0-9]+)', rel)
        if m:
            phones.add('%s-%s' % m.groups())
    skip, pkgs = set(), []
    for n, p in nura.pkgs.items():
        m = re.match(r'firmware-([a-z0-9]+-[a-z0-9]+)$', n)
        if m and m.group(1) in phones and m.group(1) != dev:
            pkgs.append(n)
            skip.update(merged_usr(f) for f in p['files'])
    return skip, sorted(pkgs)


def build_payload(nura, args, P, kver, moddir, system_files, soc, skip=frozenset(), system=None, row=None):
    pl = Payload(P, system_files, nura)
    # the kernel's modules, as Nura has them (its modules.* indexes too; depmod runs again on the device)
    dst = os.path.join(P, 'usr/lib/modules', kver)
    for rel, st in extract.walk(moddir):
        if rel in ('build', 'source'):
            continue
        extract.copy_entry(os.path.join(moddir, rel), os.path.join(dst, rel))
    # every firmware file of the image (postmarketos/ is pmOS's override path: the kernel's own is updates/)
    fwroot = nura.trees.get('usr/lib/firmware')
    nfw = 0
    if fwroot:
        for rel, st in extract.walk(fwroot):
            if stat.S_ISDIR(st.st_mode) or 'usr/lib/firmware/' + rel in skip:
                continue
            rel2 = re.sub(r'^postmarketos/', 'updates/', rel)
            if pl.add(os.path.join(fwroot, rel), 'usr/lib/firmware/' + rel2, 'firmware'):
                nfw += 1
    # the device's DSP files (hexagonrpcd's sensor registry, the ADSP/CDSP libraries, the audio calibration)
    qroot = nura.trees.get('usr/share/qcom')
    if qroot:
        for rel, st in extract.walk(qroot):
            if not stat.S_ISDIR(st.st_mode) and 'usr/share/qcom/' + rel not in skip:
                pl.add(os.path.join(qroot, rel), 'usr/share/qcom/' + rel, 'DSP files (/usr/share/qcom)')
    # the files of the device's own packages
    words = {w.lower() for w in re.split(r'[-_ ]', nura.codename + ' ' + nura.dev) if len(w) > 2}
    words |= {soc.lower()} if soc else set()
    model = nura.di.get('name', '')
    if model:
        words.add(model.lower())
    words.discard('google'); words.discard('xiaomi'); words.discard('oneplus')
    dev_words = {nura.codename.split('-', 1)[-1].lower(), model.lower()} - {''}
    phone = nura.dev.split('-', 1)[-1].lower()
    sys_ucm = sorted({m.group(1) for m in (re.match(r'(/usr/share/alsa/ucm2/[^/]+/%s)(/|$)' % re.escape(phone), f.lower())
                                          for f in system_files) if m})
    owned = {}
    for n in device_packages(nura):
        for f in nura.pkgs[n]['files']:
            owned.setdefault(merged_usr(f), n)
    mask, hexa, presets, units = [], {}, [], []
    for rel in sorted(owned):
        pkg = owned[rel]
        if rel.startswith(('usr/lib/firmware/', 'usr/lib/modules/', 'boot/', 'usr/share/qcom/')):
            continue  # whole trees above / the kernel
        src = nura.tree_file(rel)
        kind = next((k for pre, k in CARRY if rel.startswith(pre)), None)
        if rel.startswith('usr/lib/systemd/system-preset/') and src:
            for line in extract.read_nofollow(src).decode(errors='replace').splitlines():
                m = FIRST_BOOT_UNITS_FROM_PRESET.match(line)
                if m:
                    presets.append((m.group(1), m.group(2), pkg))
            continue
        if rel.startswith('usr/share/hexagonrpcd/') and src and os.path.isfile(src) and not os.path.islink(src):
            for k, v in extract.deviceinfo(re.sub(r'^hexagonrpcd_', 'deviceinfo_hexagonrpcd_',
                                                  extract.read_nofollow(src).decode(errors='replace'), flags=re.M)).items():
                hexa[k] = v
            pl.carried.append((rel + ' -> hexagonrpcd.service drop-in', pkg))
            continue
        if rel == 'etc/machine-info' or rel.startswith(('usr/share/deviceinfo/', 'usr/lib/kernel-cmdline.d/',
                                                        'usr/share/mkinitfs/')):
            continue  # identity, the boot image, the initramfs: used above
        if kind is None and src and re.match(r'usr/lib/systemd/(system|user)/[^/]+\.(service|timer|path)$', rel) \
                and pkg.startswith(('device-', 'soc-')) and not any(pkg.startswith(k) for k in NO_DEBIAN) \
                and os.path.isfile(src) and not os.path.islink(src):
            units.append((rel, src, pkg))
            continue
        if kind is None or src is None:
            pl.not_carried.append((rel, pkg))
            continue
        if kind == 'ucm' and sys_ucm:
            continue  # the system's alsa-ucm-conf has this phone: none of pmOS's fork, not to mix the two
        if kind == 'ucm' and pkg.startswith('alsa-ucm-conf') and not ucm_relevant(rel, words | dev_words):
            continue  # pmOS's alsa-ucm-conf fork: only this device's and its SoC's parts
        pl.add(src, rel, pkg)
    ucm_fork = ([n for n in device_packages(nura) if n.startswith('alsa-ucm-conf')], sys_ucm)
    # a device package's own units: carried when what they run is here, a shell script of the same packages or a
    # program the system has; enabled by the package's postinst when they have an [Install] section
    enable = []
    for rel, src, pkg in units:
        text = extract.read_nofollow(src).decode('utf-8', 'replace')
        why, scripts = None, []
        for c in unit_commands(text):
            if c.startswith('/'):
                r2 = merged_usr(c.lstrip('/'))
                body = b''
                if owned.get(r2):  # one of the device packages' files: read from the image (regular files only)
                    body = extract.ext4_cat(nura.spec, extract.resolve(nura.spec, '/' + r2)) or b''
                if body.startswith((b'#!/bin/sh', b'#!/usr/bin/env sh')) and len(body) < 65536:
                    scripts.append((r2, body))
                    continue
                base = os.path.basename(c) if os.path.dirname(r2) in ('usr/bin', 'usr/sbin') else None
            else:
                base = c
            dp = SYSTEM_CMDS.get(base or '')
            if not dp or system is None or dp not in system.ver:
                why = 'runs %s: not in the system image%s' % (c, '' if c.startswith('/') else ' (or not known here)')
                break
        if why:
            pl.not_carried.append(('%s (%s)' % (rel, why), pkg))
            continue
        for r2, body in scripts:
            os.makedirs(os.path.dirname(os.path.join(P, r2)), exist_ok=True)
            with open(os.path.join(P, r2), 'wb') as f:
                f.write(body)
            os.chmod(os.path.join(P, r2), 0o755)
            pl.carried.append((r2, pkg))
            pl.not_carried[:] = [x for x in pl.not_carried if x[0] != r2]
        if pl.add(src, rel, pkg) and re.search(r'^\s*WantedBy\s*=', text, re.M):
            enable.append(('--user ' if '/user/' in rel else '') + os.path.basename(rel))
    # bootmac is not in Debian: its Bluetooth half is vibeos-bt-addr (a QCA controller without an address stays hidden)
    if 'bootmac' in nura.pkgs:
        for name, dst, mode in (('vibeos-bt-addr', 'usr/libexec/vibeos-bt-addr', 0o755),
                                ('vibeos-bt-addr.service', 'usr/lib/systemd/system/vibeos-bt-addr.service', 0o644)):
            os.makedirs(os.path.dirname(os.path.join(P, dst)), exist_ok=True)
            shutil.copy(os.path.join(HERE, 'data', 'bt-addr', name), os.path.join(P, dst))
            os.chmod(os.path.join(P, dst), mode)
            pl.carried.append((dst, 'bootmac (replaced by vibeos-bt-addr)'))
        enable.append('vibeos-bt-addr.service')
    # q6voiced is not in Debian: without what it does, a call connects and stays silent both ways
    if 'q6voiced' in nura.pkgs:
        need = [d for d in ('python3-gi', 'libasound2t64') if system is None or d not in system.ver]
        if need:
            pl.not_carried.append(('vibeos-q6voiced (needs %s: not in the system image, or not known here)'
                                   % ', '.join(need), 'q6voiced'))
        else:
            for name, dst, mode in (('vibeos-q6voiced', 'usr/libexec/vibeos-q6voiced', 0o755),
                                    ('vibeos-q6voiced.service', 'usr/lib/systemd/system/vibeos-q6voiced.service', 0o644),
                                    ('vibeos-q6voiced.sysusers', 'usr/lib/sysusers.d/vibeos-q6voiced.conf', 0o644)):
                os.makedirs(os.path.dirname(os.path.join(P, dst)), exist_ok=True)
                shutil.copyfile(os.path.join(HERE, 'data', 'q6voice', name), os.path.join(P, dst))
                os.chmod(os.path.join(P, dst), mode)
                pl.carried.append((dst, 'q6voiced (replaced by vibeos-q6voiced)'))
            enable.append('vibeos-q6voiced.service')
    nura.enable_units = enable
    # no pmOS config naming the DSP files' directory (a generic image's hexagonrpcd finds it itself; Debian's
    # wrapper passes -R, by default a droid-juicer path): this phone's directory under /usr/share/qcom
    if 'hexagonrpcd_fw_dir' not in hexa and 'hexagonrpcd' in nura.pkgs:
        q = os.path.join(P, 'usr/share/qcom')
        cand = sorted(os.path.join('/usr/share/qcom', rel) for rel, st in extract.walk(q)
                      if rel.count('/') == 2 and rel.split('/')[2].lower() == phone and
                      os.path.isdir(os.path.join(q, rel))) if os.path.isdir(q) else []
        if len(cand) == 1:
            hexa['hexagonrpcd_fw_dir'] = cand[0]
            pl.carried.append(('hexagonrpcd_fw_dir=%s (this phone\'s DSP files; the image has no hexagonrpcd config)' % cand[0], 'hexagonrpcd'))
        else:
            pl.not_carried.append(('hexagonrpcd: no config and %d directories for %s under /usr/share/qcom: the sensors '
                                   'may stay off' % (len(cand), phone), 'hexagonrpcd'))
    # Debian's hexagonrpcd reads hexagonrpcd_* from its environment (the same names pmOS's config uses)
    drop = os.path.join(P, 'etc/systemd/system/hexagonrpcd.service.d/50-vibeos-nura.conf')
    if hexa:
        os.makedirs(os.path.dirname(drop), exist_ok=True)
        with open(drop, 'w') as f:
            f.write('# from Nura\'s %s (pmOS hexagonrpcd config)\n[Service]\n' % nura.codename)
            for k, v in sorted(hexa.items()):
                f.write('Environment=%s=%s\n' % (k, v))
    row = device_row(nura.dev)
    if row and row['watchdog']:
        watchdog_dropins(P)
        pl.carried.append(('systemd watchdog and rmtfs stop drop-ins (table: watchdog reset)', 'vibeos'))
    # the units pmOS's presets disable: masked. An empty unit file masks as a link to /dev/null does (systemd.unit(5)),
    # and unlike that link it can be unpacked over itself: toybox tar in recovery refuses to replace a symlink that
    # points out of the tree, so a second install would stop there
    for what, unit, pkg in presets:
        if what == 'disable' and unit.endswith(('.service', '.socket', '.timer')) and '*' not in unit:
            d = os.path.join(P, 'etc/systemd/system')
            os.makedirs(d, exist_ok=True)
            if os.path.lexists(os.path.join(d, unit)):
                continue
            open(os.path.join(d, unit), 'wb').close()
            mask.append(unit)
            pl.carried.append(('preset "disable %s" -> masked' % unit, pkg))
        else:
            pl.not_carried.append(('preset "%s %s"' % (what, unit), pkg))
    for unit in mask_units(P, row['mask'] if row else []):
        mask.append(unit)
        pl.carried.append(('devices.txt "mask %s" -> masked' % unit, 'devices.txt'))
    return pl, nfw, mask, hexa, ucm_fork


def debian_debs(nura, args, out_dir, system):
    want, why = [], {}
    for n in sorted(nura.pkgs):
        for d in DEBIAN_FOR.get(n, []):
            if d not in want:
                want.append(d); why[d] = n
    if 'rmtfs' in nura.pkgs and 'qrtr-tools' not in want:
        want += ['qrtr-tools']; why['qrtr-tools'] = 'rmtfs (qrtr tools)'
    if args.no_qbootctl and 'qbootctl' in want:
        want.remove('qbootctl')
    gaps = [(n, t) for n, t in NO_DEBIAN.items() if n in nura.pkgs]
    os.makedirs(out_dir, exist_ok=True)
    got = []
    if args.debs:
        for f in sorted(os.listdir(args.debs)):
            if f.endswith('.deb'):
                p = os.path.join(args.debs, f)
                name = run(['dpkg-deb', '-f', p, 'Package']).decode().strip()
                if name in want:
                    shutil.copy(p, os.path.join(out_dir, f))
                    got.append((name, os.path.join(out_dir, f)))
    else:
        arch = debfetch.Archive(os.path.join(args.cache, 'debian'), suite=args.suite, log=log)
        for n in want:
            fn, s = arch.fetch(n, out_dir)
            got.append((n, fn))
    # every dependency must be in the system image or among these (the first boot has no network)
    ps = debver.PackageSet()
    for n, v in system.ver.items():
        ps.ver[n] = v
    ps.prov = dict(system.prov)
    fields = {}
    for n, fn in got:
        f = run(['dpkg-deb', '-f', fn, 'Package', 'Version', 'Depends', 'Pre-Depends', 'Provides', 'Architecture']).decode()
        d = {k: v.strip() for k, _, v in (l.partition(':') for l in f.splitlines()) if k}
        fields[n] = (fn, d)
        ps.add(n, d.get('Version', ''), d.get('Provides', ''))
    ok, dropped = [], []
    changed = True
    while changed:
        changed = False
        for n in list(fields):
            fn, d = fields[n]
            miss = ps.missing(', '.join(x for x in (d.get('Depends', ''), d.get('Pre-Depends', '')) if x))
            if d.get('Architecture') not in ('arm64', 'all'):
                miss.append('architecture %s' % d.get('Architecture'))
            if miss:
                dropped.append((n, miss)); os.unlink(fn); del fields[n]; ps.ver.pop(n, None); changed = True
    for n, (fn, d) in sorted(fields.items()):
        ok.append((n, d.get('Version'), why.get(n, ''), os.path.basename(fn)))
    return ok, dropped, gaps, [w for w in want if w not in {g[0] for g in got}]


def write_deb(P, name, ver, desc, kver, mask, depends, out, enable=(), regdb_upstream=False):
    os.makedirs(os.path.join(P, 'DEBIAN'), exist_ok=True)
    hwdb = any(r.startswith(('usr/lib/udev/hwdb.d', 'etc/udev/hwdb.d')) for r, _ in extract.walk(P))
    sysusers = any(r.startswith('usr/lib/sysusers.d/') for r, _ in extract.walk(P))
    with open(os.path.join(P, 'DEBIAN/control'), 'w') as f:
        f.write('Package: %s\nVersion: %s\nArchitecture: arm64\nMaintainer: VibeOS (nura-to-vibeos)\n'
                'Section: kernel\nPriority: optional\nProvides: vibeos-device\nConflicts: vibeos-device\n%sDescription: VibeOS device layer from a Nura build: %s\n'
                ' %s.\n The device zip unpacks these files into the system zip\'s root file system;\n'
                ' the first boot registers them (vibeos-device-setup).\n'
                % (name, ver, ('Recommends: %s\n' % ', '.join(depends)) if depends else '', desc.split(':')[0], desc))
    with open(os.path.join(P, 'DEBIAN/postinst'), 'w') as f:
        f.write('#!/bin/sh\nset -e\nif [ "$1" = configure ]; then\n'
                '\t# the device\'s name, while the system image\'s generic one is set\n'
                '\tif [ "$(cat /etc/hostname 2>/dev/null)" = vibeos ]; then\n'
                '\t\tcp /usr/share/vibeos-device/hostname /etc/hostname\n'
                '\t\tsed -i "s/^127\\.0\\.1\\.1[[:space:]].*/127.0.1.1\\t$(cat /etc/hostname)/" /etc/hosts\n'
                '\t\tcp /usr/share/vibeos-device/machine-info /etc/machine-info\n\tfi\n'
                '\tdepmod -a %s || true\n%s%s%s%s'
                '\tglib-compile-schemas /usr/share/glib-2.0/schemas 2>/dev/null || true\nfi\nexit 0\n'
                % (kver, '\tsystemd-hwdb update || true\n' if hwdb else '',
                   # before the units below are enabled: a service whose User= does not exist yet fails to start
                   '\tsystemd-sysusers || true\n' if sysusers else '',
                   ''.join('\tsystemctl %senable %s 2>/dev/null || true\n' % ('--global ' if u.startswith('--user ') else '',
                                                                           u.split()[-1]) for u in enable),
                   REGDB_POSTINST if regdb_upstream else ''))
    os.chmod(os.path.join(P, 'DEBIAN/postinst'), 0o755)
    if regdb_upstream:
        with open(os.path.join(P, 'DEBIAN/postrm'), 'w') as f:
            f.write('#!/bin/sh\nset -e\nif [ "$1" = remove ] || [ "$1" = purge ]; then\n'
                    '\t# back to Debian\'s choice of wireless-regdb\n'
                    '\tupdate-alternatives --auto regulatory.db 2>/dev/null || true\nfi\nexit 0\n')
        os.chmod(os.path.join(P, 'DEBIAN/postrm'), 0o755)
    # directories 755, files 644 or 755, owned by root in the package
    for r, ds, fs in os.walk(P):
        for d in ds:
            p = os.path.join(r, d)
            if not os.path.islink(p):
                os.chmod(p, 0o755)
    # mtimes clamped (SOURCE_DATE_EPOCH): the same inputs make the same zip
    run(['dpkg-deb', '--root-owner-group', '-Zzstd', '-z9', '-b', P, out], env=dict(os.environ, SOURCE_DATE_EPOCH=str(EPOCH)))


REGDB_POSTINST = ('\t# the kernel trusts the upstream wireless-regdb signers only (cfg80211), not Debian\'s\n'
                  '\tif [ -e /lib/firmware/regulatory.db-upstream ]; then\n'
                  '\t\tupdate-alternatives --set regulatory.db /lib/firmware/regulatory.db-upstream || true\n\tfi\n')


def payload_tar(debs_to_unpack, x, out):
    """the device package's files (and firmware packages'), as dpkg would unpack them, owned by root; only named
    top directories of a merged-/usr root (never ".", never lib/bin/sbin: they are the root's symlinks)"""
    os.makedirs(x)
    for d in debs_to_unpack:
        run(['dpkg-deb', '-x', d, x])
    tops = sorted(os.listdir(x))
    for t in tops:
        if t not in ('etc', 'usr', 'var', 'opt') or os.path.islink(os.path.join(x, t)):
            die('payload: /%s at the top' % t)

    def norm(ti):
        ti.uid = ti.gid = 0
        ti.uname = ti.gname = 'root'
        ti.mtime = EPOCH
        if ti.isdir():
            ti.mode = 0o755
        elif ti.isfile():
            ti.mode &= 0o755
        elif ti.issym() and ti.linkname.startswith('/'):
            # relative, so that it stays inside the root it is unpacked into (see the masks above)
            ti.linkname = os.path.relpath(ti.linkname, '/' + os.path.dirname(ti.name))
        return ti
    with tarfile.open(out, 'w', format=tarfile.GNU_FORMAT) as t:
        for top in tops:
            t.add(os.path.join(x, top), arcname=top, filter=norm, recursive=True)


# ---------------------------------------------------------------- the zip
def make_zip(Z, out, files):
    for r, ds, fs in os.walk(Z):
        for n in ds + fs:
            os.utime(os.path.join(r, n), (EPOCH, EPOCH), follow_symlinks=False)
    run(['zip', '-q', '-0', '-r', '-X', out + '.part'] + files, cwd=Z)
    os.rename(out + '.part', out)


