# ---------------------------------------------------------------- main
def main():
    ap = argparse.ArgumentParser(description=__doc__.split('\n\n')[0], formatter_class=argparse.RawDescriptionHelpFormatter,
                                 epilog=__doc__.split('\n\n', 1)[1])
    ap.add_argument('source', nargs='+', help='a Nura build directory URL, or its -boot.img.xz and .img.xz')
    ap.add_argument('-o', '--out', default='.', help='where the zip goes (default: .)')
    ap.add_argument('--work', help='work directory (default: OUT/nura-work-<device>-<build>; kept with --keep)')
    ap.add_argument('--cache', default=os.path.expanduser('~/.cache/nura-to-vibeos'), help='Debian package cache')
    ap.add_argument('--device', help='the phone, for a generic SoC image (e.g. xiaomi-surya for qcom-sm7150)')
    ap.add_argument('--dtb', help='the DTB under dtbs/ (generic images; a glob is fine)')
    ap.add_argument('--panel', help='the display panel, where a phone has more than one DTB (POCO X3 NFC: huaxing or '
                                    'tianma); the zip then refuses a phone whose bootloader names another panel')
    ap.add_argument('--header', type=int, choices=[0, 2], help='generic images: the boot image header version '
                    '(0: DTB appended to the kernel; 2: DTB in its own section), instead of the device table\'s')
    ap.add_argument('--boot-target', default='ask', choices=['ask', 'auto', 'boot', 'recovery', 'other-slot', 'none'],
                    help='where the zip writes the boot image: auto = the running slot\'s boot on A/B devices, '
                         'recovery on devices with one (Android keeps boot), else boot; none = nothing '
                         '(fastboot boot the -boot.img); ask (default) = recovery shows a menu of auto\'s choice '
                         'and none (volume keys and power)')
    ap.add_argument('--android-device', help='LineageOS device names the zip accepts (comma-separated), or "any"')
    ap.add_argument('--debs', help='take the Debian packages from this directory instead of the archive')
    ap.add_argument('--busybox', help='busybox-static arm64 .deb (default: from the Debian archive)')
    ap.add_argument('--suite', default='sid', help='Debian suite for the packages (default: sid, as the system)')
    ap.add_argument('--system-packages', default=os.path.join(HERE, 'data', 'system-packages.txt'))
    ap.add_argument('--system-files', default=os.path.join(HERE, 'data', 'system-files.txt'))
    ap.add_argument('--cmdline-add', default='', help='extra kernel parameters')
    ap.add_argument('--no-qbootctl', action='store_true', help='leave qbootctl out (A/B slot marking)')
    ap.add_argument('--keep', action='store_true', help='keep the work directory')
    args = ap.parse_args()
    need_tools()
    os.makedirs(args.out, exist_ok=True)
    out = os.path.abspath(args.out)
    t0 = time.time()

    srcs, url = args.source, None
    stamp = build_stamp(srcs)
    tmpw = args.work or os.path.join(out, 'nura-work-%s-%d' % (stamp, os.getpid()))
    if os.path.exists(tmpw):
        die('%s exists: move it aside first' % tmpw)
    os.makedirs(tmpw)
    try:
        convert(args, out, srcs, url, stamp, tmpw, t0)
    except BaseException:
        if not args.keep:
            shutil.rmtree(tmpw, ignore_errors=True)
        raise


def convert(args, out, srcs, url, stamp, tmpw, t0):
    if len(srcs) == 1 and re.match(r'https?://', srcs[0]):
        log('Nura build: %s' % srcs[0])
        parts = [x for x in srcs[0].split('/') if x]
        dl = os.path.join(out, 'nura-download', '-'.join(parts[-3:-1] + parts[-1:]) if len(parts) >= 3 else 'build')
        srcs, url = fetch_listing(srcs[0], dl)
        log('  kept in %s' % dl)
        stamp = build_stamp(srcs)
    inputs = [(os.path.basename(s), sha256f(s)) for s in srcs]

    nura = Nura(tmpw)
    log('unpacking %s' % ', '.join(os.path.basename(s) for s in srcs))
    nura.unpack(srcs)
    log('  partitions: %s' % ', '.join('%s %s "%s" %d MiB' % (p['index'], p['fs'], p['label'], p['size'] >> 20) for p in nura.parts))
    log('reading the root (debugfs) and the boot partition (%s)' % nura.boot['fs'])
    nura.read_root()
    nura.read_boot()
    generic = nura.codename.startswith('qcom-') or nura.codename.startswith('generic-')
    dev = args.device or nura.codename
    if generic and not args.device:
        die('%s is a generic SoC image: --device NAME (e.g. xiaomi-surya) says which phone' % nura.codename)
    row = device_row(dev)
    nura.dev = dev
    log('  device: %s (%s), deviceinfo %s; kernels %s' % (dev, nura.di.get('name', '?'), nura.codename, ' '.join(nura.kvers)))

    # ---- the boot image
    plan = plan_boot(nura, args, row)
    if generic and plan.get('model'):
        # the phone's name from its DTB (the image's deviceinfo names the SoC)
        nura.notes.append('name: "%s" from the DTB (the image\'s deviceinfo says "%s")' % (plan['model'], nura.di.get('name')))
        nura.di['name'] = plan['model']
        nura.machine_info = 'PRETTY_HOSTNAME="%s"\nCHASSIS=handset\n' % plan['model']
    kver = bootimg.linux_version(plan['image']) if plan['image'] else None
    if not kver:
        die('cannot read the kernel version from the kernel (%s)' % plan['kfmt'])
    if kver not in nura.kvers:
        die('the kernel is %s, the root has modules for %s' % (kver, ' '.join(nura.kvers)))
    moddir = os.path.join(nura.trees['usr/lib/modules'], kver)
    # what the initramfs needs from the kernel, built in or as a module
    have = set()
    for f in ('modules.builtin', 'modules.dep'):
        p = os.path.join(moddir, f)
        if os.path.isfile(p):
            have |= {mod_name(l.split(':')[0].strip()) for l in open(p, encoding='utf-8', errors='replace') if l.strip()}
    for m, what in (('ext4', 'the VibeOS root is ext4'), ('loop', 'nested and image roots need loop devices'),
                    ('libcomposite', 'the USB shell of a failed boot'), ('usb_f_ncm', 'the USB shell (NCM)')):
        if m not in have:
            nura.notes.append('WARNING: the kernel has no %s (neither built in nor a module): %s' % (m, what))
    dtbs = plan['dtbs'] + ([plan['dtb_section']] if plan.get('dtb_section') else [])
    models = [bootimg.dtb_model(d) for d in dtbs if d[:4] == bootimg.FDT]
    log('  kernel %s (%s), boot image from %s; DTB: %s' % (kver, plan['kfmt'], plan['source'],
                                                          '; '.join('%s %s' % (m, c[:2]) for m, c in models) or 'none'))
    soc = None
    for m, c in models:
        for x in c:
            if x.startswith('qcom,') and re.match(r'qcom,(sd|sm|sc|msm|apq)\w*\d', x):
                soc = x.split(',')[1]
    cmd, dropped = clean_cmdline(plan['cmdline'])
    if args.cmdline_add:
        cmd = (cmd + ' ' + args.cmdline_add).strip()
    comp = initramfs_compression(nura)
    android = args.android_device.split(',') if args.android_device and args.android_device != 'any' else \
        ([] if args.android_device == 'any' else (row['android'] if row else [dev.split('-', 1)[-1]]))
    conf = 'NAME="%s"\nCODENAME=%s\nKVER=%s\nVERSION=%s\n' % (nura.di.get('name', dev).replace('"', ''), dev, kver, VERSION)
    if args.busybox:
        bbdeb = args.busybox
    elif args.debs and any(f.startswith('busybox-static_') for f in os.listdir(args.debs)):
        bbdeb = os.path.join(args.debs, sorted(f for f in os.listdir(args.debs) if f.startswith('busybox-static_'))[-1])
    else:
        bbdeb, _ = debfetch.Archive(os.path.join(args.cache, 'debian'), suite=args.suite, log=log).fetch(
            'busybox-static', os.path.join(tmpw, 'bb'))
    if run(['dpkg-deb', '-f', bbdeb, 'Package', 'Architecture']).decode().split() != ['Package:', 'busybox-static', 'Architecture:', 'arm64']:
        die('%s is not busybox-static for arm64' % bbdeb)
    bx = os.path.join(tmpw, 'bbx'); run(['dpkg-deb', '-x', bbdeb, bx])
    busybox = extract.read_nofollow(os.path.join(bx, 'usr/bin/busybox'))
    log('building the initramfs (%s)' % comp)
    skip, others = other_phones_files(nura, dev) if generic else (set(), [])
    if others:
        nura.notes.append('firmware of the other phones the image boots, left out: %s (%d files)' % (', '.join(others), len(skip)))
    rd, rdinfo = initramfs(nura, kver, moddir, busybox, conf, comp, skip)
    h = dict(plan['header'])
    new = bootimg.build(h, plan['kernel'], rd, cmd.encode())
    # read back: everything but the ramdisk and the command line is Nura's
    nh = bootimg.parse(new)
    for k in ('header_version', 'page_size', 'kernel_addr', 'ramdisk_addr', 'second_addr', 'tags_addr', 'os_version',
              'kernel', 'second', 'recovery_dtbo', 'dtb', 'dtb_addr', 'name'):
        if k in ('dtb', 'dtb_addr') and h['header_version'] < 2 or k == 'recovery_dtbo' and h['header_version'] < 1:
            continue  # not in this header version
        empty = b'' if k in ('kernel', 'second', 'recovery_dtbo', 'dtb') else 0
        if k in h and (nh.get(k) or empty) != (h.get(k) or empty):
            die('the new boot image differs from %s in %s' % ('Nura\'s' if nura.bootimg else 'the plan', k))
    if nh['ramdisk'] != rd or nh['cmdline'] != cmd.encode():
        die('the new boot image does not read back')
    n, bad = check_modules(moddir, kver)
    if bad:
        die('%d of %d modules are not for %s: %s' % (len(bad), n, kver, bad[:5]))
    log('  modules: %d, vermagic %s for all' % (n, kver))

    # ---- the device layer
    log('the device layer')
    system = debver.PackageSet.from_list(args.system_packages)
    sysfiles = {l.strip() for l in open(args.system_files, encoding='utf-8') if l.startswith('/')}
    P = os.path.join(tmpw, 'pkg')
    pl, nfw, mask, hexa, ucm_fork = build_payload(nura, args, P, kver, moddir, sysfiles, soc, skip, system, row)
    host = dev.split('-', 1)[-1]
    mi = nura.machine_info or 'PRETTY_HOSTNAME="%s"\nCHASSIS=handset\n' % nura.di.get('name', dev)
    for path, body in (('usr/share/vibeos-device/hostname', host + '\n'), ('usr/share/vibeos-device/machine-info', mi),
                       ('usr/share/vibeos-device/nura/deviceinfo', nura.deviceinfo_text),
                       ('usr/share/vibeos-device/nura/cmdline', cmd + '\n'),
                       # Video Player's codecs on the hardware decoder: H.264 and HEVC; VP9 wedged a Qualcomm iris
                       # decoder until a reboot, so it stays in software
                       ('usr/share/vibeos-device/video.conf',
                        '# Video Player: the codecs this device\'s hardware decoder plays cleanly (mpv\'s names); the '
                        'others are\n# decoded in software\n[Video]\nhwdec-codecs=h264,hevc\n')):
        os.makedirs(os.path.dirname(os.path.join(P, path)), exist_ok=True)
        open(os.path.join(P, path), 'w').write(body)
    debsdir = os.path.join(tmpw, 'debs')
    log('Debian packages for the first boot')
    ok, ddropped, gaps, missing = debian_debs(nura, args, debsdir, system)
    pkgname = 'vibeos-device-nura-%s' % dev
    # the converter's revision too: a later converter's package for the same Nura build is a newer version
    pver = '0.1.3+nura%s-%s' % (stamp.replace('-', '.'), VERSION.rsplit('nura', 1)[1])
    desc = '%s (%s): Nura\'s kernel %s modules, %d firmware files, the device\'s settings' % (
        nura.di.get('name', dev), dev, kver, nfw)
    deb = os.path.join(debsdir, '%s_%s_arm64.deb' % (pkgname, pver))
    log('  %s' % os.path.basename(deb))
    regdb = regdb_signers(moddir, plan.get('image'))
    if '/usr/lib/firmware/regulatory.db' not in sysfiles:
        regdb = None  # no wireless-regdb in the system image: Nura's database, if any, is in the payload
    for n_, v_, *_ in ok:
        if n_ == 'hexagonrpcd' and v_.startswith('0.4.'):
            nura.notes.append('hexagonrpcd %s is Debian\'s. On the POCO X3 NFC that version refused the DSP\'s '
                              'sensor-registry writes, and the DSP restarted over and over with the sensors and the '
                              'audio off (the POCO runs a newer hexagonrpcd and a writable copy of the registry). '
                              'Not checked on this phone.' % v_)
    write_deb(P, pkgname, pver, desc, kver, mask, [n for n, *_ in ok], deb, getattr(nura, 'enable_units', []),
              regdb == 'upstream')
    # forbidden content, as build-device.sh refuses it
    for rel, st in extract.walk(P):
        if re.search('|'.join(['gsm2sip', 'waydroid'] + os.environ.get('FORBID_EXTRA', '').split()), rel, re.I):
            die('forbidden file in the payload: %s' % rel)

    # ---- the zip
    name = 'vibeos-device-%s_%s' % (dev, stamp)
    Z = os.path.join(tmpw, 'zip')
    os.makedirs(os.path.join(Z, 'META-INF/com/google/android'))
    ub = os.environ.get('UPDATE_BINARY') or os.path.join(HERE, '..', 'zip', 'update-binary')
    if not os.path.isfile(ub):
        die('no %s: image/get-update-binary.sh LINEAGEOS.zip makes it (or set UPDATE_BINARY)' % ub)
    shutil.copy(ub, os.path.join(Z, 'META-INF/com/google/android/update-binary'))
    open(os.path.join(Z, 'META-INF/com/google/android/updater-script'), 'w').write(
        updater_script(nura.di.get('name', dev), ', '.join(android) or dev, android, args.boot_target))
    shutil.copy(os.path.join(HERE, '..', 'zip', 'vibeos-lib.sh'), os.path.join(Z, 'vibeos-lib.sh'))
    inst = open(os.path.join(HERE, 'zip/nura-install.sh')).read()
    open(os.path.join(Z, 'install.sh'), 'w').write(inst)
    os.makedirs(os.path.join(Z, 'debs'))
    for f in os.listdir(debsdir):
        shutil.copy(os.path.join(debsdir, f), os.path.join(Z, 'debs', f))
    log('  payload.tar')
    payload_tar([deb], os.path.join(tmpw, 'x'), os.path.join(Z, 'payload.tar'))
    open(os.path.join(Z, 'boot.img'), 'wb').write(new)
    with open(os.path.join(Z, 'nura-device.prop'), 'w') as f:
        f.write('device=nura-%s\nname=%s\nkver=%s\nboot_target=%s\nheader=%d\nsource=%s\n' % (
            dev, nura.di.get('name', dev), kver, args.boot_target, h['header_version'], url or 'local files'))
        if plan.get('panel'):
            f.write('panel=%s\n' % plan['panel'])
        if row and row['dtbo']:
            f.write('dtbo=%s\n' % row['dtbo'])
    with open(os.path.join(Z, 'device-sums.txt'), 'w') as f:
        for n_, p_ in (('payload', 'payload.tar'), ('bootimg', 'boot.img')):
            f.write('%s %d %s\n' % (n_, os.path.getsize(os.path.join(Z, p_)), sha256f(os.path.join(Z, p_))))
        for d in sorted(os.listdir(os.path.join(Z, 'debs'))):
            f.write('deb %s %s\n' % (d, sha256f(os.path.join(Z, 'debs', d))))
    for s in ('install.sh', 'vibeos-lib.sh'):
        r = subprocess.run(['sh', '-n', os.path.join(Z, s)])
        if r.returncode:
            die('%s does not parse' % s)
    zpath = os.path.join(out, name + '.zip')
    if os.path.exists(zpath):
        die('%s exists: move it aside first' % zpath)
    make_zip(Z, zpath, ['META-INF', 'vibeos-lib.sh', 'install.sh', 'nura-device.prop', 'device-sums.txt',
                        'payload.tar', 'debs', 'boot.img'])
    bpath = os.path.join(out, name + '-boot.img')
    open(bpath, 'wb').write(new)

    # ---- the report
    nmod = sum(1 for r, _, fs in os.walk(moddir) for f in fs if re.search(r'\.ko(\.\w+)?$', f))
    R = []
    R.append('VibeOS device zip from Nura: %s (%s)' % (nura.di.get('name', dev), dev))
    R.append('made %s by nura-to-vibeos %s in %d s' % (time.strftime('%Y-%m-%d %H:%M'), VERSION, time.time() - t0))
    R.append('')
    R.append('inputs: %s' % (url or 'local files'))
    for n_, s_ in inputs:
        R.append('  %s  sha256 %s' % (n_, s_))
    R.append('')
    R.append('zip: %s  %d MiB  sha256 %s' % (os.path.basename(zpath), os.path.getsize(zpath) >> 20, sha256f(zpath)))
    R.append('boot image: %s  sha256 %s' % (os.path.basename(bpath), sha256f(bpath)))
    R.append('  from: %s' % plan['source'])
    R.append('  header v%d, page %d, kernel 0x%x, ramdisk 0x%x, second 0x%x, tags 0x%x%s, os_version 0x%x' % (
        h['header_version'], h['page_size'], h['kernel_addr'], h['ramdisk_addr'], h['second_addr'], h['tags_addr'],
        (', dtb 0x%x' % h['dtb_addr']) if h['header_version'] >= 2 else '', h.get('os_version', 0)))
    R.append('  kernel: %s, %d bytes, %s; DTB: %s' % (plan['kfmt'], len(plan['kernel']), kver,
             ('%d appended' % len(plan['dtbs'])) if plan['dtbs'] else ('the dtb section' if plan.get('dtb_section') else 'none')))
    for m, c in models:
        R.append('    DTB model "%s", compatible %s' % (m, ' '.join(c)))
    R.append('  kernel and DTB byte for byte Nura\'s: %s' % ('yes (read back)' if nura.bootimg else 'kernel from vmlinuz, DTB from dtbs/'))
    R.append('  cmdline: %s' % cmd)
    R.append('  dropped (pmOS): %s' % (' '.join(dropped) or '-'))
    R.append('  initramfs: VibeOS\'s, %s, %d KiB (%d KiB unpacked): busybox-static %s, %d modules, %d firmware files; early: %s' % (
        rdinfo['compression'], rdinfo['size'] >> 10, rdinfo['raw_size'] >> 10, os.path.basename(bbdeb),
        len(rdinfo['modules']), len(rdinfo['firmware']), ' '.join(rdinfo['early_load']) or '-'))
    R.append('  boot target in the zip: %s' % args.boot_target)
    if row and row['dtbo']:
        R.append('  dtbo: the boot slot\'s cleared after boot is written (its old content saved in the system)')
    if plan.get('panel'):
        R.append('  panel: %s (the zip refuses a phone whose bootloader names another panel)' % plan['panel'])
    R.append('')
    R.append('kernel modules: %d (vermagic %s, all checked)' % (nmod, kver))
    R.append('firmware files: %d (postmarketos/ moved to the kernel\'s updates/)' % nfw)
    R.append('device package: %s %s' % (pkgname, pver))
    R.append('wireless-regdb: %s' % {
        'upstream': 'the system\'s; the kernel\'s cfg80211 trusts the upstream signers only, so the postinst selects '
                    'regulatory.db-upstream (Debian\'s default is its own re-signed copy)',
        'debian': 'the system\'s default; the kernel trusts Debian\'s signer',
        'none': 'the system\'s default; the kernel\'s cfg80211 names no signer',
        None: 'not the system\'s (no cfg80211, or no wireless-regdb in the system image)'}[regdb])
    R.append('Debian packages for the first boot: %s' % (', '.join('%s %s' % (n_, v_) for n_, v_, *_ in ok) or '-'))
    for n_, miss in ddropped:
        R.append('  LEFT OUT %s: dependencies not in the system image: %s' % (n_, ', '.join(miss)))
    for n_ in missing:
        R.append('  NOT FOUND in Debian: %s' % n_)
    R.append('')
    R.append('carried over (%d):' % len(pl.carried))
    groups = {}
    for rel, why in pl.carried:
        if rel.startswith('usr/lib/firmware/'):
            continue
        groups.setdefault(why, []).append(rel)
    for why, rels in sorted(groups.items()):
        R.append('  %s: %s' % (why, ', '.join(rels)))
    if hexa:
        R.append('  hexagonrpcd: %s' % ' '.join('%s=%s' % kv for kv in sorted(hexa.items())))
    R.append('the system image has these already (kept the system\'s; Nura\'s copy in /usr/share/vibeos-device/nura/system-has):')
    for rel, why in pl.kept_system:
        R.append('  /%s (%s)' % (rel, why))
    fork, sys_ucm = ucm_fork
    if fork and sys_ucm:
        R.append('  UCM: the system\'s alsa-ucm-conf has this phone (%s): none of %s carried, not to mix the two' % (
            ' '.join(sys_ucm), ', '.join(fork)))
    elif fork:
        R.append('  (UCM: only the %s parts of %s were looked at)' % (', '.join(sorted({w for w in re.split(r'[-_ ]', dev) if len(w) > 2} | ({soc} if soc else set()))), ', '.join(fork)))
    R.append('not carried over:')
    for n_, t_ in gaps:
        R.append('  %s: %s' % (n_, t_))
    for rel, pkg in pl.not_carried:
        R.append('  /%s (%s)' % (rel, pkg))
    for n_ in sorted(nura.pkgs):
        if n_.endswith('-systemd') and (n_.startswith('device-' + nura.codename) or n_.startswith('soc-')):
            pass
    R.extend('note: ' + x for x in nura.notes)
    rep = os.path.join(out, name + '.txt')
    open(rep, 'w').write('\n'.join(R) + '\n')
    log('\n'.join(R[:20]))
    log('report: %s' % rep)
    if not args.keep:
        shutil.rmtree(tmpw)
    else:
        log('work directory kept: %s' % tmpw)


if __name__ == '__main__':
    main()
