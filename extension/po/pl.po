# android: SystemUI switch_bar_on (several translations, short)
#: qs.js
msgctxt "mobile data"
msgid "On"
msgstr "Włączono"

# android: SystemUI switch_bar_off (several translations, short)
#: qs.js
msgctxt "mobile data"
msgid "Off"
msgstr "Wyłączono"

# android: SystemUI quick_settings_rotation_unlocked_label
#: qs.js
msgid "Auto-rotate"
msgstr "Autoobracanie"

# android: SystemUI quick_settings_location_label
#: qs.js
msgid "Location"
msgstr "Lokalizacja"

# android: SystemUI quick_settings_ui_mode_night_label
#: qs.js
msgid "Dark theme"
msgstr "Ciemny motyw"

# android: SystemUI quick_settings_dark_mode_secondary_label_battery_saver
#: qs.js
msgid "Battery Saver"
msgstr "Oszczędzanie baterii"

# android: SystemUI quick_settings_night_display_label
#: qs.js
msgid "Night Light"
msgstr "Podświetlenie nocne"

# android: Settings auto_brightness_title (short)
#: qs.js
msgid "Adaptive brightness"
msgstr "Automatyczna jasność"

# android: SystemUI volume_ringer_status_silent (several translations, short)
#: qs.js
msgctxt "media volume"
msgid "Mute"
msgstr "Wyciszenie"

# android: SystemUI hearing_devices_settings_button
#: qs.js
msgid "Settings"
msgstr "Ustawienia"

# android: SystemUI accessibility_quick_settings_power_menu
#: qs.js
msgid "Power menu"
msgstr "Menu zasilania"

#. TRANSLATORS: an amount of memory; %s is the number of gigabytes ("1.5")
#: recents.js
#, javascript-format
msgid "%s GB"
msgstr "%s GB"

#. TRANSLATORS: an amount of memory; %s is the number of megabytes ("512")
#: recents.js
#, javascript-format
msgid "%s MB"
msgstr "%s MB"

# android: Settings running_processes_header_used_prefix (short)
#: recents.js
msgctxt "memory"
msgid "Used"
msgstr "Używana"

# android: Settings cache_header_label (short)
#: recents.js
msgctxt "memory"
msgid "Cache"
msgstr "Pamięć podręczna"

# android: Settings running_processes_header_free_prefix (short)
#: recents.js
msgctxt "memory"
msgid "Free"
msgstr "Wolna"

#: recents.js
msgctxt "recent apps"
msgid "Clear all"
msgstr "Wyczyść wszystko"

# android: SystemUI global_action_screenshot
#: recents.js
msgid "Screenshot"
msgstr "Zrzut ekranu"

# android: Launcher3 recents_empty_message
#: recents.js
msgid "No recent items"
msgstr "Brak ostatnich elementów"

# android: Framework app_info (several translations, short)
#. the app's page in Settings, over the home screen (where back from it leads on Android)
#. (info_24px: the newer App info icon, which the phone has)
#: recents.js
msgid "App info"
msgstr "O aplikacji"

# android: Launcher3 recent_task_option_remove_task (several translations, short)
#. TRANSLATORS: in a recent app's menu: removes it from the recent apps
#: recents.js
msgctxt "recent apps"
