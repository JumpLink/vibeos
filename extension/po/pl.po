# android: SystemUI controls_pin_instructions (several translations, short)
#: bouncer.js
msgid "Enter PIN"
msgstr "Wpisz kod PIN"

# android: Keyguard kg_wrong_pin_try_again
#: bouncer.js
msgid "Wrong PIN. Try again."
msgstr "Błędny kod PIN. Spróbuj ponownie."

# android: Keyguard kg_primary_auth_locked_out_pin
#: bouncer.js
msgid "Too many attempts with incorrect PIN"
msgstr "Zbyt wiele nieudanych prób wpisania kodu PIN"

# android: Keyguard kg_prompt_reason_restart_pin
#: bouncer.js
msgid "PIN is required after device restarts"
msgstr "Po ponownym uruchomieniu wymagany jest kod PIN"

# android: Keyguard keyguard_enter_pattern (short)
#: bouncer.js
msgid "Draw pattern"
msgstr "Narysuj wzór"

# android: Keyguard kg_wrong_pattern_try_again
#: bouncer.js
msgid "Wrong pattern. Try again."
msgstr "Błędny wzór. Spróbuj ponownie."

# android: Keyguard kg_primary_auth_locked_out_pattern
#: bouncer.js
msgid "Too many attempts with incorrect pattern"
msgstr "Zbyt wiele nieudanych prób narysowania wzoru"

# android: Keyguard kg_prompt_reason_restart_pattern
#: bouncer.js
msgid "Pattern is required after device restarts"
msgstr "Po ponownym uruchomieniu wymagany jest wzór"

# android: Keyguard kg_too_many_failed_attempts_countdown
#: bouncer.js
#, javascript-format
msgid "Try again in %d second."
msgid_plural "Try again in %d seconds."
msgstr[0] "Spróbuj ponownie za %d sekundę"
msgstr[1] "Spróbuj ponownie za %d sekundy"
msgstr[2] "Spróbuj ponownie za %d sekund"

# android: Framework emergency_calls_only
#. the mobile network, then (the owner's addition) the Wi-Fi network, joined with " | " as two SIMs' names
#. are
#: keyguard.js
msgid "Emergency calls only"
msgstr "Tylko połączenia alarmowe"

# android: Keyguard keyguard_missing_sim_message_short (short)
#: keyguard.js qs.js
msgid "No SIM"
msgstr "Brak karty SIM"

# android: Keyguard keyguard_charged (short)
#: keyguard.js
msgid "Charged"
msgstr "Naładowana"

#. PAM could not run: no attempt counted
#: keyguard.js
msgid "Could not check"
msgstr "Nie udało się sprawdzić"

# android: SystemUI gesture_error_title (several translations, short)
#: keyguard.js
msgid "Try again"
msgstr "Spróbuj ponownie"

#. TRANSLATORS: an app that failed to start; %s is its name
#: launch.js
#, javascript-format
msgid "%s can't open"
msgstr "Nie można otworzyć aplikacji %s"

#: launch.js
msgid "It's turned off on this phone"
msgstr "Aplikacja jest wyłączona na tym telefonie"

# android: Framework now_string_shortest (short)
#. TRANSLATORS: how long ago a notification came, shortest: under a minute
#: notifications.js
msgid "now"
msgstr "teraz"

# android: Framework duration_minutes_shortest
#. TRANSLATORS: how long ago a notification came, shortest: %d minutes
#: notifications.js
#, javascript-format
msgid "%dm"
msgstr "%d min"

# android: Framework duration_hours_shortest
#. TRANSLATORS: how long ago a notification came, shortest: %d hours
#: notifications.js
#, javascript-format
msgid "%dh"
msgstr "%d godz."

# android: Framework duration_days_shortest
#. TRANSLATORS: how long ago a notification came, shortest: %d days
#: notifications.js
#, javascript-format
msgid "%dd"
msgstr "%d d."

# android: Framework duration_years_shortest
#. TRANSLATORS: how long ago a notification came, shortest: %d years
#: notifications.js
#, javascript-format
msgid "%dy"
msgstr "%d r."

# android: Framework expand_button_content_description_collapsed (short)
#: notifications.js
msgid "Expand"
msgstr "Rozwiń"

# android: SystemUI privacy_dialog_collapse_action
#: notifications.js
msgid "Collapse"
msgstr "Zwiń"

# android: SystemUI notification_section_header_gentle (several translations, short)
#. TRANSLATORS: the heading of the low-priority notifications in the shade
#: notifications.js
msgid "Silent"
msgstr "Ciche"

# android: SystemUI notification_history_button_description
#: notifications.js
msgid "Notification history"
msgstr "Historia powiadomień"

# android: SystemUI clear_all_notifications_text (several translations, short)
#: notifications.js
msgctxt "notifications"
msgid "Clear all"
msgstr "Wyczyść wszystkie"

# android: SystemUI notification_settings_button_description
#: notifications.js
msgid "Notification settings"
msgstr "Ustawienia powiadomień"

# android: SystemUI empty_shade_text
#: notifications.js
msgid "No notifications"
msgstr "Brak powiadomień"

#. TRANSLATORS: an app records sound for the first time and asks for the microphone; %s is the app's name
#: pairdialog.js
#, javascript-format
msgid "Allow %s to use the microphone?"
msgstr "Zezwolić aplikacji %s na używanie mikrofonu?"

#. TRANSLATORS: a Bluetooth device asks to connect to one of the phone's services; %s is its name
#: pairdialog.js
#, javascript-format
msgid "Allow %s to connect?"
msgstr "Zezwolić urządzeniu %s na połączenie?"

# android: Settings bluetooth_pairing_request
#. TRANSLATORS: a Bluetooth device asks to pair; %s is its name
#: pairdialog.js
#, javascript-format
msgid "Pair with %s?"
msgstr "Sparować z urządzeniem %s?"

# android: Settings bluetooth_pin_values_hint
#: pairdialog.js
msgid "Usually 0000 or 1234"
msgstr "Zazwyczaj 0000 lub 1234"

# android: SystemUI controls_pin_use_alphanumeric
#: pairdialog.js
msgid "PIN contains letters or symbols"
msgstr "Kod PIN zawiera litery lub symbole"

# android: Settings bluetooth_enter_pin_other_device
#: pairdialog.js
msgid "You may also need to type this PIN on the other device."
msgstr "Może być również konieczne wpisanie tego kodu PIN na drugim urządzeniu."

# android: SystemUI usb_device_dialog_cancel_button
#. authorize: a device pairing without a code
#: pairdialog.js
msgid "Cancel"
msgstr "Anuluj"

# android: SettingsLib bluetooth_pairing_accept (short)
#: pairdialog.js
msgid "Pair"
msgstr "Sparuj"

#. TRANSLATORS: the passkey (six digits) to type here, as the other device shows it
#: pairdialog.js
msgid "Type the passkey shown on the other device."
msgstr "Wpisz klucz dostępu widoczny na drugim urządzeniu."

# android: Settings bluetooth_pairing_key_msg
#: pairdialog.js
msgid "Bluetooth pairing code"
msgstr "Kod parowania Bluetooth"

#. TRANSLATORS: over the code shown here, for a keyboard (the other device) to type
#: pairdialog.js
msgid "Type this code on the other device, then press Return or Enter."
msgstr "Wpisz ten kod na drugim urządzeniu i naciśnij Return lub Enter."

# android: SystemUI usb_authorization_deny
#: pairdialog.js
msgid "Don't allow"
msgstr "Nie zezwalaj"

# android: SystemUI usb_authorization_allow (several translations, short)
#: pairdialog.js
msgid "Allow"
msgstr "Zezwól"

#. TRANSLATORS: the lock screen's line while a Bluetooth device waits to connect; %s is its name
#: pairdialog.js
#, javascript-format
msgid "Unlock to let %s connect"
msgstr "Odblokuj, aby połączyć z urządzeniem %s"

#. TRANSLATORS: the lock screen's line while a Bluetooth device waits to pair; %s is its name
#: pairdialog.js
#, javascript-format
msgid "Unlock to pair with %s"
msgstr "Odblokuj, aby sparować z urządzeniem %s"

# android: SettingsLib bluetooth_pairing_error_message (adapted)
#. TRANSLATORS: a notification's title when a pairing timed out; %s is the device's name
#: pairdialog.js
#, javascript-format
msgid "Couldn't pair with %s"
msgstr "Nie udało się sparować z urządzeniem %s"

# android: SystemUI quick_settings_bluetooth_label
#: pairdialog.js qs.js
msgid "Bluetooth"
msgstr "Bluetooth"

#. TRANSLATORS: a Bluetooth device's question waits behind this notification while the phone is locked
#: pairdialog.js
msgid "Unlock the phone to answer."
msgstr "Odblokuj telefon, aby odpowiedzieć."

#. TRANSLATORS: under "Couldn't pair with …": a tap starts the pairing again
#: pairdialog.js
msgid "Tap to try again."
msgstr "Kliknij, aby spróbować ponownie."

# android: Framework global_action_lockdown (short)
#: powermenu.js
msgid "Lockdown"
msgstr "Blokada"

# android: Framework power_off (short)
#: powermenu.js
msgid "Power off"
msgstr "Wyłącz"

# android: Framework sim_restart_button (several translations, short)
#: powermenu.js
