msgstr "%s • Wolne ładowanie"

#. TRANSLATORS: the lock screen's charging line; %s is the battery's level ("75%")
#: state.js
#, javascript-format
msgid "%s • Fast charging"
msgstr "%s • Szybkie ładowanie"

#. TRANSLATORS: the lock screen's charging line; %s is the battery's level ("75%")
#: state.js
#, javascript-format
