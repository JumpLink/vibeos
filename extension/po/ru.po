#: bouncer.js
msgid "Enter PIN"
msgstr "Введите PIN-код"

#: bouncer.js
msgid "Wrong PIN. Try again."
msgstr "Неверный PIN-код."

#: bouncer.js
msgid "Too many attempts with incorrect PIN"
msgstr "Слишком много неудачных попыток ввести PIN-код"

#: bouncer.js
msgid "PIN is required after device restarts"
msgstr "После перезапуска необходимо ввести PIN-код"

#: bouncer.js
msgid "Draw pattern"
msgstr "Введите графический ключ"

#: bouncer.js
msgid "Wrong pattern. Try again."
msgstr "Неверный графический ключ."

#: bouncer.js
msgid "Too many attempts with incorrect pattern"
msgstr "Слишком много неудачных попыток ввести графический ключ"

#: bouncer.js
msgid "Pattern is required after device restarts"
msgstr "После перезапуска необходимо ввести графический ключ"

#: bouncer.js
#, javascript-format
msgid "Try again in %d second."
msgid_plural "Try again in %d seconds."
msgstr[0] "Повторите попытку через %d секунду"
msgstr[1] "Повторите попытку через %d секунды"
msgstr[2] "Повторите попытку через %d секунд"

#. the mobile network, then (the owner's addition) the Wi-Fi network, joined with " | " as two SIMs' names
#. are
#: keyguard.js
msgid "Emergency calls only"
msgstr "Только экстренные вызовы"

#: keyguard.js qs.js
msgid "No SIM"
msgstr "Нет SIM-карты"

#: keyguard.js
msgid "Charged"
msgstr "Батарея заряжена"

#. PAM could not run: no attempt counted
#: keyguard.js
msgid "Could not check"
msgstr "Не удалось проверить"

#: keyguard.js
msgid "Try again"
msgstr "Повторите попытку"

#. TRANSLATORS: an app that failed to start; %s is its name
#: launch.js
#, javascript-format
msgid "%s can't open"
msgstr "Не удалось открыть приложение «%s»"

#: launch.js
msgid "It's turned off on this phone"
msgstr "Приложение отключено на этом телефоне"

#. TRANSLATORS: how long ago a notification came, shortest: under a minute
#: notifications.js
msgid "now"
msgstr "Сейчас"

#. TRANSLATORS: how long ago a notification came, shortest: %d minutes
#: notifications.js
#, javascript-format
msgid "%dm"
msgstr "%d мин."

#. TRANSLATORS: how long ago a notification came, shortest: %d hours
#: notifications.js
#, javascript-format
msgid "%dh"
msgstr "%d ч."

#. TRANSLATORS: how long ago a notification came, shortest: %d days
#: notifications.js
#, javascript-format
msgid "%dd"
msgstr "%d дн."

#. TRANSLATORS: how long ago a notification came, shortest: %d years
#: notifications.js
#, javascript-format
msgid "%dy"
msgstr "%d г."

#: notifications.js
msgid "Expand"
msgstr "Развернуть"

#: notifications.js
msgid "Collapse"
msgstr "Свернуть"

#. TRANSLATORS: the heading of the low-priority notifications in the shade
#: notifications.js
msgid "Silent"
msgstr "Без звука"

#: notifications.js
msgid "Notification history"
msgstr "История уведомлений"

#: notifications.js
msgctxt "notifications"
msgid "Clear all"
msgstr "Очистить все"

#: notifications.js
msgid "Notification settings"
msgstr "Настройки уведомлений"

#: notifications.js
msgid "No notifications"
msgstr "Нет уведомлений"

#. TRANSLATORS: an app records sound for the first time and asks for the microphone; %s is the app's name
#: pairdialog.js
#, javascript-format
msgid "Allow %s to use the microphone?"
msgstr "Разрешить приложению %s использовать микрофон?"

#. TRANSLATORS: a Bluetooth device asks to connect to one of the phone's services; %s is its name
#: pairdialog.js
#, javascript-format
msgid "Allow %s to connect?"
msgstr "Разрешить устройству %s подключиться?"

# android: Settings bluetooth_pairing_request
#. TRANSLATORS: a Bluetooth device asks to pair; %s is its name
#: pairdialog.js
#, javascript-format
msgid "Pair with %s?"
msgstr "Подключить устройство %s?"

# android: Settings bluetooth_pin_values_hint
#: pairdialog.js
msgid "Usually 0000 or 1234"
msgstr "Обычно 0000 или 1234"

# android: Settings bluetooth_enable_alphanumeric_pin
#: pairdialog.js
msgid "PIN contains letters or symbols"
msgstr "PIN-код содержит буквы или символы"

# android: Settings bluetooth_enter_pin_other_device
#: pairdialog.js
msgid "You may also need to type this PIN on the other device."
msgstr "Возможно, потребуется ввести PIN-код на другом устройстве."

# android: SettingsLib bluetooth_pairing_decline
#. authorize: a device pairing without a code
#: pairdialog.js
msgid "Cancel"
msgstr "Отмена"

# android: SettingsLib bluetooth_pairing_accept
#: pairdialog.js
msgid "Pair"
msgstr "Подключить"

#. TRANSLATORS: the passkey (six digits) to type here, as the other device shows it
#: pairdialog.js
msgid "Type the passkey shown on the other device."
msgstr "Введите ключ доступа, показанный на другом устройстве."

# android: Settings bluetooth_pairing_key_msg
#: pairdialog.js
msgid "Bluetooth pairing code"
msgstr "Код подключения Bluetooth"

# android: Settings bluetooth_enter_passkey_msg, typed on the other device
#. TRANSLATORS: over the code shown here, for a keyboard (the other device) to type
#: pairdialog.js
msgid "Type this code on the other device, then press Return or Enter."
msgstr "Введите этот код на другом устройстве и нажмите клавишу ввода."

# android: SystemUI usb_authorization_deny
#: pairdialog.js
msgid "Don't allow"
msgstr "Запретить"

# android: SystemUI usb_authorization_allow
#: pairdialog.js
msgid "Allow"
msgstr "Разрешить"

#. TRANSLATORS: the lock screen's line while a Bluetooth device waits to connect; %s is its name
#: pairdialog.js
#, javascript-format
msgid "Unlock to let %s connect"
msgstr "Разблокируйте для подключения %s"

#. TRANSLATORS: the lock screen's line while a Bluetooth device waits to pair; %s is its name
#: pairdialog.js
#, javascript-format
msgid "Unlock to pair with %s"
msgstr "Разблокируйте, чтобы подключить %s"

# android: SettingsLib bluetooth_pairing_error_message
#. TRANSLATORS: a notification's title when a pairing timed out; %s is the device's name
#: pairdialog.js
#, javascript-format
msgid "Couldn't pair with %s"
msgstr "Не удалось подключиться к устройству %s"

#: pairdialog.js qs.js
msgid "Bluetooth"
msgstr "Bluetooth"

#. TRANSLATORS: a Bluetooth device's question waits behind this notification while the phone is locked
#: pairdialog.js
msgid "Unlock the phone to answer."
msgstr "Разблокируйте телефон, чтобы ответить."

#. TRANSLATORS: under "Couldn't pair with …": a tap starts the pairing again
#: pairdialog.js
msgid "Tap to try again."
msgstr "Нажмите, чтобы повторить попытку."

#: powermenu.js
msgid "Lockdown"
msgstr "Блокировка входа"

#: powermenu.js
msgid "Power off"
msgstr "Выключить"

#: powermenu.js
msgid "Restart"
msgstr "Перезапустить"

#: qs.js
msgid "Wi-Fi"
msgstr "Wi-Fi"

#: qs.js
msgid "Flashlight"
msgstr "Фонарик"

#: qs.js
msgid "Do Not Disturb"
msgstr "Не беспокоить"

#. a phone's is Android's Modes tile, Do Not Disturb its one mode
#: qs.js
msgid "Modes"
msgstr "Режимы"

#: qs.js
msgid "Airplane mode"
msgstr "Режим полета"

#: qs.js
msgid "Mobile data"
msgstr "Моб. интернет"

#: qs.js
msgctxt "mobile data"
msgid "On"
msgstr "Включен"

#: qs.js
msgctxt "mobile data"
msgid "Off"
msgstr "Отключен"

#: qs.js
msgid "Auto-rotate"
msgstr "Автоповорот"

#: qs.js
msgid "Location"
msgstr "Геолокация"

#: qs.js
msgid "Dark theme"
msgstr "Тёмная тема"

#: qs.js
msgid "Battery Saver"
msgstr "Энергосбережение"

#: qs.js
msgid "Night Light"
msgstr "Ночная подсветка"

#: qs.js
msgid "Adaptive brightness"
msgstr "Адаптивная яркость"

#: qs.js
msgctxt "media volume"
msgid "Mute"
msgstr "Отключить звук"

#. the footer of quick settings: how many apps are running with no window (Android counts the apps with a
#. foreground service)
#: qs.js
#, javascript-format
msgid "%d app is active"
msgid_plural "%d apps are active"
msgstr[0] "%d активное приложение"
msgstr[1] "%d активных приложения"
msgstr[2] "%d активных приложений"

#: qs.js
msgid "Settings"
msgstr "Настройки"

#: qs.js
msgid "Power menu"
msgstr "Меню кнопки питания"

#. TRANSLATORS: an amount of memory; %s is the number of gigabytes ("1.5")
#: recents.js
#, javascript-format
msgid "%s GB"
msgstr "%s ГБ"

#. TRANSLATORS: an amount of memory; %s is the number of megabytes ("512")
#: recents.js
#, javascript-format
msgid "%s MB"
msgstr "%s МБ"

#: recents.js
msgctxt "memory"
msgid "Used"
msgstr "Используется"

#: recents.js
msgctxt "memory"
msgid "Cache"
msgstr "Кеш"

#: recents.js
msgctxt "memory"
msgid "Free"
msgstr "Свободно"

#: recents.js
msgctxt "recent apps"
msgid "Clear all"
msgstr "Очистить все"

#: recents.js
msgid "Screenshot"
msgstr "Скриншот"

#: recents.js
msgid "No recent items"
msgstr "Здесь пока ничего нет"

#. the app's page in Settings, over the home screen (where back from it leads on Android)
#. (info_24px: the newer App info icon, which the phone has)
#: recents.js
msgid "App info"
msgstr "О приложении"

#. TRANSLATORS: in a recent app's menu: removes it from the recent apps
#: recents.js
msgctxt "recent apps"
msgid "Clear"
msgstr "Очистить"

#. TRANSLATORS: the lock screen's charging line; %s is the battery's level ("75%")
#: state.js
#, javascript-format
msgid "%s • Charging slowly"
msgstr "Идет медленная зарядка (%s)"

#. TRANSLATORS: the lock screen's charging line; %s is the battery's level ("75%")
#: state.js
#, javascript-format
msgid "%s • Fast charging"
msgstr "Быстрая зарядка (%s)"

#. TRANSLATORS: the lock screen's charging line; %s is the battery's level ("75%")
#: state.js
#, javascript-format
msgid "%s • Super fast charging"
msgstr "Сверхбыстрая зарядка (%s)"

#. TRANSLATORS: the lock screen's charging line; %s is the battery's level ("75%")
#: state.js
#, javascript-format
msgid "%s • Wireless charging"
msgstr "Беспроводная зарядка (%s)"

#. TRANSLATORS: the lock screen's charging line, for a charger that is plugged in but holds the battery
#. where it is (too warm, or a charge limit); %s is the battery's level ("75%")
#: state.js
#, javascript-format
msgid "%s • Not charging"
msgstr "Не заряжается (%s)"

#. TRANSLATORS: the lock screen's charging line; %s is the battery's level ("75%")
#: state.js
#, javascript-format
msgid "%s • Charging"
msgstr "Идет зарядка (%s)"

#. TRANSLATORS: a current the battery charges at; %s is the number of amperes ("1.5")
#: state.js
#, javascript-format
msgid "%s A"
msgstr "%s А"

#: volume.js
msgctxt "ringer mode"
msgid "Ring"
msgstr "Со звуком"

#: volume.js
msgctxt "ringer mode"
msgid "Mute"
msgstr "Без звука"

#: volume.js
msgctxt "ringer mode"
msgid "Vibrate"
msgstr "Вибрация"

#: volume.js
msgid "Media volume"
msgstr "Громкость мультимедиа"

#: volume.js
msgid "Sound settings"
msgstr "Настройки звука"
