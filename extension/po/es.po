msgid "Wrong PIN. Try again."
msgstr "PIN incorrecto. Inténtalo de nuevo."

#: bouncer.js
msgid "Too many attempts with incorrect PIN"
msgstr "Demasiados intentos con un PIN incorrecto"

#: bouncer.js
msgid "PIN is required after device restarts"
msgstr "Se necesita el PIN tras el reinicio"

#: bouncer.js
msgid "Draw pattern"
msgstr "Dibuja el patrón"

