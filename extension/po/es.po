msgid "Too many attempts with incorrect pattern"
msgstr "Demasiados intentos con un patrón incorrecto"

#: bouncer.js
msgid "Pattern is required after device restarts"
msgstr "Se necesita el patrón tras el reinicio"

#: bouncer.js
#, javascript-format
msgid "Try again in %d second."
msgid_plural "Try again in %d seconds."
msgstr[0] "Vuelve a intentarlo en %d segundo."
