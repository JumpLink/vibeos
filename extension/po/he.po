msgstr "מצב פעיל"

# android: SystemUI cell_data_off (several translations, short)
#: qs.js
msgctxt "mobile data"
msgid "Off"
msgstr "כבוי"

# android: SystemUI quick_settings_rotation_unlocked_label
#: qs.js
msgid "Auto-rotate"
msgstr "סיבוב אוטומטי"

# android: SystemUI quick_settings_location_label
#: qs.js
msgid "Location"
msgstr "מיקום"

# android: SystemUI quick_settings_ui_mode_night_label
#: qs.js
msgid "Dark theme"
msgstr "עיצוב כהה"

# android: SystemUI quick_settings_dark_mode_secondary_label_battery_saver
#: qs.js
msgid "Battery Saver"
msgstr "חיסכון בסוללה"

# android: SystemUI quick_settings_night_display_label
#: qs.js
msgid "Night Light"
