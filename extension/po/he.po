msgstr "ניקוי הכול"

# android: SystemUI global_action_screenshot
#: recents.js
msgid "Screenshot"
msgstr "צילום מסך"

# android: Launcher3 recents_empty_message
#: recents.js
msgid "No recent items"
msgstr "אין פריטים אחרונים"

# android: SystemUI app_info (several translations, short)
#. the app's page in Settings, over the home screen (where back from it leads on Android)
#. (info_24px: the newer App info icon, which the phone has)
#: recents.js
msgid "App info"
msgstr "פרטי האפליקציה"

# android: Launcher3 recent_task_option_remove_task (several translations, short)
#. TRANSLATORS: in a recent app's menu: removes it from the recent apps
#: recents.js
msgctxt "recent apps"
msgid "Clear"
msgstr "ניקוי"

# android: Keyguard keyguard_plugged_in_charging_slowly
#. TRANSLATORS: the lock screen's charging line; %s is the battery's level ("75%")
#: state.js
#, javascript-format
msgid "%s • Charging slowly"
msgstr "%s • בטעינה איטית"

#. TRANSLATORS: the lock screen's charging line; %s is the battery's level ("75%")
#: state.js
#, javascript-format
msgid "%s • Fast charging"
msgstr "%s • בטעינה מהירה"

#. TRANSLATORS: the lock screen's charging line; %s is the battery's level ("75%")
#: state.js
#, javascript-format
msgid "%s • Super fast charging"
msgstr "%s • בטעינה מהירה במיוחד"

#. TRANSLATORS: the lock screen's charging line; %s is the battery's level ("75%")
#: state.js
#, javascript-format
msgid "%s • Wireless charging"
msgstr "%s • בטעינה אלחוטית"

#. TRANSLATORS: the lock screen's charging line, for a charger that is plugged in but holds the battery
#. where it is (too warm, or a charge limit); %s is the battery's level ("75%")
#: state.js
#, javascript-format
msgid "%s • Not charging"
msgstr "%s • הטעינה מושהית"

# android: Keyguard keyguard_plugged_in_dock
#. TRANSLATORS: the lock screen's charging line; %s is the battery's level ("75%")
#: state.js
#, javascript-format
msgid "%s • Charging"
msgstr "%s • בטעינה"

#. TRANSLATORS: a current the battery charges at; %s is the number of amperes ("1.5")
#: state.js
#, javascript-format
msgid "%s A"
msgstr "%s A"

