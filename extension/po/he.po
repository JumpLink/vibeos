# android: Settings auto_brightness_title (short)
#: qs.js
msgid "Adaptive brightness"
msgstr "בהירות אוטומטית"

# android: SystemUI screen_record_mute (several translations, short)
#: qs.js
msgctxt "media volume"
msgid "Mute"
msgstr "השתקה"

# android: SystemUI hearing_devices_settings_button (several translations, short)
#: qs.js
msgid "Settings"
msgstr "הגדרות"

# android: SystemUI accessibility_quick_settings_power_menu (several translations, short)
#: qs.js
msgid "Power menu"
msgstr "תפריט הפעלה"

#. TRANSLATORS: an amount of memory; %s is the number of gigabytes ("1.5")
#: recents.js
#, javascript-format
msgid "%s GB"
msgstr "%s GB"

#. TRANSLATORS: an amount of memory; %s is the number of megabytes ("512")
#: recents.js
#, javascript-format
