#: bouncer.js
msgid "Enter PIN"
msgstr "Inserisci il PIN"

#: bouncer.js
msgid "Wrong PIN. Try again."
msgstr "PIN errato. Riprova."

#: bouncer.js
msgid "Too many attempts with incorrect PIN"
msgstr "Troppi tentativi con il PIN errato"

#: bouncer.js
msgid "PIN is required after device restarts"
msgstr "PIN richiesto dopo il riavvio del dispositivo"

#: bouncer.js
msgid "Draw pattern"
msgstr "Traccia la sequenza"

#: bouncer.js
msgid "Wrong pattern. Try again."
msgstr "Sequenza errata. Riprova."

#: bouncer.js
msgid "Too many attempts with incorrect pattern"
msgstr "Troppi tentativi con la sequenza errata"

#: bouncer.js
msgid "Pattern is required after device restarts"
msgstr "Sequenza richiesta dopo il riavvio del dispositivo"

#: bouncer.js
#, javascript-format
msgid "Try again in %d second."
msgid_plural "Try again in %d seconds."
msgstr[0] "Riprova fra %d secondo"
msgstr[1] "Riprova fra %d secondi"

#. the mobile network, then (the owner's addition) the Wi-Fi network, joined with " | " as two SIMs' names
#. are
#: keyguard.js
msgid "Emergency calls only"
msgstr "Solo chiamate di emergenza"

#: keyguard.js qs.js
msgid "No SIM"
msgstr "Nessuna SIM presente"

#: keyguard.js
msgid "Charged"
msgstr "Carico"

#. PAM could not run: no attempt counted
#: keyguard.js
msgid "Could not check"
msgstr "Impossibile verificare"

#: keyguard.js
msgid "Try again"
msgstr "Riprova"

#. TRANSLATORS: an app that failed to start; %s is its name
#: launch.js
#, javascript-format
msgid "%s can't open"
msgstr "Impossibile aprire %s"

#: launch.js
msgid "It's turned off on this phone"
msgstr "L'app è disattivata su questo telefono"

#. TRANSLATORS: how long ago a notification came, shortest: under a minute
#: notifications.js
msgid "now"
msgstr "ora"

#. TRANSLATORS: how long ago a notification came, shortest: %d minutes
#: notifications.js
#, javascript-format
msgid "%dm"
msgstr "%d m"

#. TRANSLATORS: how long ago a notification came, shortest: %d hours
#: notifications.js
#, javascript-format
msgid "%dh"
msgstr "%d h"

#. TRANSLATORS: how long ago a notification came, shortest: %d days
#: notifications.js
#, javascript-format
msgid "%dd"
msgstr "%d g"

#. TRANSLATORS: how long ago a notification came, shortest: %d years
#: notifications.js
#, javascript-format
msgid "%dy"
msgstr "%d a"

#: notifications.js
msgid "Expand"
msgstr "Espandi"

#: notifications.js
msgid "Collapse"
msgstr "Comprimi"

#. TRANSLATORS: the heading of the low-priority notifications in the shade
#: notifications.js
msgid "Silent"
msgstr "Notifiche silenziose"

#: notifications.js
msgid "Notification history"
msgstr "Cronologia delle notifiche"

#: notifications.js
msgctxt "notifications"
msgid "Clear all"
msgstr "Cancella tutto"

#: notifications.js
msgid "Notification settings"
msgstr "Impostazioni di notifica"

#: notifications.js
msgid "No notifications"
msgstr "Nessuna notifica"

#. TRANSLATORS: an app records sound for the first time and asks for the microphone; %s is the app's name
#: pairdialog.js
#, javascript-format
msgid "Allow %s to use the microphone?"
msgstr "Consentire a %s di usare il microfono?"

#. TRANSLATORS: a Bluetooth device asks to connect to one of the phone's services; %s is its name
#: pairdialog.js
#, javascript-format
msgid "Allow %s to connect?"
msgstr "Consentire a %s di connettersi?"

# android: Settings bluetooth_pairing_request
#. TRANSLATORS: a Bluetooth device asks to pair; %s is its name
#: pairdialog.js
#, javascript-format
msgid "Pair with %s?"
msgstr "Accoppiare con %s?"

# android: Settings bluetooth_pin_values_hint
#: pairdialog.js
msgid "Usually 0000 or 1234"
msgstr "Di solito 0000 o 1234"

# android: Settings bluetooth_enable_alphanumeric_pin
#: pairdialog.js
msgid "PIN contains letters or symbols"
msgstr "Il PIN contiene lettere o simboli"

# android: Settings bluetooth_enter_pin_other_device
#: pairdialog.js
msgid "You may also need to type this PIN on the other device."
msgstr ""
"Potrebbe inoltre essere necessario digitare questo PIN sull'altro "
"dispositivo."

# android: SettingsLib bluetooth_pairing_decline
#. authorize: a device pairing without a code
#: pairdialog.js
msgid "Cancel"
msgstr "Annulla"

# android: SettingsLib bluetooth_pairing_accept
#: pairdialog.js
msgid "Pair"
msgstr "Accoppia"

#. TRANSLATORS: the passkey (six digits) to type here, as the other device shows it
#: pairdialog.js
msgid "Type the passkey shown on the other device."
msgstr "Digita la passkey mostrata sull'altro dispositivo."

# android: Settings bluetooth_pairing_key_msg
#: pairdialog.js
msgid "Bluetooth pairing code"
msgstr "Codice di accoppiamento via Bluetooth"

# android: Settings bluetooth_enter_passkey_msg, typed on the other device
#. TRANSLATORS: over the code shown here, for a keyboard (the other device) to type
#: pairdialog.js
msgid "Type this code on the other device, then press Return or Enter."
msgstr "Digita questo codice sull'altro dispositivo e premi Invio."

# android: SystemUI usb_authorization_deny
#: pairdialog.js
msgid "Don't allow"
msgstr "Non consentire"

# android: SystemUI usb_authorization_allow
#: pairdialog.js
msgid "Allow"
msgstr "Consenti"

#. TRANSLATORS: the lock screen's line while a Bluetooth device waits to connect; %s is its name
#: pairdialog.js
#, javascript-format
msgid "Unlock to let %s connect"
msgstr "Sblocca per far connettere %s"

#. TRANSLATORS: the lock screen's line while a Bluetooth device waits to pair; %s is its name
#: pairdialog.js
#, javascript-format
msgid "Unlock to pair with %s"
msgstr "Sblocca per accoppiare con %s"

# android: SettingsLib bluetooth_pairing_error_message
#. TRANSLATORS: a notification's title when a pairing timed out; %s is the device's name
#: pairdialog.js
#, javascript-format
msgid "Couldn't pair with %s"
msgstr "Impossibile eseguire l'accoppiamento con %s"

#: pairdialog.js qs.js
msgid "Bluetooth"
msgstr "Bluetooth"

#. TRANSLATORS: a Bluetooth device's question waits behind this notification while the phone is locked
#: pairdialog.js
msgid "Unlock the phone to answer."
msgstr "Sblocca il telefono per rispondere."

#. TRANSLATORS: under "Couldn't pair with …": a tap starts the pairing again
#: pairdialog.js
msgid "Tap to try again."
msgstr "Tocca per riprovare."

#: powermenu.js
msgid "Lockdown"
msgstr "Blocco"

#: powermenu.js
msgid "Power off"
msgstr "Spegni"

#: powermenu.js
msgid "Restart"
msgstr "Riavvia"

#: qs.js
msgid "Wi-Fi"
msgstr "Wi-Fi"

#: qs.js
msgid "Flashlight"
msgstr "Torcia"

#: qs.js
msgid "Do Not Disturb"
msgstr "Non disturbare"

#. a phone's is Android's Modes tile, Do Not Disturb its one mode
#: qs.js
msgid "Modes"
msgstr "Modalità"

#: qs.js
msgid "Airplane mode"
msgstr "Modalità aereo"

#: qs.js
msgid "Mobile data"
msgstr "Dati mobili"

#: qs.js
msgctxt "mobile data"
msgid "On"
msgstr "On"

#: qs.js
msgctxt "mobile data"
msgid "Off"
msgstr "Off"

#: qs.js
msgid "Auto-rotate"
msgstr "Rotazione automatica"

#: qs.js
msgid "Location"
msgstr "Posizione"

#: qs.js
msgid "Dark theme"
msgstr "Tema scuro"

#: qs.js
msgid "Battery Saver"
msgstr "Risparmio energetico"

#: qs.js
msgid "Night Light"
msgstr "Luminosità notturna"

#: qs.js
msgid "Adaptive brightness"
msgstr "Luminosità adattiva"

#: qs.js
msgctxt "media volume"
msgid "Mute"
msgstr "Disattiva audio"

#: qs.js
msgid "Settings"
msgstr "Impostazioni"

#: qs.js
msgid "Power menu"
msgstr "Menu del tasto di accensione"

#. TRANSLATORS: an amount of memory; %s is the number of gigabytes ("1.5")
#: recents.js
#, javascript-format
msgid "%s GB"
msgstr "%s GB"

#. TRANSLATORS: an amount of memory; %s is the number of megabytes ("512")
#: recents.js
#, javascript-format
msgid "%s MB"
msgstr "%s MB"

#: recents.js
msgctxt "memory"
msgid "Used"
msgstr "Utilizzata"

#: recents.js
msgctxt "memory"
msgid "Cache"
msgstr "Cache"

#: recents.js
msgctxt "memory"
msgid "Free"
msgstr "Disponibile"

#: recents.js
msgctxt "recent apps"
msgid "Clear all"
msgstr "Cancella tutto"

#: recents.js
msgid "Screenshot"
msgstr "Screenshot"

#: recents.js
msgid "No recent items"
msgstr "Nessun elemento recente"

#. the app's page in Settings, over the home screen (where back from it leads on Android)
#. (info_24px: the newer App info icon, which the phone has)
#: recents.js
msgid "App info"
msgstr "Informazioni app"

#. TRANSLATORS: in a recent app's menu: removes it from the recent apps
#: recents.js
msgctxt "recent apps"
msgid "Clear"
msgstr "Cancella"

#. TRANSLATORS: the lock screen's charging line; %s is the battery's level ("75%")
#: state.js
#, javascript-format
msgid "%s • Charging slowly"
msgstr "%s • Ricarica lenta"

#. TRANSLATORS: the lock screen's charging line; %s is the battery's level ("75%")
#: state.js
#, javascript-format
msgid "%s • Fast charging"
msgstr "%s • Ricarica rapida"

#. TRANSLATORS: the lock screen's charging line; %s is the battery's level ("75%")
#: state.js
#, javascript-format
msgid "%s • Super fast charging"
msgstr "%s • Ricarica super rapida"

#. TRANSLATORS: the lock screen's charging line; %s is the battery's level ("75%")
#: state.js
#, javascript-format
msgid "%s • Wireless charging"
msgstr "%s • Ricarica wireless"

#. TRANSLATORS: the lock screen's charging line, for a charger that is plugged in but holds the battery
#. where it is (too warm, or a charge limit); %s is the battery's level ("75%")
#: state.js
#, javascript-format
msgid "%s • Not charging"
msgstr "%s • Non in carica"

#. TRANSLATORS: the lock screen's charging line; %s is the battery's level ("75%")
#: state.js
#, javascript-format
msgid "%s • Charging"
msgstr "%s • In carica"

#. TRANSLATORS: a current the battery charges at; %s is the number of amperes ("1.5")
#: state.js
#, javascript-format
msgid "%s A"
msgstr "%s A"

#: volume.js
msgctxt "ringer mode"
msgid "Ring"
msgstr "Attiva suoneria"

#: volume.js
msgctxt "ringer mode"
msgid "Mute"
msgstr "Silenzia"

#: volume.js
msgctxt "ringer mode"
msgid "Vibrate"
msgstr "Attiva vibrazione"

#: volume.js
msgid "Media volume"
msgstr "Volume contenuti multimediali"

#: volume.js
msgid "Sound settings"
msgstr "Impostazioni audio"
