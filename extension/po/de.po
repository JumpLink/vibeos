#: bouncer.js
msgid "Pattern is required after device restarts"
msgstr "Nach Geräteneustart ist das Muster erforderlich"

#: bouncer.js
#, javascript-format
msgid "Try again in %d second."
msgid_plural "Try again in %d seconds."
msgstr[0] "Versuche es in %d Sekunde noch einmal"
