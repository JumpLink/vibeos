#: qs.js
msgid "Do Not Disturb"
msgstr "Niet storen"

#. a phone's is Android's Modes tile, Do Not Disturb its one mode
#: qs.js
msgid "Modes"
msgstr "Modi"

#: qs.js
msgid "Airplane mode"
msgstr "Vliegtuigmodus"

#: qs.js
msgid "Mobile data"
msgstr "Mobiele data"

#: qs.js
msgctxt "mobile data"
msgid "On"
msgstr "Aan"

#: qs.js
msgctxt "mobile data"
msgid "Off"
msgstr "Uit"

#: qs.js
msgid "Auto-rotate"
msgstr "Automatisch draaien"

#: qs.js
msgid "Location"
msgstr "Locatie"

#: qs.js
msgid "Dark theme"
msgstr "Donker thema"

#: qs.js
msgid "Battery Saver"
msgstr "Batterijbesparing"

#: qs.js
msgid "Night Light"
msgstr "Nachtverlichting"

#: qs.js
msgid "Adaptive brightness"
msgstr "Aanpasbare helderheid"

#: qs.js
msgctxt "media volume"
msgid "Mute"
msgstr "Geluid uitzetten"

#: qs.js
msgid "Settings"
msgstr "Instellingen"

#: qs.js
msgid "Power menu"
msgstr "Aan/uit-menu"

#. TRANSLATORS: an amount of memory; %s is the number of gigabytes ("1.5")
#: recents.js
#, javascript-format
msgid "%s GB"
msgstr "%s GB"

#. TRANSLATORS: an amount of memory; %s is the number of megabytes ("512")
#: recents.js
#, javascript-format
msgid "%s MB"
msgstr "%s MB"

#: recents.js
msgctxt "memory"
msgid "Used"
msgstr "Gebruikt"

#: recents.js
msgctxt "memory"
msgid "Cache"
msgstr "Cache"

#: recents.js
msgctxt "memory"
msgid "Free"
msgstr "Vrij"

#: recents.js
msgctxt "recent apps"
msgid "Clear all"
msgstr "Alles wissen"

#: recents.js
msgid "Screenshot"
msgstr "Screenshot"

#: recents.js
msgid "No recent items"
msgstr "Geen recente items"

#. the app's page in Settings, over the home screen (where back from it leads on Android)
#. (info_24px: the newer App info icon, which the phone has)
#: recents.js
msgid "App info"
msgstr "App-info"

#. TRANSLATORS: in a recent app's menu: removes it from the recent apps
#: recents.js
msgctxt "recent apps"
msgid "Clear"
msgstr "Wissen"

#. TRANSLATORS: the lock screen's charging line; %s is the battery's level ("75%")
#: state.js
#, javascript-format
msgid "%s • Charging slowly"
msgstr "%s • Langzaam opladen"

#. TRANSLATORS: the lock screen's charging line; %s is the battery's level ("75%")
#: state.js
#, javascript-format
msgid "%s • Fast charging"
msgstr "%s • Snel opladen"

#. TRANSLATORS: the lock screen's charging line; %s is the battery's level ("75%")
#: state.js
#, javascript-format
msgid "%s • Super fast charging"
msgstr "%s • Supersnel opladen"

#. TRANSLATORS: the lock screen's charging line; %s is the battery's level ("75%")
#: state.js
#, javascript-format
msgid "%s • Wireless charging"
msgstr "%s • Draadloos opladen"

#. TRANSLATORS: the lock screen's charging line, for a charger that is plugged in but holds the battery
#. where it is (too warm, or a charge limit); %s is the battery's level ("75%")
#: state.js
#, javascript-format
msgid "%s • Not charging"
msgstr "%s • Wordt niet opgeladen"

#. TRANSLATORS: the lock screen's charging line; %s is the battery's level ("75%")
#: state.js
#, javascript-format
msgid "%s • Charging"
msgstr "%s • Opladen"

#. TRANSLATORS: a current the battery charges at; %s is the number of amperes ("1.5")
#: state.js
#, javascript-format
msgid "%s A"
msgstr "%s A"

#: volume.js
msgctxt "ringer mode"
msgid "Ring"
msgstr "Beltoon"

#: volume.js
msgctxt "ringer mode"
msgid "Mute"
msgstr "Geluid staat uit"

#: volume.js
msgctxt "ringer mode"
msgid "Vibrate"
msgstr "Trillen"

