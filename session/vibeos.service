# The phone's session: GNOME Shell (mobile, /opt/gnome-mobile) with the vibeos extension, no display manager.
# gnome-desktop.service (the docked desktop) excludes it.
[Unit]
Description=VibeOS session
Conflicts=gnome-desktop.service
After=gnome-desktop.service systemd-user-sessions.service plymouth-quit-wait.service dbus.socket s10e-gpu-load.service
Wants=dbus.socket s10e-gpu-load.service
ConditionPathExists=/dev/tty0

[Service]
Environment=XDG_CURRENT_DESKTOP=GNOME
Environment=XDG_SESSION_DESKTOP=gnome
Environment=XDG_SESSION_TYPE=wayland
EnvironmentFile=-/run/s10e-gpu.env
# in the user's language (Settings' Language: AccountsService's), as a display manager would start it
ExecStart=/usr/local/libexec/vibeos-session-language /usr/bin/gnome-session
ExecStartPost=+chvt 7
User=user
PAMName=login
WorkingDirectory=~
TimeoutStartSec=30
TimeoutStopSec=10s
# a session that ends by itself comes back. gnome-session exits 0 when its D-Bus goes away under it: the session
# vibeos-dock swaps out restarts the user's D-Bus as it ends (gnome-session-restart-dbus.service), and one started a moment
# too early went with it (11-06), as a session does when the shell aborts. OnFailure saw neither, and the phone was
# left with no session at all: a black screen and a dead power key. A stop (a swap, shutdown) stays a stop
Restart=always
RestartSec=1

TTYPath=/dev/tty7
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty7
UtmpMode=user

[Install]
WantedBy=graphical.target
